{
  "schema": "profile/v1",
  "argv": {
    "build": [
      "python3",
      "-m",
      "compileall",
      "-q",
      "."
    ],
    "test": [
      "python3",
      "-c",
      "import json, pathlib; json.loads(pathlib.Path('.prd/profile.json').read_text())"
    ]
  },
  "notes": "argv bootstrapped before real suites exist \u2014 build compiles the future src/+skills/ trees, test proves profile parses; replace with real pytest argv at first suite.",
  "module_map": {
    ".": 1,
    "plans": 9,
    "reports": 1
  },
  "hot_files": [],
  "land_target": "sprint",
  "max_parallel": 5,
  "default_host": "2IC",
  "protected_paths": [],
  "docs": {
    "machinery": "docs/machinery",
    "decisions": "docs/decisions"
  },
  "file_line_cap": 800,
  "machinery_root": "",
  "tests_root": "tests"
}
