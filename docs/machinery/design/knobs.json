    "space.section_py": {"token": "space.section_py", "kind": "map", "per": {"compact": [32, 48, 64], "regular": [64, 96], "spacious": [96, 128]}, "tier": "structural", "rules": ["G.1", "G.2", "L.7"]},
    "grid.gutter": {"token": "grid.gutter_px", "kind": "enum", "values": [16, 24, 32, 48, 64], "tier": "structural", "rules": ["G.1", "R.2"]},
