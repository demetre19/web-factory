{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://web-factory.local/schemas/web-meta.json",
 "title": "web capture meta — client site, reference, comparison and corpus captures",
 "description": "One meta.json per analysed site/page. Single source of truth: W1 discovery writes it for client and reference sites, patterns/tools/capture_*.py writes it for the pattern corpus, and gate.py w1 validates it. capture_status is written by capture_ok.py (HTTP probe + pixel variance) and a non-ok capture may never be annotated, classified, embedded, indexed or counted as evidence.",
 "type": "object",
 "additionalProperties": true,
 "required": [
  "url",
  "domain",
  "site_type",
  "page_type",
  "source",
  "width",
  "height",
  "tiles",
  "capture_status",
  "schema_version"
 ],
 "properties": {
  "url": {"type": "string", "pattern": "^https?://"},
  "domain": {"type": "string", "minLength": 1},
  "site_type": {"type": "string", "minLength": 1,
                "description": "one of patterns/TAXONOMY.md §2 (26 verticals)"},
  "page_type": {"type": "string", "minLength": 1},
  "source": {"type": "string",
             "enum": ["client", "reference", "comparison", "curated", "negative", "discovery"]},
  "width": {"type": "integer", "minimum": 320},
  "height": {"type": "integer", "minimum": 320,
             "description": "capture window height, not the page's true height; content_tiles is the real extent"},
  "tiles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
  "content_tiles": {"type": "integer", "minimum": 0,
                    "description": "leading tiles that are not flat — a short page is valid, its trailing tiles are padding"},
  "capture_status": {
   "type": "string",
   "enum": ["ok", "blocked", "error", "blank", "parked"],
   "description": "ok is the only value that may enter classification, DNA, the pattern corpus, embeddings, the search index or training"
  },
  "capture_reason": {"type": "string",
                     "description": "machine code + the evidence it rests on, e.g. blocked:cloudflare_just_a_moment (title='Just a moment...')"},
  "probe": {
   "type": "object",
   "description": "the HTTP evidence capture_status rests on",
   "properties": {
    "status": {"type": "integer"},
    "final_url": {"type": "string"},
    "title": {"type": "string"},
    "text_sample": {"type": "string"},
    "bytes": {"type": "integer"},
    "seconds": {"type": "number"},
    "error": {"type": "string"},
    "fetched_at": {"type": "string"}
   }
  },
  "images": {
   "type": "array",
   "description": "one entry per image on the page (CLASSIFY.md output, media blocks only — a whole section screenshot is not an image)",
   "items": {"$ref": "#/definitions/image"}
  },
  "ui_analysis": {"$ref": "#/definitions/ui_analysis"},
  "set_summary": {"$ref": "#/definitions/set_summary"},
  "motion": {"$ref": "#/definitions/motion"},
  "schema_version": {"type": "string"},
  "classified_at": {"type": "string"},
  "classifier_model": {"type": "string"}
 },
 "definitions": {
  "valued": {
   "type": "object",
   "required": ["value", "confidence"],
   "properties": {
    "value": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "string"}
   }
  },
  "image": {
   "type": "object",
   "required": ["file", "tile", "bbox", "medium", "subject_class", "role_on_page", "confidence"],
   "properties": {
    "file": {"type": "string", "description": "tile file the crop lives in"},
    "tile": {"type": "string"},
    "bbox": {"type": "array", "minItems": 4, "maxItems": 4,
             "items": {"type": "number"}, "description": "[x0,y0,x1,y1] in page px"},
    "medium": {"$ref": "#/definitions/valued"},
    "subject": {"type": "string"},
    "subject_class": {"$ref": "#/definitions/valued"},
    "role_on_page": {"$ref": "#/definitions/valued"},
    "technical": {"type": "object"},
    "graphic": {"type": "object"},
    "composition": {"type": "object"},
    "emotion_axes": {
     "type": "object",
     "description": "CLASSIFY.md §5, integers -2..+2",
     "additionalProperties": {"type": "number", "minimum": -2, "maximum": 2}
    },
    "emotion_tags": {"type": "array", "items": {"type": "string"}, "maxItems": 3},
    "style": {"type": "object"},
    "intent": {"type": "object"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1,
                   "description": "min of the closed-set confidences"},
    "evidence": {"type": "string"},
    "classifier_model": {"type": "string"},
    "classified_at": {"type": "string"}
   }
  },
  "ui_analysis": {
   "type": "object",
   "description": "UI-ANALYSIS.md output, provenance extracted|inferred",
   "properties": {
    "summary_title": {"type": "string"},
    "nav": {"type": "string"},
    "layout": {"type": "object"},
    "sections": {"type": "array", "items": {"type": "object"}},
    "controls": {"type": "array", "items": {"type": "object"}},
    "palette": {"type": "object",
                "description": "role -> hex (bg, surface, ink, ink_muted, accent, accent_fg, border)"},
    "grid": {"type": "object"},
    "typography": {"type": "object"},
    "imagery_icons": {"type": "object"},
    "design_extraction": {"type": "object"},
    "provenance": {"type": "string", "enum": ["extracted", "inferred"]}
   }
  },
  "set_summary": {
   "type": "object",
   "required": ["dominant_medium", "emotion_axes", "emotion_tags", "style", "consistency"],
   "properties": {
    "dominant_medium": {"type": "string"},
    "emotion_axes": {"type": "object",
                     "additionalProperties": {"type": "number"}},
    "emotion_tags": {"type": "array", "items": {"type": "string"}},
    "style": {"type": "string"},
    "consistency": {"type": "number", "minimum": 0, "maximum": 1},
    "outliers": {"type": "array", "items": {"type": "string"}},
    "n_images": {"type": "integer"},
    "provenance": {"type": "string", "enum": ["inferred", "confirmed"]}
   }
  }
  ,
  "motion": {
   "type": "object",
   "description": "CLASSIFY-MOTION output. Enums generated from docs/machinery/design/motion/taxonomy.json (single source; regenerate when taxonomy.json changes). Requires capture_status ok upstream.",
   "required": ["schema_version", "classified_at", "reduced_motion_emulated", "counts", "records", "summary"],
   "properties": {
    "schema_version": {"type": "string"},
    "classified_at": {"type": "string"},
    "reduced_motion_emulated": {"type": "boolean", "enum": [false],
                                "description": "guard: the scan ran with prefers-reduced-motion:no-preference (enum not const — gate _schema_errors enforces enum)"},
    "reduced_motion_fallback_present": {"type": "boolean"},
    "partial": {"type": "boolean",
                "description": "true when evidence is incomplete (cross-origin CSS, opaque JS motion)"},
    "libs": {"type": "array",
             "items": {"type": "string",
                       "enum": ["none", "gsap", "anime-js", "lottie", "rive", "lenis", "scrollmagic", "other"]}},
    "counts": {
     "type": "object",
     "properties": {
      "svg": {"type": "integer", "minimum": 0},
      "smil": {"type": "integer", "minimum": 0},
      "canvas": {"type": "integer", "minimum": 0},
      "keyframes_defined": {"type": "integer", "minimum": 0},
      "keyframes_dead": {"type": "array", "items": {"type": "string"}},
      "animated_elements": {"type": "integer", "minimum": 0}
     }
    },
    "records": {"type": "array", "items": {
   "type": "object",
   "required": ["selector", "trigger", "technique", "budget", "timing_class", "status", "confidence"],
   "properties": {
    "selector": {"type": "string", "minLength": 1},
    "context": {"type": "string"},
    "in_svg": {"type": "boolean"},
    "trigger": {"type": "string",
                "enum": ["load", "in-view", "loop", "hover", "focus", "active", "scroll-linked", "click", "media", "undetermined", "none"]},
    "technique": {"type": "string",
                  "enum": ["css-keyframes", "css-transition", "smil", "waapi", "rAF-loop", "lottie", "rive", "gsap", "anime-js", "css-scroll-timeline", "svg-sprite-loop", "view-transition", "video-gif"]},
    "property": {"type": "array",
                 "items": {"type": "string",
                           "enum": ["transform-translate", "transform-scale", "transform-rotate", "transform-skew", "opacity", "stroke-dashoffset", "stroke-dasharray", "stroke", "fill-opacity", "fill", "path-d", "clip-path", "mask", "filter", "custom-property", "border-radius", "geometry-attr", "motion-path", "color", "background", "visibility"]}},
    "budget": {"type": "string",
               "enum": ["compositor-safe", "stroke-cheap", "paint-bound", "layout-risk"]},
    "m_type": {"type": "string",
               "enum": ["conversational", "functional", "structural", "emotional"]},
    "purpose": {"type": "array",
                "items": {"type": "string",
                          "enum": ["entrance", "exit", "state-change", "feedback", "loading", "progress", "attention", "explanation", "navigation", "ambient", "scroll-progress", "word-cycle"]}},
    "timing_class": {"type": "string",
                     "enum": ["instant", "micro", "standard", "structural", "slow", "loop-short", "loop-ambient"]},
    "duration_ms": {"type": "number", "minimum": 0},
    "easing_family": {"type": "string",
                      "pattern": "^(linear|ease-out|ease-in|ease-both|overshoot|elastic|bounce|steps|custom:cubic-bezier\\(|other:)"},
    "easing_raw": {"type": "string"},
    "delay": {"type": "string"},
    "iterations": {"type": "string"},
    "loop_type": {"type": "string",
                  "enum": ["none", "infinite", "n-times", "palindrome", "phased", "handoff"]},
    "complexity": {"type": "string",
                   "enum": ["atomic", "composite", "choreographed", "system"]},
    "js_dependency": {"type": "string",
                      "enum": ["none", "light", "library"]},
    "status": {"type": "string", "enum": ["live", "paused", "dead"]},
    "detail": {"type": "string", "enum": ["opaque"],
               "description": "JS-driven motion that cannot be decompiled"},
    "keyframes": {"type": "string"},
    "personality_fit": {"type": "array",
                        "items": {"type": "string",
                                  "enum": ["none", "subtle", "elegant", "professional", "playful"]}},
    "layout_per_s": {"type": "number", "minimum": 0,
                     "description": "CDP Performance LayoutCount delta per second during the animation"},
    "violations": {"type": "array",
                   "items": {"type": "string",
                             "enum": ["linear_on_spatial", "ambient_exempt", "layout_prop_animated", "budget_exceeded", "dead_keyframe"]},
                   "description": "ambient_exempt is the recorded exemption for linear on infinite ambient loops, not a failure"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "string"}
   }
  }},
    "summary": {
     "type": "object",
     "properties": {
      "motion_tier": {"type": "string",
                      "enum": ["static", "subtle", "expressive", "cinematic"]},
      "dominant_personality": {"type": "string",
                               "enum": ["none", "subtle", "elegant", "professional", "playful"]},
      "focal_per_viewport_ok": {"type": "boolean"},
      "budget_violations": {"type": "array", "items": {"type": "string"}},
      "continuous_loops": {"type": "integer", "minimum": 0}
     }
    }
   }
  }
 }
}
