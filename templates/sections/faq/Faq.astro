---
/**
 * faq — gold exemplar (SB.5). Native details/summary: no JS, keyboard
 * and screen-reader correct, and the first answer can stay open.
 */
interface Props {
  heading?: string;
  fs?: string;
  body?: string;
  eyebrow?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string }[];
  image?: { src: string; alt: string };
  h1?: boolean;
  brand?: string;
}
const {
  heading = 'Section heading', fs = '', body = '', eyebrow = '',
  cta, items = [], h1, brand,
} = Astro.props;
const sub = fs || body;
---
<div>
  <div class="sec-head">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="text-fluid-3">{heading}</h2>
    {sub && <p class="lede">{sub}</p>}
  </div>
  <div class="mt-sec">
    {items.map((it, i) => (
      <details class="faq-item" open={i === 0}>
        <summary class="faq-q">{it.title}</summary>
        <p class="t0 faq-a">{it.text}</p>
      </details>
    ))}
  </div>
</div>
