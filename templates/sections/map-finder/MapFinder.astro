---
/**
 * map-finder — gold exemplar (SB.5). Adapt copy, tokens and rhythm to the
 * contract; keep the skeleton. Renders inside Section.astro: no
 * <section>, no outer padding/background/max-width (SB.2).
 */
interface Props {
  heading?: string;
  fs?: string;
  body?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string; value?: string;
             label?: string; term?: string; href?: string; quote?: string }[];
  image?: { src: string; alt: string };
  h1?: boolean;
}
const {
  heading = 'Section heading', fs = '',
  body = '', cta, items = [], image, h1,
} = Astro.props;
// the map is the section: it centres on the first area the items list
const area = [items.map((it) => it.label || it.title || it.term).find(Boolean),
              'Victoria, Australia'].filter(Boolean).join(', ');
---

<div class="grid gap-fluid-l md:grid-cols-2">
  <div class="max-w-prose">
    {h1 ? <h1 class="text-fluid-4">{heading}</h1> : <h2 class="text-fluid-3">{heading}</h2>}
    {fs && <p class="mt-stack text-fluid-0">{fs}</p>}
    <ul class="mt-stack grid-auto list-plain text-fluid-0">
      {items.map((it) => (
        <li><a class="underline" href={it.href ?? '#'}>{it.label || it.title || it.term}</a></li>
      ))}
    </ul>
  </div>
  <iframe class="aspect-square w-full rounded-card border border-muted" title={`Map of ${area}`} src={`https://maps.google.com/maps?q=${encodeURIComponent(area)}&z=11&output=embed`} loading="lazy"></iframe>
</div>
