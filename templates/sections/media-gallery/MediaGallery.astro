---
/**
 * media-gallery — gold exemplar (SB.5). Adapt copy, tokens and rhythm to the
 * contract; keep the skeleton. Renders inside Section.astro: no
 * <section>, no outer padding/background/max-width (SB.2).
 */
interface Props {
  heading?: string;
  fs?: string;
  body?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string; value?: string;
             label?: string; href?: string; quote?: string }[];
  image?: { src: string; alt: string };
  h1?: boolean;
}
const {
  heading = 'Section heading', fs = 'The first sentence a reader needs.',
  body = '', cta, items = [], image, h1,
} = Astro.props;
---

<div>
  {h1 ? <h1 class="text-fluid-2">{heading}</h1> : <h2 class="text-fluid-2">{heading}</h2>}
  <ul class="mt-stack grid-auto gap-fluid-s">
    {items.map((it) => (
      <li class="aspect-square overflow-hidden rounded-card">
        <picture><img class="h-full w-full object-cover" src={it.href ?? '/media/placeholder.svg'}
             alt={it.label ?? 'Gallery item'} width="800" height="800" loading="lazy" /></picture>
      </li>
    ))}
  </ul>
</div>
