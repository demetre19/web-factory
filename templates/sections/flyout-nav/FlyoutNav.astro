---
/**
 * flyout-nav — gold exemplar (SB.5). A bar, not a band: brand,
 * desktop link row (.nav-desk), one phone action, burger. The
 * mobile menu is ALWAYS the flyout sheet (.nav-links.nav-flyout:
 * scrim, close control, grouped links, the bar CTA docking at the
 * panel foot — N.flyout), toggled by the BaseLayout contract.
 * Renders inside Section.astro (mode="bar").
 */
interface Props {
  brand?: string;
  logo?: string;
  items?: { label?: string; href?: string }[];
  cta?: { label: string; href: string };
}
const { brand = 'Brand', logo, items = [], cta } = Astro.props;
// N.select — the desktop bar keeps the leading links whose labels
// fit its budget; the rest open behind "More"
const navFit = (() => { let w = 0, n = 0;
  for (const it of items) { w += String(it.label || '').length + 2;
    if (w > 56) break; n++; }
  return n; })();
const navOver = items.length > 6 || navFit < items.length;
const navCut = Math.max(1, Math.min(navFit, 4));
// P.11 — the brand mark renders as inline SVG markup, never an
// image tag: the emitter mirrors public/<logo>.svg into src/assets/
// so it compiles in via ?raw glob
const logos = import.meta.glob('../assets/*.svg', { query: '?raw', import: 'default', eager: true });
const logoName = logo ? String(logo).split('/').pop() : null;
const logoSvg = logoName ? logos[`../assets/${logoName}`] : null;
---
<div class="row between bar-min">
  <a class="brand-mark logo" href="/" aria-label={logoSvg ? brand : undefined}>{logoSvg ? <span class="brand-logo" set:html={logoSvg} role="img" aria-label={brand} /> : brand}</a>
  <nav class="nav-desk" aria-label="Primary">
    <ul class="row gap-fluid-m list-plain">
      {items.slice(0, navCut).map((it) => (
        <li><a class="nav-link" href={it.href || '#'}>{it.label}</a></li>
      ))}
    </ul>
  </nav>
  {navOver && <button class="nav-more" type="button" aria-label="More links">More</button>}
  <div class="row">
    {cta && <div class="nav-cta"><a class="wf-cta-button" href={cta.href}>{cta.label}</a></div>}
    <button class="theme-toggle" data-theme-toggle type="button" aria-label="Switch between light and dark mode"><svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg><svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg></button>
    <button class="burger" type="button" aria-label="Menu"><span aria-hidden="true">&equiv;</span></button>
  </div>
  <nav class="nav-links nav-flyout" aria-label="Menu">
    <button class="nav-close" type="button" aria-label="Close menu">&times;</button>
    <ul class="nav-group list-plain">
      {items.map((it) => (
        <li><a class="nav-link" href={it.href || '#'}>{it.label}</a></li>
      ))}
    </ul>
  </nav>
</div>
