---
/**
 * nav-bar — gold exemplar (SB.5). A bar, not a band: brand, links,
 * one phone action. Renders inside Section.astro (mode="bar").
 */
interface Props {
  brand?: string;
  items?: { label?: string; href?: string }[];
  cta?: { label: string; href: string };
}
const { brand = 'Brand', items = [], cta } = Astro.props;
---
<div class="row between bar-min">
  <a class="brand-mark logo" href="/">{brand}</a>
  <nav class="nav-links" aria-label="Primary">
    {items.map((it) => (
      <a class="nav-link" href={it.href || '#'}>{it.label}</a>
    ))}
  </nav>
  <button class="burger wf-cta-button" type="button" aria-label="Menu">Menu</button>
  {cta && <a class="wf-cta-button" href={cta.href}>{cta.label}</a>}
</div>
