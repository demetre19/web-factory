---
/**
 * nav-h21 — gold exemplar (SB.5), bound to bank recipe bricksmaven/headers/header-21. The skeleton IS the gold structure — this file is the recipe verbatim so emit and the gate judge one artifact.
 */

/**
 * wf-header-21 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (header-21.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string; term?: string;
             label?: string; href?: string;
             icon?: string; items?: any[] }[];
  image?: { src: string; alt: string };
  copy?: any;
}
import { inline } from '../_shared/inline';
import IconChip from '../_shared/IconChip.astro';
import { Image } from 'astro:assets';
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
  image,
  copy,
} = Astro.props;
// §4.3 — a copy slot binds verbatim article copy onto
// the skeleton's native props (F.1 — nothing dropped)
const cp = copy || {};
const head = cp.heading || heading;
const sub = cp.answer || cp.text || fs;
const before = cp.before || [];
const list = (cp.items && cp.items.length
  ? cp.items : items) || [];
const qas = cp.qa || [];
const links = cp.links || [];
const after = cp.after || [];
const act = cp.cta || cta;
const phone = cp.phone || '';
const tel = phone ? 'tel:' + phone.replace(/[^0-9+]/g, '') : '';
// V.8/P.12 — rasters resolve through src/assets/media/
// so <Image> compiles AVIF/WebP srcsets
const _media = import.meta.glob('../assets/media/*.{jpg,jpeg,png,webp}', { eager: true });
const _mn = image ? String(image.src).split('/').pop() : null;
const mediaSrc = _mn ? (_media[`../assets/media/${_mn}`]?.default ?? null) : null;
---

<div class="wf-header-21">
  <span class="logo brand-mark">{brand}</span>
  <div class="sec-inner">
    <div class="wf-header-21__container row between">
      {list.length > 0 &&       <div>
        {list.length > 0 && <nav class="nav-desk" aria-label="Primary"><ul class="row gap-fluid-m list-plain">{(list || []).map((it) => <li><a class="nav-link" href={it.href}>{it.label || it.term || it.title || it.text}</a></li>)}</ul></nav>}
      </div>
      }
      {image &&       <div>
        {image && image.src && <figure class="ratio-portrait"><div class="media-round" data-ratio={image.ratio || null}><Image src={mediaSrc || image.src} alt={image.alt || ''} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 50vw, 100vw" width={900} height={600} loading="lazy" /></div></figure>}
      </div>
      }
      <div class="wf-header-21__cta row between">
        <div class="row between">
          {list.length > 0 && <button class="burger" type="button" aria-label="Menu"><span aria-hidden="true">≡</span></button>}
          {list.length > 0 && <nav class="nav-links nav-flyout" aria-label="Primary">
            <div class="wf-off-canvas-6__content">
              <button class="nav-close" type="button" aria-label="Close menu">×</button>
              {head && <h2 class="text-fluid-2">{head}</h2>}
              {list.length > 0 && <div class="wf-off-canvas-nav-ul">
                <div class="nav-group">{(list || []).map((it) => (
                    <div>
                      <a class="text-fluid-0" href={it.href}>{it.icon && <IconChip name={it.icon} />} {it.label || it.term || it.anchor || it.text}</a>
                      {(it.label || it.term || it.anchor) && it.text && <p class="text-fluid-0">{it.text}</p>}
                    </div>
                  ))}</div>
              </div>}
              <div class="wf-off-canvas-6__contact-footer">
                {links.length > 0 && <div class="wf-off-canvas-contact">
                  <div class="nav-group">{(links || []).map((it) => (
                      <div class="wf-off-canvas-contact-item">
                        <a class="text-fluid-0" href={it.href}>{it.icon && <IconChip name={it.icon} />} {it.label || it.term || it.anchor || it.text}</a>
                        {(it.label || it.term || it.anchor) && it.text && <p class="text-fluid-0">{it.text}</p>}
                      </div>
                    ))}</div>
                </div>}
                {sub && <p class="text-fluid-0" set:html={inline(sub)} />}
                              </div>
              {before.length > 0 && <div class="flow mt-stack">
{before.map((p) => <p class="mt-flow text-fluid-0" set:html={inline(p)} />)}
              </div>}

            </div>
          }
          {act.label && <p class="nav-cta mt-fluid-m"><a class="wf-cta-button" href={act.href}>{act.label}</a></p>}
        </div>
      </div>
    </div>
  </div>
</div>
