---
/**
 * cutout-catalog-grid — gold exemplar (SB.5). Catalog rows whose
 * visuals are background-removed objects floating on the card's
 * surface (spec-sheet / product-catalog feel), not framed photos.
 * Each item's `image` is a transparent PNG from the cutout stage;
 * a missing asset drops to the .cutout-ph placeholder so the grid
 * still renders (G.1). Items bind from COPY.json items[].
 */
import { Image } from 'astro:assets';
import { inline, mediaFor } from '../_shared/inline';
import type { CopySlot, MediaInput } from '../_shared/inline';
interface Props {
  heading?: string;
  fs?: string;
  body?: string;
  eyebrow?: string;
  cta?: { label: string; href: string };
  items?: { term?: string; title?: string; text?: string;
             label?: string; href?: string; image?: MediaInput }[];
  h1?: boolean;
  brand?: string;
  copy?: CopySlot;
}
const {
  heading = 'Section heading', fs = '', body = '', eyebrow = '',
  cta, items = [], h1, brand, copy,
} = Astro.props;
const cp: CopySlot = copy || {};
const head = cp.heading || heading;
const answer = cp.answer || '';
const sub = answer || fs || body;
const before = cp.before || [];
const list = (cp.items && cp.items.length ? cp.items : items) || [];
const links = cp.links || [];
const after = cp.after || [];
---
<div>
  <div class="sec-head">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    {h1 ? <h1 class="text-fluid-3">{head}</h1> : <h2 class="text-fluid-3">{head}</h2>}
    {sub && <p class="lede" set:html={inline(sub)} />}
    {before.map((p) => (
      <p class="t0 sub-p" set:html={inline(p)} />
    ))}
  </div>
  {list.length > 0 && (
    <ul class="mt-sec grid-auto list-plain">
      {list.map((it) => {
        const m = mediaFor(it.image, it.title || it.term || '');
        return (
        <li class="card cutout-card">
          <figure class="cutout-slot">
            {m
              ? (m.mod
                  ? <Image class="cutout" src={m.mod} alt={m.alt}
                           widths={[320, 640]} sizes="(min-width: 48rem) 30vw, 88vw"
                           loading="lazy" />
                  : <img class="cutout" src={m.src} alt={m.alt}
                         width="640" height="640" loading="lazy" />)
              : <div class="cutout-ph" role="img"
                     aria-label={it.title || it.term || ''}>
                  <span class="cutout-ph-label">cutout pending</span>
                </div>}
          </figure>
          <h3 class="t0 sub-h" set:html={inline(it.term || it.title)} />
          <p class="t0 sub-p" set:html={inline(it.text)} />
        </li>
        );
      })}
    </ul>
  )}
  {links.map((l) => (
    <p class="t0 sub-p" set:html={inline(l.text || '')} />
  ))}
  {after.map((p) => (
    <p class="t0 sub-p" set:html={inline(p)} />
  ))}
  {cta && <div class="cta-row mt-sec">
    <a class="wf-cta-button" href={cta.href}>{cta.label}</a>
  </div>}
</div>
