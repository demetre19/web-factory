---
/**
 * sequence — gold exemplar (SB.5). Ordered steps as ruled rows: the
 * numeral column is the motif, the rule is the rhythm. Reads as a
 * process, not a card grid.
 */
interface Props {
  heading?: string;
  fs?: string;
  body?: string;
  eyebrow?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string }[];
  image?: { src: string; alt: string };
  h1?: boolean;
  brand?: string;
}
const {
  heading = 'Section heading', fs = '', body = '', eyebrow = '',
  cta, items = [], h1, brand,
} = Astro.props;
const sub = fs || body;
const num = (i: number) => String(i + 1).padStart(2, '0');
---
<div>
  <div class="sec-head">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="text-fluid-3">{heading}</h2>
    {sub && <p class="lede">{sub}</p>}
  </div>
  <ol class="flow-list mt-sec list-plain">
    {items.map((it, i) => (
      <li class="flow-row">
        <span class="num num-prom">{num(i)}</span>
        <div>
          <h3 class="t0 sub-h">{it.title}</h3>
          <p class="t0 sub-p sub-flow">{it.text}</p>
        </div>
      </li>
    ))}
  </ol>
</div>
