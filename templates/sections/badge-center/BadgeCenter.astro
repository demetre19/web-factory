---
/**
 * badge-center — gold exemplar (SB.5). Adapt copy, tokens and rhythm to the
 * contract; keep the skeleton. Renders inside Section.astro: no
 * <section>, no outer padding/background/max-width (SB.2).
 */
import IconChip from '../_shared/IconChip.astro';

interface Props {
  heading?: string;
  fs?: string;
  body?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string; value?: string;
             label?: string; href?: string; quote?: string }[];
  image?: { src: string; alt: string };
  h1?: boolean;
}
const {
  heading = 'Section heading', fs = '',
  body = '', cta, items = [], image, h1,
} = Astro.props;
---

<div class="text-center">
  <IconChip name="check" />
  {h1 ? <h1 class="mt-fluid-s text-fluid-1">{heading}</h1> : <h2 class="mt-fluid-s text-fluid-1">{heading}</h2>}
  {fs && <p class="mt-fluid-s text-fluid-0">{fs}</p>}
</div>
