---
/**
 * split-media — gold exemplar (SB.5). Claim on the left, media on the
 * right; the fold's one job is to say what this is and offer the act.
 */
interface Props {
  heading?: string;
  fs?: string;
  body?: string;
  eyebrow?: string;
  cta?: { label: string; href: string };
  items?: { label?: string; href?: string }[];
  image?: { src: string; alt: string };
  h1?: boolean;
  brand?: string;
}
const {
  heading = 'Section heading', fs = '', body = '', eyebrow = '',
  cta, items = [], image, h1, brand,
} = Astro.props;
const sub = fs || body;
---
<div class="split">
  <div class="stack">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    {h1
      ? <h1 class="t0 h-display text-fluid-5">{heading}</h1>
      : <h2 class="t0 h-section text-fluid-3">{heading}</h2>}
    {sub && <p class="t0 lede">{sub}</p>}
    <div class="cta-row mt-act">
      {cta
        ? <a class="wf-cta-button" href={cta.href}>{cta.label}</a>
        : items[0] && <a class="wf-cta-button" href={items[0].href || '#'}>{items[0].label}</a>}
      {items[1] && <a class="link-quiet" href={items[1].href || '#'}>{items[1].label}</a>}
    </div>
    <p class="t0 attrib sub-flow">
      Licensed Victorian plumber · Fixed price agreed on site · 7 days
    </p>
  </div>
  {image
    ? <div class="media-round ratio-portrait">
        <img src={image.src} alt={image.alt} loading="eager" />
      </div>
    : <div class="media-panel media-hero" aria-hidden="true"></div>}
</div>
