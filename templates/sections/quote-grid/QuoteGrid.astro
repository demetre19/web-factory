---
/**
 * quote-grid — gold exemplar (SB.5). Three first-party voices, each a
 * full sentence, attributed. No stars, no stock faces.
 */
interface Props {
  heading?: string;
  fs?: string;
  body?: string;
  eyebrow?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string; quote?: string;
             who?: string }[];
  image?: { src: string; alt: string };
  h1?: boolean;
  brand?: string;
}
const {
  heading = 'Section heading', fs = '', body = '', eyebrow = '',
  cta, items = [], h1, brand,
} = Astro.props;
const sub = fs || body;
---
<div>
  <div class="sec-head">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="text-fluid-3">{heading}</h2>
    {sub && <p class="lede">{sub}</p>}
  </div>
  <ul class="mt-sec grid-auto gap-fluid-m list-plain">
    {items.map((it) => (
      <li class="card">
        <p class="t0 quote">“{it.quote || it.text}”</p>
        <p class="t0 attrib">{it.who || it.title}</p>
      </li>
    ))}
  </ul>
</div>
