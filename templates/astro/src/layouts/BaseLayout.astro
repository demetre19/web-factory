---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCTA from '../components/MobileCTA.astro';
import JsonLd from '../components/JsonLd.astro';

// Every route renders inside this layout: SEOHead gets the page's
// frontmatter fields copied verbatim, body content lands in <slot />.
// One layout per template kind (service-detail / article / utility) is
// the S5 build lane's job — this file is the shared shell they extend.
interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  robots?: string;
  ogType?: string;
  /** BCP-47 lang for <html>. */
  lang?: string;
  /** sitemap page_class — drives Service/Article JSON-LD nodes. */
  pageClass?: 'money' | 'article' | 'ancillary' | string;
  /** Breadcrumb trail root→leaf for BreadcrumbList JSON-LD. */
  breadcrumbs?: { name: string; path: string }[];
  /** FAQ Q/A pairs — only on faq: yes routes. */
  faq?: { q: string; a: string }[];
}

const {
  title,
  description,
  path = '/',
  image,
  robots,
  ogType,
  lang = 'en',
  pageClass,
  breadcrumbs = [],
  faq = [],
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEOHead
      title={title}
      description={description}
      path={path}
      image={image}
      robots={robots}
      ogType={ogType}
    />
    <JsonLd
      path={path}
      title={title}
      description={description}
      pageClass={pageClass}
      breadcrumbs={breadcrumbs}
      faq={faq}
    />
  </head>
  <body>
    <a class="wf-skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="wf-container">
      <slot />
    </main>
    <Footer />
    <MobileCTA path={path} />
  </body>
</html>

<style>
  .wf-skip {
    position: absolute; left: -9999px; top: 0;
    padding: 0.75rem 1rem; background: var(--c-ink);
    color: var(--c-paper); z-index: 100; text-decoration: none;
  }
  .wf-skip:focus-visible { left: 0; }
</style>
