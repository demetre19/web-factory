---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site';

// Proof-of-build page: the starter must `astro build` green with zero
// content. The S5 build lane replaces this page (and adds one page file
// per ROUTE-MANIFEST.json route) — this file is an example, not a route.
// The hero block below models the fold-quad contract: H1 (what/who) +
// standfirst (pain → offer) + primary CTA (next step) + trust strip —
// the same four parts every built page's hero module carries (S5 spec).
const tel = site.phone.replace(/[^0-9+]/g, '');
---

<BaseLayout
  title={`${site.name} — Starter`}
  description="Vendored Astro starter for Web Factory S5 build lanes."
  path="/"
>
  <section class="wf-hero">
    <h1>{site.name}</h1>
    <p class="wf-standfirst">
      This page proves the starter builds clean. S5 build lanes replace
      it with real routes bound to site/content-final/.
    </p>
    {tel && (
      <p>
        <a class="wf-cta-button" href={`tel:${tel}`}
           aria-label={`Call ${site.name}`}>Call {site.name}</a>
      </p>
    )}
    <p class="wf-trust-strip">Fully insured — details on request.</p>
  </section>
</BaseLayout>

<style>
  .wf-hero {
    padding-block: var(--sp-fluid-l);
    display: grid;
    gap: var(--sp-fluid-s);
  }
  .wf-standfirst { font-size: var(--fs-1); }
  .wf-trust-strip {
    font-size: var(--fs--1);
    color: var(--c-muted);
  }
</style>
