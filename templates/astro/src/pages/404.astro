---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site';

// Designed 404 per the S5 ancillary-surface contract: brand shell
// (Header/Footer/MobileCTA ride BaseLayout), one H1, the company
// description, onward links into the pillar routes + call CTA.
// noindex — the page is not a sitemap or nav member.
const tel = site.phone.replace(/[^0-9+]/g, '');
---

<BaseLayout
  title={`Page not found — ${site.name}`}
  description="The page you requested does not exist."
  path="/404/"
  robots="noindex"
  pageClass="ancillary"
>
  <section class="wf-404">
    <h1>Page not found</h1>
    {site.description && <p>{site.description}</p>}
    <nav aria-label="Site sections">
      <ul class="wf-404-links">
        {site.nav.map((n) => (
          <li><a href={n.path}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    {tel && (
      <p>
        <a class="wf-cta-button" href={`tel:${tel}`}
           aria-label={`Call ${site.name}`}>Call {site.name}</a>
      </p>
    )}
  </section>
</BaseLayout>

<style>
  .wf-404 {
    padding-block: var(--sp-fluid-l);
    display: grid;
    gap: var(--sp-fluid-s);
  }
  .wf-404-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-fluid-s);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .wf-404-links a {
    display: inline-block;
    min-height: 44px;
    align-content: center;
    padding-inline: 0.75rem;
    border: 1px solid var(--c-muted);
    border-radius: var(--r-card);
    text-decoration: none;
  }
</style>
