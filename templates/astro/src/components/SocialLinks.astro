---
import { site } from '../site';

// The two render sites for `site.social` — the footer (every page)
// and the /about/ page body. One data source, zero dead icons: an
// empty array renders nothing (S5 spec §Social links).
interface Props {
  /** Heading shown above the list (e.g. "Follow us", "Social"). */
  heading?: string;
}
const { heading } = Astro.props;
---

{site.social.length > 0 && (
  <nav class="wf-social" aria-label="Social profiles">
    {heading && <span class="wf-social-heading">{heading}</span>}
    <ul>
      {site.social.map((profile) => (
        <li>
          <a href={profile.url} rel="me noopener" target="_blank">
            {profile.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .wf-social ul {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap; gap: 0.75rem 1rem;
  }
  .wf-social-heading {
    display: block; font-weight: 600; margin-block-end: 0.5rem;
  }
  .wf-social a { color: var(--c-ink); }
</style>
