---
import { site } from '../site';

// Complete footer per the S5 spec: site map (every route) + NAP/contact
// block. Facts come from src/site.ts — the build lane fills them from
// site-brief.md. `itemscope` keeps the NAP machine-readable.
const year = new Date().getFullYear();
---

<footer class="wf-footer">
  <div class="wf-container wf-footer-grid">
    <nav class="wf-footer-sitemap" aria-label="Site map">
      <h2 class="wf-footer-heading">Site map</h2>
      <ul>
        {site.nav.map((item) => (
          <li><a href={item.path}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <address class="wf-footer-nap" itemscope itemtype="https://schema.org/LocalBusiness">
      <h2 class="wf-footer-heading">Contact</h2>
      <meta itemprop="name" content={site.name} />
      <span itemprop="address">{site.address}</span>
      <a itemprop="telephone" href={`tel:${site.phone.replace(/[^0-9+]/g, '')}`}>{site.phone}</a>
      <a itemprop="email" href={`mailto:${site.email}`}>{site.email}</a>
    </address>
  </div>

  <div class="wf-container wf-footer-legal">
    <small>© {year} {site.name}</small>
  </div>
</footer>

<style>
  .wf-footer { border-top: 1px solid rgb(0 0 0 / 0.08); margin-top: var(--sp-fluid-l); }
  .wf-footer-grid {
    display: grid; gap: var(--sp-fluid-m);
    grid-template-columns: 1fr; padding-block: var(--sp-fluid-m);
  }
  @media (min-width: 640px) {
    .wf-footer-grid { grid-template-columns: 1fr 1fr; }
  }
  .wf-footer-heading { font-size: var(--fs-1); }
  .wf-footer-sitemap ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .wf-footer-nap { font-style: normal; display: flex; flex-direction: column; gap: 0.5rem; }
  .wf-footer a { color: var(--c-ink); }
  .wf-footer-legal { padding-block: 1rem; color: var(--c-muted); }
</style>
