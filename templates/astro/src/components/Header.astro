---
import { site } from '../site';

// Header + real functional mobile menu (S5 spec): hamburger opens a
// focus-trapped, dismissible panel. Labels are shortened forms of the
// route's long H1 — URL/H1/title stay bound, labels do not.
const current = Astro.url.pathname;
const isCurrent = (p: string) =>
  p === '/' ? current === '/' : current.startsWith(p);
---

<header class="wf-header">
  <div class="wf-container wf-header-bar">
    <a class="wf-header-brand" href="/">{site.name}</a>

    <nav class="wf-nav-desktop" aria-label="Primary">
      {site.nav.map((item) => (
        <a
          href={item.path}
          aria-current={isCurrent(item.path) ? 'page' : undefined}
          class:list={['wf-nav-link', { 'is-current': isCurrent(item.path) }]}
        >{item.label}</a>
      ))}
    </nav>

    <button
      id="wf-menu-button"
      class="wf-menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="wf-menu-panel"
      aria-label="Open menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <div id="wf-menu-overlay" class="wf-menu-overlay" hidden></div>

  <nav
    id="wf-menu-panel"
    class="wf-menu-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Site menu"
    hidden
  >
    <button
      id="wf-menu-close"
      class="wf-menu-close"
      type="button"
      aria-label="Close menu"
    >✕</button>
    <ul class="wf-menu-list">
      {site.nav.map((item) => (
        <li>
          <a
            href={item.path}
            aria-current={isCurrent(item.path) ? 'page' : undefined}
            class="wf-menu-link"
          >{item.label}</a>
        </li>
      ))}
    </ul>
    <div class="wf-menu-nap">
      <a class="wf-menu-phone" href={`tel:${site.phone.replace(/[^0-9+]/g, '')}`}>{site.phone}</a>
      <a class="wf-menu-email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </nav>
</header>

<style>
  .wf-header { border-bottom: 1px solid rgb(0 0 0 / 0.08); }
  .wf-header-bar {
    display: flex; align-items: center; justify-content: space-between;
    min-height: 4rem; gap: 1rem;
  }
  .wf-header-brand { font-size: var(--fs-1); font-weight: 700; text-decoration: none; color: var(--c-ink); }
  .wf-nav-desktop { display: none; gap: 1.5rem; }
  .wf-nav-link { color: var(--c-ink); text-decoration: none; }
  .wf-nav-link.is-current { color: var(--c-accent); font-weight: 600; }
  .wf-menu-button { display: inline-flex; padding: 0.5rem; }
  @media (min-width: 768px) {
    .wf-nav-desktop { display: flex; }
    .wf-menu-button { display: none; }
  }
  .wf-menu-overlay {
    position: fixed; inset: 0; background: rgb(0 0 0 / 0.4); z-index: 40;
  }
  .wf-menu-panel {
    position: fixed; inset-block: 0; right: 0; z-index: 50;
    width: min(20rem, 85vw); background: var(--c-paper);
    display: flex; flex-direction: column; gap: 1rem;
    padding: 1rem var(--sp-fluid-s); box-shadow: var(--sh-lift);
  }
  .wf-menu-close { align-self: flex-end; padding: 0.5rem; font-size: var(--fs-1); }
  .wf-menu-list { display: flex; flex-direction: column; gap: 0.75rem; list-style: none; padding: 0; margin: 0; }
  .wf-menu-link { font-size: var(--fs-1); color: var(--c-ink); text-decoration: none; }
  .wf-menu-nap { margin-top: auto; display: flex; flex-direction: column; gap: 0.5rem; font-size: var(--fs--1); }
</style>

<script>
  // Focus-trapped menu: Tab/Shift+Tab cycle inside the panel, Escape or
  // overlay click closes, focus returns to the trigger. Runs once per
  // page load (View Transitions re-run astro:page-load automatically).
  function initMenu() {
    const button = document.getElementById('wf-menu-button');
    const panel = document.getElementById('wf-menu-panel');
    const overlay = document.getElementById('wf-menu-overlay');
    const closeBtn = document.getElementById('wf-menu-close');
    if (!button || !panel || !overlay || !closeBtn) return;
    if (button.dataset.wfInit === '1') return;
    button.dataset.wfInit = '1';

    const FOCUSABLE =
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';
    let lastFocused: Element | null = null;

    function focusables(): HTMLElement[] {
      return Array.from(panel!.querySelectorAll<HTMLElement>(FOCUSABLE));
    }

    function openMenu() {
      lastFocused = document.activeElement;
      panel!.hidden = false;
      overlay!.hidden = false;
      button!.setAttribute('aria-expanded', 'true');
      button!.setAttribute('aria-label', 'Close menu');
      document.body.style.overflow = 'hidden';
      document.addEventListener('keydown', onKeydown);
      focusables()[0]?.focus();
    }

    function closeMenu() {
      panel!.hidden = true;
      overlay!.hidden = true;
      button!.setAttribute('aria-expanded', 'false');
      button!.setAttribute('aria-label', 'Open menu');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKeydown);
      (lastFocused as HTMLElement | null)?.focus?.();
    }

    function onKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        closeMenu();
        return;
      }
      if (e.key !== 'Tab') return;
      const items = focusables();
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement as HTMLElement | null;
      if (e.shiftKey && (active === first || active === panel)) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && (active === last || !panel!.contains(active))) {
        e.preventDefault();
        first.focus();
      }
    }

    button.addEventListener('click', () =>
      panel.hidden ? openMenu() : closeMenu()
    );
    closeBtn.addEventListener('click', closeMenu);
    overlay.addEventListener('click', closeMenu);
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a[href]')) closeMenu();
    });
  }

  initMenu();
  document.addEventListener('astro:page-load', initMenu);
</script>
