     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Card\". --*/\n\n.card-feature-111{\n  /* Card hover and focus styles */\n  &:hover, &:focus-within{\n    background-color: var(--neutral);\n    \n    /* Text color on hover or focus */\n    .card-feature-111__heading,\n    .card-feature-111__taxonomy,\n    .card-feature-111__description,\n    .card-feature-111__author-name{\n      color: var(--white);\n    }\n    \n    /* Border color on hover or focus */\n    .card-feature-111__taxonomy{\n      border-color: var(--white-trans-20);\n    }\n  }\n}"
