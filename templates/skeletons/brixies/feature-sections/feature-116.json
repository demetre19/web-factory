     "user_id": 2,
     "time": 1722633118,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Content\" (Section). -- */\n\n.feature-116 {\n  /* Controls the size of the transparency effect on the left and right sides. */\n  --feature-116-logo-transparency-size: 25%;\n\n  /* Controls the animation speed. A higher value creates a slower animation. */\n  --feature-116-logo-duration: 35s;\n\n  .feature-116-logo__logo-list-container {\n    -webkit-mask-image: linear-gradient(\n      to right,\n      transparent 0%,\n      #000 var(--feature-116-logo-transparency-size),\n      #000 calc(100% - var(--feature-116-logo-transparency-size)),\n      transparent 100%\n    );\n\n    mask-image: linear-gradient(\n      to right,\n      transparent 0%,\n      #000 var(--feature-116-logo-transparency-size),\n      #000 calc(100% - var(--feature-116-logo-transparency-size)),\n      transparent 100%\n    );\n\n    .feature-116-logo__logo-list {\n      animation:\n        feature-116-logo-horizontal-scroll\n        var(--feature-116-logo-duration)\n        linear\n        infinite;\n    }\n\n    /* Pauses the animation while hovering over the logo container. */\n    &:hover {\n      .feature-116-logo__logo-list {\n        animation-play-state: paused;\n      }\n    }\n  }\n}\n\n\n/* Moves the logo list continuously from right to left. */\n@keyframes feature-116-logo-horizontal-scroll {\n  from {\n    transform: translateX(0);\n  }\n\n  to {\n    transform: translateX(-100%);\n  }\n}"
    },
