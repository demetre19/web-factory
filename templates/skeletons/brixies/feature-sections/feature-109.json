   {
    "id": "zbycqv",
    "name": "code",
    "parent": 0,
    "children": [],
    "settings": {
     "executeCode": true,
     "signature": "1a460a33f96d4f07eaff36560b84fe21",
     "user_id": 2,
     "time": 1775753157,
     "code": "<script src=\"https://cdn.jsdelivr.net/npm/@splidejs/splide-extension-auto-scroll@0.5.3/dist/js/splide-extension-auto-scroll.min.js\"></script>",
     "javascriptCode": "document.addEventListener('DOMContentLoaded', () => {\n  // Delay to allow Bricks to initialize the sliders\n  setTimeout(() => {\n    // Get the full slider element (update the class if it has been changed manually)\n    const sliderElement = document.querySelector(\".feature-109__slider\");\n    // Retrieve the required object ID from the data attribute for the slider instance\n    const sliderId = sliderElement.getAttribute('data-script-id');\n\n    // Access the slider instance using the dynamic ID\n    const sliderInstance = window.bricksData?.splideInstances[sliderId];\n    if (sliderInstance) {\n      // Destroy the previous instance and reinitialize it\n      sliderInstance.destroy(true);\n\n      // Set options for the auto-scroll feature\n      sliderInstance.options = {\n        autoScroll: {\n          speed: 1, // Set the auto-scroll speed\n        },\n      };\n\n      // Mount the slider with the AutoScroll extension\n      sliderInstance.mount({ AutoScroll: window.splide.Extensions.AutoScroll });\n    } else {\n      console.error('Slider instance not found.');\n    }\n  }, 10); // Adjust the delay if needed\n});",
     "cssCode": "/* -- Root styles should be placed in the structural element named \"Slider\" -- */\n\n.feature-109__slider {\n  .card-feature-109{\n    /* Hover styles and when there is focus on a link within the card */\n    &:hover, &:focus-within{\n      .card-feature-109__overlay{\n        opacity: 1;\n      }\n    }\n  }\n\n  /* Styles for the slider container to show the cards that are outside the container. Change it to hidden or remove the styles if you don't want that. */\n  .splide__track {\n    overflow: visible;\n  }\n}\n"
    },
    "label": "CSS & JS AutoScroll",
