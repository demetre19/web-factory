     "time": 1722633118,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Card wrapper\". --*/\n\n/* These styles will be applied to the only even-numbered elements */\n.card-feature-16__wrapper:nth-child(even){\n  .card-feature-16__container-info{\n    order:2;\n\n    /* - Styles for mobile landscape version - */\n    @media(max-width: 767px){\n      order:1;\n    }\n  }\n\n  .card-feature-16__img{\n    order:1;\n\n    /* - Styles for mobile landscape version - */\n    @media(max-width: 767px){\n      order:2;\n    }\n  }\n}"
    },
    "label": "CSS Styles"
