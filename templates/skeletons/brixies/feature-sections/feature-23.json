     "time": 1722633118,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Card\". --*/ \n.card-feature-23__wrapper{\n  /*-- Styles applied to all even elements --*/\n  &:nth-child(even){\n    margin-top: calc(-1 * var(--space-xxl));\n\n    @media(max-width: 767px){\n      margin-top:0;\n    }\n  }\n  /*-- Styles applied when mouse hover or focus on the card --*/\n  .card-feature-23__link{\n    &:hover, &:focus{\n      /*-- Background image is scaled 1.2 larger --*/\n      .card-feature-23__img{\n        transform: scale(1.2);\n      }\n    }\n  }\n}"
    },
