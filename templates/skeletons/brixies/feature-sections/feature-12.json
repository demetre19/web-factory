     "user_id": 2,
     "time": 1722633118,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Pane\" (It is inside \"Tab content\"). --*/ \n\n\n/* -- Styles for the card of a fade in for each time it is displayed, you can remove it if you don't want it or change it for the one you like. --*/ \n.feature-12__tabs-content-img-wrapper.brx-open{\n  animation: fade-in 0.5s ease;\n}\n\n/* Animation */\n@keyframes fade-in {\n  0% {\n    opacity: 0;\n  }\n  100% {\n    opacity: 1;\n  }\n}"
    },
    "label": "Style CSS"
   }
