    "id": "seegzi",
    "name": "code",
    "parent": 0,
    "children": [],
    "settings": {
     "javascriptCode": "document.addEventListener('DOMContentLoaded', () => {\n  // Selecting all available cards with the class \"card-feature-102\"\n  const cards = document.querySelectorAll('.card-feature-102');\n\n  cards.forEach((card) => {\n    // Target description text to animate\n    const text = card.querySelector('.card-feature-102__description');\n    if (!text) return;\n\n    // Open: add state class + set max-height to the real content height\n    const open = () => {\n      card.classList.add('is-open');\n      text.style.maxHeight = text.scrollHeight + 'px';\n    };\n\n    // Close: remove state class + remove inline max-height (CSS handles collapsed state)\n    const close = () => {\n      card.classList.remove('is-open');\n      text.style.removeProperty('max-height');\n    };\n\n    // Desktop hover behavior\n    card.addEventListener('mouseenter', open);\n    card.addEventListener('mouseleave', close);\n\n    // Keyboard accessibility: trigger open/close on heading link focus\n    const link = card.querySelector('.card-feature-102__heading a');\n    if (link) {\n      link.addEventListener('focus', open);\n      link.addEventListener('blur', close);\n    }\n  });\n});",
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Features\" (Section). --*/\n\n\n/* Style the element with the class \u201cis-open\u201d when JS adds it */\n.card-feature-102{\n  &.is-open\n  .card-feature-102__description{\n    margin-top: var(--space-xs);\n  }\n}",
     "executeCode": true
    },
    "label": "JS & CSS Styles"
   },
