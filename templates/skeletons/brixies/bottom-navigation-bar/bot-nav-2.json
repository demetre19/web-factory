     "time": 1720984090,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Nav (Nestable)\". --*/\n\n.bot-nav-2__nav{\n\n  /* Styles to element when active or on page */\n  .bot-nav-2__nav-link[aria-current=\"page\"]{\n\n    /* Display the text when the element is active or is the page */\n    .bot-nav-2__nav-info{\n      display: block;\n    }\n  }\n}"
    },
