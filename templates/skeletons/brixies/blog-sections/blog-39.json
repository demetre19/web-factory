     "time": 1722633118,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Card\". --*/\n\n.card-blog-39{\n  /* Hover styles and when there is focus on a link within the card */\n  &:hover, &:focus-within{\n    transform: translateY(-2%);\n\n    .card-blog-39__icon-wrapper{\n      transform: scale(1.1);\n    }\n  }\n\n  /* Styles for adding a comma when there is more than one element */\n  .card-blog-39__list-item:not(:last-of-type){\n    .card-blog-39__list-info:after{\n      content: \",\";\n    }\n  }\n}"
    },
    "label": "CSS Style",
