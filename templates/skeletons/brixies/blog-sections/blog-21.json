    "settings": {
     "code": "<style>\n  /* -- The root styles must go in the element of the structure with the name \"Card blog\". --*/\n\n  .card-blog-21__wrapper {\n\n    /*-- Styles applied to the first two cards --*/\n    &:nth-of-type(-n + 2) {\n      grid-row: span 3;\n\n      /* Tablet styles */\n      @media(max-width: 991px) {\n        grid-row: auto;\n      }\n    }\n\n    /*--  Styles applied to all cards except the first two cards --*/\n    &:not(:nth-of-type(-n + 2)) {\n\n      /* Image and button styles */\n      .card-blog-21__img,\n      .card-blog-21__btn {\n        display: none;\n      }\n\n      /* Styles that will not affect the last card */\n      &:not(:last-child) {\n        padding-block-end: var(--space-m);\n        border-bottom: 1px solid var(--neutral-trans-10);\n\n        /* Tablet styles */\n        @media(max-width: 991px) {\n          padding-block-end: var(--space-xl);\n        }\n      }\n\n      /* Tablet styles */\n      @media(max-width: 991px) {\n        grid-column: span 2;\n\n        /* Styles applied to the second-to-last card */\n        &:nth-last-child(3) {\n          padding-block-start: var(--space-xl);\n          border-top: 1px solid var(--neutral-trans-10);\n        }\n      }\n\n      /* Mobile landscape styles */\n      @media(max-width: 767px) {\n        grid-column: auto;\n      }\n    }\n\n    /* Excerpt styles to have only 2 line breaks */\n    .card-blog-21__excerpt {\n      overflow: hidden;\n      display: -webkit-box;\n      -webkit-line-clamp: 2;\n      -webkit-box-orient: vertical;\n      height: max-content;\n    }\n  }\n</style>\n",
     "executeCode": true,
