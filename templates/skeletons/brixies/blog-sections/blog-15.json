     "user_id": 2,
     "time": 1722633118,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Card\". --*/\n\n/* Styles applied to the first card */\n.card-blog-15__wrapper{\n  &:first-child{\n    grid-column: 1 / 3;\n    grid-row: span 2;\n\n    /* Header styles using clamp, you can change it if your root font is 100% */\n    .card-blog-15__heading{\n      font-size: clamp(2.9rem, 0.7735rem + 4.4487vw, 7.5rem);\n    }\n\n    /* Tablet styles */\n    @media (max-width: 991px){\n      grid-column: 1 / -1;\n      aspect-ratio: 4 / 3;\n    }\n\n    /* Mobile styles */\n    @media(max-width: 767px){\n      grid-column: auto;\n      aspect-ratio: 1 / 1;\n\n      .card-blog-15__heading{\n        font-size: var(--text-xl);\n      }\n    }\n  }\n\n  /* Styles applied to all elements except the first one. */\n  &:not(:first-child){\n    aspect-ratio: 1 / 1;\n\n    .card-blog-15__btn{\n      display: none;\n    }\n\n    /* Mobile styles */\n    @media(max-width: 767px){\n      .card-blog-15__btn{\n        display: flex;\n      }\n    }\n  }\n}"
    },
    "label": "CSS Style"
   },
