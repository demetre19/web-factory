     "user_id": 2,
     "time": 1722633118,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Card\". --*/\n\n.card-blog-16__wrapper {\n\n  /* Styles applied to the first card */\n  &:nth-child(4n + 1) {\n    grid-column: 1 / 9;\n    aspect-ratio: 890 / 420;\n  }\n\n  /* Styles applied to the second card */\n  &:nth-child(4n + 2) {\n    grid-column: 9 / -1;\n    grid-row: span 2;\n    aspect-ratio: 9 / 16;\n  }\n\n  /* Styles applied to the third card */\n  &:nth-child(4n + 3) {\n    grid-column: 1 / 4;\n    aspect-ratio: 1 / 1;\n  }\n\n  /* Styles applied to the fourth card */\n  &:nth-child(4n + 4) {\n    grid-column: 4 / 9;\n    aspect-ratio: 545 / 315;\n  }\n\n\n  /*-- TABLET STYLES --*/\n  @media(max-width: 991px) {\n\n    /* Styles for the first and fourth cards */\n    &:nth-child(3n + 1) {\n      grid-column: 1 / 3;\n      grid-row: span 1;\n      aspect-ratio: 16 / 9;\n    }\n\n    /* Styles for the second and third cards */\n    &:nth-child(3n + 2),\n    &:nth-child(3n + 3) {\n      grid-column: span 1;\n      grid-row: span 1;\n      aspect-ratio: 4 / 3;\n    }\n  }\n\n\n  /*-- MOBILE STYLES --*/\n  @media(max-width: 767px) {\n\n    /* Styles for all cards */\n    &:nth-child(1n) {\n      grid-column: auto;\n      aspect-ratio: 1 / 1;\n    }\n  }\n\n  /* Excerpt text styles and heading */\n  /*-- This will ensure that the excerpt is always displayed in two lines no matter how wide the text is, so that it is always responsive and does not break the design.  --*/\n  .card-blog-16__excerpt {\n    overflow: hidden;\n    display: -webkit-box;\n    -webkit-line-clamp: 2;\n    -webkit-box-orient: vertical;\n    height: max-content;\n  }\n\n  /*-- Styles so that the header does not exceed 3 lines and does not generate an overflow of content. --*/\n  .card-blog-16__heading {\n    overflow: hidden;\n    display: -webkit-box;\n    -webkit-line-clamp: 3;\n    -webkit-box-orient: vertical;\n    height: max-content;\n  }\n}"
    },
    "label": "CSS Style"
   },
