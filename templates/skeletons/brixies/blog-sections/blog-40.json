     "time": 1722633118,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Blog\" (Section). --*/\n\n/* Styles applied to the first card */\n.blog-40__list-item{\n  &:first-child{\n    grid-column: span 2;\n    grid-row: span 2;\n\n    /* Tablet styles */\n    @media (max-width: 991px) {\n      grid-row: auto;\n    }\n\n    /* Mobile landscape styles */\n    @media (max-width: 767px) {\n      grid-column: auto;\n    }\n\n    /* Styles for the first heading */\n    .card-blog-40__heading{\n      font-size: var(--text-xl);\n\n      /* Mobile landscape styles */\n      @media *max-width: 767px {\n        font-size: var(--text-l);\n      }\n    }\n  }\n}"
