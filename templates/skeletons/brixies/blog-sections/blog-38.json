    "settings": {
     "executeCode": true,
     "noRoot": true,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Card\". --*/\n\n.blog-38__list-item{\n  /* Styles of the first card */\n  &:first-child{\n    grid-column: span 2;\n    grid-row: span 3;\n    position: relative;\n\n    /* Tablet styles */\n    @media (max-width: 991px) {\n      grid-row: auto;\n    }\n    \n    /* Mobile landscape styles */\n    @media (max-width: 767px) {\n      grid-column: auto;\n    }\n\n    /* Card styles */\n    .card-blog-38{\n      position: sticky;\n      top: -20%;\n\n      /* Tablet styles */\n      @media (max-width: 991px) {\n        position: static;\n      }\n\n      /* Styles of the info container with white background */\n      .card-blog-38__container-info{\n        position: absolute;\n        bottom: 0;\n        left: 0;\n        z-index: 10;\n        padding: var(--space-m);\n        background-color: var(--white);\n        width: calc(100% - var(--space-l));\n        gap: var(--space-m);\n\n        /* Heading styles */\n        .card-blog-38__heading{\n          font-size: var(--text-xl);\n          font-weight: 700;\n        }\n\n        /* Styles for displaying the list of taxonomies and authors */\n        .card-blog-38__taxonomy-list,\n        .card-blog-38__author-container{\n          display: flex;\n        }\n      }\n    }\n  }\n}"
    },
