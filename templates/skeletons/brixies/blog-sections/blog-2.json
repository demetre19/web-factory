     "user_id": 2,
     "time": 1722633118,
     "javascriptCode": "document.addEventListener('DOMContentLoaded', (event) => {\n  setTimeout(() => {\n\n    // Get full slider class ID (change if you have changed it manually)\n    const idComplete = document.querySelector(\".blog-2__slider\").id;\n    // Obtaining the required object ID for the const mySlider\n    const idSlider = idComplete.substring(5);\n\n    const mySlider = window.bricksData?.splideInstances[idSlider] || false\n\n    // Please replace the button classes to suit your scenario\n    const myPrevBtn = document.querySelector('.blog-2__arrow-left')\n    const myNextBtn = document.querySelector('.blog-2__arrow-right')\n\n    if (mySlider && myPrevBtn && myNextBtn) {\n\n      // Add click event handlers for your custom buttons\n      myPrevBtn.addEventListener('click', function () {\n        mySlider.go('-1') // go() function by SplideJS\n      })\n      myNextBtn.addEventListener('click', function () {\n        mySlider.go('+1') // go() function by SplideJS\n      })\n    }\n  }, 250)\n})"
    },
    "label": "Script slider",
    "themeStyles": []
