     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Card\". --*/\n\n.card-blog-33__wrapper{\n  &:first-child{\n    grid-column: 1 / -1;\n\n    .card-blog-33{\n      flex-direction: row;\n      gap: var(--grid-gap);\n      align-items: center;\n    }\n\n    .card-blog-33__container{\n      height: auto;\n    }\n\n    .card-blog-33__icon{\n      display: none;\n    }\n\n    @media (max-width: 767px) {\n      grid-column: auto;\n      grid-row: auto;\n\n      .card-blog-33{\n        flex-direction: column;\n      }\n    }\n  }\n}"
