     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Card\". --*/\n\n.card-blog-35{\n  /* Hover styles and when there is focus on a link within the card */\n  &:hover, &:focus-within{\n\n    /* Image styles Scale on hover */\n    .card-blog-35__img{\n      transform: scale(1, 1);\n    }\n  }\n}"
    },
