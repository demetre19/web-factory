     "user_id": 2,
     "time": 1722633118,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Hero Section\". --*/\n.cta-42 {\n  --cta-42-speed-animation: 35s;\n  --cta-42-transparency-size: 50px;\n\n  .cta-42__container-img{\n\n    /* Column left styles */\n    .cta-42__column:first-child{    \n      .cta-42__column-img {\n        animation-name: vertical-scroll-btt;\n        animation-duration: var(--cta-42-speed-animation);\n        animation-iteration-count: infinite;\n        animation-timing-function: linear;\n\n        .cta-42__img-wrapper{\n          margin-bottom: var(--space-m);\n        }\n      }\n    }\n\n    /* Column right styles */\n    .cta-42__column:last-child{\n      .cta-42__column-img{\n        animation-name: vertical-scroll-ttb;\n        animation-duration: var(--cta-42-speed-animation);\n        animation-iteration-count: infinite;\n        animation-timing-function: linear;\n\n        .cta-42__img-wrapper{\n          margin-top: var(--space-m);\n\n          @media(max-width: 991px){\n            margin-top: var(--space-s);\n          }\n        }\n      }\n    }\n\n    /* Tablet Styles */\n    @media(max-width:991px){\n\n      /* If you do not want the gradient masks at the top and bottom you can remove these styles */\n      -webkit-mask-image: linear-gradient(to bottom, #000, #000, transparent 0, #000 var(--cta-42-transparency-size));\n    }\n  }\n}\n\n\n\n/*-- Animation bot to top \u2191 --*/\n@keyframes vertical-scroll-btt {\n  from {transform: translateY(0%);}\n  to {transform: translateY(-100%);}\n}\n\n/*-- Animation top to bot \u2193 --*/\n@keyframes vertical-scroll-ttb {\n  from {transform: translateY(-100%);}\n  to {transform: translateY(0%);}\n}"
    },
    "label": "CSS Style"
   }
  ],
