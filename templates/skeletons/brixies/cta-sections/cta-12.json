     "time": 1723336150,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Form newsletter\". --*/ \n\n.cta-12__form{\n  /* Important style for the terms and conditions field to be after the button. */\n  & .form-group:has(.cta-12__form-terms){\n    order:3;\n  }\n\n  /* Styles terms and conditions */\n  & .cta-12__form-terms{\n    margin-top: var(--space-xs);\n    font-size: var(--text-xs);\n    color: var(--neutral-trans-80);\n\n    /* Styles anchor link terms and conditions */\n    & a{\n      color:var(--neutral);\n      font-weight: 600;\n    }\n  }\n}"
    },
    "label": "Styles CSS"
   },
