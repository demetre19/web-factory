     "noRoot": true,
     "executeCode": true,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"CTA\" (Section). --*/\n\n.cta-49{\n  /* Image wrapper styles */\n  .cta-49__img-wrapper{\n\n    /* First image */\n    &:first-of-type{\n      grid-column: span 2;\n\n      /* Tablet styles */\n      @media (max-width: 991px) {\n        order: 30;\n      }\n\n      /* Mobile landscape styles */\n      @media (max-width: 767px) {\n        grid-column: auto;\n      }\n    }\n  }\n\n  /* Social proof styles */\n  .card-cta-49__social-proof {\n    /* Styles applied to all elements except the first one */\n    .card-cta-49__avatar-wrapper:not(:first-child) {\n      margin-left: -1rem;\n    }\n  }\n}"
    },
