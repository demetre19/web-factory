     "signature": "dfa39a93caa5c1b40b233640d5377a70",
     "user_id": 2,
     "time": 1716512667,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"CTA\" (Section). --*/\n\n.cta-51{\n  /* Styles applied to all elements except the first one */\n  .cta-51__avatar-wrapper:not(:first-child) {\n    margin-left: -1rem;\n  }\n\n  .cta-51__form{\n    /* Important style for the terms and conditions field to be after the button. */\n    & .form-group:has(.cta-51__form-terms){\n      order:3;\n    }\n\n    /* Styles terms and conditions */\n    & .cta-51__form-terms{\n      margin-top: var(--space-xs);\n      font-size: var(--text-xs);\n      color: var(--neutral-trans-80);\n\n      /* Styles anchor link terms and conditions */\n      & a{\n        color:var(--neutral);\n        font-weight: 600;\n      }\n    }\n  }\n}"
    },
