     "time": 1722633118,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Form newsletter\". --*/ \n\n.cta-11__form{\n  /* Important style for the terms and conditions field to be after the button. */\n  & .form-group:has(.cta-11__form-terms){\n    order:3;\n  }\n\n  /* Styles terms and conditions */\n  & .cta-11__form-terms{\n    margin-top: var(--space-xs);\n    font-size: var(--text-xs);\n    color: var(--white-trans-80);\n\n    /* Styles anchor link terms and conditions */\n    & a{\n      color:var(--white);\n      font-weight: 600;\n    }\n  }\n}"
    },
