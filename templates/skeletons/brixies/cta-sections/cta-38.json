    "settings": {
     "executeCode": true,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Container\". --*/\n\n.cta-38__container{\n  /* Hover and Focus links styles */\n  &:hover, &:focus-within{\n    \n    /* Styles to move the layout and make a larger scale, you can change the \u201c1.1\u201d value of scale to make it bigger or smaller. */\n    .cta-38__img--left{\n      transform:\n        scale(1.1) translateX(-50%) translateY(50%);\n      left: var(--space-l);\n      bottom: var(--space-l);\n    }\n    \n    .cta-38__img--right{\n      transform:\n        scale(1.1) translateX(50%) translateY(50%);\n      right: var(--space-l);\n      bottom: var(--space-l);\n    }\n  }\n}"
    },
    "label": "CSS Styles"
   }
