     "user_id": 2,
     "time": 1722633118,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Content\". --*/\n.cta-40 {\n  --cta-40-speed-animation: 35s;\n\n  /* Row left styles */\n  .cta-40__row{    \n    .cta-40__row-img {\n      animation-name: horizontal-scroll-rtl;\n      animation-duration: var(--cta-40-speed-animation);\n      animation-iteration-count: infinite;\n      animation-timing-function: linear;\n\n      .cta-40__img-wrapper{\n        margin-right: var(--grid-gap);\n      }\n    }\n  }\n}\n\n\n\n/*-- Animation right to left --*/\n@keyframes horizontal-scroll-rtl {\n  from {transform: translateX(0%);}\n  to {transform: translateX(-100%);}\n}",
     "executeCode": true
    },
