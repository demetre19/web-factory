    "children": [],
    "settings": {
     "noRoot": true,
     "executeCode": true,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"CTA\" (Section). --*/\n\n/* Styles for gallery items */\n.cta-52__gallery-item{\n  transform: rotateZ(-4deg);\n\n  /* Styles for even images */\n  &:nth-of-type(even){\n    transform: rotateZ(4deg);\n  }\n\n  /* Mobile Landscape styles */\n  @media (max-width: 767px) {\n    /* Styles in the second image */\n    &:nth-of-type(2){\n      transform: rotateZ(0);\n    }\n\n    /* Styles in the third image */\n    &:nth-of-type(3){\n      transform: rotateZ(4deg);\n    }\n\n    /* We hide all elements except for the first 3 images */\n    &:nth-of-type(n+4){\n      display: none;\n    }\n  }\n}"
    },
