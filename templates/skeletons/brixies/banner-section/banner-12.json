     "time": 1720984090,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Banner\" (Section). -- */\n\n.banner-12 {\n  /* Controls the rotation angle of each row. */\n  --banner-12-angle: 9deg;\n\n  /* Controls the horizontal distance traveled while scrolling. */\n  --banner-12-scroll-distance: 20rem;\n\n  /* Controls when the scroll animation starts and ends. */\n  --banner-12-animation-start: 0%;\n  --banner-12-animation-end: 100%;\n\n  position: relative;\n\n  view-timeline-name: --banner-12-timeline;\n  view-timeline-axis: block;\n\n  .banner-12__item-list-wrapper {\n    overflow: hidden;\n\n    /* Odd rows: left to right. */\n    &:nth-child(odd) {\n      --banner-12-scroll-from: calc(\n        var(--banner-12-scroll-distance) * -1\n      );\n\n      --banner-12-scroll-to: var(--banner-12-scroll-distance);\n\n      transform:\n        rotateZ(calc(-1 * var(--banner-12-angle)))\n        translateY(-50%);\n    }\n\n    /* Even rows: right to left. */\n    &:nth-child(even) {\n      --banner-12-scroll-from: var(--banner-12-scroll-distance);\n\n      --banner-12-scroll-to: calc(\n        var(--banner-12-scroll-distance) * -1\n      );\n\n      transform:\n        rotateZ(var(--banner-12-angle))\n        translateY(-50%);\n    }\n  }\n\n  .banner-12__item-list {\n    width: max-content;\n    min-width: max-content;\n\n    transform: translateX(\n      var(--banner-12-scroll-from)\n    );\n  }\n}\n\n\n/* Applies the animation only in supported browsers. */\n@supports (animation-timeline: view()) {\n  .banner-12 {\n    .banner-12__item-list {\n      animation:\n        banner-12-horizontal-scroll\n        1ms\n        linear\n        both;\n\n      animation-timeline: --banner-12-timeline;\n\n      animation-range:\n        cover var(--banner-12-animation-start)\n        cover var(--banner-12-animation-end);\n\n      will-change: transform;\n    }\n  }\n}\n\n\n/* Moves each row between its configured horizontal positions. */\n@keyframes banner-12-horizontal-scroll {\n  from {\n    transform: translateX(\n      var(--banner-12-scroll-from)\n    );\n  }\n\n  to {\n    transform: translateX(\n      var(--banner-12-scroll-to)\n    );\n  }\n}\n\n\n/* Disables the animation for users who prefer reduced motion. */\n@media (prefers-reduced-motion: reduce) {\n  .banner-12 {\n    .banner-12__item-list {\n      animation: none;\n      transform: none;\n    }\n  }\n}"
    },
