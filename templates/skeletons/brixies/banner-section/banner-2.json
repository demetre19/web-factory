     "time": 1720984090,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Item list\". --*/  \n\n.banner-2__container{\n  /* These styles apply only when the document has RTL text direction */\n  &:dir(rtl) {\n    flex-direction: row-reverse;\n  }\n\n  .banner-2__item-list{\n    /* Here you can change the animation time (75s), the more time you add, the slower the animation will be. */\n    --banner-2-duration: 75s;\n\n    animation: horizontal-scroll-rtl var(--banner-2-duration) linear infinite;\n  }\n}\n\n/* Animation from right to left */\n@keyframes horizontal-scroll-rtl {\n  from {transform: translateX(0);}\n  to {transform: translateX(-100%);}\n}"
    },
