     "user_id": 2,
     "time": 1720984090,
     "cssCode": "/* -- The root styles must go in the element of the structure with the name \"Item list wrapper\". --*/  \n.banner-3__item-list-wrapper{\n  /* Here you can change the animation time (35s), the more time you add, the slower the animation will be. */\n  --banner-3-angle: 9deg;\n  --banner-3-duration: 35s;\n\n  /* Styles for even list containers */\n  &:nth-child(even){\n    transform: rotateZ(var(--banner-3-angle)) translateY(-50%);\n    \n    /* These styles apply only when the document has RTL text direction */\n    &:dir(rtl) {\n      flex-direction: row;\n    }\n    \n    .banner-3__item-list {\n      animation: horizontal-scroll-rtl var(--banner-3-duration) linear infinite;\n    }\n  }\n\n  /* Styles for odd list containers */\n  &:nth-child(odd){\n    transform: rotateZ(calc(-1 * var(--banner-3-angle))) translateY(-50%);\n\n    flex-direction: row-reverse;\n    \n    /* These styles apply only when the document has RTL text direction */\n    &:dir(rtl) {\n      flex-direction: row;\n    }\n\n    .banner-3__item-list {\n      animation: horizontal-scroll-ltr var(--banner-3-duration) linear infinite;\n    }\n  }\n}\n\n/* Animation from right to left */\n@keyframes horizontal-scroll-rtl {\n  from {\n    transform: translateX(0);\n  }\n\n  to {\n    transform: translateX(-100%);\n  }\n}\n\n/* Animation from left to right */\n@keyframes horizontal-scroll-ltr {\n  from {\n    transform: translateX(0);\n  }\n\n  to {\n    transform: translateX(100%);\n  }\n}"
    },
    "label": "Styles CSS",
