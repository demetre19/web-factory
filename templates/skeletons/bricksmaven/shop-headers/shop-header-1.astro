---
/**
 * wf-shop-header-1 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (shop-header-1.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string; term?: string;
             label?: string; href?: string;
             icon?: string; items?: any[] }[];
  image?: { src: string; alt: string };
  images?: { src: string; alt: string }[];
  copy?: any;
  h1?: boolean;
}
import { inline } from '../_shared/inline';
import IconChip from '../_shared/IconChip.astro';
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
  image,
  images = [],
  copy,
  h1 = false,
} = Astro.props;
// §4.3 — a copy slot binds verbatim article copy onto
// the skeleton's native props (F.1 — nothing dropped)
const cp = copy || {};
const head = cp.heading || heading;
const sub = cp.answer || cp.text || fs;
const before = cp.before || [];
const list = (cp.items && cp.items.length
  ? cp.items : items) || [];
// N.select — the desktop bar keeps the leading links whose
// labels fit its budget; the rest open behind "More"
const _lbl = (it) => String(it.label || it.term || it.title || it.text || '');
const navFit = (() => { let w = 0, n = 0;
  for (const it of list) { w += _lbl(it).length + 2;
    if (w > 56) break; n++; }
  return n; })();
const navOver = list.length > 6 || navFit < list.length;
const navCut = Math.max(1, Math.min(navFit, 4));
const qas = cp.qa || [];
const links = cp.links || [];
const after = cp.after || [];
const act = cp.cta || cta;
const phone = cp.phone || '';
const tel = phone ? 'tel:' + phone.replace(/[^0-9+]/g, '') : '';
---

<div class="wf-shop-header-1">
  {head && (h1 ? <h1 class="text-fluid-4">{head}</h1> : <h2 class="text-fluid-2">{head}</h2>)}
  {sub && <p class="mt-stack lede" set:html={inline(sub)} />}
  {before.map((p) => <p class="mt-flow text-fluid-0" set:html={inline(p)} />)}
  <div class="sec-inner">
    <div class="wf-shop-header-1__container">
      <div>
        <span class="logo brand-mark">{brand}</span>
      </div>
      <div>
        {list.length > 0 && !navOver && <nav class="nav-links" aria-label="Primary"><div class="nav-sheet-head"><span class="logo nav-sheet-brand">{brand}</span><button class="nav-close" type="button" aria-label="Close menu">×</button></div><form class="nav-search" role="search"><input class="nav-search-input" type="search" placeholder="Search" aria-label="Search site" /></form><div class="nav-mega-cols">{Object.entries(list.reduce((g, it) => {const s = (it.href || "").replace(/^\/+|\/+$/g, "").split("/")[0] || "pages"; (g[s] = g[s] || []).push(it); return g;}, {})).map(([seg, grp]) => (<div class="nav-group"><p class="nav-group-head">{seg.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase())}</p><ul class="row gap-fluid-m list-plain">{grp.map((it, i) => <li><a class="nav-link" href={it.href}><span>{it.label || it.term || it.title || it.text}</span><span class="nav-num" aria-hidden="true">{String(list.indexOf(it) + 1).padStart(2, '0')}</span></a></li>)}</ul></div>))}</div>{act.label && <p class="nav-sheet-cta mt-fluid-m"><a class="wf-cta-button" href={act.href}>{act.label}</a></p>}</nav>}
        {navOver && <nav class="nav-links nav-mega" aria-label="Primary"><div class="nav-sheet-head"><span class="logo nav-sheet-brand">{brand}</span><button class="nav-close" type="button" aria-label="Close menu">×</button></div><form class="nav-search" role="search"><input class="nav-search-input" type="search" placeholder="Search" aria-label="Search site" /></form><div class="nav-mega-cols">{Object.entries(list.reduce((g, it) => {const s = (it.href || "").replace(/^\/+|\/+$/g, "").split("/")[0] || "pages"; (g[s] = g[s] || []).push(it); return g;}, {})).map(([seg, grp]) => (<div class="nav-group"><p class="nav-group-head">{seg.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase())}</p><ul class="row gap-fluid-m list-plain">{grp.map((it, i) => <li><a class="nav-link" href={it.href}><span>{it.label || it.term || it.title || it.text}</span><span class="nav-num" aria-hidden="true">{String(list.indexOf(it) + 1).padStart(2, '0')}</span></a></li>)}</ul></div>))}</div>{act.label && <p class="nav-sheet-cta mt-fluid-m"><a class="wf-cta-button" href={act.href}>{act.label}</a></p>}</nav>}
        {navOver && <Fragment><nav class="nav-priority nav-desk" aria-label="Primary"><ul class="row gap-fluid-m list-plain">{list.slice(0, navCut).map((it) => <li><a class="nav-link" href={it.href}>{it.label || it.term || it.title || it.text}</a></li>)}</ul></nav><button class="nav-more" type="button" aria-label="More links">More</button></Fragment>}
        {list.length > 0 && <button class="burger" type="button" aria-label="Menu"><span aria-hidden="true">≡</span></button>}
      </div>
      {act.label &&       <div class="wf-shop-header-1__end">
        {act.label &&         <div class="wf-shop-header-1__login-wrapper">
          {act.label && <p class="mt-fluid-m"><a class="wf-cta-button" href={act.href}>{act.label}</a></p>}
        </div>
        }
      </div>
      }
    </div>
  </div>
  {list.length > 0 && <dl class="mt-stack list-plain flow-list">{list.map((it) => <div class="flow-row">{it.icon && <IconChip name={it.icon} />}<dt class="text-fluid-0" set:html={inline(it.term || it.title || it.label || '')} />{it.text && <dd class="text-fluid-0" set:html={inline(it.text)} />}</div>)}</dl>}
  {qas.length > 0 && <dl class="mt-stack">{qas.map((qa) => <><dt class="text-fluid-0" set:html={inline(qa.q)} /><dd class="text-fluid-0" set:html={inline(qa.a)} /></>)}</dl>}
  {links.length > 0 && <div class="flow mt-stack">{links.map((l) => <p class="text-fluid-0" set:html={inline(l.text || `[${l.anchor}](${l.href})`)} />)}</div>}
  {after.length > 0 && <div class="flow mt-stack">{after.map((p) => <p class="text-fluid-0" set:html={inline(p)} />)}</div>}
  {tel && <p class="mt-stack"><a class="link-quiet" href={tel}>{phone}</a></p>}
</div>
