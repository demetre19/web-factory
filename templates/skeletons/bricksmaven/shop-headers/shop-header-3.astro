 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string; term?: string;
             label?: string; href?: string;
             icon?: string; items?: any[] }[];
  image?: { src: string; alt: string };
  copy?: any;
}
import { inline } from '../_shared/inline';
import IconChip from '../_shared/IconChip.astro';
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
  image,
  copy,
} = Astro.props;
// §4.3 — a copy slot binds verbatim article copy onto
