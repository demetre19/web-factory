                                      </div>
                                    ))}</div>
                                </div>}
                              </div>
                            ))}</div>}
                      ))}</div>}
                </div>
                }
              ))}</div>
          </div>}
          <div></div>
        </div>
        <div></div>
      </div>
    </div>
    <div class="bm-shop-header-3__footer-container">
      <div>
        {links.length > 0 && <div class="bm-shop-header-3__nav-items">
          <div class="grid-auto gap-fluid-m">{(links || []).map((it) => (
              <a class="text-fluid-0" href={it.href}>{it.icon && <IconChip name={it.icon} />} {it.label || it.term || it.anchor || it.text}</a>
              {(it.label || it.term || it.anchor) && it.text && <p class="text-fluid-0">{it.text}</p>}
            ))}</div>
