---
/**
 * wf-shop-header-3 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (shop-header-3.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string; term?: string;
             label?: string; href?: string;
             icon?: string; items?: any[] }[];
  image?: { src: string; alt: string };
  images?: { src: string; alt: string }[];
  copy?: any;
  h1?: boolean;
}
import { inline } from '../_shared/inline';
import IconChip from '../_shared/IconChip.astro';
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
  image,
  images = [],
  copy,
  h1 = false,
} = Astro.props;
// §4.3 — a copy slot binds verbatim article copy onto
// the skeleton's native props (F.1 — nothing dropped)
const cp = copy || {};
const head = cp.heading || heading;
const sub = cp.answer || cp.text || fs;
const before = cp.before || [];
const list = (cp.items && cp.items.length
  ? cp.items : items) || [];
// N.select — the desktop bar keeps the leading links whose
// labels fit its budget; the rest open behind "More"
const _lbl = (it) => String(it.label || it.term || it.title || it.text || '');
const navFit = (() => { let w = 0, n = 0;
  for (const it of list) { w += _lbl(it).length + 2;
    if (w > 56) break; n++; }
  return n; })();
const navOver = list.length > 6 || navFit < list.length;
const navCut = Math.max(1, Math.min(navFit, 4));
const qas = cp.qa || [];
const links = cp.links || [];
const after = cp.after || [];
const act = cp.cta || cta;
const phone = cp.phone || '';
const tel = phone ? 'tel:' + phone.replace(/[^0-9+]/g, '') : '';
---

<div class="wf-shop-header-3">
  {head && (h1 ? <h1 class="text-fluid-4">{head}</h1> : <h2 class="text-fluid-2">{head}</h2>)}
  {sub && <p class="mt-stack lede" set:html={inline(sub)} />}
  {before.map((p) => <p class="mt-flow text-fluid-0" set:html={inline(p)} />)}
  <div class="sec-inner">
    <div class="wf-shop-header-3__top-container">
      <div>
        <span class="logo brand-mark">{brand}</span>
      </div>
      <div class="wf-shop-header-3__end">
        <div>
          {list.length > 0 && <div>
            <div class="grid-auto gap-fluid-m">{(list || []).map((it) => (
              <>
                {(it.items || []).length > 0 &&                 <div class="card">
                  {(it.items || []).length > 0 && <div class="wf-megamenu-7__content">{((it.items || []) || []).map((it2) => (
                      <>
                        {(it2.items || []).length > 0 && <div class="wf-megamenu-7__column-wrapper card">{((it2.items || []) || []).map((it22) => (
                              <div class="wf-megamenu-7__column card">
                                {it22.icon && <IconChip name={it22.icon} />}
                                <h3 class="text-fluid-1">{it22.term || it22.title}</h3>
                                {(it22.items || []).length > 0 && <div class="wf-megamenu-7__card-wrapper">
                                  <div class="grid-auto gap-fluid-m">{((it22.items || []) || []).map((it222) => (
                                      <div class="card">
                                        <h3 class="text-fluid-1"><a class="text-fluid-0" href={it222.href}>{it222.icon && <IconChip name={it222.icon} />} {it222.label || it222.term || it222.anchor || it222.text}</a></h3>
                                        {(it222.label || it222.term || it222.anchor) && it222.text && <p class="text-fluid-0">{it222.text}</p>}
                                      </div>
                                    ))}</div>
                                </div>}
                              </div>
                            ))}</div>}
                      </>
                      ))}</div>}
                </div>
                }
              </>
              ))}</div>
          </div>}
          <button class="flyout-open" type="button" aria-label="Open panel"><span aria-hidden="true">≡</span></button>
        </div>
      </div>
    </div>
    <div class="wf-shop-header-3__footer-container">
      <div>
        {links.length > 0 && <div>
          <div class="grid-auto gap-fluid-m">{(links || []).map((it) => (
            <>
              <h3 class="text-fluid-1"><a class="text-fluid-0" href={it.href}>{it.icon && <IconChip name={it.icon} />} {it.label || it.term || it.anchor || it.text}</a></h3>
              {(it.label || it.term || it.anchor) && it.text && <p class="text-fluid-0">{it.text}</p>}
            </>
            ))}</div>
        </div>}
        <button class="flyout-open" type="button" aria-label="Open panel"><span aria-hidden="true">≡</span></button>
      </div>
    </div>
  </div>
  {qas.length > 0 && <dl class="mt-stack">{qas.map((qa) => <><dt class="text-fluid-0" set:html={inline(qa.q)} /><dd class="text-fluid-0" set:html={inline(qa.a)} /></>)}</dl>}
  {links.length > 0 && <div class="flow mt-stack">{links.map((l) => <p class="text-fluid-0" set:html={inline(l.text || `[${l.anchor}](${l.href})`)} />)}</div>}
  {after.length > 0 && <div class="flow mt-stack">{after.map((p) => <p class="text-fluid-0" set:html={inline(p)} />)}</div>}
  {tel && <p class="mt-stack"><a class="link-quiet" href={tel}>{phone}</a></p>}
</div>
