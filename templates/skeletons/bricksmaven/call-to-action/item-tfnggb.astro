    width: auto;
  }

  .cta-12-sales-card-wrapper {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-m);
  }

  .cta-12-sales-card {
    display: flex;
    flex-direction: column;
    row-gap: var(--space-xs);
    padding: var(--space-l) var(--space-l) var(--space-l) var(--space-l);
    background: color-mix(in srgb, var(--action-primary) 60%, transparent);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    align-items: center;
    text-align: center;
