    font-size: calc(var(--fs-4) * 1.3);
  }

  .bm-cta-22-review-card {
    row-gap: var(--flow-spacing);
  }

  .bm-user-card {
    display: flex;
    flex-wrap: nowrap;
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-user-card__image {
    object-fit: cover;
    width: 48px;
    height: 48px;
    border-radius: 100% 100% 100% 100%;
