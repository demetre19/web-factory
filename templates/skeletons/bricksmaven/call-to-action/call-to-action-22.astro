    background: var(--text-primary);
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 2);
  }

  .bm-cta-22-widget__content {
    row-gap: var(--flow-spacing);
    justify-content: center;
    padding: 0 var(--space-s) 0 0;
    border-right: 1px solid var(--bg-subtle);
