   "custom_css": "/* White + Icon*/\n.bm-btn-cta[data-design='whiteicon'] {\n  background-color: var(--white);\n  border: 1px solid var(--white);\n  font-size: var(--text-s);\n  transition: 0.2s ease;\n}\n\n.bm-btn-cta[data-design='whiteicon'] a {\n  color: var(--text-dark);\n  transition: 0.2s ease;\n}\n\n.bm-btn-cta[data-design='whiteicon']:hover a {\n  color: var(--primary);\n}\n\n.bm-btn-cta[data-design='whiteicon']:hover {\n  border: 1px solid var(--primary);\n  color: var(--primary);\n}\n\n.bm-btn-cta[data-design='whiteicon'] .bm-btn-cta__icon-wrapper {\n  transition: 0.2s ease;\n}\n\n.bm-btn-cta[data-design='whiteicon']:hover .bm-btn-cta__icon-wrapper {\n  background-color: var(--primary);\n}\n\n/* White*/\n.bm-btn-cta[data-design='white'] {\n  background-color: var(--white);\n  border: 1px solid var(--white);\n  padding-block: 14px;\n  padding-inline: 24px;\n  font-size: var(--text-s);\n  justify-content: center;\n  transition: 0.2s ease;\n  \n}\n\n.bm-btn-cta[data-design='white'] a {\n  color: var(--text-dark);\n  transition: 0.2s ease;\n}\n\n.bm-btn-cta[data-design='white']:hover a {\n  color: var(--primary);\n}\n\n.bm-btn-cta[data-design='white']:hover {\n  border: 1px solid var(--primary);\n  color: var(--primary);\n}\n\n.bm-btn-cta[data-design='white'] .bm-btn-cta__icon-wrapper {\n  display:none;\n}\n\n\n/* Whitetrans */\n.bm-btn-cta[data-design='whitetrans'] {\n  background-color: var(--white-trans-20);\n  border: 1px solid var(--white-trans-10);\n  font-size: var(--text-s);\n  transition: 0.2s ease;\n}\n\n.bm-btn-cta[data-design='whitetrans'] a {\n  color: var(--white);\n  transition: 0.2s ease;\n}\n\n.bm-btn-cta[data-design='whitetrans']:hover a {\n  color: var(--black);\n}\n\n.bm-btn-cta[data-design='whitetrans']:hover {\n  border: 1px solid var(--white);\n  color: var(--black);\n  background-color: var(--white);\n}\n\n.bm-btn-cta[data-design='whitetrans'] .bm-btn-cta__icon-wrapper {\n  transition: 0.2s ease;\n  background-color: var(--white); \n}\n\n.bm-btn-cta[data-design='whitetrans'] .bm-btn-cta__icon {\n  color: var(--black);\n}\n\n\n/* Red */\n.bm-btn-cta[data-design='red'] {\n  background-color: var(--primary);\n  border: 1px solid var(--primary);\n  font-size: var(--text-s);\n  transition: 0.2s ease;\n}\n\n.bm-btn-cta[data-design='red'] a {\n  color: var(--white) ;\n  transition: 0.2s ease;\n}\n\n.bm-btn-cta[data-design='red']:hover a {\n  color: var(--white);\n}\n\n.bm-btn-cta[data-design='red']:hover {\n  border: 1px solid var(--primary-dark);\n  color: var(--white);\n  background-color: var(--primary-dark);\n}\n\n.bm-btn-cta[data-design='red'] .bm-btn-cta__icon-wrapper {\n  transition: 0.2s ease;\n  background-color: var(--white); \n}\n\n.bm-btn-cta[data-design='red'] .bm-btn-cta__icon {\n  color: var(--black);\n}",
