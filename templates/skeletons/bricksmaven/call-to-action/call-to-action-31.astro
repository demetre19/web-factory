---
/**
 * bm-call-to-action-31 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (call-to-action-31.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-cta-31__container">
      <div class="bm-testimonial-card-cta">
        <div class="bm-testimonial-card-cta__content">
          {fs && <p class="text-fluid-0">{fs}</p>}
          <div class="bm-testimonial-card-cta__icon-wrapper">
            <span data-icon="lucide" aria-hidden="true"></span>
          </div>
        </div>
        <div>
          <figure class="bm-testimonial-card-cta__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
      </div>
      <div class="bm-cta-31__content">
        <div class="bm-cta-31__top">
          {heading && <h2 class="text-fluid-2">{heading}</h2>}
          <div class="bm-avatar-list-2">
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="card">
                  <figure class="bm-avatar-item-2__avatar ratio-portrait"><img src="/media/placeholder.svg" alt="Avatar" loading="lazy" width="900" height="600" /></figure>
                </div>
              ))}
            </div>
          </div>
        </div>
        <p class="mt-fluid-m"><a class="wf-cta-button" href={cta.href}>{cta.label || 'Continue'}</a></p>
      </div>
    </div>
  </div>
</div>
