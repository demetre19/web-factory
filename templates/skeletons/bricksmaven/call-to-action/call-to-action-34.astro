---
/**
 * bm-call-to-action-34 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (call-to-action-34.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-cta-34__container">
    <div class="bm-cta-34__content">
      <div class="bm-cta-34__top">
        <h2 class="bm-cta-34__heading">{heading}</h2>
        <p class="bm-cta-34__text">{fs}</p>
      </div>
      <div class="bm-cta-34__footer">
        <div class="bm-btn-cta">
          <p class="bm-btn-cta__label clickable-parent">Bel ons: 06 13 43 69 47</p>
          <div class="bm-btn-cta__icon-wrapper">
            <span class="bm-btn-cta__icon" data-icon="lucide" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </div>
    <div class="bm-cta-34__media">
      <figure class="bm-cta-34__image"><img src="/media/placeholder.svg" alt="Image" loading="lazy" width="900" height="600" /></figure>
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-cta-34 {
    background: var(--bg-subtle);
  }

  .bm-cta-34__container {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    height: 100%;
    background: var(--bg-canvas);
  }

  .bm-cta-34__content {
    padding: var(--space-l) var(--space-l) var(--space-l) var(--space-l);
    justify-content: space-between;
    position: relative;
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    background: var(--action-primary);
    row-gap: var(--space-s);
  }

  .bm-cta-34__top {
    row-gap: var(--flow-spacing);
    z-index: 1;
  }

  .bm-cta-34__heading {
    font-size: var(--fs-4);
  }

  .bm-cta-34__footer {
    align-items: stretch;
  }

  .bm-btn-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    column-gap: var(--space-xs);
    padding: 8px 8px 8px 24px;
    border-radius: 100% 100% 100% 100%;
    position: relative;
  }

  .bm-btn-cta__icon-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 32px;
    height: 32px;
    background: var(--text-primary);
    border-radius: 100% 100% 100% 100%;
  }

  .bm-cta-34__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    overflow: clip;
  }

  /* bm-custom */
  /* White + Icon*/
  .bm-btn-cta[data-design='whiteicon'] {
    background-color: var(--bg-canvas);
    border: 1px solid var(--bg-canvas);
    font-size: var(--fs-0);
    transition: 0.2s ease;
  }
  
  .bm-btn-cta[data-design='whiteicon'] a {
    color: var(--fs-0);
    transition: 0.2s ease;
  }
  
  .bm-btn-cta[data-design='whiteicon']:hover a {
    color: var(--action-primary);
  }
  
  .bm-btn-cta[data-design='whiteicon']:hover {
    border: 1px solid var(--action-primary);
    color: var(--action-primary);
  }
  
  .bm-btn-cta[data-design='whiteicon'] .bm-btn-cta__icon-wrapper {
    transition: 0.2s ease;
  }
  
  .bm-btn-cta[data-design='whiteicon']:hover .bm-btn-cta__icon-wrapper {
    background-color: var(--action-primary);
  }
  
  /* White*/
  .bm-btn-cta[data-design='white'] {
    background-color: var(--bg-canvas);
    border: 1px solid var(--bg-canvas);
    padding-block: 14px;
    padding-inline: 24px;
    font-size: var(--fs-0);
    justify-content: center;
    transition: 0.2s ease;
    
  }
  
  .bm-btn-cta[data-design='white'] a {
    color: var(--fs-0);
    transition: 0.2s ease;
  }
  
  .bm-btn-cta[data-design='white']:hover a {
    color: var(--action-primary);
  }
  
  .bm-btn-cta[data-design='white']:hover {
    border: 1px solid var(--action-primary);
    color: var(--action-primary);
  }
  
  .bm-btn-cta[data-design='white'] .bm-btn-cta__icon-wrapper {
    display:none;
  }
  
  
  /* Whitetrans */
  .bm-btn-cta[data-design='whitetrans'] {
    background-color: color-mix(in srgb, var(--bg-canvas) 20%, transparent);
    border: 1px solid color-mix(in srgb, var(--bg-canvas) 10%, transparent);
    font-size: var(--fs-0);
    transition: 0.2s ease;
  }
  
  .bm-btn-cta[data-design='whitetrans'] a {
    color: var(--bg-canvas);
    transition: 0.2s ease;
  }
  
  .bm-btn-cta[data-design='whitetrans']:hover a {
    color: var(--text-primary);
  }
  
  .bm-btn-cta[data-design='whitetrans']:hover {
    border: 1px solid var(--bg-canvas);
    color: var(--text-primary);
    background-color: var(--bg-canvas);
  }
  
  .bm-btn-cta[data-design='whitetrans'] .bm-btn-cta__icon-wrapper {
    transition: 0.2s ease;
    background-color: var(--bg-canvas); 
  }
  
  .bm-btn-cta[data-design='whitetrans'] .bm-btn-cta__icon {
    color: var(--text-primary);
  }
  
  
  /* Red */
  .bm-btn-cta[data-design='red'] {
    background-color: var(--action-primary);
    border: 1px solid var(--action-primary);
    font-size: var(--fs-0);
    transition: 0.2s ease;
  }
  
  .bm-btn-cta[data-design='red'] a {
    color: var(--bg-canvas) ;
    transition: 0.2s ease;
  }
  
  .bm-btn-cta[data-design='red']:hover a {
    color: var(--bg-canvas);
  }
  
  .bm-btn-cta[data-design='red']:hover {
    border: 1px solid var(--action-primary);
    color: var(--bg-canvas);
    background-color: var(--action-primary);
  }
  
  .bm-btn-cta[data-design='red'] .bm-btn-cta__icon-wrapper {
    transition: 0.2s ease;
    background-color: var(--bg-canvas); 
  }
  
  .bm-btn-cta[data-design='red'] .bm-btn-cta__icon {
    color: var(--text-primary);
  }
</style>
