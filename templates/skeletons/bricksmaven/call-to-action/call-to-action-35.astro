---
/**
 * bm-call-to-action-35 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (call-to-action-35.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div>
      <div class="cta-35__cover">
        <div class="cta-35__content">
          <div class="cta-35__inner">
            <div class="bm-project-status"></div>
            {heading && <h2 class="text-fluid-2">{heading}</h2>}
            {fs && <p class="text-fluid-0">{fs}</p>}
          </div>
          <p class="mt-fluid-m"><a class="wf-cta-button" href={cta.href}>{cta.label || 'Continue'}</a></p>
        </div>
        <div class="cta-35-list">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="cta-35-item card">
                <div>
                  <custom class="text-fluid-2">{it.title}</custom>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
                <div class="cta-35-item__icon-wrapper">
                  <span data-icon="lucide" aria-hidden="true"></span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
