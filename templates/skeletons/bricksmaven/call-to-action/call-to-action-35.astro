---
/**
 * bm-call-to-action-35 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (call-to-action-35.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="cta-35__container">
    <div class="cta-35__cover">
      <div class="cta-35__content">
        <div class="cta-35__inner">
          <div class="bm-project-status">
            <p class="bm-project-status__label">Discover the possibilities</p>
          </div>
          <h2 class="cta-35__heading">Request your free website scan today!</h2>
          <p class="cta-35__text">Fill in your website and recieve within seconds which processes you need to automate and how much time you can save.</p>
        </div>
        <a class="btn--primary cta-35__cta wf-cta-button" href={cta.href}>{cta.label}</a>
      </div>
      <div class="cta-35-list">
        {items.map((it) => (
          <div class="cta-35-item">
            <div class="cta-35-item__detail">
              <custom class="cta-35-item__label">{it.title}</custom>
              <p class="cta-35-item__description">{it.text}</p>
            </div>
            <div class="cta-35-item__icon-wrapper">
              <span class="cta-35-item__icon" data-icon="lucide" aria-hidden="true"></span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style is:global>
@layer components {
  .cta-35__cover {
    display: grid;
    grid-template-columns: calc(100% * 2 / 3);
    gap: var(--space-m);
    padding: var(--space-l) var(--space-l) var(--space-l) var(--space-l);
    border-top: 1px solid var(--fs-0);
    border-right: 1px solid var(--fs-0);
    border-bottom: 1px solid var(--fs-0);
    border-left: 1px solid var(--fs-0);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    background: var(--fs-0);
  }

  .cta-35__content {
    row-gap: var(--flow-spacing);
    justify-content: center;
    width: 100%;
  }

  .cta-35__inner {
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-project-status {
    padding: 6px var(--space-s) 6px var(--space-s);
    background: var(--fs-0);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
  }

  .bm-project-status__label {
    position: relative;
  }

  .cta-35-list {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    row-gap: calc(var(--flow-spacing) / 2);
    width: 100%;
    padding: 0 0 0 0;
    column-gap: calc(var(--flow-spacing) / 2);
  }

  .cta-35-item {
    display: flex;
    align-items: flex-start;
    column-gap: calc(var(--flow-spacing) / 2);
    padding: var(--space-s) var(--space-s) var(--space-s) var(--space-s);
    background: var(--bg-canvas);
    border-top: 1px solid var(--fs-0);
    border-right: 1px solid var(--fs-0);
    border-bottom: 1px solid var(--fs-0);
    border-left: 1px solid var(--fs-0);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    width: 100%;
  }

  .cta-35-item__label {
    font-weight: 700;
  }

  .cta-35-item__description {
    font-size: var(--fs-0);
  }

  .cta-35-item__icon-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 40px;
    height: 40px;
    border-radius: 100% 100% 100% 100%;
    background: var(--fs-0);
  }

  /* bm-custom */
  .bm-project-status__label::before {
    content: '●';
    padding-inline-end: calc(var(--space-s) / 2);
    color: var(--bg-subtle);
    animation: 3s ease-in 0s infinite alternate both running glow;
  
  }
  
  @keyframes glow {
    from {
      
      filter: blur(1px);
    }
  
    to {
      
      filter: blur(3px);
    }
  }
}
</style>
