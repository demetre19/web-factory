    flex-direction: row;
    display: flex;
    align-items: center;
    column-gap: var(--flow-spacing);
  }

  .bm-list__item-icon {
    padding: 0.5rem 0.5rem 0.5rem 0.5rem;
    background: var(--bg-subtle);
    border-radius: 100% 100% 100% 100%;
