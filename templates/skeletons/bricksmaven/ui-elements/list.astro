---
/**
 * bm-list — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (list.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="bm-list">
    <div class="grid-auto gap-fluid-m">
      {(items || []).map((it) => (
        <div class="bm-list__item card">
          <span class="bm-list__item-icon" data-icon="lucide" aria-hidden="true"></span>
          <p class="text-fluid-0">{it.text}</p>
        </div>
      ))}
    </div>
  </div>
</div>
