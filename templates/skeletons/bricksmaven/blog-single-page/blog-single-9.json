  {
   "id": "epyydn",
   "name": "code",
   "parent": "roruol",
   "children": [],
   "settings": {
    "executeCode": true,
    "code": "<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n    const contentContainer = document.querySelector('.brxe-post-content');\n    if (!contentContainer) return;\n\n    const headings = contentContainer.querySelectorAll('h2, h3, h4, h5, h6');\n    if (!headings.length) return;\n\n    const toc = document.querySelector('.table-of-content-1 ol');\n    if (!toc) return;\n\n    toc.innerHTML = ''; // Clear existing ToC entries\n\n    let lastLevel = 2;\n    let currentOl = toc;\n    let olStack = [toc];\n\n    headings.forEach(heading => {\n        const level = parseInt(heading.tagName.substring(1));\n        const sanitizedId = heading.textContent.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');\n        heading.id = sanitizedId;\n\n        if (level === 2) {\n            // Reset to the top level for h2 headings\n            currentOl = toc;\n            olStack = [toc];\n        } else if (level > lastLevel) {\n            // Create a new nested list for lower level headings\n            const newOl = document.createElement('ol');\n            newOl.className = 'brxe-block table-of-content-1-ol';\n            olStack[olStack.length - 1].lastElementChild.appendChild(newOl);\n            olStack.push(newOl);\n            currentOl = newOl;\n        } else if (level < lastLevel && level !== 2) {\n            // Adjust the stack for heading levels that are not h2\n            while (olStack.length > 1 && level <= parseInt(olStack[olStack.length - 2].tagName.substring(1))) {\n                olStack.pop();\n            }\n            currentOl = olStack[olStack.length - 1];\n        }\n\n        const li = document.createElement('li');\n        li.className = 'brxe-block table-of-content-1-li';\n        const a = document.createElement('a');\n        a.className = 'brxe-text-link table-of-content-1-li__link';\n        a.href = '#' + sanitizedId;\n        a.textContent = heading.textContent;\n        li.appendChild(a);\n        currentOl.appendChild(li);\n\n        lastLevel = level;\n    });\n});\n</script>",
    "noRoot": true,
    "signature": "42acd79a3227e1e2a4c757e1b3cca647",
    "user_id": 7,
    "time": 1713781218
   }
