 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="blog-single-5-container">
    <div class="blog-single-5__head">
      <div class="blog-single-5__post-title"></div>
      <div class="blog-single-5__meta">
        <div class="blog-single-5__author">
          <figure class="blog-single-5__photo"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          <div class="blog-single-5__author-data">
            <p class="blog-single-5__author-name">{author_name}</p>
            <p class="blog-single-5__author-label">Author Position</p>
          </div>
        </div>
        <div class="flex--row align-items--center gap--xs blog-single-5__meta-detials">
          <p class="blog-single-5__term">{post_terms_category}</p>
          <p class="blog-single-5__date">{post_date}</p>
        </div>
      </div>
      <p class="blog-single-5__subtitle">This is a static text. Maybe you want to add a tagline or short message here?</p>
      <div class="blog-single-5__featured-image-wrapper">
        <figure class="blog-single-5__featured-image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
    </div>
    <div class="blog-single-5__body">
      <div class="blog-single-5__body-wrapper">
        <div class="blog-single-5__body-content"></div>
      </div>
      <div class="blog-single-2__body-sidebar">
        <div class="blog-single-2-search">
          <h2 class="blog-single-2-aside__title">Search</h2>
          <div class="blog-single-2-search__form"></div>
        </div>
        <div class="blog-single-2-newsletter">
          <h2 class="blog-single-2-aside__title">Weekly Newsletter</h2>
          <p class="blog-single-2-newsletter__desc">No spam. Just the latest releases and tips, interesting articles, and exclusive interviews in your inbox every week.</p>
          <form class="blog-single-2-newsletter__form" novalidate>
          </form>
          <p class="blog-single-2-newsletter__policy">Your information is protected by us. Read our privacy policy</p>
        </div>
        <div class="blog-single-2-social">
          <h2 class="blog-single-2-aside__title">Follow us</h2>
          <div class="blog-single-2-social__item"></div>
        </div>
      </div>
    </div>
    <div class="blog-single-5-footer">
      <div class="sb-5-footer__adjacent">
        <div class="blog-single-5-footer__adjacent-post"></div>
      </div>
    </div>
  </div>
</div>

<style is:global>
@layer components {
  .blog-single-5 {
    padding: var(--space-l) var(--space-l) var(--space-l) var(--space-l);
  }

  .blog-single-5-container {
    row-gap: var(--flow-spacing);
  }

  .blog-single-5__head {
    display: flex;
    flex-direction: column;
    row-gap: var(--flow-spacing);
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .blog-single-5__meta {
    display: flex;
    flex-direction: row;
    row-gap: var(--flow-spacing);
    align-items: center;
    column-gap: var(--flow-spacing);
    justify-content: center;
  }

  .blog-single-5__author {
    display: flex;
    flex-direction: row;
    column-gap: var(--flow-spacing);
    justify-content: center;
    align-items: center;
  }

  .blog-single-5__photo {
    width: 4.5rem;
    height: 4.5rem;
    object-fit: cover;
    overflow: hidden;
    border-radius: 100% 100% 100% 100%;
  }

  .blog-single-5__author-data {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .blog-single-5__author-name {
    font-weight: 700;
    font-size: var(--fs-0);
  }

  .blog-single-5__author-label {
    font-size: var(--fs-0);
  }

  .blog-single-5__term {
    padding: .4rem .8rem .4rem .8rem;
    background: var(--bg-canvas);
    font-size: var(--fs-0);
  }

  .blog-single-5__date {
    font-size: var(--fs-0);
  }

  .blog-single-5__subtitle {
    font-weight: 700;
  }

  .blog-single-5__featured-image {
    object-fit: cover;
    width: 100%;
  }

  .blog-single-5__body {
    display: grid;
    grid-template-columns: calc(100% * 1 / 6);
    gap: var(--space-m);
  }

  .blog-single-2__body-sidebar {
    position: sticky;
    top: 5rem;
    display: flex;
    row-gap: var(--flow-spacing);
    flex-direction: column;
  }

  .blog-single-2-search {
    padding: var(--space-s) var(--space-s) var(--space-s) var(--space-s);
    display: flex;
    flex-direction: column;
    row-gap: var(--flow-spacing);
    background: color-mix(in srgb, var(--bg-subtle) 40%, transparent);
  }

  .blog-single-2-aside__title {
    padding: 0 0 var(--space-s) 0;
    border-bottom: .1rem solid var(--bg-subtle);
  }

  .blog-single-2-newsletter {
    padding: var(--space-s) var(--space-s) var(--space-s) var(--space-s);
    background: color-mix(in srgb, var(--bg-subtle) 40%, transparent);
    display: flex;
    flex-direction: column;
    row-gap: var(--flow-spacing);
  }

  .blog-single-2-newsletter__policy {
    font-size: var(--fs-0);
  }

  .blog-single-2-social {
    display: flex;
    flex-direction: column;
    row-gap: var(--flow-spacing);
    padding: var(--space-s) var(--space-s) var(--space-s) var(--space-s);
    background: color-mix(in srgb, var(--bg-subtle) 40%, transparent);
  }

  .blog-single-5-footer {
    display: flex;
    flex-direction: column;
    width: 100%;
    row-gap: var(--flow-spacing);
    column-gap: var(--flow-spacing);
    padding: var(--space-m) 0 0 0;
    border-top: .1rem solid var(--bg-subtle);
  }

  /* bm-custom */
  .blog-single-5__head::before {
      position: absolute;
      top: 0px;
      left: 0px;
      right: 0px;
      height: 70vh;
      background-color: var(--action-primary);
      content: "";
      z-index: -1;
  }

  /* bm-custom */
  .blog-single-5__term a {
  	color: var(--fs-0);
  }

  /* bm-custom */
  .blog-single-5__featured-image {
  	aspect-ratio: 6/4;
  }

  /* bm-custom */
  .blog-single-5__body-content h1,
  .blog-single-5__body-content h2,
  .blog-single-5__body-content h3,
  .blog-single-5__body-content h4,
  .blog-single-5__body-content h5,
  .blog-single-5__body-content h6,
  .blog-single-5__body-content p {
  	max-width: 100%; 
  }

  /* bm-custom */
  .blog-single-2-newsletter__form {
  	gap: 1rem;
    flex-wrap: nowrap;
  }
  .blog-single-2-newsletter__form [type="email"],
  .blog-single-2-newsletter__form [type="submit"] {
  	height: 100%;
  }

  /* bm-custom */
  .blog-single-5-footer__adjacent-post a {
  	max-width: 30rem;
  }
  .blog-single-5-footer__adjacent-post a.prev-post .content {
  	align-items: flex-start;
  }
  .blog-single-5-footer__adjacent-post a.next-post .content {
  	align-items: flex-end;
  }
  .blog-single-5-footer__adjacent-post a .swiper-button {
  	height: 100%;
    align-items: flex-end;
  }
  .blog-single-5-footer__adjacent-post a .content {
  	display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow: visible;
    justify-content: flex-end;
    height: 100%;
  }
  .blog-single-5-footer__adjacent-post a .label {
  	order: 1;
    text-transform: capitalize;
    font-weight: 400;
    font-size: var(--fs-0);
  }
  .blog-single-5-footer__adjacent-post a .title {
  	white-space: normal;
  }
}
</style>
