---
/**
 * bm-blog-single-12 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (blog-single-12.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-blog-single-12__top-container">
    <div class="bm-blog-single-12__top-inner">
      <div class="bm-blog-single-12__post-title"></div>
      <div class="bm-blog-single-12__term-category">
        <p class="blog-single-2__term">{post_terms_category}</p>
      </div>
      <div class="blog-single-2__meta">
        <div class="blog-single-2__author">
          <div class="blog-single-head__media">
            <figure class="blog-single-2__photo"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
          <div class="blog-single-head__data">
            <p class="blog-single-2__name">{author_name}</p>
            <p class="blog-single-2__position">Author Position</p>
          </div>
        </div>
        <div class="blog-single-head__details">
          <p class="blog-single-2__date">{post_date}</p>
        </div>
      </div>
      <div class="bm-blog-single-12__footer">
        <div class="bm-blog-single-12__post-excerpt"></div>
        <div class="bm-share-widget list--none">
          <div class="bm-share-widget__item">
            <a class="bm-share-widget__button btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
          </div>
          <div class="bm-share-widget__item">
            <a class="bm-share-widget__button btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="bm-blog-single-12__content-container">
    <figure class="bm-blog-single-featured-image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
    <div class="bm-blog-single-12__post-content"></div>
    <div class="bm-newsletter-widget-card-2">
      <div class="bm-newsletter-widget-card-2__top">
        <h3 class="bm-newsletter-widget-card-2__heading">{heading}</h3>
        <p class="bm-newsletter-widget-card-2__text">{fs}</p>
        <form class="bm-form-widget" novalidate>
        </form>
      </div>
      <div class="bm-newsletter-widget-card-2__footer">
        <div class="bm-review-widget">
          <div class="bm-team-list list--none">
            {items.map((it) => (
              <div class="bm-team-media">
                <figure class="bm-team-media__image"><img src="/media/placeholder.svg" alt="Team Image" loading="lazy" width="900" height="600" /></figure>
              </div>
            ))}
          </div>
          <div class="bm-testimonial-38__star-ratings">
            <p class="bm-testimonial-38__meta-text">Join over 2k+ subscribers</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-blog-single-12 {
    padding: 0 0 0 0;
    overflow: hidden;
    row-gap: var(--space-s);
  }

  .bm-blog-single-12__top-container {
    padding: var(--section-space-m) 0 var(--section-space-m) 0;
    width: 100vw;
    align-items: center;
    margin: 0 0 0 -50vw;
    position: relative;
    left: 50%;
    background: var(--bg-subtle);
  }

  .bm-blog-single-12__top-inner {
    row-gap: calc(var(--flow-spacing) / 1.4);
  }

  .bm-blog-single-12__post-title {
    font-size: calc(var(--fs-4) * 1.6);
  }

  .blog-single-2__term {
    padding: .4rem .8rem .4rem .8rem;
    background: var(--color-line-default);
    font-size: var(--fs-0);
  }

  .blog-single-2__meta {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    column-gap: var(--flow-spacing);
    text-align: center;
  }

  .blog-single-2__author {
    display: flex;
    flex-direction: row;
    column-gap: calc(var(--flow-spacing) / 2);
    align-items: center;
    padding: 0 var(--space-m) 0 0;
    border-right: .1rem solid var(--color-line-default);
  }

  .blog-single-2__photo {
    width: 4.4rem;
    height: 4.4rem;
    object-fit: cover;
    overflow: hidden;
    border-radius: 100% 100% 100% 100%;
  }

  .blog-single-head__data {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .blog-single-2__name {
    font-weight: 700;
    font-size: var(--fs-0);
  }

  .blog-single-2__position {
    font-size: var(--fs-0);
  }

  .blog-single-head__details {
    display: flex;
    column-gap: var(--flow-spacing);
    align-items: center;
  }

  .blog-single-2__date {
    font-size: var(--fs-0);
  }

  .bm-blog-single-12__footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--flow-spacing);
    row-gap: var(--flow-spacing);
  }

  .bm-blog-single-12__post-excerpt {
    width: 100%;
    font-size: var(--fs-2);
  }

  .bm-share-widget {
    flex-wrap: nowrap;
    column-gap: var(--flow-spacing);
    margin: 0 0 0 0;
    padding: 0 0 0 0;
    display: flex;
    row-gap: var(--flow-spacing);
  }

  .bm-blog-single-12__content-container {
    row-gap: var(--space-s);
    width: 100%;
  }

  .bm-blog-single-featured-image {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  .bm-newsletter-widget-card-2 {
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    background: var(--bg-subtle);
    border-top: 1 solid var(--color-line-default);
    border-right: 1 solid var(--color-line-default);
    border-bottom: 1 solid var(--color-line-default);
    border-left: 1 solid var(--color-line-default);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    row-gap: var(--flow-spacing);
  }

  .bm-newsletter-widget-card-2__top {
    padding: 0 0 var(--space-m) 0;
    border-bottom: 1 solid var(--color-line-default);
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-form-widget {
    display: flex;
    gap: var(--space-xs);
    flex-direction: row;
    align-items: center;
  }

  .bm-review-widget {
    flex-direction: row;
    display: flex;
    flex-wrap: nowrap;
    column-gap: calc(var(--flow-spacing) / 2);
    text-align: center;
    align-items: center;
  }

  .bm-team-list {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
  }

  .bm-team-media__image {
    object-fit: cover;
    width: 53;
    height: 52;
    border-top: .4rem solid var(--bg-canvas);
    border-right: .4rem solid var(--bg-canvas);
    border-bottom: .4rem solid var(--bg-canvas);
    border-left: .4rem solid var(--bg-canvas);
    border-radius: 100% 100% 100% 100%;
    overflow: hidden;
  }

  .bm-testimonial-38__star-ratings {
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    row-gap: calc(var(--flow-spacing) / 4);
  }

  /* bm-custom */
  .blog-single-2__term a {
  	color: var(--fs-0);
  }

  /* bm-custom */
  .bm-form-widget {
  flex-wrap: nowrap;
  }
  
  .bm-form-widget input:focus {
  	outline-offset: 0;
  } 
  
  .bm-form-widget button[type=submit].bricks-button {
      height: 100% !important;
  }
  
  .bm-form-widget .submit-button-wrapper {
      height: 100% !important;
  }

  /* bm-custom */
  .bm-team-media:nth-child(even),.bm-team-media:nth-child(odd) {
  	margin-inline-start: -20px;
  }
  
  .bm-team-media:first-child {
  	margin-inline-start: 0px;
  }
</style>
