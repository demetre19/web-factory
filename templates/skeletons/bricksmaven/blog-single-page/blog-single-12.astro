---
/**
 * bm-blog-single-12 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (blog-single-12.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-blog-single-12__top-container">
      <div class="bm-blog-single-12__top-inner">
        <div></div>
        <div></div>
        <div class="blog-single-2__meta">
          <div class="blog-single-2__author">
            <div>
              <figure class="blog-single-2__photo ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            </div>
            <div class="blog-single-head__data"></div>
          </div>
          <div class="blog-single-head__details"></div>
        </div>
        <div class="bm-blog-single-12__footer">
          <div class="bm-blog-single-12__post-excerpt"></div>
          <div class="bm-share-widget">
            <div>
              <p class="mt-fluid-m"><a class="wf-cta-button" href={cta.href}>{cta.label || 'Continue'}</a></p>
            </div>
            <div></div>
          </div>
        </div>
      </div>
    </div>
    <div class="bm-blog-single-12__content-container grid-auto gap-fluid-l">
      <figure class="bm-blog-single-featured-image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      <div></div>
      <div class="bm-newsletter-widget-card-2">
        <div class="bm-newsletter-widget-card-2__top">
          {heading && <h3 class="text-fluid-2">{heading}</h3>}
          {fs && <p class="text-fluid-0">{fs}</p>}
          <form class="bm-form-widget" novalidate>
          </form>
        </div>
        <div>
          <div class="bm-review-widget">
            <div class="bm-team-list">
              <div class="grid-auto gap-fluid-m">
                {(items || []).map((it) => (
                  <div class="card">
                    <figure class="bm-team-media__image ratio-portrait"><img src="/media/placeholder.svg" alt="Team Image" loading="lazy" width="900" height="600" /></figure>
                  </div>
                ))}
              </div>
            </div>
            <div class="bm-testimonial-38__star-ratings"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
