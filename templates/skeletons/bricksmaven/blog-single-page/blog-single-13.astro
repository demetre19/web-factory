---
/**
 * bm-blog-single-13 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (blog-single-13.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-blog-single-13__top-container">
    <div class="bm-blog-single-13__inner">
      <div class="bm-blog-single-13__content">
        <div class="bm-blog-single-13__wrapper">
          <div class="bm-blog-single-12__term-category">
            <p class="blog-single-2__term">{post_terms_category}</p>
          </div>
          <div class="bm-blog-single-13__post-title"></div>
          <div class="bm-blog-single-13__post-excerpt"></div>
        </div>
        <div class="blog-single-2__meta">
          <div class="blog-single-2__author">
            <div class="blog-single-head__media">
              <figure class="blog-single-2__photo"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            </div>
            <div class="blog-single-head__data">
              <p class="blog-single-2__name">{author_name}</p>
              <p class="blog-single-2__position">Author Position</p>
            </div>
          </div>
          <div class="blog-single-head__details blog-single-head__details--coloumn">
            <p class="blog-single-head__label">Date</p>
            <p class="blog-single-2__date">{post_date}</p>
          </div>
        </div>
      </div>
      <div class="bm-blog-single-13__featured-media">
        <figure class="bm-blog-single-13__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
    </div>
  </div>
  <div class="bm-blog-single-13__bottom-container">
    <div class="bm-blog-single-13__content-wrapper">
      <div class="bm-blog-single-13__post-content"></div>
    </div>
    <div class="bm-blog-single-13__aside">
      <div class="bm-blog-single-13__aside-sticky">
        <div class="bm-blog-single-13__aside-column">
          <div class="bm-newsletter-widget-card-3">
            <h3 class="bm-newsletter-widget-card-3__heading">{heading}</h3>
            <p class="bm-newsletter-widget-card-3__text">{fs}</p>
            <form class="bm-form-widget bm-form-widget--stacked" novalidate>
            </form>
            <p class="bm-newsletter-widget-card-3__micro-copy">Join 3k+ users growing their skills</p>
          </div>
        </div>
        <div class="bm-blog-single-13__aside-column">
          <h3 class="bm-blog-single-13__aside-heading">Follow us on our socials</h3>
          <div class="bm-social-share bm-social-share--left list--none">
            {items.map((it) => (
              <div class="bm-social-share__icon-wrapper">
                <span class="bm-social-share__icon" data-icon="lucide" aria-hidden="true"></span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-blog-single-13 {
    padding: 0 0 0 0;
    row-gap: var(--space-s);
  }

  .bm-blog-single-13__top-container {
    width: 100vw;
    margin: 0 0 0 -50vw;
    position: relative;
    left: 50%;
    align-items: center;
    background: var(--bg-subtle);
    padding: 0 var(--gutter) 0 var(--gutter);
  }

  .bm-blog-single-13__inner {
    display: grid;
    grid-template-columns: calc(100% * 1 / 2);
    gap: var(--space-m);
    padding: var(--section-space-m) 0 var(--section-space-m) 0;
  }

  .bm-blog-single-13__content {
    justify-content: space-between;
    row-gap: var(--flow-spacing);
  }

  .bm-blog-single-13__wrapper {
    row-gap: var(--flow-spacing);
  }

  .blog-single-2__term {
    padding: .4rem .8rem .4rem .8rem;
    background: var(--color-line-default);
    font-size: var(--fs-0);
  }

  .bm-blog-single-13__post-title {
    font-size: calc(var(--fs-4) * 1.5);
  }

  .bm-blog-single-13__post-excerpt {
    font-size: var(--fs-2);
  }

  .blog-single-2__meta {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    column-gap: var(--flow-spacing);
    text-align: center;
  }

  .blog-single-2__author {
    display: flex;
    flex-direction: row;
    column-gap: calc(var(--flow-spacing) / 2);
    align-items: center;
    padding: 0 var(--space-m) 0 0;
    border-right: .1rem solid var(--color-line-default);
  }

  .blog-single-2__photo {
    width: 4.4rem;
    height: 4.4rem;
    object-fit: cover;
    overflow: hidden;
    border-radius: 100% 100% 100% 100%;
  }

  .blog-single-head__data {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .blog-single-2__name {
    font-weight: 700;
    font-size: var(--fs-0);
  }

  .blog-single-2__position {
    font-size: var(--fs-0);
  }

  .blog-single-head__details {
    display: flex;
    column-gap: var(--flow-spacing);
    align-items: center;
  }

  .blog-single-head__details--coloumn {
    flex-direction: column;
    align-items: flex-start;
    row-gap: calc(var(--flow-spacing) / 1/6);
  }

  .blog-single-head__label {
    font-size: var(--fs-0);
    font-weight: 700;
  }

  .blog-single-2__date {
    font-size: var(--fs-0);
  }

  .bm-blog-single-13__image {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  .bm-blog-single-13__bottom-container {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 3);
  }

  .bm-blog-single-13__aside {
    position: relative;
    row-gap: var(--flow-spacing);
  }

  .bm-blog-single-13__aside-sticky {
    position: sticky;
    top: var(--space-m);
    row-gap: var(--flow-spacing);
  }

  .bm-blog-single-13__aside-column {
    padding: 0 0 var(--space-m) 0;
    border-bottom: 1 solid var(--bg-subtle);
    row-gap: var(--flow-spacing);
  }

  .bm-newsletter-widget-card-3 {
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-form-widget {
    display: flex;
    gap: var(--space-xs);
    flex-direction: row;
    align-items: center;
  }

  .bm-form-widget--stacked {
    flex-direction: column;
  }

  .bm-social-share {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    column-gap: var(--flow-spacing);
  }

  .bm-social-share--left {
    justify-content: flex-start;
  }

  /* bm-custom */
  .blog-single-2__term a {
  	color: var(--fs-0);
  }

  /* bm-custom */
  .bm-blog-single-13__aside-column:last-child {
    border-bottom:none;
  }

  /* bm-custom */
  .bm-form-widget {
  flex-wrap: nowrap;
  }
  
  .bm-form-widget input:focus {
  	outline-offset: 0;
  } 
  
  .bm-form-widget button[type=submit].bricks-button {
      height: 100% !important;
  }
  
  .bm-form-widget .submit-button-wrapper {
      height: 100% !important;
  }
</style>
