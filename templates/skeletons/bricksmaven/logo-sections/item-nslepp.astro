---
/**
 * bm-item-nslepp — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (item-nslepp.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="grid--2 align-items--center grid--m-1 logo-8-container gap--xxl gap--l-l">
    <div class="logo-8-list order--last-m">
      <div class="logo-8-list-item"></div>
    </div>
    <div class="gap--m flex--col logo-8-heading">
      <h2 class="logo-8-title">{heading}</h2>
      <p class="logo-8-desc">{fs}</p>
      <div class="flex--row gap--s logo-8-btn">
        <a class="btn--primary logo-8-btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
        <a class="btn--primary btn--outline logo-8-btn--outline" href={cta.href}>{cta.label}</a>
      </div>
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .logo-8-list-item {
    border-top: .5px solid color-mix(in srgb, var(--fs-0) 20%, transparent);
    border-right: .5px solid color-mix(in srgb, var(--fs-0) 20%, transparent);
    border-bottom: .5px solid color-mix(in srgb, var(--fs-0) 20%, transparent);
    border-left: .5px solid color-mix(in srgb, var(--fs-0) 20%, transparent);
  }

  .btn--primary {
    padding: 1.25rem 1.875rem 1.25rem 1.875rem !important;
    width: auto;
  }

  .logo-8-btn--primary {
    font-family: DM Sans;
  }

  .btn--outline {
    border-top: .1rem solid var(--action-primary);
    border-right: .1rem solid var(--action-primary);
    border-bottom: .1rem solid var(--action-primary);
    border-left: .1rem solid var(--action-primary);
  }

  /* bm-custom */
  .logo-8-list-item li {
  transition: all .2s ease-in-out;
  }
  
  .logo-8-list-item li:hover {
  background: color-mix(in srgb, var(--action-primary) 40%, transparent)
  }
  
  .logo-8-list-item li div {
  background-size: contain!important;
  }
</style>
