   "settings": {
    "cssCode": "/* VIEWPORT / MASK */\n.bm-logo-13__wrapper {\n  --gap: 24px; /* adjust as needed, or use var(--content-gap, 24px) */\n  inline-size: 100vw;\n  max-inline-size: 100vw;\n  margin-inline-start: calc(50% - 50vw); /* centers it full-bleed */\n  margin-inline-end: calc(50% - 50vw);\n  overflow: hidden;\n  padding-block: 16px 20px; /* vertical breathing room + hover shadow space */\n  position: relative;\n  inset-inline-start: 0;\n  inset-inline-end: 0;\n}\n\n/* TRACK \u2013 gets translated, now with gap for the seam between lists */\n.bm-logo-13__lijst{\n  display: flex;\n  flex-direction: row;\n  flex-wrap: nowrap;\n  align-items: center;\n  inline-size: max-content;\n  will-change: transform;\n  gap: var(--gap); /* \u2190 CRITICAL: adds the seam gap between original and clone ULs */\n}\n\n/* LIST \u2013 uses modern flex gap */\n.bm-logo-13-list {\n  display: flex;\n  flex-direction: row;\n  flex-wrap: nowrap;\n  align-items: center;\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  gap: var(--gap);\n  flex: 0 0 auto;\n  inline-size: max-content;\n}\n\n/* ITEM */\n.bm-logo-13-item {\n  flex: 0 0 auto;\n  display: flex;\n  flex-direction:row;\n  flex-wrap: nowrap;\n  gap: calc(var(--content-gap) / 2);\n  align-items: center;\n  justify-content: start;\n  background: white;\n  border-radius: 999px;\n  padding: 8px var(--space-xs);\n  box-shadow: 0 2px 8px rgba(0,0,0,0.08);\n  transition: transform 0.25s ease, box-shadow 0.25s ease;\n}\n\n.bm-logo-13-item:hover {\n  transform: scale(1.06);\n  box-shadow: 0 6px 20px rgba(0,0,0,0.12);\n}",
    "_display": "none",
    "executeCode": true,
    "javascriptCode": "(() => {\n  // Skip if user prefers reduced motion\n  if (window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) return;\n\n  const px = (val) => {\n    if (!val) return 0;\n    const num = parseFloat(val);\n    return isFinite(num) ? num : 0;\n  };\n\n  function getVisibleCount(wrapper) {\n    const ww = window.innerWidth;\n    const d = parseInt(wrapper.dataset.visibleDesktop || wrapper.dataset.visible || '7', 10);\n    const t = parseInt(wrapper.dataset.visibleTablet || '4', 10);\n    const m = parseInt(wrapper.dataset.visibleMobile || '2', 10);\n    if (ww <= 767) return m;\n    if (ww <= 1240) return t;\n    return d;\n  }\n\n  function initCarousel(wrapper) {\n    const track = wrapper.querySelector('.bm-logo-13__lijst, .bm-logo-13__lijst--alt');\n    if (!track) return;\n\n    const originalList = track.querySelector('ul.bm-logo-13-list');\n    if (!originalList) return;\n\n    // Prevent double init\n    if (track.dataset.init === 'done') return;\n    track.dataset.init = 'done';\n\n    // Clone once\n    const clone = originalList.cloneNode(true);\n    clone.setAttribute('aria-hidden', 'true');\n    track.appendChild(clone);\n\n    const speed = parseFloat(wrapper.dataset.speed || '60'); // px/s\n    const direction = (wrapper.dataset.direction || 'left').toLowerCase() === 'right' ? 1 : -1;\n\n    let position = 0;\n    let contentWidth = 0;\n    let lastTime = performance.now();\n    let isPaused = false;\n\n    track.style.display = 'flex';\n    track.style.alignItems = 'center';\n\n    function updateItemWidths() {\n      const gap = px(getComputedStyle(wrapper).getPropertyValue('--gap'));\n      const visible = getVisibleCount(wrapper);\n      const vw = wrapper.clientWidth;\n\n      const totalGaps = Math.max(0, visible - 1);\n      const itemWidth = Math.max(60, (vw - totalGaps * gap) / visible);\n\n      track.querySelectorAll('.bm-logo-13-item').forEach(item => {\n        item.style.width = `${itemWidth}px`;\n      });\n\n      return gap;\n    }\n\n    function measure() {\n      const gap = updateItemWidths();\n\n      // Force layout/reflow\n      void track.offsetWidth;\n\n      // With gap on track, full cycle = scrollWidth of list + gap (seam between lists)\n      contentWidth = originalList.scrollWidth + gap;\n\n      // Initial position\n      position = direction === 1 ? -contentWidth : 0;\n      track.style.transform = `translate3d(${position}px, 0, 0)`;\n    }\n\n    function animate(time) {\n      const delta = (time - lastTime) / 1000;\n      lastTime = time;\n\n      if (!isPaused && contentWidth > 0) {\n        position += direction * speed * delta;\n\n        // Seamless reset with small epsilon for subpixel drift\n        const epsilon = 1;\n        if (direction === -1) { // \u2190 left\n          if (-position >= contentWidth - epsilon) position += contentWidth;\n        } else { // \u2192 right\n          if (position >= -epsilon) position -= contentWidth;\n        }\n\n        track.style.transform = `translate3d(${position}px, 0, 0)`;\n      }\n\n      requestAnimationFrame(animate);\n    }\n\n    // Events\n    wrapper.addEventListener('mouseenter', () => { isPaused = true; });\n    wrapper.addEventListener('mouseleave', () => { isPaused = false; });\n\n    // Resize\n    new ResizeObserver(() => requestAnimationFrame(measure)).observe(wrapper);\n\n    // Image load / error \u2192 remeasure\n    track.querySelectorAll('img').forEach(img => {\n      if (img.complete) return;\n      img.addEventListener('load', () => requestAnimationFrame(measure), { once: true });\n      img.addEventListener('error', () => requestAnimationFrame(measure), { once: true });\n    });\n\n    // Start (double rAF helps Safari initial paint)\n    requestAnimationFrame(() => {\n      measure();\n      requestAnimationFrame(() => {\n        measure();\n        requestAnimationFrame(animate);\n      });\n    });\n  }\n\n  // Boot\n  document.querySelectorAll('.bm-logo-13__wrapper').forEach(initCarousel);\n})();",
    "_attributes": [
     {
      "id": "rojtyd"
     }
    ]
   },
   "themeStyles": {
