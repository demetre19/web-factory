---
/**
 * bm-item-ctmenm — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (item-ctmenm.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="logo-7-container grid--2 gap--l align-items--center grid--m-1">
    <div class="logo-7-list order--last-m">
      <div class="logo-7-list-item"></div>
    </div>
    <div class="logo-7-heading gap--m flex--col">
      <h2 class="logo-7-title">{heading}</h2>
      <p class="logo-7-desc">{fs}</p>
      <div class="logo-7-btn flex--row gap--s">
        <a class="logo-7-btn--primary btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
        <a class="logo-7-btn--outline btn--primary btn--outline" href={cta.href}>{cta.label}</a>
      </div>
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .logo-7-btn--primary {
    font-family: DM Sans;
  }

  .btn--primary {
    padding: 1.25rem 1.875rem 1.25rem 1.875rem !important;
    width: auto;
  }

  .btn--outline {
    border-top: .1rem solid var(--action-primary);
    border-right: .1rem solid var(--action-primary);
    border-bottom: .1rem solid var(--action-primary);
    border-left: .1rem solid var(--action-primary);
  }

  /* bm-custom */
  .logo-7-list-item li:nth-child(1),
  .logo-7-list-item li:nth-child(3),
  .logo-7-list-item li:nth-child(5) {
  	border-right: .5px solid color-mix(in srgb, var(--fs-0) 20%, transparent);
  }
  
  .logo-7-list-item li:nth-child(2),
  .logo-7-list-item li:nth-child(4),
  .logo-7-list-item li:nth-child(6) {
  	border-left: .5px solid color-mix(in srgb, var(--fs-0) 20%, transparent);
  }
  
  
  .logo-7-list-item li {
  	transition: all .2s ease-in-out;
  }
  
  .logo-7-list-item li:after {
    content: '';
    width: 0.1rem;
    height: 93px;
    background: var(--action-primary);
    position: absolute;
    display: none;
    top: 0;
    right: 0;
    transition: background .3s;
  }
  
  .logo-7-list-item li:hover {
  	background: color-mix(in srgb, var(--action-primary) 40%, transparent);
  }
  
  .logo-7-list-item li:hover:after {
  	display: block;
  }
  
  .logo-7-list-item li div {
  	background-size: contain !important;
  }
</style>
