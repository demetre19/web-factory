---
/**
 * bm-item-otgozz — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (item-otgozz.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="logo-5-container">
    <div class="center--all pad--m width--full align-items--center flex--col logo-5-row gap--xl">
      <h2 class="logo-5-title">ACSS + Bricksmaven used by top design teams and whole lot of designers</h2>
      <div class="logo-5-list-item"></div>
    </div>
  </div>
</div>

<style is:global>
@layer components {
  /* bm-custom */
  .logo-5-list-item li {
  	border: 1px solid color-mix(in srgb, var(--fs-0) 20%, transparent);
    transition: all .4s ease-in-out;
  }
  
  .logo-5-list-item li:hover {
  	background: color-mix(in srgb, var(--action-primary) 60%, transparent);
    cursor: pointer;
  }
  
  .logo-5-list-item li div {
  	background-size: contain!important;
  }
}
</style>
