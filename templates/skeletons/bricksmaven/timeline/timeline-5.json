   "settings": {
    "code": "<style>\n.timeline-5hdg {\n\tmargin-top: 50px;\n\ttext-align: center;\n}\n/* Timeline */\n.timeline-5-list {\n\tborder-left: 3px solid var(--primary);\n\tborder-bottom-right-radius: 4px;\n\tborder-top-right-radius: 4px;\n\tbackground: var(--primary-dark);\n\tcolor: var(--shade-light);\n\tmargin: 50px auto;\n\tletter-spacing: 0.5px;\n\tposition: relative;\n\tline-height: 1.4em;\n\tfont-size: 1.03em;\n\tpadding: var(--space-l) !important;\n\tlist-style: none;\n\ttext-align: left;\n\tfont-weight: 100;\n\tmax-width: 100%;\n}\n\n.timeline-5-card h3 {\n\tcolor: var(--primary-light);\n}\n\n.timeline-5-list .timeline-5-card {\n\tborder-bottom: 1px dashed rgba(255, 255, 255, 0.1);\n\tpadding-bottom: 25px;\n\tmargin-bottom: 50px;\n\tposition: relative;\n}\n.timeline-5-list .timeline-5-card:last-of-type {\n\tpadding-bottom: 0;\n\tmargin-bottom: 0;\n\tborder: none;\n}\n.timeline-5-list .timeline-5-card:before,\n.timeline-5-list .timeline-5-card:after {\n\tposition: absolute;\n\tdisplay: block;\n\ttop: 0;\n}\n.timeline-5-list .timeline-5-card:before {\n\tleft: -30%;\n\tcolor: var(--black);\n\tcontent: attr(data-date);\n\ttext-align: right;\n\tfont-weight: 100;\n\tfont-size: 0.9em;\n\tmin-width: 120px;\n\n}\n.timeline-5-list .timeline-5-card:after {\n\tbox-shadow: 0 0 0 2px var(--primary);\n\tleft: calc(var(--space-l) * -1 + -7px);\n\tbackground: var(--primary-ultra-dark);\n\tborder-radius: 50%;\n\theight: 11px;\n\twidth: 11px;\n\tcontent: \"\";\n\ttop: 5px;\n}\n\n@media (max-width: 999px) {\n\t.timeline-5-list {\n\t\tmax-width: 90%;\n\t}\n\t\n\t.timeline-5-list .timeline-5-card:before {\n\t\tleft: calc(var(--space-l) * -1 + -104px);\n\t\ttop: 22px;\n\t\tz-index: 1;\n    color: var(--primary-light);\n\t}\n\t.timeline-5-list .timeline-5-card:after {\n\t\theight: 55px;\n\t\twidth: 55px;\n\t\tleft: calc(var(--space-l) * -1 + -30px);\n\t}\n}\n\n</style>",
