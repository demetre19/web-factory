   "custom_css": ".timeline-14-card:last-child {\n\tpadding-block-end: var(--space-xxl);\n}\n\n\n.timeline-14-card:first-child {\n\tpadding-block-start: var(--space-xxl);\n}\n\n/* ODD card styling */\n.timeline-14-card:nth-child(odd) {\n\tgrid-column: 2 / -1;\n}\n\n.timeline-14-card__date-wrapper {\n  \tposition:relative;\n}\n\n.timeline-14-card:nth-child(odd) .timeline-14-card__date-wrapper::before {\n\tcontent:'';\n  position:absolute;\n  width: calc(100% + (var(--grid-gap) * 2)) ;\n\theight:.1rem;\n  bottom: calc(-1 * var(--space-xs));\n  left: calc((var(--grid-gap) * 2) * -1 );\n  background-color: var(--neutral-dark);\n  transition: .5s ease;\n}\n\n\n\n.timeline-14-card:nth-child(odd):hover .timeline-14-card__date-wrapper::before {\n  background-color: var(--neutral-light);\n}\n\n.timeline-14-card:nth-child(odd) .timeline-14-card__date-wrapper::after {\n\tcontent:'';\n  position:absolute;\n  width: 0 ;\n\theight:.2rem;\n  bottom: calc(-1 * var(--space-xs));\n  left: calc((var(--grid-gap) * 2) * -1 );\n  background-color: var(--neutral-dark);\n  transition: .5s ease, width 1s;\n}\n\n.timeline-14-card:nth-child(odd):hover .timeline-14-card__date-wrapper::after {\n  width: calc(100% + (var(--grid-gap) * 2)) ;\n}\n\n/* EVEN card styling */\n.timeline-14-card:nth-child(even) {\n\tgrid-template-columns: var(--grid-2-3);\n  grid-column: 1 / 2;\n  transform: translateY(-50%);\n}\n\n.timeline-14-card:nth-child(even) .timeline-14-card__media {\n  order:-1;\t\n}\n\n.timeline-14-card:nth-child(even) .timeline-14-card__date-wrapper::before {\n\tcontent:'';\n  position:absolute;\n  width: calc(100% + (var(--grid-gap) * 2)) ;\n\theight:.1rem;\n  bottom: calc(-1 * var(--space-xs));\n  right: calc((var(--grid-gap) * 2) * -1);\n  background-color: var(--neutral-dark);\n  transition: .5s ease;\n}\n\n.timeline-14-card:nth-child(even):hover .timeline-14-card__date-wrapper::before {\n  background-color: var(--neutral-light);\n}\n\n.timeline-14-card:nth-child(even) .timeline-14-card__date-wrapper::after {\n\tcontent:'';\n  position:absolute;\n  width: 0 ;\n\theight:.2rem;\n  bottom: calc(-1 * var(--space-xs));\n  right: calc((var(--grid-gap) * 2) * -1 );\n  background-color: var(--neutral-dark);\n  transition: .5s ease, width 1s;\n}\n\n.timeline-14-card:nth-child(even):hover .timeline-14-card__date-wrapper::after {\n  width: calc(100% + (var(--grid-gap) * 2)) ;\n}\n\n\n@media (max-width:991px) {\n\t\t\n  /* EVEN card styling */\n      .timeline-14-card:nth-child(even) {\n        grid-template-columns: var(--grid-1);\n      }\n  \n  /* ODD card styling */\n      .timeline-14-card:nth-child(odd) {\n        grid-template-columns: var(--grid-1);\n      }\n\t\n}\n\n@media (max-width:478px) {\n\t\t\n  .timeline-14-card {\n  \tpadding-inline-start: calc(var(--grid-gap) * 2);\n  }\n  \n  /* EVEN card styling */\n      .timeline-14-card:nth-child(even) {\n        grid-column: unset;\n        transform: translateY(0%);\n      }\n  \n      .timeline-14-card:nth-child(even) .timeline-14-card__date-wrapper::before,\n  \t\t.timeline-14-card:nth-child(even) .timeline-14-card__date-wrapper::after{\n\t\t\t\t left: calc((var(--grid-gap) * 2) * -1);\n    }\n  \n  .timeline-14-card:nth-child(even) .timeline-14-card__media {\n  order:unset;\t\n}\n  \n  /* ODD card styling */\n      .timeline-14-card:nth-child(odd) {\n        grid-column: unset;\n      }\n\t\n}",
