   "custom_css": "/* CARD */\n.bm-timeline-16__slide .bm-timeline-16-card {\n  position: relative;\n  gap: 0;\n}\n\n.bm-timeline-16__slide .bm-timeline-16-card::after {\n  content: '';\n  position: absolute;\n  top:50%;\n  width:100%;\n  height:1px;\n  background-color: var(--neutral-ultra-light);\n}\n.bm-timeline-16__slide:nth-child(even) .bm-timeline-16-card::before  {\n  content: '';\n  position: absolute;\n  left:50%;\n  top:50%;\n  width:1px;\n  height:var(--space-l);\n  background-color: var(--neutral-ultra-light);\n}\n\n.bm-timeline-16__slide:nth-child(odd) .bm-timeline-16-card::before  {\n  content: '';\n  position: absolute;\n  left:50%;\n  bottom:50%;\n  width:1px;\n  height:var(--space-l);\n  background-color: var(--neutral-ultra-light);\n}\n\n/* CONTENT */\n.bm-timeline-16__slide .bm-timeline-16-card .bm-timeline-16-card__content {\n  align-items: center;\n  text-align: center;\n  padding-inline: var(--space-m);\n}\n\n.bm-timeline-16__slide:nth-child(odd) .bm-timeline-16-card .bm-timeline-16-card__content {\n  padding-block-start: var(--space-xl);\n}\n\n.bm-timeline-16__slide:nth-child(even) .bm-timeline-16-card .bm-timeline-16-card__content {\n  padding-block-end: var(--space-xl);\n}\n\n/* DATE WRAPPER */\n.bm-timeline-16__slide .bm-timeline-16-card .bm-timeline-16-card__date-wrapper {\n  align-items: center;\n  padding: var(--space-m);\n  position: relative;\n}\n\n\n.bm-timeline-16__slide:nth-child(odd) .bm-timeline-16-card .bm-timeline-16-card__date-wrapper {\n  order:-2;\n  padding-block-end: var(--space-xl);\n}\n\n.bm-timeline-16__slide:nth-child(even) .bm-timeline-16-card .bm-timeline-16-card__date-wrapper {\n  padding-block-start: var(--space-xl);\n}\n\n\n\n/* DATE */\n.bm-timeline-16__slide .bm-timeline-16-card .bm-timeline-16-card__date {\n  \n  font-size: calc(var(--text-xxl) * 2);\n  line-height: 1;\n  color:var(--neutral-ultra-light)\n}\n\n\n",
