   "children": [],
   "settings": {
    "code": "<style>\n.timeline-9-card {\n    display: flex;\n    align-items: flex-start;\n    margin-top: var(--space-l);\n    position: relative;\n    flex-direction: row;\n}\n\n.timeline-9-card:not(:last-child)::after {\n  content: '';\n  display: block;\n  position: absolute;\n  width: 4px;\n  height: 100px;\n  background-color: var(--shade-light);\n  left: 2.3rem;\n  top: 5rem;\n  transform: translateX(-50%);\n}\n\n[status='true'].timeline-9-card:not(:last-child)::after {\n\tbackground-color: var(--success);\n}\n\n.timeline-9-card__status {\n  height: 46px;\n  width: 46px;\n  border-radius: 50%;\n  background-color: var(--success);\n\tposition: absolute;\n}\n\n.timeline-9-card:not([status='true']) .timeline-9-card__status {\n  background: var(--white);\n  border: 4px solid var(--shade-light);\n}\n\n.timeline-9-card__content {\n  margin-left: 60px;\n}\n\n.timeline-9-card__content h3 {\n  color: var(--success);\n  background: var(--success-light);\n  padding: 5px 10px;\n  border-radius: var(--radius-s);\n  margin-bottom: 10px;\n}\n\n\n.timeline-9-card:not([status='true']) .timeline-9-card__content h3 {\n  color: var(--shade-light);\n  background: var(--shade-ultra-light);\n}\n</style>\n",
    "executeCode": true,
