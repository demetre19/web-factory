        <div class="timeline-15-card__content">
          <div class="timeline-15-card__intro">
            <h2 class="timeline-15-card__heading">{post_title}</h2>
            <p class="timeline-15-card__date">{post_date}</p>
            <p class="timeline-15-card__text">{post_excerpt}</p>
          </div>
          <a class="btn--primary timeline-15-card__btn wf-cta-button" href={cta.href}>{cta.label}</a>
        </div>
        <div class="timeline-15-card__media">
          <figure class="timeline-15-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
