---
/**
 * bm-timeline-10 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (timeline-10.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="timeline-10-container">
    <div class="intro">
      <h2 class="intro__heading">{heading}</h2>
      <p class="intro__subheading">{fs}</p>
      <p class="intro__accent-heading">Accent heading</p>
    </div>
    <div class="timeline-10-slider-container">
      <div class="timeline-10-list">
        {items.map((it) => (
          <div class="timeline-10-card">
            <div class="timeline-10-card__content">
              <h2 class="timeline-10-card__heading">{it.title}</h2>
              <p class="timeline-10-card__text">{it.text}</p>
            </div>
            <p class="timeline-10-card__date">{it.text}</p>
            <div class="timeline-10-card__media">
              <figure class="timeline-10-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            </div>
            <div class="timeline-10-card__overlay"></div>
          </div>
        ))}
      </div>
      <div class="timeline-10__border-line"></div>
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .timeline-10-container {
    row-gap: var(--space-s);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .timeline-10-list {
    display: flex;
    flex-direction: row;
    width: 100%;
  }

  .timeline-10-card {
    position: relative;
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .timeline-10-card__content {
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    row-gap: var(--flow-spacing);
  }

  .timeline-10-card__heading {
    font-size: var(--fs-1);
    text-transform: uppercase;
    letter-spacing: 1;
  }

  .timeline-10-card__text {
    font-size: var(--fs-0);
  }

  .timeline-10-card__date {
    position: absolute;
    border-top: .1rem solid;
    border-bottom: .1rem solid;
    top: 50%;
    left: 50%;
    z-index: 1;
  }

  .timeline-10-card__media {
    overflow: hidden;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    position: absolute;
  }

  .timeline-10-card__image {
    object-fit: cover;
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
  }

  .timeline-10-card__overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
  }

  .timeline-10__border-line {
    width: 100%;
    height: .4rem;
    background: var(--action-primary);
    margin: -1.2rem 0 0 0;
  }

  /* bm-custom */
  .timeline-10-list .splide__track {
  		padding-bottom: calc(var(--section-space-xxl) + 1.5rem);
  }
  
  .timeline-10-list .splide__arrows.custom {
      display: flex!important;
      position: absolute;
      gap: var(--space-s);
      top: calc(100% + var(--space-m));
      width: 100%;
      justify-content: center;
  }
  
  .timeline-10-list .splide__arrow {
      position: relative !important;
  
  }

  /* bm-custom */
  .timeline-10-card:focus-within :focus {
  	outline: none;
    box-shadow: none;
  }
  
  .timeline-10-card:focus-within {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--text-primary) 10%, transparent);
  }
  
  /* Overlay */
  .timeline-10-card__overlay {
    transition: 7s ease-in;
  }
  
  .timeline-10-card:hover .timeline-10-card__overlay, .timeline-10-card:focus-within .timeline-10-card__overlay {
      background-image: linear-gradient(color-mix(in srgb, var(--action-primary) 10%, transparent), color-mix(in srgb, var(--action-primary) 90%, transparent));
  
  }
  
  /* Image */
  .timeline-10-card__image {
    transition: .8s linear;
  }
  
  .timeline-10-card:hover .timeline-10-card__image {
    scale: 1.1;
  }
  
  /* Date */
  .timeline-10-card__date {
    transition: .3s linear;
    opacity: 1;
  }
  
  .timeline-10-card:hover .timeline-10-card__date {
    opacity: 0;
  }
  
  /* Faded red line underneath card */
  .timeline-10-card::before { 
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    width: .1rem;
    height: var(--section-space-xxl); 
    background-color: var(--action-primary);
  }
  
  /* Circle at the end of the line */
  .timeline-10-card::after { 
    content: "";
    position: absolute;
    top: calc(100% + var(--section-space-xxl) - 6px);
    left: 50%;
    transform: translateX(-50%);
    width: 2rem;
    height: 2rem; 
    background-color: var(--action-primary);
    border-radius: 100%;
    border: .4rem solid var(--bg-canvas);
  }
  
  @media (min-width: 767px) {
  	/* Hide content */
  .timeline-10-card .timeline-10-card__content {
  	opacity: 0;
    transition: ease 1s;
    transform: translateY(3rem);
  }
  
  /* Reveal content */
  .timeline-10-card:hover .timeline-10-card__content, .timeline-10-card:focus-within .timeline-10-card__content {
  	opacity: 1;
    transform: translateY(0rem);
  }
  }
</style>
