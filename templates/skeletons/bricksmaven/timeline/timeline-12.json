   "settings": {
    "code": "<style>\n\n.timeline-12-list {\n\tborder-left:2px solid var(--primary);\n\tpadding: var(--space-s);\n  width: var(--width-l);\n}\n.timeline-12-list .timeline-12-card{\n\tpadding:var(--space-s);\n\tposition:relative;\n\tcursor:pointer;\n\ttransition:.5s;\n  gap: var(--content-gap);\n}\n.timeline-12-list .timeline-12-card .timeline-12-card__date{\n\tdisplay:inline-block;\n\tbackground-color:var(--primary-light);\n\tborder-radius: var(--radius-xl);\n\tpadding:var(--space-xs);\n\tfont-size: var(--text-s);\n\tfont-weight: 500;\n\ttext-transform: uppercase;\n\ttext-align:center;\n\tletter-spacing: 1px;\n  order: -1;\n}\n  \n.timeline-12-list .timeline-12-card .timeline-12-card__content{\n\tgap: var(--content-gap);\n}\n  \n.timeline-12-list .timeline-12-card .timeline-12-card__content h3{\n\tcolor:var(--primary);\n}\n\n.timeline-12-list .timeline-12-card:before{\n\tposition:absolute;\n\tcontent:'';\n\twidth:10px;\n\theight:10px;\n\tbackground-color:var(--primary);\n\tborder-radius: var(--radius-circle);\n\tleft:-.6rem;\n\ttop:3rem;\n\ttransition:.5s;\n}\n.timeline-12-list .timeline-12-card:hover{\n\tbackground-color: var(--primary-hover);\n}\n\n.timeline-12-list .timeline-12-card:hover .timeline-12-card__content p,\n.timeline-12-list .timeline-12-card:hover .timeline-12-card__content h3 {\n\tcolor: var(--white);\n}\n.timeline-12-list .timeline-12-card:hover:before{\n\tbackground-color: var(--success);\n\tbox-shadow: 0px 0px 10px 2px var(--neutral-trans-10);\n\n}\n</style>\n",
