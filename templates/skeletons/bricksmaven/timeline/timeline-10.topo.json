   "custom_css": "\n.timeline-10-card:focus-within :focus {\n\toutline: none;\n  box-shadow: none;\n}\n\n.timeline-10-card:focus-within {\n  box-shadow: 0 0 0 2px var(--black-trans-10);\n}\n\n/* Overlay */\n.timeline-10-card__overlay {\n  transition: 7s ease-in;\n}\n\n.timeline-10-card:hover .timeline-10-card__overlay, .timeline-10-card:focus-within .timeline-10-card__overlay {\n    background-image: linear-gradient(var(--primary-ultra-dark-trans-10), var(--primary-ultra-dark-trans-90));\n\n}\n\n/* Image */\n.timeline-10-card__image {\n  transition: .8s linear;\n}\n\n.timeline-10-card:hover .timeline-10-card__image {\n  scale: 1.1;\n}\n\n/* Date */\n.timeline-10-card__date {\n  transition: .3s linear;\n  opacity: 1;\n}\n\n.timeline-10-card:hover .timeline-10-card__date {\n  opacity: 0;\n}\n\n/* Faded red line underneath card */\n.timeline-10-card::before { \n  content: \"\";\n  position: absolute;\n  top: 100%;\n  left: 50%;\n  transform: translateX(-50%);\n  width: .1rem;\n  height: var(--space-xxl); \n  background-color: var(--primary-light);\n}\n\n/* Circle at the end of the line */\n.timeline-10-card::after { \n  content: \"\";\n  position: absolute;\n  top: calc(100% + var(--space-xxl) - 6px);\n  left: 50%;\n  transform: translateX(-50%);\n  width: 2rem;\n  height: 2rem; \n  background-color: var(--primary);\n  border-radius: var(--radius-circle);\n  border: .4rem solid var(--white);\n}\n\n@media (min-width: 767px) {\n\t/* Hide content */\n.timeline-10-card .timeline-10-card__content {\n\topacity: 0;\n  transition: ease 1s;\n  transform: translateY(3rem);\n}\n\n/* Reveal content */\n.timeline-10-card:hover .timeline-10-card__content, .timeline-10-card:focus-within .timeline-10-card__content {\n\topacity: 1;\n  transform: translateY(0rem);\n}\n}\n",
