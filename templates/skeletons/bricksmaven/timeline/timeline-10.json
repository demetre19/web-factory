    "_cssCustom": ".timeline-10-list .splide__track {\n\t\tpadding-bottom: calc(var(--space-xxl) + 1.5rem);\n}\n\n.timeline-10-list .splide__arrows.custom {\n    display: flex!important;\n    position: absolute;\n    gap: var(--space-s);\n    top: calc(100% + var(--space-m));\n    width: 100%;\n    justify-content: center;\n}\n\n.timeline-10-list .splide__arrow {\n    position: relative !important;\n\n}",
