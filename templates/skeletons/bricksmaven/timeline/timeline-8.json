   "settings": {
    "code": "<style>\n/* Styling */\n.timeline-8-list {\n  margin: var(--space-m) auto;\n  position: relative;\n  max-width: var(--width-l);\n  padding-left:  0;\n}\n.timeline-8-list:before {\n  background-color: var(--black);\n  content: '';\n  margin-left: -1px;\n  position: absolute;\n  top: 0;\n  left: 2em;\n  width: 2px;\n  height: 100%;\n}\n\n.timeline-8-list .timeline-8-card {\n  position: relative;\n}\n.timeline-8 .timeline-8-card:hover .timeline-8-card__icon-div {\n  -moz-transform: rotate(-45deg);\n  -ms-transform: rotate(-45deg);\n  -webkit-transform: rotate(-45deg);\n  transform: rotate(-45deg);\n  background-color: var(--primary);\n}\n.timeline-8 .timeline-8-card:hover .timeline-8-card__date {\n  -moz-box-shadow: inset 40em 0 0 0 var(--primary);\n  -webkit-box-shadow: inset 40em 0 0 0 var(--primary);\n  box-shadow: inset 40em 0 0 0 var(--primary);\n  \n}\n\n.timeline-8-card__content {\n  padding: var(--space-l);\n  position: relative;\n  top: -1.875em;\n  left: 4em;\n  width: 80%;\n  gap: var(--content-gap);\n}\n\n.timeline-8-card__content strong {\n  font-weight: 700;\n}\n  \n\n.timeline-8-card__icon-div {\n  -moz-transition: -moz-transform 0.2s ease-in;\n  -o-transition: -o-transform 0.2s ease-in;\n  -webkit-transition: -webkit-transform 0.2s ease-in;\n  transition: transform 0.2s ease-in;\n  -moz-transform: rotate(45deg);\n  -ms-transform: rotate(45deg);\n  -webkit-transform: rotate(45deg);\n  transform: rotate(45deg);\n  background-color: black;\n  outline: 10px solid white;\n  display: block;\n  margin: 0.5em 0.5em 0.5em -0.5em;\n  position: absolute;\n  top: 0;\n  left: 2em;\n  width: 1em;\n  height: 1em;\n}\n\n.timeline-8-card__date {\n  -moz-transition: box-shadow 0.5s ease-in 0.1s;\n  -o-transition: box-shadow 0.5s ease-in 0.1s;\n  -webkit-transition: box-shadow 0.5s ease-in;\n  -webkit-transition-delay: 0.1s;\n  transition: box-shadow 0.5s ease-in 0.1s;\n  color: white;\n  font-size: 0.75em;\n  background-color: black;\n  -moz-box-shadow: inset 0 0 0 0em var(--primary-light);\n  -webkit-box-shadow: inset 0 0 0 0em var(--primary-light);\n  box-shadow: inset 0 0 0 0em var(--primary-light);\n  display: inline-block;\n  margin-bottom: 1.2em;\n  padding: 0.25em 1em 0.2em 1em;\n  order: -1;\n}\n\n</style>\n",
