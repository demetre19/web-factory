   "settings": {
    "code": "<style>\n.timeline-7-list {\n  \tposition: relative;\n  \twidth: var(--width-l);\n  \tpadding-left: 0;\n  \tmargin: auto;\n\t\tcounter-reset: timeline-7;\n}\n.timeline-7-list::before {\n  content: '';\n  position: absolute;\n  height: 100%;\n  width: 2px;\n  background-color: var(--primary-ultra-light);\n  left: 50%;\n  transform: translateX(-50%);  \n}\n\n.timeline-7-list .timeline-7-card {\n  width: 50%;\n  padding: var(--space-m);\n  position: relative;\n  background-color: var(--primary-ultra-light);\n  box-shadow: 0 5px 15px rgba(0, 0, 0, .04);\n}\n.timeline-7-list .timeline-7-card:not(:first-child),\n.timeline-7-list .timeline-7-card:not(:last-child) {\n  margin: var(--space-xl) 0 var(--space-l) 0;\n}\n.timeline-7-list .timeline-7-card:nth-child(odd) {\n  transform: translateX(100%);\n  border-left: 2px solid var(--primary);\n  border-radius: 0 var(--radius-xs) var(--radius-xs) 0;\n}\n.timeline-7-list .timeline-7-card:nth-child(even) {\n  border-right: 2px solid var(--secondary);\n  border-radius: var(--radius-xs) 0 0 var(--radius-xs);\n}\n\n.timeline-7-list .timeline-7-card .timeline-7-card__number {\n  position: absolute;\n  height: 26px;\n  width: 25px !important;\n  color: #333;\n  background-color: var(--primary-ultra-light);\n  text-align: center;\n  line-height: 22px;\n  border-radius: 3px;\n  font-size: .8rem;\n}\n\n.timeline-7-list .timeline-7-card .timeline-7-card__number::before {\n\tcounter-increment: timeline-7;\n\tcontent: counter(timeline-7);\n}\n\n.timeline-7-list .timeline-7-card:nth-child(odd)  .timeline-7-card__number {\n  top: -4rem;\n  left: -1.4rem;\n  border: 2px solid var(--primary);\n}\n.timeline-7-list .timeline-7-card:nth-child(even)  .timeline-7-card__number {\n  top: -4rem;\n  right: -1.4rem;\n  border: 2px solid var(--secondary);\n}\n  \n  .timeline-7-list .timeline-7-card .timeline-7-card__content {\n  gap: var(--content-gap);\n}\n\n\n@media screen and (max-width: 500px) {\n  .timeline-7-list .timeline-7-card {\n    width: 100%;\n    text-align: center;\n    transform: translateX(0%);\n    border-radius: var(--radius-xs) !important;\n  }\n  .timeline-7-list .timeline-7-card:nth-child(odd) {\n    transform: translateX(0%);\n    border: none;\n    border-top: 2px solid var(--primary);\n  }\n  .timeline-7-list .timeline-7-card:nth-child(even) {\n    border: none;\n    border-top: 2px solid var(--secondary);\n  }\n  .timeline-7-list .timeline-7-card .timeline-7-card__number {\n    left: 50% !important;\n    transform: translateX(-50%);\n  }\n}\n</style>\n\n",
