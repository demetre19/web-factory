---
/**
 * bm-contact-30 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (contact-30.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-contact-30__container">
      <div class="bm-contact-30__intro">
        <div class="bm-contact-30__top">
          {heading && <h1 class="text-fluid-4">{heading}</h1>}
        </div>
        {fs && <p class="text-fluid-0">{fs}</p>}
      </div>
      <div class="bm-contact-30-card">
        <div class="bm-contact-30-card__top">
          <div class="bm-social-share bm-social-share--left">
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="card">
                  <span data-icon="lucide" aria-hidden="true"></span>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="bm-contact-30-card__row card">
              <h2 class="text-fluid-2">{it.title}</h2>
              <p class="text-fluid-0">{it.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
