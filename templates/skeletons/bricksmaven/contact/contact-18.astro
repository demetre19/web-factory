---
/**
 * bm-contact-18 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (contact-18.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="contact-18-container">
      <div class="contact-18-content">
        <div class="intro contact-18-content__intro">
          {heading && <h2 class="text-fluid-2">{heading}</h2>}
          {fs && <p class="text-fluid-0">{fs}</p>}
        </div>
        <div class="contact-18-content__list-ul">
          <div class="contact-18-content__list-item">
            <span data-icon="lucide" aria-hidden="true"></span>
            <div class="contact-18-content__list-detail">
              <p class="mt-fluid-m"><a class="wf-cta-button" href={cta.href}>{cta.label || 'Continue'}</a></p>
            </div>
          </div>
          <div class="contact-18-content__list-item">
            <span data-icon="lucide" aria-hidden="true"></span>
            <div class="contact-18-content__list-detail"></div>
          </div>
        </div>
        <div class="contact-18-content__media">
          <figure class="contact-18-content__media-image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
      </div>
      <div>
        <form class="contact-18-form__content" novalidate>
        </form>
      </div>
    </div>
  </div>
