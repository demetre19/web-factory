              <span data-icon="lucide" aria-hidden="true"></span>
            </div>
          ))}
        </div>
      </div>
    </div>
    <figure class="ratio-portrait"><img src="/media/placeholder.svg" alt="Background Image" loading="lazy" width="900" height="600" /></figure>
  </div>
</div>
