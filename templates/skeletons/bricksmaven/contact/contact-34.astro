---
/**
 * bm-contact-34 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (contact-34.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-contact-34__container">
      <div class="bm-contact-34__content">
        {heading && <h2 class="text-fluid-2">{heading}</h2>}
        <div class="bm-contact-34__contact-data">
          <div class="bm-contact-widget bm-contact-34__widget-negative">
            <div class="bm-contact-widget__avatar-wrapper">
              <figure class="bm-contact-widget__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            </div>
            <div class="bm-contact-widget__footer">
              <div class="bm-contact-widget__notification">
                <div class="bm-contact-widget__dot"></div>
              </div>
            </div>
          </div>
          <div class="bm-contact-25-side-list-ul">
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="bm-contact-25-side-list-item bm-contact-25-side-list-item--alt card">
                  <div class="bm-contact-25-side-list-item__detail">
                    <a class="bm-contact-25-side-list-item__cta text-fluid-0" href={it.href}>{it.label}</a>
                  </div>
                  <span class="bm-contact-25-side-list-item__icon" data-icon="lucide" aria-hidden="true"></span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
      <div>
        <figure class="bm-contact-34__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
    </div>
  </div>
</div>
