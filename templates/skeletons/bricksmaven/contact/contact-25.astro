---
/**
 * bm-contact-25 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (contact-25.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="contact-25-container">
      <div class="intro">
        {heading && <h1 class="text-fluid-4">{heading}</h1>}
        {fs && <p class="text-fluid-0">{fs}</p>}
      </div>
      <div class="contact-25-content">
        <div class="contact-25-side">
          <div class="contact-25-side-intro"></div>
          <div class="contact-25-side-list-ul">
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="contact-25-side-list-item card">
                  <div class="contact-25-side-list-item__detail">
                    <h2 class="text-fluid-2">{it.title}</h2>
                    <p class="text-fluid-0">{it.text}</p>
                  </div>
                  <span class="contact-25-side-list-item__icon" data-icon="lucide" aria-hidden="true"></span>
                </div>
              ))}
            </div>
          </div>
          <div class="contact-25-side-social">
            <div class="contact-25-side-social__icon"></div>
          </div>
        </div>
        <div class="contact-25-form">
          <form novalidate>
          </form>
        </div>
      </div>
      <div class="contact-25-media">
        <figure class="contact-25-media__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
    </div>
  </div>
</div>
