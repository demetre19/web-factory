    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .contact-25-content {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    width: 100%;
    gap: var(--space-l);
  }

  .contact-25-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    row-gap: var(--space-l);
    background: var(--action-primary);
    padding: 3rem 3rem 3rem 3rem;
  }

  .contact-25-side-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    row-gap: var(--space-xs);
  }

  .contact-25-side-intro__title {
    font-size: var(--fs-2);
    font-weight: 500;
  }

  .contact-25-side-list-ul {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    row-gap: var(--space-s);
    width: 100%;
  }

  .contact-25-side-list-item {
    display: flex;
    align-items: flex-start;
    column-gap: 1.5rem;
  }

  .contact-25-side-list-item__detail {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .contact-25-side-list-item__title {
    font-size: var(--fs-1);
  }

  .contact-25-side-list-item__cta {
    padding: 0 0 0 0;
    margin: 1.5rem 0 0 0;
