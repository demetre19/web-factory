  }

  .contact-25-media {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }

  .contact-25-media__image {
    object-fit: cover;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

