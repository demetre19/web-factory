---
/**
 * bm-contact-23 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (contact-23.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="contact-23-container">
    <div class="contact-23-content">
      <div class="intro contact-23-content__intro">
        <h2 class="intro__heading">{heading}</h2>
        <p class="intro__subheading">{fs}</p>
      </div>
      <div class="contact-23-list-ul list--none">
        {items.map((it) => (
          <div class="contact-23-list-item">
            <span class="contact-23-list-item__icon" data-icon="lucide" aria-hidden="true"></span>
            <div class="contact-23-list-item__detail">
              <h2 class="contact-23-list-item__title">{it.title}</h2>
              <p class="contact-23-list-item__desc">{it.text}</p>
              <a class="contact-23-list-item__cta wf-cta-button" href={it.href}>{it.label}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="contact-23-form">
      <form class="contact-23-form__inner" novalidate>
      </form>
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .contact-23 {
    background: var(--action-primary);
  }

  .contact-23-container {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .contact-23-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    row-gap: var(--space-m);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .contact-23-content__intro {
    align-items: flex-start;
    text-align: left;
    row-gap: var(--space-xs);
  }

  .contact-23-list-ul {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-s);
    width: 100%;
  }

  .contact-23-list-item {
    display: flex;
    column-gap: 1rem;
  }

  .contact-23-list-item__detail {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    row-gap: var(--space-xs);
  }

  .contact-23-list-item__title {
    font-size: var(--fs-1);
  }

  .contact-23-list-item__cta {
    padding: 0 0 0 0;
    text-align: left;
    font-size: calc(var(--fs-1) - .4rem);
  }

  .contact-23-form__inner {
    padding: 3rem 0 3rem 0;
    gap: var(--space-s);
  }

  /* bm-custom */
  .contact-23-content__intro h2 {
  	font-size: var(--fs-4);
  }
</style>
