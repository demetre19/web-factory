                <span data-icon="lucide" aria-hidden="true"></span>
              </div>
              <div class="contact-3-card__content">
                <p class="text-fluid-0">{it.text}</p>
                <p class="text-fluid-0">{it.text}</p>
                <p class="text-fluid-0">{it.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="contact-3-footer">
        <div class="contact-3-form">
          <form novalidate>
          </form>
        </div>
        <div>
          <figure class="contact-3-media__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
