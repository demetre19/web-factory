---
/**
 * bm-contact-40 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (contact-40.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-contact-40__container">
      <div class="bm-contact-40__content">
        {heading && <h2 class="text-fluid-2">{heading}</h2>}
        <div class="bm-contact-40-media-card grid-auto gap-fluid-l">
          <figure class="bm-contact-40-media-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          <div class="bm-contact-40-contact-list">
            <div class="bm-contact-40-contact-item">
              <div class="bm-contact-40-contact-item__icon-wrapper">
                <span data-icon="lucide" aria-hidden="true"></span>
              </div>
              <div class="bm-contact-40-contact-item__content"></div>
            </div>
            <div class="bm-contact-40-contact-item">
              <div class="bm-contact-40-contact-item__icon-wrapper">
                <span data-icon="lucide" aria-hidden="true"></span>
              </div>
              <div class="bm-contact-40-contact-item__content"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="bm-contact-40__form-wrapper">
        <form novalidate>
        </form>
      </div>
    </div>
    <div>
      <div>
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="bm-hero-86-card card">
              <div class="bm-hero-86-card__thumb">
                <figure class="bm-hero-86-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
              <div class="bm-hero-86-card__content">
                <div class="bm-hero-86-card__top">
                  <p class="text-fluid-0">{it.text}</p>
                  <span data-icon="lucide" aria-hidden="true"></span>
                </div>
                <p class="bm-hero-86-card__review text-fluid-0">{it.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
