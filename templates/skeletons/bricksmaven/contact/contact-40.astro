---
/**
 * bm-contact-40 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (contact-40.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-contact-40__container">
    <div class="bm-contact-40__content">
      <h2 class="bm-contact-40__heading">{heading}</h2>
      <div class="bm-contact-40-media-card">
        <figure class="bm-contact-40-media-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        <div class="list--none bm-contact-40-contact-list">
          <div class="bm-contact-40-contact-item">
            <div class="bm-contact-40-contact-item__icon-wrapper">
              <span class="bm-contact-40-contact-item__icon" data-icon="lucide" aria-hidden="true"></span>
            </div>
            <div class="bm-contact-40-contact-item__content">
              <p class="bm-contact-40-contact-item__label">Call us</p>
              <p class="bm-contact-40-contact-item__link link--white">+00 123 456 7890</p>
            </div>
          </div>
          <div class="bm-contact-40-contact-item">
            <div class="bm-contact-40-contact-item__icon-wrapper">
              <span class="bm-contact-40-contact-item__icon" data-icon="lucide" aria-hidden="true"></span>
            </div>
            <div class="bm-contact-40-contact-item__content">
              <p class="bm-contact-40-contact-item__label">Email us</p>
              <p class="bm-contact-40-contact-item__link link--white">hello@maven.com</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="bm-contact-40__form-wrapper">
      <form class="bm-contact-40__form" novalidate>
      </form>
    </div>
  </div>
  <div class="bm-contact-40__review-container">
    <div class="bm-hero-86__slider-nested bm-contact-40__slider-visible">
      {items.map((it) => (
        <div class="bm-hero-86-card">
          <div class="bm-hero-86-card__thumb">
            <figure class="bm-hero-86-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
          <div class="bm-hero-86-card__content">
            <div class="bm-hero-86-card__top">
              <p class="bm-hero-86-card__social-handle">{it.text}</p>
              <span class="bm-hero-86-card__icon" data-icon="lucide" aria-hidden="true"></span>
            </div>
            <p class="bm-hero-86-card__review">{it.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
