---
/**
 * bm-contact-26 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (contact-26.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="contact-26-container">
      <div class="contact-26-content">
        <div class="intro contact-26-content__intro">
          {heading && <h2 class="text-fluid-2">{heading}</h2>}
          {fs && <p class="text-fluid-0">{fs}</p>}
        </div>
        <div class="contact-26-content-list-ul">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="contact-26-content-list-item card">
                <div class="contact-26-content-list-item__detail">
                  <h2 class="text-fluid-2">{it.title}</h2>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
                <span class="contact-26-content-list-item__icon" data-icon="lucide" aria-hidden="true"></span>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div>
        <form class="contact-26-form__content" novalidate>
        </form>
      </div>
    </div>
  </div>
</div>
