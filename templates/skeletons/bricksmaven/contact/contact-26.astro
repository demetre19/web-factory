interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="contact-26-container">
    <div class="contact-26-content">
      <div class="intro contact-26-content__intro">
        <h2 class="intro__heading">Leave us a Message</h2>
        <p class="intro__subheading">Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Aenean commodo ligula eget dolor. Aenean massa.</p>
        <p class="intro__accent-heading">Contact Us</p>
      </div>
      <div class="contact-26-content-list-ul list--none">
        {items.map((it) => (
          <div class="contact-26-content-list-item">
            <div class="contact-26-content-list-item__detail">
              <h2 class="contact-26-content-list-item__title">{it.title}</h2>
              <p class="contact-26-content-list-item__desc">{it.text}</p>
              <a class="contact-26-content-list-item__cta wf-cta-button" href={it.href}>{it.label}</a>
            </div>
            <span class="contact-26-content-list-item__icon" data-icon="lucide" aria-hidden="true"></span>
          </div>
        ))}
      </div>
    </div>
    <div class="contact-26-form">
      <form class="contact-26-form__content" novalidate>
      </form>
    </div>
  </div>
