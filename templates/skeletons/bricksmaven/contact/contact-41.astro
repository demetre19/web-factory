 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-contact-41__container">
    <div class="bm-contact-41__content">
      <h2 class="bm-contact-41__contact-heading">Don't hesitate to contact us</h2>
      <div class="bm-contact-41__contact">
        <div class="bm-contact-41__contact-data">
          <h2 class="bm-contact-41__heading">Contact</h2>
          <div class="bm-contact-41__column">
            <p class="bm-contact-41__address">Bricksmaven Streetname 12345 HG City name</p>
            <p class="bm-contact-41__links">+31 234 456 78 info@bricksmaven.com</p>
          </div>
        </div>
        <div class="bm-contact-41__social-media">
          <h2 class="bm-contact-41__heading">Social media</h2>
          <div class="bm-social-share list--none bm-social-share--left">
            {items.map((it) => (
              <div class="bm-social-share__icon-wrapper">
                <span class="bm-social-share__icon" data-icon="lucide" aria-hidden="true"></span>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="bm-contact-41-contact-list list--none">
        <div class="bm-contact-41-contact-card">
          <div class="bm-contact-41-contact-card__team-data">
