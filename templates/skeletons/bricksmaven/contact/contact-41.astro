              <p class="bm-contact-41-contact-card__text">For advice and new projects</p>
            </div>
          </div>
          <div class="bm-contact-41-contact-card__data">
            <a class="bm-contact-41-contact-card__text-link" href="#">info@bricksmaven.com</a>
            <a class="bm-contact-41-contact-card__text-link" href="#">+31 245 3456 56</a>
          </div>
        </div>
        <div class="bm-contact-41-contact-card">
          <div class="bm-contact-41-contact-card__team-data">
            <div class="bm-contact-41-contact-card__media">
              <figure class="bm-contact-41-contact-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            </div>
            <div class="bm-contact-41-contact-card__content">
              <p class="bm-contact-41-contact-card__title">Support</p>
              <p class="bm-contact-41-contact-card__text">Fast help for our clients</p>
            </div>
          </div>
          <div class="bm-contact-41-contact-card__data">
            <a class="bm-contact-41-contact-card__text-link" href="#">info@bricksmaven.com</a>
            <a class="bm-contact-41-contact-card__text-link" href="#">+31 245 3456 56</a>
          </div>
        </div>
      </div>
    </div>
    <div class="bm-contact-41__form-wrapper">
      <h2 class="bm-contact-41__form-heading">Send us a message. We respond pretty quick!</h2>
      <form class="bm-contact-40__form" novalidate>
      </form>
    </div>
  </div>
</div>

<style is:global>
@layer components {
  .bm-contact-41 {
