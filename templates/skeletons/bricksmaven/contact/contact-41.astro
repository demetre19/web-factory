    flex-wrap: nowrap;
    background: var(--bg-canvas);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
  }

  /* bm-custom */
  .bm-contact-41::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0;
    inline-size: 65%;
    block-size: 50vh;
    background-color: var(--fs-0);
    z-index: -1;
    
  }
  
  @media (max-width:767px) {
    .bm-contact-41::before {
    inline-size: 100vw;
    
  }
  }

  /* bm-custom */
  .bm-contact-41-contact-card:not(:last-child) {
