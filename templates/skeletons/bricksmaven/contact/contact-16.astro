---
/**
 * bm-contact-16 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (contact-16.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="contact-16-container">
    <div class="contact-16-content">
      <div class="intro contact-16-content__intro">
        <h2 class="intro__heading">{heading}</h2>
        <p class="intro__subheading">{fs}</p>
        <p class="intro__accent-heading">Contact Us</p>
      </div>
      <div class="contact-16-content__list-ul list--none">
        {items.map((it) => (
          <div class="contact-16-content__list-item">
            <span class="contact-16-content__list-icon" data-icon="lucide" aria-hidden="true"></span>
            <div class="contact-16-content__list-detail">
              <h2 class="contact-16-content__list-title">{it.title}</h2>
              <p class="contact-16-content__list-desc">{it.text}</p>
              <a class="contact-16-content__list-cta wf-cta-button" href={it.href}>{it.label}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="contact-16-media">
      <figure class="contact-16-media__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .contact-16-container {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }

  .contact-16-content {
    display: flex;
    z-index: 1;
    background: var(--bg-canvas);
    padding: var(--space-l) var(--space-m) var(--space-l) var(--space-m);
    flex-direction: column;
    align-self: center;
    row-gap: var(--space-l);
    /* bm: box-shadow omitted — token layer owns elevation */
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .contact-16-content__intro {
    align-items: flex-start;
    text-align: left;
    row-gap: var(--space-xs);
  }

  .contact-16-content__list-ul {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-m) var(--space-xs);
  }

  .contact-16-content__list-item {
    display: flex;
    column-gap: 1rem;
  }

  .contact-16-content__list-detail {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    row-gap: var(--space-xs);
  }

  .contact-16-content__list-title {
    font-size: var(--fs-1);
  }

  .contact-16-content__list-cta {
    padding: 0 0 0 0;
    text-align: left;
    font-size: calc(var(--fs-1) - .4rem);
  }

  .contact-16-media__image {
    object-fit: cover;
    height: 100%;
    width: 100%;
  }
</style>
