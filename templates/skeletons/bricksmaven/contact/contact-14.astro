---
/**
 * bm-contact-14 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (contact-14.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="contact-14-container">
    <div class="intro">
      <h2 class="intro__heading">{heading}</h2>
      <p class="intro__subheading">{fs}</p>
    </div>
    <div class="contact-14-list-ul list--none">
      {items.map((it) => (
        <div class="contact-14-list-item">
          <h2 class="contact-14-list-item__title">{it.title}</h2>
          <p class="contact-14-list-item__desc">{it.text}</p>
          <a class="contact-14-list-item__cta btn--outline" href={it.href}>{it.label}</a>
          <div class="contact-14-list-item__media">
            <figure class="contact-14-list-item__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .contact-14 {
    position: relative;
  }

  .contact-14-container {
    row-gap: var(--space-xl);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .contact-14-list-ul {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }

  .contact-14-list-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    row-gap: var(--space-s);
    padding: 0 var(--space-l) 0 var(--space-l);
    position: relative;
  }

  .contact-14-list-item__desc {
    text-align: center;
  }

  .btn--outline {
    border-top: .1rem solid var(--action-primary);
    border-right: .1rem solid var(--action-primary);
    border-bottom: .1rem solid var(--action-primary);
    border-left: .1rem solid var(--action-primary);
  }

  .contact-14-list-item__image {
    object-fit: cover;
    width: 19rem;
    height: 19rem;
    overflow: hidden;
    border-radius: 50% 50% 50% 50%;
  }

  /* bm-custom */
  .contact-14::before {
  	content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 45%;
    background-color: #F2F2F2;
  }

  /* bm-custom */
  .contact-14-list-item:not(:last-child)::after {
  	content: '';
    position: absolute;
    width: .1rem;
    height: 100%;
    background-color: #C7C7C7;
    right: 0;
  }
</style>
