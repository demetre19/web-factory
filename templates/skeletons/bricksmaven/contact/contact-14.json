     "left": "var(--space-l)"
    },
    "_position": "relative",
    "_cssCustom": ".contact-14-list-item:not(:last-child)::after {\n\tcontent: '';\n  position: absolute;\n  width: .1rem;\n  height: 100%;\n  background-color: #C7C7C7;\n  right: 0;\n}",
