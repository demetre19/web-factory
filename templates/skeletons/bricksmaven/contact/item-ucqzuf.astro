    row-gap: var(--space-l);
    text-align: center;
    align-items: center;
  }

  .contact-4-details {
    display: flex;
    flex-direction: column;
    row-gap: var(--space-s);
    align-items: center;
  }

  .contact-4-tel-email {
    display: flex;
    flex-direction: row;
    column-gap: var(--space-s);
  }

  .contact-4-tel-email-btn {
    width: 26rem;
    display: flex;
    padding: var(--space-xs) var(--space-xs) var(--space-xs) var(--space-xs);
    background: color-mix(in srgb, var(--bg-subtle) 40%, transparent);
    align-items: center;
    column-gap: var(--space-xs);
  }

  .cta-combo {
    display: flex;
    align-items: center;
    column-gap: var(--space-xs);
  }

  .btn--primary {
    padding: 1.25rem 1.875rem 1.25rem 1.875rem !important;
    width: auto;
  }

  .btn--outline {
    border-top: .1rem solid var(--action-primary);
    border-right: .1rem solid var(--action-primary);
    border-bottom: .1rem solid var(--action-primary);
    border-left: .1rem solid var(--action-primary);
  }

  .contact-4-media {
    align-items: center;
  }

  .contact-4-media__image {
    height: 34.7rem;
    width: 54rem;
    object-fit: cover;
  }
