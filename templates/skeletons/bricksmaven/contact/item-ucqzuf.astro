---

<div>
  <div class="contact-4-container">
    <div class="contact-4-details">
      <h2 class="contact-4-details__heading">Contact with us</h2>
      <p class="contact-4-details__desc">Lorem ipsum dolor sit amet, consectetuer adipiscing elit.</p>
      <div class="contact-4-tel-email">
        <div class="contact-4-tel-email-btn">
          <span class="contact-4-tel-email-btn__icon" data-icon="lucide" aria-hidden="true"></span>
          <p class="contact-4-tel-email-btn__text">+32 465 45 37 15</p>
        </div>
        <div class="contact-4-tel-email-btn">
          <span class="contact-4-tel-email-btn__icon text--primary" data-icon="lucide" aria-hidden="true"></span>
          <p class="contact-4-tel-email-btn__text">support@bricksmaven.com</p>
        </div>
      </div>
      <div class="cta-combo">
        <a class="btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
        <p class="cta-combo__text">OR</p>
        <a class="btn--primary btn--outline" href={cta.href}>{cta.label}</a>
      </div>
    </div>
    <div class="contact-4-media">
      <figure class="contact-4-media__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
