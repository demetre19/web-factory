---
/**
 * bm-contact-29 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (contact-29.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-contact-29__container">
      <div class="bm-contact-29__content">
        <div>
          {heading && <h1 class="bm-contact-29__heading text-fluid-4">{heading}</h1>}
        </div>
        <div class="bm-contact-29-contact-details">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="bm-contact-29-row card">
                <h2 class="bm-contact-29-row__heading text-fluid-2">{it.title}</h2>
                <div class="bm-contact-29-row__footer">
                  <p class="bm-contact-29-row__text text-fluid-0">{it.text}</p>
                  <div>
                    <p class="text-fluid-0">{it.text}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div>
        <figure class="bm-contact-29__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
    </div>
  </div>
</div>
