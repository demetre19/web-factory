          <h2 class="contact-2-sales-card__name">Jane Doe</h2>
          <p class="contact-2-sales-card__title">Sales</p>
          <div class="contact-2-sales-card__contact-information">
            <p class="contact-2-sales-card__tel-mail">+32 465 45 37 15</p>
            <p class="contact-2-sales-card__tel-mail">hi@bricksmaven.com</p>
          </div>
          <div class="contact-2-sales-card__media">
            <figure class="contact-2-sales-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
        <div class="contact-2-sales-card">
          <h2 class="contact-2-sales-card__name">Jane Doe</h2>
          <p class="contact-2-sales-card__title">Senior Consultant</p>
          <div class="contact-2-sales-card__contact-information flex--col">
