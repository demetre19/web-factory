            <figure class="contact-2-sales-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      </div>
      <div class="contact-form">
        <h2 class="contact-form__heading">Do you have a question for us? Don’t hesitate and send us a mail</h2>
        <form class="contact-form__fields" novalidate>
        </form>
      </div>
    </div>
    <div class="contact-aside">
      <h2 class="contact-aside__heading">Contact</h2>
      <div class="contact-aside-list list--none">
        {items.map((it) => (
          <div class="contact-aside-list-item">
            <span class="contact-aside-list-item__icon" data-icon="lucide" aria-hidden="true"></span>
            <p class="contact-aside-list-item__text">{it.text}</p>
