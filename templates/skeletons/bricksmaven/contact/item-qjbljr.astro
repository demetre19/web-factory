             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="contact-6-container">
    <div class="contact-6-details">
      <p class="contact-6-details__accent-heading">Have a question?</p>
      <h2 class="contact-6-details__heading">Let’s talk!</h2>
      <div class="contact-6-ul-list list--none">
        {items.map((it) => (
          <div class="contact-6-list">
            <span class="contact-6-list__icon" data-icon="lucide" aria-hidden="true"></span>
            <p class="contact-6-list__text">{it.text}</p>
          </div>
        ))}
