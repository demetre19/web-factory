---
/**
 * bm-item-gouojh — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (item-gouojh.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="contact-10-container">
      <div>
        <figure class="contact-10-map__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
      <div class="contact-10-content">
        <div class="contact-10-intro">
          {heading && <h2 class="contact-10-intro__heading text-fluid-2">{heading}</h2>}
          {fs && <p class="text-fluid-0">{fs}</p>}
        </div>
        <div class="contact-10-information-grid-ul">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="contact-10-info-card card">
                <div class="contact-10-info-card__content">
                  <h2 class="text-fluid-2">{it.title}</h2>
                  <p class="text-fluid-0">{it.text}</p>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
                <span class="contact-10-info-card__icon" data-icon="lucide" aria-hidden="true"></span>
              </div>
            ))}
          </div>
          <div class="contact-10-info-card">
            <div class="contact-10-info-card__content"></div>
            <span class="contact-10-info-card__icon" data-icon="lucide" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
