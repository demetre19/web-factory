---
/**
 * bm-contact-24 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (contact-24.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="contact-24-container">
    <div class="intro">
      <h1 class="intro__heading">We’d love to hear from you</h1>
      <p class="intro__subheading">Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Aenean commodo ligula eget dolor. Aenean massa.</p>
      <p class="intro__accent-heading">Contact Us</p>
    </div>
    <div class="contact-24-list-ul list--none">
      {items.map((it) => (
        <div class="contact-24-list-card">
          <h2 class="contact-24-list-card__title">{it.title}</h2>
          <p class="contact-24-list-card__desc">{it.text}</p>
          <a class="contact-24-list-card__cta btn--primary wf-cta-button" href={it.href}>{it.label}</a>
        </div>
      ))}
    </div>
    <div class="contact-24-media">
      <figure class="contact-24-media__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
    </div>
  </div>
</div>

<style is:global>
@layer components {
  .contact-24-container {
    row-gap: var(--space-l);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .contact-24-list-ul {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-m);
  }

  .contact-24-list-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    row-gap: var(--space-m);
    padding: 4rem 2.5rem 4rem 2.5rem;
    border-top: .1rem solid var(--bg-subtle);
    border-right: .1rem solid var(--bg-subtle);
    border-bottom: .1rem solid var(--bg-subtle);
    border-left: .1rem solid var(--bg-subtle);
  }

  .btn--primary {
    padding: 1.25rem 1.875rem 1.25rem 1.875rem !important;
    width: auto;
  }

  .contact-24-media {
    width: 100%;
  }

  .contact-24-media__image {
    object-fit: cover;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* bm-custom */
  .contact-24-list-card:nth-child(1) {
  	grid-column: span 6;
  }
  .contact-24-list-card:nth-child(2) {
  	grid-column: span 6;
  }
}
</style>
