---
/**
 * bm-contact-35 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (contact-35.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-contact-35__container">
      <div class="bm-contact-35__content">
        {heading && <h2 class="text-fluid-2">{heading}</h2>}
        {fs && <p class="text-fluid-0">{fs}</p>}
        <div class="bm-contact-widget bm-contact-widget--inline">
          <div class="bm-contact-widget__avatar-wrapper">
            <figure class="bm-contact-widget__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
          <div class="bm-contact-widget__footer">
            <div class="bm-contact-widget__notification">
              <div class="bm-contact-widget__dot"></div>
            </div>
          </div>
        </div>
        <div class="bm-contact-25-side-list-ul">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="bm-contact-25-side-list-item card">
                <div class="bm-contact-25-side-list-item__detail">
                  <a class="bm-contact-25-side-list-item__cta text-fluid-0" href={it.href}>{it.label}</a>
                </div>
                <span class="bm-contact-25-side-list-item__icon" data-icon="lucide" aria-hidden="true"></span>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div>
        <div>
          <div class="bm-contact-tab__tab-menu">
            <div></div>
            <div></div>
          </div>
          <div>
            <div>
              <form novalidate>
              </form>
            </div>
            <div>
              <div class="accordion-4-main">
                <div class="grid-auto gap-fluid-m">
                  {(items || []).map((it) => (
                    <div class="accordion-4-item card">
                      <div class="accordion-4-head">
                        <p class="accordion-4-head__title text-fluid-0">{it.text}</p>
                        <div class="accordion-4-head__icon">
                          <span data-icon="lucide" aria-hidden="true"></span>
                          <span data-icon="lucide" aria-hidden="true"></span>
                        </div>
                      </div>
                      <div class="accordion-4-body">
                        <p class="accordion-4-body__content text-fluid-0">{it.text}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
