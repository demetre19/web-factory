              <button class="flyout-open" type="button" aria-label="Open panel"><span aria-hidden="true">&#9776;</span></button>
            </div>
            <div class="flyout" role="dialog" aria-modal="true">
              <div class="bm-product-archive-off-canvas__content">
                {list.length > 0 &&                 <div class="bm-product-archive-2__filter-container">
                  {list.length > 0 && <div class="nav-group">{(list || []).map((it) => (
                      <div class="bm-product-archive__filter-row card">
                        {it.icon && <IconChip name={it.icon} />}
                        <h4 class="text-fluid-1">{it.term || it.title}</h4>
                      </div>
                    ))}</div>}
                </div>
                }
                <button class="flyout-close" type="button" aria-label="Close">&times;</button>
              </div>
            </div>
          </div>
        </div>
        {image &&         <div class="bm-product-archive__product-list">
          {image &&           <div class="product-list-1-card grid-auto gap-fluid-l">
