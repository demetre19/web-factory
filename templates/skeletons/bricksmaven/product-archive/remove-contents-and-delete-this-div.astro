---

<div class="wf-remove-contents-and-delete-this-div">
  <div>
    <div class="sec-inner">
      <div class="bm-product-archive-4__header-container">
        {head && <h1 class="text-fluid-4">{head}</h1>}
        {sub && <p class="text-fluid-0" set:html={inline(sub)} />}
