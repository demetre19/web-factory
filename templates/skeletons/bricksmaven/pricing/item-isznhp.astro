 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="pricing-5-container gap--l">
    <div class="intro">
      <h2 class="intro__heading">{heading}</h2>
      <p class="intro__subheading">{fs}</p>
      <div class="cta-combo">
        <a class="btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
        <p class="cta-combo__text">OR</p>
        <a class="btn--primary btn--outline" href={cta.href}>{cta.label}</a>
      </div>
      <p class="intro__accent-heading">Pricing tagline</p>
    </div>
    <div class="pricing-5-content">
      <div class="pricing-5-price-box">
        <div class="pricing-5-intro">
          <div class="pricing-5-intro__price-wrapper">
            <p class="pricing-5-intro__price">$0</p>
            <span class="pricing-5-intro__price-icon" data-icon="lucide" aria-hidden="true"></span>
          </div>
          <p class="pricing-5-intro__price-desc">Change the color to match your brand or vision, add your logo, choose the perfect thumbnail, remove the playbar</p>
        </div>
        <div class="bm-ul-benefits list--none">
          {items.map((it) => (
            <div class="bm-li-benefits">
              <span class="bm-li-benefits__icon" data-icon="lucide" aria-hidden="true"></span>
              <p class="bm-li-benefits__text">{it.text}</p>
            </div>
          ))}
        </div>
        <div class="pricing-5-cta">
          <a class="btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
          <a class="pricing-5-cta__btn--link" href={cta.href}>{cta.label}</a>
        </div>
      </div>
      <div class="pricing-5-price-box">
        <div class="pricing-5-intro gap--xs flex--col">
          <div class="pricing-5-intro__price-wrapper flex--row justify-content--between">
            <p class="pricing-5-intro__price text--700 text--xxl">$99/year</p>
            <span class="pricing-5-intro__price-icon" data-icon="lucide" aria-hidden="true"></span>
          </div>
          <p class="pricing-5-intro__price-desc">Change the color to match your brand or vision, add your logo, choose the perfect thumbnail, remove the playbar</p>
        </div>
        <div class="bm-ul-benefits list--none">
          {items.map((it) => (
            <div class="bm-li-benefits">
              <span class="bm-li-benefits__icon" data-icon="lucide" aria-hidden="true"></span>
              <p class="bm-li-benefits__text">{it.text}</p>
            </div>
          ))}
        </div>
        <div class="pricing-5-cta">
          <a class="btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
          <a class="pricing-5-cta__btn--link" href={cta.href}>{cta.label}</a>
        </div>
      </div>
    </div>
  </div>
</div>

