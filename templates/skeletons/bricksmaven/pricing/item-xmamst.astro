---
/**
 * bm-item-xmamst — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (item-xmamst.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="pricing-4-container">
    <div class="intro">
      <h2 class="intro__heading">{heading}</h2>
      <p class="intro__subheading">{fs}</p>
      <div class="cta-combo">
        <a class="btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
        <p class="cta-combo__text">OR</p>
        <a class="btn--primary btn--outline" href={cta.href}>{cta.label}</a>
      </div>
      <p class="intro__accent-heading">Pricing tagline</p>
    </div>
    <div class="pricing-4-price-cards">
      <div class="pricing-4-card">
        <p class="pricing-4-card__label">Personal</p>
        <p class="pricing-4-card__price">$99/mo</p>
        <p class="pricing-4-card__benefit">Change the color to match your brand or vision, add your logo, choose the perfect thumbnail, remove the playbar</p>
        <a class="btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
      </div>
      <div class="pricing-4-card">
        <p class="pricing-4-card__label">Untitled</p>
        <p class="pricing-4-card__price text--700 text--xxl">$129/mo</p>
        <p class="pricing-4-card__benefit">Change the color to match your brand or vision, add your logo, choose the perfect thumbnail, remove the playbar</p>
        <a class="pricing-4-card__benefit btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
      </div>
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .pricing-4 {
    display: flex;
    justify-content: center;
  }

  .pricing-4-container {
    display: flex;
    row-gap: var(--space-m);
    flex-direction: column;
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .cta-combo {
    display: flex;
    align-items: center;
    column-gap: var(--space-xs);
  }

  .btn--primary {
    padding: 1.25rem 1.875rem 1.25rem 1.875rem !important;
    width: auto;
  }

  .btn--outline {
    border-top: .1rem solid var(--action-primary);
    border-right: .1rem solid var(--action-primary);
    border-bottom: .1rem solid var(--action-primary);
    border-left: .1rem solid var(--action-primary);
  }

  .pricing-4-price-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    position: relative;
    width: 100%;
  }

  .pricing-4-card {
    display: flex;
    row-gap: var(--space-s);
    flex-direction: column;
    align-items: center;
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
  }

  .pricing-4-card__price {
    font-weight: 700;
    font-size: var(--fs-4);
  }

  .pricing-4-card__benefit {
    text-align: center;
  }

  /* bm-custom */
  .pricing-4-card:nth-child(2n+1) {
  border-right: 0.2rem solid var(--acss-bricks-border-color);
  }

  /* bm-custom */
  .pricing-4-card__price span {
  	font-size: var(--fs-1)
  }
</style>
