  .bm-pricing-14-card__left-column {
    width: auto;
  }

  .bm-pricing-14-card__plan-wrapper {
    display: flex;
    flex-direction: row;
    width: 100%;
    column-gap: var(--flow-spacing);
  }

  .bm-pricing-14-card__plan {
    font-weight: 700;
  }

  .bm-pricing-14-card__label-wrapper {
    display: flex;
    justify-content: center;
    padding: 0 var(--space-xs) 0 var(--space-xs);
    background: var(--bg-subtle);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
  }

  .bm-pricing-14-card__label {
    font-size: var(--fs-0);
  }

  .bm-pricing-14-card__meta-copy {
    font-size: var(--fs-0);
  }

  .bm-pricing-14-card__right-column {
    width: auto;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: baseline;
  }

  .bm-pricing-14-card__price {
    font-size: var(--fs-4);
    font-weight: 700;
  }

  .bm-pricing-14-card__price-span {
    font-size: var(--fs-1);
    font-weight: 700;
  }

  .bm-pricing-14-card__feature-text {
    font-size: var(--fs-2);
