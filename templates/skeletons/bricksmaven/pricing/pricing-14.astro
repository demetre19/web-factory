    flex-direction: row;
    column-gap: var(--flow-spacing);
    row-gap: var(--flow-spacing);
    padding: 0 0 var(--space-m) 0;
    border-bottom: 1 solid var(--bg-subtle);
  }

  .bm-list {
    display: flex;
    flex-direction: column;
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-list-item {
    flex-direction: row;
    display: flex;
    align-items: center;
    column-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-list-item__icon-wrapper {
    padding: var(--tap) var(--tap) var(--tap) var(--tap);
