    border-bottom: 1 solid var(--color-line-default);
    border-left: 1 solid var(--color-line-default);
  }

  .bm-pricing-14-card__top {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding: 0 0 var(--space-xs) 0;
    border-bottom: 1 solid var(--bg-subtle);
