    "code": "<script>\nconst wcToggleCt = document.querySelector('.pricing-3-toggle__switch'),\n  wcToggleSwitch = document.querySelector('.pricing-3-toggle__switch-state'),\n  wcPricingFstTag = document.querySelector('.pricing-3-toggle__label.monthly'),\n  wcPricingsndTag = document.querySelector('.pricing-3-toggle__label.yearly'),\n\twcPricingFstCt =  document.querySelector('.pricing-3-price.monthly'),\n\twcPricingSndCt =  document.querySelector('.pricing-3-price.yearly');\n\n  wcToggleCt.addEventListener('click', function() {\n    wcToggleSwitch.classList.toggle('active');\n    wcPricingFstTag.classList.toggle('active');\n    wcPricingsndTag.classList.toggle('active');\n    wcPricingFstCt.classList.toggle('hide');\n    wcPricingSndCt.classList.toggle('hide');\n  });\n</script>",
