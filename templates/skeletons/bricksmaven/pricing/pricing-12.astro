              <p class="bm-pricing-12-card__content-text">{it.text}</p>
            </div>
            <div class="bm-list list--none">
              {(it.items || []).map((it2) => (
                <div class="bm-list-item">
                  <div class="bm-list-item__icon-wrapper">
                    <span class="bm-list-item__icon" data-icon="lucide" aria-hidden="true"></span>
                  </div>
                  <p class="bm-list-item__text">{it2.text}</p>
                </div>
              ))}
            </div>
          </div>
          <div class="bm-cta-combo">
            <a class="btn--primary" href="#">{it.text}</a>
            <a class="btn--primary btn--outline" href="#">{it.text}</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

