            <div class="bm-pricing-12-card__top">
              <h1 class="bm-pricing-12-card__heading">{it.title}</h1>
              <div class="bm-pricing-12-card__label-wrapper">
                <p class="bm-pricing-12-card__label">{it.text}</p>
              </div>
            </div>
            <div class="bm-pricing-12-card__price-wrapper">
              <p class="bm-pricing-12-card__price">{it.text}</p>
              <p class="bm-pricing-12-card__attachment">{it.text}</p>
