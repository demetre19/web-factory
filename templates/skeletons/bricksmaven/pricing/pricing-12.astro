---
/**
 * bm-pricing-12 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (pricing-12.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-pricing-12__container">
      <div class="intro intro--split">
        <div class="intro__left-column">
          {heading && <h2 class="text-fluid-2">{heading}</h2>}
        </div>
        <div class="intro__right-column">
          {fs && <p class="text-fluid-0">{fs}</p>}
        </div>
      </div>
      <div class="bm-pricing-12-price-options">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="bm-pricing-12-card card">
              <div class="bm-pricing-12-card__intro">
                <div class="bm-pricing-12-card__top">
                  <h1 class="text-fluid-4">{it.title}</h1>
                  <div class="bm-pricing-12-card__label-wrapper">
                    <p class="text-fluid-0">{it.text}</p>
                  </div>
                </div>
                <div class="bm-pricing-12-card__price-wrapper">
                  <p class="text-fluid-0">{it.text}</p>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
                <p class="text-fluid-0">{it.text}</p>
              </div>
              <div class="bm-pricing-12-card__content">
                <div>
                  <h4 class="text-fluid-2">{it.title}</h4>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
                <div class="bm-list">
                  <div class="grid-auto gap-fluid-m">
                    {((it.items || []) || []).map((it2) => (
                      <div class="bm-list-item card">
                        <div class="bm-list-item__icon-wrapper">
                          <span data-icon="lucide" aria-hidden="true"></span>
                        </div>
                        <p class="text-fluid-0">{it2.text}</p>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
              <div class="bm-cta-combo">
                <a class="btn--primary text-fluid-0" href={it.href}>{it.label}</a>
                <a class="btn--primary text-fluid-0" href={it.href}>{it.label}</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
