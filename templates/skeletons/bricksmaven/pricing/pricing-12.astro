        <p class="intro__accent-heading">Tagline</p>
      </div>
      <div class="intro__right-column">
        <p class="intro__subheading">{fs}</p>
        <a class="btn--primary" href="#">Call to action</a>
      </div>
    </div>
    <div class="bm-pricing-12-price-options list--none">
      {items.map((it) => (
        <div class="bm-pricing-12-card">
