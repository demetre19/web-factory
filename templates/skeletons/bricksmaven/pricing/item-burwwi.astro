---
/**
 * bm-item-burwwi — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (item-burwwi.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="pricing-9-container">
    <div class="intro">
      <h2 class="intro__heading">{heading}</h2>
      <p class="intro__subheading">{fs}</p>
      <div class="cta-combo">
        <a class="btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
        <p class="cta-combo__text">OR</p>
        <a class="btn--primary btn--outline" href={cta.href}>{cta.label}</a>
      </div>
      <p class="intro__accent-heading">Pricing tagline</p>
    </div>
    <div class="pricing-9-content">
      {items.map((it) => (
        <div class="pricing-9-card">
          <div class="pricing-9-card__box">
            <h2 class="pricing-9-card__heading">{it.title}</h2>
            <p class="pricing-9-card__price">{it.text}</p>
            <p class="pricing-9-card__desc">{it.text}</p>
            <a class="pricing-9-card__cta btn--primary wf-cta-button" href={it.href}>{it.label}</a>
          </div>
          <div class="pricing-9-card__media">
            <figure class="pricing-9-card__img"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .pricing-9-container {
    display: flex;
    row-gap: var(--space-l);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .cta-combo {
    display: flex;
    align-items: center;
    column-gap: var(--space-xs);
  }

  .btn--primary {
    padding: 1.25rem 1.875rem 1.25rem 1.875rem !important;
    width: auto;
  }

  .btn--outline {
    border-top: .1rem solid var(--action-primary);
    border-right: .1rem solid var(--action-primary);
    border-bottom: .1rem solid var(--action-primary);
    border-left: .1rem solid var(--action-primary);
  }

  .pricing-9-content {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-s);
  }

  .pricing-9-card {
    flex-direction: column;
    display: flex;
  }

  .pricing-9-card__box {
    display: flex;
    row-gap: var(--space-s);
    flex-direction: column;
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    height: 100%;
  }

  .pricing-9-card__heading {
    font-size: var(--space-xs);
    font-weight: 400;
  }

  .pricing-9-card__price {
    font-size: var(--fs-4);
    font-weight: 700;
  }

  .pricing-9-card__cta {
    margin: auto 0 0 0;
  }

  .pricing-9-card__media {
    width: 100%;
    overflow: hidden;
    position: relative;
    height: 100%;
  }

  .pricing-9-card__img {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  /* bm-custom */
  .pricing-9-card {
    box-shadow: var(--shadow-card); 
  }
</style>
