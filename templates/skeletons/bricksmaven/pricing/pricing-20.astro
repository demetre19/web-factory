 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-pricing-20__container">
    <div class="intro intro--left">
      <h2 class="intro__heading">{heading}</h2>
      <p class="intro__subheading">{fs}</p>
      <p class="intro__accent-heading">Tagline</p>
    </div>
    <div class="bm-pricing-20__pricing-wrapper">
      <div class="bm-pricing-20-feature-list list--none">
        {items.map((it) => (
          <div class="bm-pricing-20-feature-card">
            <h2 class="bm-pricing-20-feature-card__heading">{it.title}</h2>
            <p class="bm-pricing-20-feature-card__text">{it.text}</p>
          </div>
        ))}
      </div>
      <div class="bm-pricing-20-pricing-card">
        <div class="bm-pricing-20-pricing-card__top">
          <p class="bm-pricing-20-card__pricing">$129</p>
          <div class="bm-list list--none">
            {items.map((it) => (
              <div class="bm-list-item">
                <div class="bm-list-item__icon-wrapper">
                  <span class="bm-list-item__icon" data-icon="lucide" aria-hidden="true"></span>
                </div>
                <p class="bm-list-item__text">{it.text}</p>
              </div>
            ))}
          </div>
          <p class="bm-pricing-20-card__text">Try free for 14 days, no credit card required</p>
        </div>
        <div class="bm-pricing-20-card__cta-wrapper">
          <a class="btn--black wf-cta-button" href={cta.href}>{cta.label}</a>
        </div>
      </div>
    </div>
  </div>
</div>

