---
/**
 * bm-item-sivzmx — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (item-sivzmx.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="pricing-7-container gap--l">
    <div class="intro">
      <h2 class="intro__heading">{heading}</h2>
      <p class="intro__subheading">{fs}</p>
      <p class="intro__accent-heading">Pricing tagline</p>
    </div>
    <div class="pricing-7-content">
      {items.map((it) => (
        <div class="pricing-7-card">
          <h3 class="pricing-7-card__heading">{it.title}</h3>
          <div class="bm-ul-benefits list--none">
            {(it.items || []).map((it2) => (
              <div class="bm-li-benefits">
                <span class="bm-li-benefits__icon" data-icon="lucide" aria-hidden="true"></span>
                <p class="bm-li-benefits__text">{it2.text}</p>
              </div>
            ))}
          </div>
          <p class="pricing-7-card__price">{it.text}</p>
          <a class="btn--primary wf-cta-button" href={it.href}>{it.label}</a>
          <span class="pricing-7-card__icon" data-icon="lucide" aria-hidden="true"></span>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .pricing-7-content {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: 100%;
    gap: var(--space-m);
  }

  .pricing-7-card {
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    padding: var(--space-l) var(--space-l) var(--space-l) var(--space-l);
    flex-direction: column;
  }

  .bm-li-benefits {
    display: flex;
    align-items: center;
    column-gap: var(--space-xs);
  }

  .pricing-7-card__price {
    font-size: var(--space-l);
    font-weight: 700;
  }

  .btn--primary {
    padding: 1.25rem 1.875rem 1.25rem 1.875rem !important;
    width: auto;
  }

  /* bm-custom */
  .pricing-7-card:nth-child(2) {
  
  	box-shadow: var(--shadow-card);
  
  }
</style>
