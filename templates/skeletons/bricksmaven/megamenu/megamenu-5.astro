---
/**
 * bm-megamenu-5 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (megamenu-5.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-header-1__container">
      <div class="bm-header-1__brand">
        <span class="logo">{brand}</span>
      </div>
      <div class="bm-header-1__nav-wrapper">
        <div>
          <div>
            <div>
              <div class="megamenu-5__content">
                <div class="megamenu-5__column">
                  <div class="megamenu-5__card-wrapper">
                    <div class="grid-auto gap-fluid-m">
                      {(items || []).map((it) => (
                        <div class="megamenu-card-link-3 card">
                          <div>
                            <a class="text-fluid-0" href={it.href}>{it.label}</a>
                            <p class="text-fluid-0">{it.text}</p>
                          </div>
                          <div class="megamenu-card-link-3__icon-wrapper">
                            <span data-icon="lucide" aria-hidden="true"></span>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
                <div class="megamenu-5__article-wrapper">
                  {heading && <h2 class="text-fluid-2">{heading}</h2>}
                  <div class="megamenu-article-list">
                    <div class="megamenu-article-card">
                      <div class="megamenu-article-card__content">
                        <div class="megamenu-article-card__top"></div>
                        {fs && <p class="text-fluid-0">{fs}</p>}
                      </div>
                      <div>
                        <figure class="megamenu-article-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                      </div>
                    </div>
                    <div class="megamenu-article-card">
                      <div class="megamenu-article-card__content">
                        <div class="megamenu-article-card__top"></div>
                      </div>
                      <div>
                        <figure class="megamenu-article-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div></div>
          </div>
          <div></div>
        </div>
      </div>
      <div class="bm-header-1__cta"></div>
    </div>
  </div>
</div>
