---
/**
 * bm-cart-page-2 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (cart-page-2.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="cart-page-2__container">
    <div class="cart-page-2__intro">
      <h2 class="cart-page-2__heading">{heading}</h2>
    </div>
    <div class="bm-woo-notice-container">
      <div class="bm-woo-notice"></div>
    </div>
    <div>
      <p>{fs}</p>
    </div>
    <div class="cart-page-2__cart-container">
      <div class="cart-page-2__card-container">
        <div class="cart-page-2__cart-items"></div>
        <div class="cart-page-2-testimonial-card">
          <div class="cart-page-2-testimonial-card__client">
            <div class="cart-page-2-testimonial-card__content">
              <p class="cart-page-2-testimonial-card__name">John Smith</p>
              <p class="cart-page-2-testimonial-card__role">Title here</p>
            </div>
            <figure class="cart-page-2-testimonial-card__avatar"><img src="/media/placeholder.svg" alt="Avatar" loading="lazy" width="900" height="600" /></figure>
          </div>
          <p class="cart-page-2-testimonial-card__text">"Here goes your text ... Select any part of your text to access the formatting toolbar."</p>
        </div>
        <div>
          <p>{do_action:woocommerce_before_cart_collaterals}</p>
        </div>
      </div>
      <div class="cart-page-2__cart-totals-container">
        <div class="cart-page-2__cart-totals"></div>
      </div>
    </div>
    <div>
      <p>{do_action:woocommerce_after_cart}</p>
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .cart-page-2 {
    width: 100%;
    row-gap: var(--space-s);
  }

  .cart-page-2__intro {
    align-items: center;
  }

  .bm-woo-notice-container {
    position: relative;
  }

  .cart-page-2__cart-container {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 2);
  }

  .cart-page-2__card-container {
    row-gap: var(--flow-spacing);
  }

  .cart-page-2-testimonial-card {
    flex-direction: row;
    background: var(--bg-subtle);
    padding: var(--space-s) var(--space-s) var(--space-s) var(--space-s);
    column-gap: var(--flow-spacing);
    row-gap: var(--flow-spacing);
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 2 / 1);
    border-top: 1 solid var(--color-line-default);
    border-right: 1 solid var(--color-line-default);
    border-bottom: 1 solid var(--color-line-default);
    border-left: 1 solid var(--color-line-default);
  }

  .cart-page-2-testimonial-card__client {
    flex-direction: row;
    column-gap: calc(var(--flow-spacing) / 2);
    align-items: center;
  }

  .cart-page-2-testimonial-card__content {
    width: auto;
    row-gap: calc(var(--flow-spacing) / 4);
  }

  .cart-page-2-testimonial-card__name {
    font-weight: 700;
  }

  .cart-page-2-testimonial-card__role {
    font-size: var(--fs-0);
  }

  .cart-page-2-testimonial-card__avatar {
    width: 5rem;
    border-radius: 100% 100% 100% 100%;
    height: 5rem;
    object-fit: cover;
    overflow: hidden;
  }

  .cart-page-2-testimonial-card__text {
    font-size: var(--fs-2);
    font-weight: 700;
    width: 100%;
  }

  .cart-page-2__cart-totals-container {
    flex-direction: row;
    background: var(--bg-subtle);
  }

  .cart-page-2__cart-totals {
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
  }

  /* bm-custom */
  .cart-page-2__cart-items {
  
  		--cart-items--primary: var(--text-primary);
  		--focus-color: var(--action-primary);
  
    	/* Style border and inline padding to header cell */
    	 .shop_table thead th {
      		border-bottom: 1px solid var(--color-line-default);
  				padding: 0 var(--space-s);
    	}
    
    	/* Add block and inline padding to data cell */
    	.shop_table tbody td {
        	padding: var(--space-xs) var(--space-s);
    	}
  
    	/* Set quantity width */
  		.shop_table .quantity {
        	width: 13rem;
    	}
    
    	/* Remove right border on the minus quantity element */
    	.shop_table .quantity .minus {
        	border-right: 0;
    	}
    
    	/* Remove left border on the plus quantity element */
    	.shop_table .quantity .plus {
        	border-left: 0;
    	}
    
    	/* Style cart items buttons */
    	.shop_table .button {
        	padding: var(--space-xs) var(--space-m);
        	background-color: var(--action-primary);
        	color: var(--bg-canvas);
    	}
    
    	/* Style cart items link color */
    	.shop_table a {
        	color: var(--action-primary);
    	}    
    
  }

  /* bm-custom */
  .cart-page-2__cart-totals {
  
  		--cart-items--primary: var(--text-primary);
  		--focus-color: var(--action-primary);
  
    	/* Remove border top & bottom and margin bottom on the table */
    	.cart_totals table {
      		border-top: 0;
        	border-bottom: 0;
        	margin-bottom: 0;      	
    	}
    
    	  .cart_totals table .cart-subtotal td, .cart_totals table .shipping td, .cart_totals table .order-total td {
      text-align: end;
      font-size: var(--fs-0);
    }
    
    	/* Style h2 heading of cart totals */
    	.cart_totals h2 {
        	border-bottom: 1px solid var(--color-line-default);
    	}
    
    	/* Style cart totals button */
    	.cart_totals .button {
        	background-color: var(--action-primary);
        	color: var(--bg-canvas);
        	font-size: 18px;
        	display: block;
        	text-align: center;      	
        	line-height: 150%;
        	margin-top: var(--space-m);
    	}
    
    	/* Style links of cart totals */
    	.cart_totals a {
        	color: var(--action-primary);
    	}  
    
    	/* Style shipping calculator button */
    	.shipping-calculator-button {
      		text-decoration: none;
        	font-weight: bold;
    	}
    
    	/* Style th & shipping destination color */
    	.cart-subtotal th,
    	.shipping th,
    	.woocommerce-shipping-destination {
      		color: var(--text-secondary);
    	}
    	
    	  	/* Add margin top to the calculation button */
      .woocommerce-shipping-calculator .button {
      margin-block-start: var(--space-xs);
      
    }	
    
    	 /* Style add padding to the right of the th cell */
    	.shipping th {	
        padding-inline-end: var(--space-m);
    	}
    	
    	/* Style strong color of shipping destination */
    	.woocommerce-shipping-destination strong {
      		color: var(--text-primary);
    	}  
    
    	  	/* Right align the shipping methods */
      ul.woocommerce-shipping-methods li {
        display: flex;
        flex-direction: row;
        justify-content: end;
      }
    
      	/* Right align the shipping methods */
    	ul.woocommerce-shipping-methods input[type=radio]+label {
      	font-size: 14px;
        color: var(--text-secondary) !important;
        font-weight: 700;
  		}
    	
    
    	/* Style data title subtotal */
    	.cart-subtotal td[data-title=Subtotal] {
        	font-weight: bold;
    	}  	 
    	
    
    	/* Style order total th and td font-size */
    	.order-total th, .order-total td {
        	font-size: var(--fs-2);
        	border-bottom: 1px solid var(--color-line-default);
        	padding-bottom: var(--space-m);      	
    	}
    
      /* Increase the Total price font size */
    .cart_totals table .order-total td {
      font-size: var(--fs-2);
    }
  }
</style>
