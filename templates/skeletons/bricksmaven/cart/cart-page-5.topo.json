   "custom_css": ".cart-page-5__cart-totals {\n\n\t\t--cart-items--primary: var(--black);\n\t\t--focus-color: var(--cart-items--primary);\n  \t\n  \t/* Remove border top & bottom and margin bottom on the table */\n  \t.cart_totals table {\n    \t\tborder-top: 0;\n      \tborder-bottom: 0;\n      \tmargin-bottom: 0;\n  \t}  \t\n  \n  .cart_totals table .cart-subtotal td, .cart_totals table .shipping td, .cart_totals table .order-total td {\n    text-align: end;\n    font-size: var(--text-s);\n  }\n  \n  /* Increase the Total price font size */\n  .cart_totals table .order-total td {\n    font-size: var(--text-l);\n  }\n  \n  \t/* Style Cart totals button */\n  \t.cart_totals .button {\n      padding: 0 var(--space-s);\t\n      background-color: var(--cart-items--primary);\n      \tcolor: var(--white);\n      \tfont-size: 18px;\n      \tdisplay: block;\n      \ttext-align: center;      \t\n      \tline-height: 40px;\n  \t}\n  \n  \t/* Style Cart totals links */\n  \t.cart_totals a {\n      \tcolor: var(--cart-items--primary);\n  \t}  \n  \n  \t/* Style shipping calculator button */\n  \t.shipping-calculator-button {\n    \t\ttext-decoration: none;\n      \tfont-weight: bold;\n  \t}\n  \n  \t/* Add margin top to the calculation button */\n    .woocommerce-shipping-calculator .button {\n    margin-block-start: var(--space-xs);\n    \n  }\n  \n  \t/* Style th & shipping destination color */\n  \t.cart-subtotal th,\n  \t.shipping th,\n  \t.woocommerce-shipping-destination {\t\n      color: var(--neutral);\n  \t}\n  \n  \t /* Style add padding to the right of the th cell */\n  \t.shipping th {\t\n      padding-inline-end: var(--space-m);\n  \t}\n  \n  \n  \t/* Style strong color of shipping destination */\n  \t.woocommerce-shipping-destination strong {\n    \t\tcolor: var(--black);\n  \t}  \n  \n  \t/* Right align the shipping methods */\n    ul.woocommerce-shipping-methods li {\n      display: flex;\n      flex-direction: row;\n      justify-content: end;\n    }\n  \t\n  \t/* Right align the shipping methods */\n  \tul.woocommerce-shipping-methods input[type=radio]+label {\n    \tfont-size: 14px;\n      color: var(--neutral) !important;\n      font-weight: 700;\n\t\t}\n  \n  \t/* Style data title subtotal */\n  \t.cart-subtotal td[data-title=Subtotal] {\n      \tfont-weight: bold;\n  \t}  \t \n  \t\n  \t/* Style order total th and td font-size */\n  \t.order-total th, .order-total td {\n      \tfont-size: var(--text-l);\n  \t}\n}",
