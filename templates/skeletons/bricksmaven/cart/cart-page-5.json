  {
   "id": "hmccun",
   "name": "cart-page-5__cart-items",
   "settings": {
    "_cssCustom": ".cart-page-5__cart-items {\n\n\t\t--cart-items--primary: var(--black);\n\t\t--focus-color: var(--cart-items--primary);\n\n  \t/* Style border and inline padding to header cell */\n  \t .shop_table thead th {\n    \t\tborder-bottom: 1px solid var(--neutral-light);\n\t\t\t\tpadding: 0 var(--space-s);\n  \t}\n  \t\n  \t/* Add block and inline padding to data cell */\n  \t.shop_table tbody td {\n      \tpadding: var(--space-xs) var(--space-s);\n  \t}\n  \n  \t\n\t\t/* Set quantity width */\n\t\t.shop_table .quantity {\n      \twidth: 13rem;\n  \t}\n  \n  \n  \t/* Remove right border on the minus quantity element */\n  \t.shop_table .quantity .minus {\n      \tborder-right: 0;\n  \t}\n  \n  \t/* Remove left border on the plus quantity element */\n  \t.shop_table .quantity .plus {\n      \tborder-left: 0;\n  \t}\n  \n  \t/* Style cart items buttons */\n  \t.shop_table .button {\n      \tbackground-color: var(--cart-items--primary);\n      \tcolor: var(--white);\n  \t}\n  \n  \t/* Style cart items link color */\n  \t.shop_table a {\n      \tcolor: var(--cart-items--primary);\n  \t}    \n  \n}",
    "_background": {
     "color": {
      "id": "acss_import_white",
      "name": "white",
      "raw": "var(--white)"
     }
    }
   }
  },
