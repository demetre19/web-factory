  {
   "id": "fahxjq",
   "name": "cart-page-4__cart-items",
   "settings": {
    "_cssCustom": ".cart-page-4__cart-items {\n\n\t\t--cart-items--primary: var(--black);\n\t\t--focus-color: var(--cart-items--primary);\n\n  \t/* Style shop table */\n  \t.shop_table {\n      \tborder-collapse: separate;\n      \tborder-spacing: var(--space-s);\n  \t}\n  \t\n  \t/* Style shop table header cell */\n  \t .shop_table thead th {\n    \t\tline-height: 30px;\n\t\t\t\tpadding: 0 var(--space-s);\n  \t}\n  \n  \t/* Style cart item */\n  \t.shop_table .cart_item {\n      \toutline: 1px solid var(--neutral-light);\n  \t}\n  \n  \t/* Style shop table table cell */\n  \t.shop_table tbody td {\n      \tpadding: var(--space-xs) var(--space-s);\n  \t}\n\n  \t/* Set the width of the quantity element */\n\t\t.shop_table .quantity {\n      \twidth: 13rem;\n  \t}\n  \n  \t/* Remove the right border on the minus quantity element */\n  \t.shop_table .quantity .minus {\n      \tborder-right: 0;\n  \t}\n  \n  \t/* Remove the left border on the plus quantity element */\n  \t.shop_table .quantity .plus {\n      \tborder-left: 0;\n  \t}\n  \n  \t/* Style the shop table button */\n  \t.shop_table .button {\n      \tpadding: var(--space-xs) var(--space-m);\n      \tbackground-color: var(--cart-items--primary);\n      \tcolor: var(--white);\n  \t}\n  \n  \t\n  \t/* Style the shop table links */\n  \t.shop_table a {\n      \tcolor: var(--cart-items--primary);\n  \t}    \n  \n}"
   },
