---
/**
 * bm-cart-page-3 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (cart-page-3.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="cart-page-3__container">
    <div class="cart-page-3__intro">
      <h1 class="cart-page-3__heading">Cart</h1>
    </div>
    <div class="bm-woo-notice-container">
      <div class="bm-woo-notice"></div>
    </div>
    <div>
      <p>{do_action:woocommerce_before_cart}</p>
    </div>
    <div class="cart-page-3__cart-items-container">
      <div class="cart-page-3__cart-items"></div>
    </div>
    <div>
      <p>{do_action:woocommerce_before_cart_collaterals}</p>
    </div>
    <div class="cart-page-3__cart-totals-container">
      <div class="cart-page-3__review-list list--none">
        <div class="cart-page-3-review">
          <div class="cart-page-3-review__top">
            <p class="cart-page-3-review__heading">John Doe</p>
            <p class="cart-page-3-review__overline">Productivity Boost</p>
          </div>
          <figure class="cart-page-3-review__image"><img src="/media/placeholder.svg" alt="Image" loading="lazy" width="900" height="600" /></figure>
          <p class="cart-page-3-review__text">Our user-friendly interface makes easy to increase your productivity and streamline your workflow.</p>
        </div>
      </div>
      <div class="cart-page-3__cart-totals"></div>
    </div>
    <div>
      <p>{do_action:woocommerce_after_cart}</p>
    </div>
  </div>
</div>

<style is:global>
@layer components {
  .cart-page-3 {
    flex-direction: column;
    row-gap: var(--space-s);
  }

  .cart-page-3__container {
    flex-direction: row;
    column-gap: var(--space-xl);
    align-items: stretch;
    display: grid;
    grid-template-columns: calc(100% * 1 / 1);
    gap: var(--space-m);
  }

  .cart-page-3__intro {
    align-items: center;
  }

  .cart-page-3__heading {
    display: flex;
    flex-direction: row;
    column-gap: var(--space-m);
    align-items: stretch;
    text-align: center;
    margin: 0 0 var(--space-m) 0;
  }

  .bm-woo-notice-container {
    position: relative;
  }

  .cart-page-3__cart-items-container {
    row-gap: var(--flow-spacing);
    grid-template-columns: calc(100% * 1 / 1);
  }

  .cart-page-3__cart-totals-container {
    gap: var(--space-m);
    display: grid;
    grid-template-columns: calc(100% * 1 / 2);
  }

  .cart-page-3__review-list {
    row-gap: var(--flow-spacing);
    flex-wrap: nowrap;
  }

  .cart-page-3-review {
    flex-direction: column;
    row-gap: calc(var(--flow-spacing) / 4);
    padding: var(--space-s) var(--space-s) var(--space-s) var(--space-s);
  }

  .cart-page-3-review__heading {
    font-weight: 700;
    font-size: var(--fs-2);
  }

  .cart-page-3-review__overline {
    font-size: var(--fs-0);
  }

  .cart-page-3-review__image {
    border-radius: 100% 100% 100% 100%;
    width: 5rem;
    height: 5rem;
    overflow: hidden;
  }

  .cart-page-3-review__text {
    font-size: var(--fs-2);
  }

  .cart-page-3__cart-totals {
    padding: var(--space-s) var(--space-m) var(--space-m) var(--space-m);
  }

  /* bm-custom */
  .cart-page-3__cart-items {
  
  		--cart-items--primary: var(--text-primary);
  		--focus-color: var(--action-primary);
  
    	/* Style border and inline padding to header cell */
    	 .shop_table thead th {
      		border-bottom: 1px solid var(--color-line-default);
  				padding: 0 var(--space-s);
    	}
    	
    	/* Add block and inline padding to data cell */
    	.shop_table tbody td {
        	padding: var(--space-xs) var(--space-s);
    	}
    
    	
  		/* Set quantity width */
  		.shop_table .quantity {
        	width: 13rem;
    	}
    
    
    	/* Remove right border on the minus quantity element */
    	.shop_table .quantity .minus {
        	border-right: 0;
    	}
    
    	/* Remove left border on the plus quantity element */
    	.shop_table .quantity .plus {
        	border-left: 0;
    	}
    
    	/* Style cart items buttons */
    	.shop_table .button {
        	background-color: var(--action-primary);
        	color: var(--bg-canvas);
    	}
    
    	/* Style cart items link color */
    	.shop_table a {
        	color: var(--action-primary);
    	}    
    
  }

  /* bm-custom */
  .cart-page-3__cart-totals {
  
  		--cart-items--primary: var(--text-primary);
  		--focus-color: var(--action-primary);
  
    	/* Remove border top & bottom and margin bottom on the table */
    	.cart_totals table {
      		border-top: 0;
        	border-bottom: 0;
        	margin-bottom: 0;      	
    	}
    
    	border: 1px solid var(--color-line-default);
    	background-color: var(--bg-subtle);
    
    	  .cart_totals table .cart-subtotal td, .cart_totals table .shipping td, .cart_totals table .order-total td {
      text-align: end;
      font-size: var(--fs-0);
    }
    
    	/* Style h2 heading of cart totals */
    	.cart_totals h2 {
        	border-bottom: 1px solid var(--color-line-default);
    	}
    
    	/* Style cart totals button */
    	.cart_totals .button {
        	background-color: var(--action-primary);
        	color: var(--bg-canvas);
        	font-size: 18px;
        	display: block;
        	text-align: center;      	
        	line-height: 150%;
        	margin-top: var(--space-m);
    	}
    
    	/* Style links of cart totals */
    	.cart_totals a {
        	color: var(--action-primary);
    	}  
    
    	/* Style shipping calculator button */
    	.shipping-calculator-button {
      		text-decoration: none;
        	font-weight: bold;
    	}
    
    	/* Style th & shipping destination color */
    	.cart-subtotal th,
    	.shipping th,
    	.woocommerce-shipping-destination {
      		color: var(--text-secondary);
    	}
    	
    	  	/* Add margin top to the calculation button */
      .woocommerce-shipping-calculator .button {
      margin-block-start: var(--space-xs);
      
    }	
    
    	 /* Style add padding to the right of the th cell */
    	.shipping th {	
        padding-inline-end: var(--space-m);
    	}
    	
    	/* Style strong color of shipping destination */
    	.woocommerce-shipping-destination strong {
      		color: var(--text-primary);
    	}  
    
    	  	/* Right align the shipping methods */
      ul.woocommerce-shipping-methods li {
        display: flex;
        flex-direction: row;
        justify-content: end;
      }
    
      	/* Right align the shipping methods */
    	ul.woocommerce-shipping-methods input[type=radio]+label {
      	font-size: 14px;
        color: var(--text-secondary) !important;
        font-weight: 700;
  		}
    	
    
    	/* Style data title subtotal */
    	.cart-subtotal td[data-title=Subtotal] {
        	font-weight: bold;
    	}  	 
    	
    
    	/* Style order total th and td font-size */
    	.order-total th, .order-total td {
        	font-size: var(--fs-2);
        	border-bottom: 1px solid var(--color-line-default);
        	padding-bottom: var(--space-m);      	
    	}
    
      /* Increase the Total price font size */
    .cart_totals table .order-total td {
      font-size: var(--fs-2);
    }
  }
}
</style>
