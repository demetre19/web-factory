---
/**
 * bm-cart-page-1 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (cart-page-1.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="cart-page-1__container">
    <div class="cart-page-1__intro">
      <h2 class="cart-page-1__heading">{heading}</h2>
    </div>
    <div class="bm-woo-notice-container">
      <div class="bm-woo-notice"></div>
    </div>
    <div>
      <p>{fs}</p>
    </div>
    <div class="cart-page-1__cart-container">
      <div class="cart-page-1__cart-items-container">
        <div class="cart-page-1__cart-items"></div>
        <div>
          <p>{do_action:woocommerce_before_cart_collaterals}</p>
        </div>
      </div>
      <div class="cart-page-1__cart-totals-container">
        <div class="cart-page-1__cart-totals"></div>
      </div>
    </div>
  </div>
  <div>
    <p>{do_action:woocommerce_after_cart}</p>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .cart-page-1__intro {
    align-items: center;
    text-align: center;
  }

  .bm-woo-notice-container {
    position: relative;
  }

  .cart-page-1__cart-container {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 2);
  }

  .cart-page-1__cart-totals {
    padding: var(--space-xs) var(--space-m) var(--space-m) var(--space-m);
  }

  /* bm-custom */
  .cart-page-1__cart-items {
  
  		--cart-items--primary: var(--text-primary);
  		--focus-color: var(--action-primary);
  
    	/* Style border and inline padding to header cell */
    	 .shop_table thead th {
      		border-bottom: 1px solid var(--color-line-default);
  				padding: 0 var(--space-s);
    	}
    	
    	/* Add block and inline padding to data cell */
    	.shop_table tbody td {
        	padding: var(--space-xs) var(--space-s);
    	}
    
    	
  		/* Set quantity width */
  		.shop_table .quantity {
        	width: 13rem;
    	}
    
    
    	/* Remove right border on the minus quantity element */
    	.shop_table .quantity .minus {
        	border-right: 0;
    	}
    
    	/* Remove left border on the plus quantity element */
    	.shop_table .quantity .plus {
        	border-left: 0;
    	}
    
    	/* Style cart items buttons */
    	.shop_table .button {
        padding: 0 var(--space-s);		
        background-color: var(--action-primary);
       	color: var(--bg-canvas);
        line-height: 40px;
    	}
    
    	/* Style cart items link color */
    	.shop_table a {
        	color: var(--action-primary);
    	}    
    
  }

  /* bm-custom */
  .cart-page-1__cart-totals {
  
  		--cart-items--primary: var(--text-primary);
  		--focus-color: var(--action-primary);
  
    	
      border: 1px solid var(--color-line-default);
    	background-color: var(--bg-subtle);
    	
    	/* Remove border top & bottom and margin bottom on the table */
    	.cart_totals table {
      		border-top: 0;
        	border-bottom: 0;
        	margin-bottom: 0;
    	}  	
    
    .cart_totals table .cart-subtotal td, .cart_totals table .shipping td, .cart_totals table .order-total td {
      text-align: end;
      font-size: var(--fs-0);
    }
    
    /* Increase the Total price font size */
    .cart_totals table .order-total td {
      font-size: var(--fs-2);
    }
    
    	/* Style Cart totals button */
    	.cart_totals .button {
        padding: 0 var(--space-s);	
        background-color: var(--action-primary);
        	color: var(--bg-canvas);
        	font-size: 18px;
        	display: block;
        	text-align: center;      	
        	line-height: 40px;
    	}
    
    	/* Style Cart totals links */
    	.cart_totals a {
        	color: var(--action-primary);
    	}  
    
    	/* Style shipping calculator button */
    	.shipping-calculator-button {
      		text-decoration: none;
        	font-weight: bold;
    	}
    
    	/* Add margin top to the calculation button */
      .woocommerce-shipping-calculator .button {
      margin-block-start: var(--space-xs);
      
    }
    
    	/* Style th & shipping destination color */
    	.cart-subtotal th,
    	.shipping th,
    	.woocommerce-shipping-destination {	
        color: var(--text-secondary);
    	}
    
    	 /* Style add padding to the right of the th cell */
    	.shipping th {	
        padding-inline-end: var(--space-m);
    	}
    
    
    	/* Style strong color of shipping destination */
    	.woocommerce-shipping-destination strong {
      		color: var(--text-primary);
    	}  
    
    	/* Right align the shipping methods */
      ul.woocommerce-shipping-methods li {
        display: flex;
        flex-direction: row;
        justify-content: end;
      }
    	
    	/* Right align the shipping methods */
    	ul.woocommerce-shipping-methods input[type=radio]+label {
      	font-size: 14px;
        color: var(--text-secondary) !important;
        font-weight: 700;
  		}
    
    	/* Style data title subtotal */
    	.cart-subtotal td[data-title=Subtotal] {
        	font-weight: bold;
    	}  	 
    	
    	/* Style order total th and td font-size */
    	.order-total th, .order-total td {
        	font-size: var(--fs-2);
    	}
  }
</style>
