    "_cssCustom": ".blog-archive-13-archive-card:nth-child(3n+1) {\n\theight: 25rem;\n}\n\n.blog-archive-13-archive-card:first-child {\n\tgrid-column: 1 / 7;\n  grid-row: span 2;\n  height:100%;\n}\n\n.blog-archive-13-archive-card:first-child .blog-archive-13-archive-card__post-title {\n\tfont-size: var(--h2);\n}\n\n.blog-archive-13-archive-card:nth-child(2) {\n\tgrid-column: 7 / -1;\n  grid-row-start: 1;\n  height: 100%;\n}\n\n.blog-archive-13-archive-card:nth-child(3) {\n\tgrid-column: 7 / -1;\n  grid-row-start: 2;\n  height: 100%;\n}\n\n@media (max-width:767px) {\n\n\t.blog-archive-13-archive-card:nth-child(3n+1) {\n\theight: 100%;\n}\n\n.blog-archive-13-archive-card:first-child {\n\tgrid-column: span 1;\n  grid-row: span 1;\n  height:100%;\n}\n\n.blog-archive-13-archive-card:first-child .blog-archive-13-archive-card__post-title {\n\tfont-size: var(--text-l);\n}\n\n.blog-archive-13-archive-card:nth-child(2) {\n\tgrid-column: span 1;\n  grid-row-start: auto;\n  height: 100%;\n}\n\n.blog-archive-13-archive-card:nth-child(3) {\n\tgrid-column: span 1;\n  grid-row-start: auto;\n  height: 100%;\n}\n\n}\n",
