   "settings": {
    "_cssCustom": ".blog-archive-2-head__form .bricks-search-form {\n\tgap: 1.5rem;\n}\n.blog-archive-2-head__form [type=\"search\"] {\n\twidth: 70% !important;\n}\n.blog-archive-2-head__form [type=\"submit\"] {\n\tbackground-color: var(--primary);\n  color: var(--white);\n  width: 30%;\n  padding: 10px 15px;\n  text-align: center;\n  height: auto;\n  position: static!important;\n  clip-path: unset !important;\n}\n.blog-archive-2-head__form [type=\"submit\"]:focus {\n\tborder-radius: 0;\n  box-shadow: none;\n  font-size: 100%;\n  font-weight: 400;\n  line-height: 100%;\n  outline: none;\n  padding: 10px;\n  text-align: center;\n  clip-path: unset;\n}\n.blog-archive-2-head__form [type=\"submit\"] span {\n\theight: auto;\n  position: static!important;\n  width: auto;\n}"
