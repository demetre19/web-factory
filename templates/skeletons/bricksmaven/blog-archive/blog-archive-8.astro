interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="blog-archive-8-container">
    <div class="blog-archive-8-head">
      <div class="blog-archive-8-head__intro">
        <h1 class="blog-archive-8-head__title">{heading}</h1>
        <p class="accent-h">Latest</p>
        <p class="blog-archive-8-head__desc">{fs}</p>
      </div>
      <div class="blog-archive-8-head__search-wrapper">
        <div class="blog-archive-8-head__form"></div>
      </div>
    </div>
    <div class="blog-archive-8-body">
      <div class="blog-archive-8-wrapper list--none">
        <div class="blog-archive-8-card">
          <div class="blog-archive-8-card__box">
            <p class="blog-archive-8-card__term">{post_terms_category}</p>
            <h2 class="blog-archive-8-card__title">{post_title}</h2>
            <div class="blog-archive-8-card__excerpt"></div>
            <div class="blog-archive-8-card__author">
              <div class="blog-archive-8-card__author-media">
                <figure class="blog-archive-8-card__photo"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
              <div class="blog-archive-8-card__meta">
                <custom class="blog-archive-8-card__name">{author_name}</custom>
                <p class="blog-archive-8-card__date">{post_date}</p>
              </div>
            </div>
          </div>
          <div class="blog-archive-8-card__media">
            <figure class="blog-archive-8-card__thumb"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      </div>
      <div class="blog-archive-8-pagination"></div>
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .blog-archive-8-container {
    grid-template-columns: calc(100% * 1 / 6);
    gap: var(--space-m);
    display: grid;
  }

  .blog-archive-8-head {
    display: flex;
    flex-direction: column;
    row-gap: var(--flow-spacing);
  }

  .blog-archive-8-head__intro {
    display: flex;
    flex-direction: column;
    row-gap: var(--flow-spacing);
  }

  .blog-archive-8-body {
    width: 100%;
    display: flex;
    flex-direction: column;
    row-gap: var(--flow-spacing);
  }

  .blog-archive-8-wrapper {
    gap: var(--space-m);
    width: 100%;
  }

  .blog-archive-8-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
  }

  .blog-archive-8-card__box {
    width: calc( 100% - 10% );
    margin: calc(var(--space-l) * -1) 0 0 0;
    display: flex;
    flex-direction: column;
    background: var(--bg-canvas);
    align-self: center;
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    text-align: center;
    align-items: center;
    row-gap: var(--flow-spacing);
    z-index: 1;
  }

  .blog-archive-8-card__term {
    padding: .3rem .8rem .3rem .8rem;
    background: color-mix(in srgb, var(--action-primary) 40%, transparent);
    font-size: var(--fs-0);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
  }

  .blog-archive-8-card__author {
    margin: auto 0 0 0;
    display: flex;
    flex-direction: row;
    column-gap: var(--flow-spacing);
    text-align: left;
  }

  .blog-archive-8-card__photo {
    width: 4.8rem;
    height: 4.8rem;
    object-fit: cover;
    border-radius: 100% 100% 100% 100%;
    overflow: hidden;
  }

  .blog-archive-8-card__meta {
    display: flex;
    flex-direction: column;
  }

  .blog-archive-8-card__name {
    font-weight: 700;
  }

  .blog-archive-8-card__thumb {
    height: 30rem;
