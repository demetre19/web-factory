  }
  .blog-archive-8-wrapper .blog-archive-8-card:nth-child(5) {
  	grid-area: 3 / 2 / 4 / 3;
  }
  .blog-archive-8-wrapper .blog-archive-8-card:nth-child(6) {
  	grid-area: 4 / 1 / 5 / 2;
  }
  .blog-archive-8-wrapper .blog-archive-8-card:nth-child(7) {
