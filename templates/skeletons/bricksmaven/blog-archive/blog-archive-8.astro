    width: 100%;
  }

  /* bm-custom */
  .blog-archive-8-head__form .bricks-search-form {
  	gap: 1.5rem;
  }
  .blog-archive-8-head__form [type="search"] {
  	width: 70% !important;
  }
  .blog-archive-8-head__form [type="submit"] {
  	background-color: var(--action-primary);
    color: var(--bg-canvas);
    width: 30%;
    padding: 10px 15px;
    text-align: center;
    height: auto;
    position: static!important;
    clip-path: unset !important;
  }
  .blog-archive-8-head__form [type="submit"]:focus {
  	border-radius: 0;
    box-shadow: none;
    font-size: 100%;
    font-weight: 400;
    line-height: 100%;
    outline: none;
    padding: 10px;
    text-align: center;
    clip-path: unset;
  }
  .blog-archive-8-head__form [type="submit"] span {
  	height: auto;
    position: static!important;
    width: auto;
  }

  /* bm-custom */
  .blog-archive-8-wrapper {
  	display: grid;
    grid-template-columns: repeat(2, 1fr);
  }
  .blog-archive-8-wrapper .blog-archive-8-card:nth-child(1) {
  	grid-area: 1 / 1 / 2 / 3;
  }
  .blog-archive-8-wrapper .blog-archive-8-card:nth-child(2) {
