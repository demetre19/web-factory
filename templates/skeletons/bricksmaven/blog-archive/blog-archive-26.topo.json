   "custom_css": "/* Set bottom margin to cards */\n.blog-archive-26-archive-card {\n\tmargin-block-end: calc(var(--space-xxl) * 1.2);\n}\n\n/* Set top margin on first card to 0px */\n.blog-archive-26-archive-card:first-child {\n\tmargin-block-start: 0px;\n}\n\n/* Set bottom margin on last card to 0px */\n.blog-archive-26-archive-card:last-child {\n\tmargin-block-end: 0px;\n}\n\n/* Set media element  */\n.blog-archive-26-archive-card__media {\n\toverflow: hidden;\n}\n\n.blog-archive-26-archive-card__image {\n\ttransition: .8s ease;\n}\n\n.blog-archive-26-archive-card:hover .blog-archive-26-archive-card__image {\n\tscale: 1.1;\n}\n\n\n.blog-archive-26-archive-card:nth-child(4n+1) .blog-archive-26-archive-card__image {\n\theight: 40rem; \n}\n\n.blog-archive-26-archive-card:nth-child(4n+2), .blog-archive-26-archive-card:nth-child(4), .blog-archive-26-archive-card:nth-child(8) {\n  transform: translateY(var(--space-xxl));\n}\n\n.blog-archive-26-archive-card:nth-child(4n+2) .blog-archive-26-archive-card__image {\n\theight: 64rem;\n}\n\n.blog-archive-26-archive-card:nth-child(3) .blog-archive-26-archive-card__image, .blog-archive-26-archive-card:nth-child(4) .blog-archive-26-archive-card__image, .blog-archive-26-archive-card:nth-child(7) .blog-archive-26-archive-card__image, .blog-archive-26-archive-card:nth-child(8) .blog-archive-26-archive-card__image {\n\theight: 48rem;\n}\n\n\n\n.blog-archive-26-archive-card:nth-child(1) {\n\tgrid-area: 1 / 2 / 2 / 11;\n}\n\n.blog-archive-26-archive-card:nth-child(2) {\n  grid-area: 1 / 13 / 2 / -1;\n}\n\n.blog-archive-26-archive-card:nth-child(3) {\n  grid-area: 2 / 1 / 3 / 11;\n}\n\n.blog-archive-26-archive-card:nth-child(4) {\n  grid-area: 2 / 13 / 3 / 24;\n}\n\n.blog-archive-26-archive-card:nth-child(5) {\n  grid-area: 4 / 2 / 5 / 11;\n}\n\n.blog-archive-26-archive-card:nth-child(6) {\n  grid-area: 4 / 13 / 5 / -1;\n}\n\n.blog-archive-26-archive-card:nth-child(7) {\n  grid-area: 6 / 1 / 7 / 11;\n}\n\n.blog-archive-26-archive-card:nth-child(8) {\n  grid-area: 6 / 13 / 7 / 24;\n}\n\n.blog-archive-26-archive-card:nth-child(9) {\n\tgrid-area: 8 / 2 / 9 / 11;\n}\n\n.blog-archive-26-archive-card:nth-child(10) {\n  grid-area: 8 / 13 / 9 / -1;\n}\n\n@media (max-width: 767px) {\n\t.blog-archive-26-archive-card:nth-child(1n+1) {\n  grid-area: span 1;\n  margin-block-end: var(--space-m);\n}\n  \n  .blog-archive-26-archive-card:nth-child(4n+2), .blog-archive-26-archive-card:nth-child(4), .blog-archive-26-archive-card:nth-child(8) {\n  transform: translateY(0);\n}\n  \n  .blog-archive-26-archive-card:nth-child(1n+1) .blog-archive-26-archive-card__image {\n\theight: 40rem;\n  \n}\n}",
