   "name": "blog-archive-11-archive-list",
   "settings": {
    "_display": "grid",
    "_gridTemplateColumns": "repeat(2, minmax(0, 1fr))",
    "_gridGap": "var(--space-xl)",
    "_cssCustom": ".blog-archive-11-archive-list .blog-archive-11-archive-card:nth-child(1) .blog-archive-11-archive-card__image, .blog-archive-11-archive-list .blog-archive-11-archive-card:nth-child(2) .blog-archive-11-archive-card__image {\n\taspect-ratio: 5 / 6;\n}\n\n\n.blog-archive-11-archive-list .blog-archive-11-archive-card:nth-child(1),.blog-archive-11-archive-list .blog-archive-11-archive-card:nth-child(2) {\n\tflex-direction:column;\n}\n\n.blog-archive-11-archive-list .blog-archive-11-archive-card:nth-child(n+3) .blog-archive-11-archive-card__excerpt {\n\tdisplay: none;\n}\n\n.blog-archive-11-archive-list .blog-archive-11-archive-card:nth-child(n+3) .blog-archive-11-archive-card__image {\n\taspect-ratio: 3/2;\n}\n\n@media (max-width:767px) {\n\t\t.blog-archive-11-archive-list .blog-archive-11-archive-card:nth-child(1) .blog-archive-11-archive-card__image, .blog-archive-11-archive-list .blog-archive-11-archive-card:nth-child(2) .blog-archive-11-archive-card__image {\n\taspect-ratio: auto;\n}\n\n\n.blog-archive-11-archive-list .blog-archive-11-archive-card:nth-child(1),.blog-archive-11-archive-list .blog-archive-11-archive-card:nth-child(2) {\n\tflex-direction:row;\n}\n\n.blog-archive-11-archive-list .blog-archive-11-archive-card:nth-child(n+3) .blog-archive-11-archive-card__excerpt {\n\tdisplay: block;\n}\n}\n\n",
