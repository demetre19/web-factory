   "name": "blog-archive-15-archive-card",
   "settings": {
    "_gridItemColumnSpan": "span 3",
    "_cssCustom": ".blog-archive-15-archive-card:nth-child(odd) {\n\tgrid-column: 10/-1;\n}\n\n.blog-archive-15-archive-card:first-child {\n  grid-column: 1/4;\n  grid-row: 1;\n}\n\n.blog-archive-15-archive-card .blog-archive-15-archive-card__image {\n\taspect-ratio: 16/9;\n  height: 100%;\n}\n\n.blog-archive-15-archive-card:nth-child(2) {\n\tgrid-column: 4/10;\n  grid-row: 1/-1;\n}\n\n.blog-archive-15-archive-card:nth-child(2) .blog-archive-15-archive-card__excerpt {\n\tdisplay:block;\n}\n\n.blog-archive-15-archive-card:nth-child(2) .blog-archive-15-archive-card__post-title {\n\tfont-size: var(--h2);\n}\n\n.blog-archive-15-archive-card:nth-child(2) .blog-archive-15-archive-card__image {\n\taspect-ratio: 9/16;\n  height: 100%;\n}\n\n.blog-archive-15-archive-card:nth-child(3) {\n\tgrid-column: 10/-1;\n  grid-row: 1;\n}\n\n@media (max-width:767px) {\n\n    .blog-archive-15-archive-card:nth-child(odd) {\n    grid-column: span 1;\n  }\n\n  .blog-archive-15-archive-card:first-child, .blog-archive-15-archive-card:nth-child(3) {\n    grid-column: span 1;\n    grid-row: auto;\n  }\n\n  .blog-archive-15-archive-card .blog-archive-15-archive-card__image {\n    aspect-ratio: 6/4;\n    height: 100%;\n  }\n\n  .blog-archive-15-archive-card:nth-child(2) {\n    grid-column: span 1;\n    grid-row: auto;\n  }\n\n  .blog-archive-15-archive-card:nth-child(2) .blog-archive-15-archive-card__post-title {\n    font-size: var(--h3);\n  }\n\n  .blog-archive-15-archive-card:nth-child(2) .blog-archive-15-archive-card__image {\n    aspect-ratio: 6/4;\n    height: 100%;\n  }\n\n\n  \n}",
