   "radius": {},
   "custom_css": ".blog-archive-12-archive-card:nth-child(even) {\n\tgrid-column: 8/15;\n}\n\n.blog-archive-12-archive-card:nth-child(odd) {\n\tgrid-column: 15 / -1;\n}\n\n.blog-archive-12-archive-card:first-child {\n\tgrid-column: 1/8;\n  grid-row: span 5;\n}\n\n.blog-archive-12-archive-card:not(:first-child) {\n\tdisplay:grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  background-color: var(--white) !important;\n}\n\n.blog-archive-12-archive-card:not(:first-child) .blog-archive-12-archive-card__excerpt, .blog-archive-12-archive-card:not(:first-child) .blog-archive-12-archive-card__link {\n\tdisplay:none;\n}\n\n.blog-archive-12-archive-card:not(:first-child) .blog-archive-12-archive-card__post-title {\n  \tfont-size: var(--h5);\n}\n\n.blog-archive-12-archive-card:not(:first-child) .blog-archive-12-archive-card__image {\n  \taspect-ratio: 6/4 !important;\n  \n}\n\n.blog-archive-12-archive-card:not(:first-child) .blog-archive-12-archive-card__content {\n\tjustify-content: center;\n}\n\n@media (max-width: 767px) {\n      .blog-archive-12-archive-card:nth-child(even) {\n      grid-column: span 1;\n      grid-row: span 1;\n    }\n\n    .blog-archive-12-archive-card:nth-child(odd) {\n      grid-column: span 1;\n      grid-row: span 1;\n    }\n\n    .blog-archive-12-archive-card:first-child {\n      grid-column: span 1;\n      grid-row: span 1;\n    }\n    .blog-archive-12-archive-card:first-child .blog-archive-12-archive-card__image {\n      aspect-ratio: 1/1 !important;\n\n    }\n  \n    .blog-archive-12-archive-card:not(:first-child) {\n    display:grid;\n    grid-template-columns: repeat(1, minmax(0, 1fr));\n  }\n  \n    .blog-archive-12-archive-card:not(:first-child) .blog-archive-12-archive-card__excerpt, .blog-archive-12-archive-card:not(:first-child) .blog-archive-12-archive-card__link {\n    display:block;\n  }\n  \n    .blog-archive-12-archive-card:not(:first-child) .blog-archive-12-archive-card__post-title {\n      font-size: var(--h3);\n  }\n  \n    .blog-archive-12-archive-card:not(:first-child) .blog-archive-12-archive-card__content {\n    justify-content: start;\n  }\n  \n  .blog-archive-12-archive-card:not(:first-child) .blog-archive-12-archive-card__image {\n  \taspect-ratio: 1/1 !important;\n  \n}\n\n}",
