---
/**
 * bm-blog-archive-5 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (blog-archive-5.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="blog-archive-5-container">
    <div class="blog-archive-5-head">
      <div class="blog-archive-5-head--heading">
        <h1 class="blog-archive-5-head__title">Fresh from the blog</h1>
        <p class="accent-h">Latest</p>
        <p class="blog-archive-5-head__desc">Sapiente fugit aspernatur quam Ipsam debitis maxime ut no</p>
      </div>
      <div class="blog-archive-5-head__search-wrapper">
        <div class="blog-archive-5-head__form"></div>
      </div>
    </div>
    <div class="blog-archive-5-body">
      <div class="blog-archive-5-wrapper list--none">
        <div class="blog-archive-5-card">
          <figure class="blog-archive-5-card__thumb"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          <p class="blog-archive-5-card__term">{post_terms_category}</p>
          <h2 class="blog-archive-5-card__title">{post_title}</h2>
          <div class="blog-archive-5-card__excerpt"></div>
          <div class="blog-archive-5-card__author">
            <figure class="blog-archive-5-card__photo"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            <div class="blog-archive-5-card__meta">
              <h4 class="blog-archive-5-card__name">{author_name}</h4>
              <p class="blog-archive-5-card__date">{post_date}</p>
            </div>
          </div>
        </div>
      </div>
      <div class="blog-archive-5-pagination"></div>
    </div>
  </div>
</div>

<style is:global>
@layer components {
  .blog-archive-5-container {
    grid-template-columns: calc(100% * 1 / 6);
    gap: var(--space-m);
    display: grid;
  }

  .blog-archive-5-head {
    display: flex;
    flex-direction: column;
    row-gap: var(--flow-spacing);
  }

  .blog-archive-5-head--heading {
    display: flex;
    flex-direction: column;
    row-gap: var(--flow-spacing);
  }

  .blog-archive-5-body {
    display: flex;
    flex-direction: column;
    row-gap: var(--flow-spacing);
    width: 100%;
  }

  .blog-archive-5-wrapper {
    display: grid;
    gap: var(--space-m);
  }

  .blog-archive-5-card {
    display: flex;
    flex-direction: column;
    row-gap: var(--flow-spacing);
    align-items: flex-start;
  }

  .blog-archive-5-card__thumb {
    height: 30rem;
    object-fit: cover;
    width: 100%;
  }

  .blog-archive-5-card__term {
    padding: .3rem .8rem .3rem .8rem;
    background: color-mix(in srgb, var(--action-primary) 40%, transparent);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
  }

  .blog-archive-5-card__author {
    margin: auto 0 0 0;
    display: flex;
    flex-direction: row;
    column-gap: var(--flow-spacing);
    align-items: center;
  }

  .blog-archive-5-card__photo {
    width: 6.8rem;
    height: 6.8rem;
    object-fit: cover;
    border-radius: 100% 100% 100% 100%;
    overflow: hidden;
  }

  /* bm-custom */
  .blog-archive-5-head__form .bricks-search-form {
  	gap: 1.5rem;
  }
  .blog-archive-5-head__form [type="search"] {
  	width: 70% !important;
  }
  .blog-archive-5-head__form [type="submit"] {
  	background-color: var(--action-primary);
    color: var(--bg-canvas);
    width: 30%;
    padding: 10px 15px;
    text-align: center;
    height: auto;
    position: static!important;
    clip-path: unset !important;
  }
  .blog-archive-5-head__form [type="submit"]:focus {
  	border-radius: 0;
    box-shadow: none;
    font-size: 100%;
    font-weight: 400;
    line-height: 100%;
    outline: none;
    padding: 10px;
    text-align: center;
    clip-path: unset;
  }
  .blog-archive-5-head__form [type="submit"] span {
  	height: auto;
    position: static!important;
    width: auto;
  }

  /* bm-custom */
  .blog-archive-5-wrapper {
  	display: grid;
    grid-template-columns: repeat(2, 1fr);
  }
  .blog-archive-5-wrapper .blog-archive-5-card:nth-child(1) {
  	grid-area: 1 / 1 / 2 / 3;
  }
  .blog-archive-5-wrapper .blog-archive-5-card:nth-child(2) {
  	grid-area: 2 / 1 / 3 / 2;
  }
  .blog-archive-5-wrapper .blog-archive-5-card:nth-child(3) {
  	grid-area: 2 / 2 / 3 / 3;
  }
  .blog-archive-5-wrapper .blog-archive-5-card:nth-child(4) {
  	grid-area: 3 / 1 / 4 / 2;
  }
  .blog-archive-5-wrapper .blog-archive-5-card:nth-child(5) {
  	grid-area: 3 / 2 / 4 / 3;
  }
  .blog-archive-5-wrapper .blog-archive-5-card:nth-child(6) {
  	grid-area: 4 / 1 / 5 / 2;
  }
  .blog-archive-5-wrapper .blog-archive-5-card:nth-child(7) {
  	grid-area: 4 / 2 / 5 / 3;
  }
  
  @media (max-width:767px) {
  	.blog-archive-5-wrapper .blog-archive-5-card:nth-child(1) {
  	grid-area: 1 / 1 / 2 / 3;
  }
  .blog-archive-5-wrapper .blog-archive-5-card:nth-child(2) {
  	grid-area: 2 / 1 / 3 / 3;
  }
  .blog-archive-5-wrapper .blog-archive-5-card:nth-child(3) {
  	grid-area: 3 / 1 / 4 / 3;
  }
  .blog-archive-5-wrapper .blog-archive-5-card:nth-child(4) {
  	grid-area: 4 / 1 / 5 / 3;
  }
  .blog-archive-5-wrapper .blog-archive-5-card:nth-child(5) {
  	grid-area: 5 / 1 / 6 / 3;
  }
  .blog-archive-5-wrapper .blog-archive-5-card:nth-child(6) {
  	grid-area: 6 / 1 / 7 / 3;
  }
  .blog-archive-5-wrapper .blog-archive-5-card:nth-child(7) {
  	grid-area: 7 / 1 / 8 / 3;
  }
  }

  /* bm-custom */
  .blog-archive-5-card__term a {
  	color: var(--fs-0);
  }
}
</style>
