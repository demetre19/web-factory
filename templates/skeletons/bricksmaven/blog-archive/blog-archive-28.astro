              <figure class="blog-archive-28-article-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="Image" loading="lazy" width="900" height="600" /></figure>
            </div>
            <div class="blog-archive-28-article-card__content">
              <div class="blog-archive-28-article-card__author">
                <div>
                  <figure class="blog-archive-28-article-card__author-image ratio-portrait"><img src="/media/placeholder.svg" alt="Image" loading="lazy" width="900" height="600" /></figure>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div>
          <div>
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="blog-archive-28-category-list-items card">
                  <a class="text-fluid-0" href={it.href}>{it.label}</a>
                  <span data-icon="lucide" aria-hidden="true"></span>
