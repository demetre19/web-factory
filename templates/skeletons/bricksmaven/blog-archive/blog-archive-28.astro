 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="blog-archive-28__container">
    <div class="blog-archive-28__intro">
      <h1 class="blog-archive-28__heading">{heading}</h1>
    </div>
    <div class="blog-archive-28__archive-articles">
      <div class="blog-archive-28-list list--none">
        <div class="blog-archive-28-article-card">
          <div class="blog-archive-28-article-card__meta-data">
            <div class="blog-archive-28-article-card__terms-wrapper">
              <p class="blog-archive-28-article-card__terms">{post_terms_category:plain}</p>
            </div>
            <div class="blog-archive-28-article-card__date-wrapper">
              <p class="blog-archive-28-article-card__date">{post_date}</p>
            </div>
            <div class="blog-archive-28-article-card__reading-time-wrapper">
              <p class="blog-archive-28-article-card__reading-time">17 minutes</p>
            </div>
          </div>
          <div class="blog-archive-28-article-card__media">
            <figure class="blog-archive-28-article-card__image"><img src="/media/placeholder.svg" alt="Image" loading="lazy" width="900" height="600" /></figure>
          </div>
          <div class="blog-archive-28-article-card__content">
            <h2 class="blog-archive-28-article-card__heading clickable-parent">{post_title}</h2>
            <div class="blog-archive-28-article-card__author">
              <p class="blog-archive-28-article-card__author-name">{author_name}</p>
              <div class="blog-archive-28-article-card__author-media">
                <figure class="blog-archive-28-article-card__author-image"><img src="/media/placeholder.svg" alt="Image" loading="lazy" width="900" height="600" /></figure>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="blog-archive-28__sidebar">
        <div class="list--none blog-archive-28-category-list">
          {items.map((it) => (
            <div class="blog-archive-28-category-list-items">
              <a class="blog-archive-28-category-list-items__text-link" href="#">{it.text}</a>
              <span class="blog-archive-28-category-list-items__icon" data-icon="lucide" aria-hidden="true"></span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

