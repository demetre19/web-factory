    "_cssCustom": ".blog-archive-4-wrapper {\n\tdisplay: grid;\n  grid-template-columns: repeat(2, 1fr);\n}\n.blog-archive-4-wrapper .blog-archive-4-card:nth-child(1) {\n\tgrid-area: 1 / 1 / 2 / 3;\n}\n.blog-archive-4-wrapper .blog-archive-4-card:nth-child(2) {\n\tgrid-area: 2 / 1 / 3 / 2;\n}\n.blog-archive-4-wrapper .blog-archive-4-card:nth-child(3) {\n\tgrid-area: 2 / 2 / 3 / 3;\n}\n.blog-archive-4-wrapper .blog-archive-4-card:nth-child(4) {\n\tgrid-area: 3 / 1 / 4 / 2;\n}\n.blog-archive-4-wrapper .blog-archive-4-card:nth-child(5) {\n\tgrid-area: 3 / 2 / 4 / 3;\n}\n\n@media (max-width:767px) {\n\t.blog-archive-4-wrapper .blog-archive-4-card:nth-child(1) {\n\tgrid-area: 1 / 1 / 2 / 3;\n}\n.blog-archive-4-wrapper .blog-archive-4-card:nth-child(2) {\n\tgrid-area: 2 / 1 / 3 / 3;\n}\n.blog-archive-4-wrapper .blog-archive-4-card:nth-child(3) {\n\tgrid-area: 3 / 1 / 4 / 3;\n}\n.blog-archive-4-wrapper .blog-archive-4-card:nth-child(4) {\n\tgrid-area: 4 / 1 / 5 / 3;\n}\n.blog-archive-4-wrapper .blog-archive-4-card:nth-child(5) {\n\tgrid-area: 5 / 1 / 6 / 3;\n}\n}",
