interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div>
    <div class="shop-hero-3-category-slider__container">
      <div class="shop-hero-3-category-slider__slider">
        <div class="shop-hero-3-category-slider__slide">
          <div class="shop-hero-3-category-slider__content">
            <h2 class="shop-hero-3-category-slider__content">{heading}</h2>
            <a class="shop-hero-3-category-slider__link" href="#">View all</a>
          </div>
          <div class="shop-hero-3-category-slider__media">
            <figure class="shop-hero-3-category-slider__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      </div>
    </div>
    <div class="shop-hero-3__container">
      <div class="shop-hero-3__content">
        <h1 class="shop-hero-3__heading">Product XYZ now 25% OFF!</h1>
        <p class="accent-h">Accent heading</p>
        <div class="shop-hero-3__price-wrapper">
          <p class="shop-hero-3__price">Now $799.99 /</p>
          <p class="shop-hero-3__original-price">$999.99</p>
        </div>
        <div class="shop-hero-3__cta">
          <a class="shop-hero-3__cta btn--white wf-cta-button" href={cta.href}>{cta.label}</a>
          <p class="shop-hero-3__discount-code">Use code: SALE25OFF</p>
        </div>
      </div>
      <div class="shop-hero-3__media">
        <figure class="shop-hero-3__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
    </div>
    <div class="shop-hero-3-featured-product__container">
      <div class="shop-hero-3-featured-product-list list--none">
        {items.map((it) => (
          <div class="shop-hero-3-featured-product-card">
            <div class="shop-hero-3-featured-product-card__content">
              <h2 class="shop-hero-3-featured-product-card__heading">{it.title}</h2>
              <p class="shop-hero-3-featured-product-card__label">{it.text}</p>
            </div>
            <a class="shop-hero-3-featured-product-card__cta btn--white wf-cta-button" href={it.href}>{it.label}</a>
            <div class="shop-hero-3__badge-wrapper">
              <p class="shop-hero-3__sales-badge">{it.text}</p>
            </div>
            <figure class="shop-hero-3-featured-product-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

