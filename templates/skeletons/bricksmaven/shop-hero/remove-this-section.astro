---
/**
 * bm-remove-this-section — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (remove-this-section.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div>
    <div class="sec-inner">
      <div>
        <div>
          <div class="shop-hero-3-category-slider__slide">
            <div class="shop-hero-3-category-slider__content">
              {heading && <h2 class="shop-hero-3-category-slider__content text-fluid-2">{heading}</h2>}
            </div>
            <div>
              <figure class="shop-hero-3-category-slider__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="sec-inner">
      <div>
        <div>
          <div class="shop-hero-3__price-wrapper"></div>
          <div class="shop-hero-3__cta">
            <p class="mt-fluid-m"><a class="wf-cta-button" href={cta.href}>{cta.label || 'Continue'}</a></p>
          </div>
        </div>
        <div>
          <figure class="shop-hero-3__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
      </div>
    </div>
    <div class="sec-inner">
      <div>
        <div class="shop-hero-3-featured-product-list">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="shop-hero-3-featured-product-card card">
                <div class="shop-hero-3-featured-product-card__content">
                  <h2 class="text-fluid-2">{it.title}</h2>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
                <div class="shop-hero-3__badge-wrapper">
                  <p class="text-fluid-0">{it.text}</p>
                </div>
                <figure class="shop-hero-3-featured-product-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
