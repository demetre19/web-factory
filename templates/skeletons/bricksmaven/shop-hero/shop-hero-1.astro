---

<div>
  <div class="shop-hero-1__top-container">
    <div class="shop-hero-1__top">
      <h1 class="shop-hero-1__heading">Long headline to catch the users attention</h1>
    </div>
  </div>
  <div class="shop-hero-1__container">
    <div class="shop-hero-1__choice-container">
      <div class="shop-hero-1-card">
        <div class="shop-hero-1-card__top">
          <h2 class="shop-hero-1-card__heading">Men</h2>
          <div class="cta-combo">
            <a class="btn--white" href="#">Call to action</a>
            <a class="btn--outline btn--white" href="#">Secondary action →</a>
          </div>
        </div>
        <figure class="shop-hero-1-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
      <div class="shop-hero-1-card">
        <div class="shop-hero-1-card__top">
          <h2 class="shop-hero-1-card__heading">Women</h2>
          <div class="cta-combo">
            <a class="btn--white" href="#">Call to action</a>
            <a class="btn--outline btn--white" href="#">Secondary action →</a>
          </div>
        </div>
        <figure class="shop-hero-1-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
    </div>
    <div class="shop-hero-1-usp list--none">
      {items.map((it) => (
        <div class="shop-hero-1-usp-card">
          <span class="shop-hero-1-usp-card__icon" data-icon="lucide" aria-hidden="true"></span>
          <p class="shop-hero-1-usp-card__text">{it.text}</p>
        </div>
      ))}
    </div>
  </div>
</div>

