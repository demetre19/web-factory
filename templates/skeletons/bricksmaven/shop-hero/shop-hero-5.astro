        <a class="bm-link" href="#">Secondary action →</a>
      </div>
    </div>
    <div class="bm-shop-hero-5__grid">
      <div class="bm-shop-hero-5__new-arrival">
        <div class="bm-shop-hero-5__button-wrapper">
          <p class="bm-shop-hero-5__label">New Arrival</p>
          <p class="bm-shop-hero-5__price">$129</p>
        </div>
        <figure class="bm-shop-hero-5__image-alpha"><img src="/media/placeholder.svg" alt="Image" loading="lazy" width="900" height="600" /></figure>
      </div>
      <div class="bm-shop-hero-5__content">
        <div class="bm-shop-hero-5__header">
          <span class="bm-shop-hero-5__counter"></span>
