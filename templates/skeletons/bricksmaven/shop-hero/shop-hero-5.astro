        </div>
        <a class="bm-shop-hero-5__link" href="#">Call to action</a>
      </div>
      <div class="bm-shop-hero-5__limited-offers">
        <div class="bm-shop-hero-5__offer">
          <div class="bm-shop-hero-5__left-column">
            <h2 class="bm-shop-hero-5__offer-heading">Limited Offers</h2>
            <p class="bm-shop-hero-5__offer-text">Up to 50% discount</p>
          </div>
          <span class="bm-shop-hero-5__offer-icon" data-icon="lucide" aria-hidden="true"></span>
        </div>
        <figure class="bm-shop-hero-5__image-beta"><img src="/media/placeholder.svg" alt="Image" loading="lazy" width="900" height="600" /></figure>
