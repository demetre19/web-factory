---
/**
 * bm-shop-hero-5 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (shop-hero-5.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-shop-hero-5__container">
      <div class="bm-shop-hero-5__intro">
        <div class="bm-shop-hero-5__top">
          {heading && <h1 class="text-fluid-4">{heading}</h1>}
          {fs && <p class="text-fluid-0">{fs}</p>}
        </div>
        <div class="cta-combo"></div>
      </div>
      <div class="bm-shop-hero-5__grid">
        <div class="bm-shop-hero-5__new-arrival grid-auto gap-fluid-l">
          <div class="bm-shop-hero-5__button-wrapper"></div>
          <figure class="bm-shop-hero-5__image-alpha ratio-portrait"><img src="/media/placeholder.svg" alt="Image" loading="lazy" width="900" height="600" /></figure>
        </div>
        <div class="bm-shop-hero-5__content">
          <div class="bm-shop-hero-5__header">
            <span></span>
          </div>
        </div>
        <div class="bm-shop-hero-5__limited-offers grid-auto gap-fluid-l">
          <div class="bm-shop-hero-5__offer">
            <div class="bm-shop-hero-5__left-column"></div>
            <span data-icon="lucide" aria-hidden="true"></span>
          </div>
          <figure class="bm-shop-hero-5__image-beta ratio-portrait"><img src="/media/placeholder.svg" alt="Image" loading="lazy" width="900" height="600" /></figure>
        </div>
      </div>
    </div>
    <div></div>
  </div>
</div>
