<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-gallery-15__container {
    row-gap: var(--space-s);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--flow-spacing);
    align-self: center;
  }

  .bm-gallery-15-media {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 12);
    grid-template-rows: calc(100% * 1 / 12);
  }

  .bm-gallery-15-item__image {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  /* bm-custom */
  @media (min-width:478px) {
  
  .bm-gallery-15-item:first-child {
    grid-column: 1/5;
    grid-row:1/9;
  }
  
  .bm-gallery-15-item:nth-child(2) {
    grid-column: 5/9;
    grid-row:1/6;
  }
  
  .bm-gallery-15-item:nth-child(3) {
    grid-column: 5/9;
    grid-row:6/-1;
  }
  
  .bm-gallery-15-item:nth-child(4) {
    grid-column: 9/ -1;
    grid-row:1/9;
  }
  
  
  
  }
