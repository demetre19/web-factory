   "id": "sdcrln",
   "name": "gallery-2-img",
   "settings": {
    "_cssCustom": ".gallery-2-img {\n  display: grid !important;\n  grid-template-columns: repeat(12, 1fr) !important;\n  grid-template-rows: repeat(3, .2fr);\n  gap: var(--space-s) !important;\n}\n\n.gallery-2-img div {\n  border-radius: var(--radius-l);\n  object-fit: cover;\n  width: 100%;\n  height: 100%;\n}\n\n.gallery-2-img li:nth-child(1) {\n\tgrid-area: 1 / 1 / 3 / 7;\n}\n.gallery-2-img li:nth-child(2) {\n\tgrid-area: 3 / 1 / 4 / 4;\n}\n.gallery-2-img li:nth-child(3) {\n\tgrid-area: 3 / 4 / 4 / 7;\n}\n.gallery-2-img li:nth-child(4) {\n\tgrid-area: 1 / 7 / 2 / 10;\n}\n.gallery-2-img li:nth-child(5) {\n\tgrid-area: 1 / 10 / 2 / 13;\n}\n.gallery-2-img li:nth-child(6) {\n\tgrid-area: 2 / 7 / 3 / 10;\n}\n.gallery-2-img li:nth-child(7) {\n\tgrid-area: 3 / 7 / 4 / 10;\n}\n.gallery-2-img li:nth-child(8) {\n\tgrid-area: 2 / 10 / 4 / 13;\n}",
    "_cssCustom:mobile_landscape": ".gallery-2-img {\n\tgap: var(--space-xs);\n}"
   }
  }
