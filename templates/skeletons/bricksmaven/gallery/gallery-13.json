    "_cssCustom": ".gallery-13__carousel-wrapper {\n\t--gradient-color: var(--white); /* Change the color of the gradient*/\n  --gradient-height: 30vh; /* Change the heigth of the gradient*/\n}\n\n.gallery-13__carousel-wrapper::before {\n\tcontent:'';\n  position:absolute;\n  top:0;\n  width:100%;\n  height:var(--gradient-height);\n  background: linear-gradient( var(--gradient-color), transparent ) ;\n  z-index:1;\n}\n\n.gallery-13__carousel-wrapper::after {\n\tcontent:'';\n  position:absolute;\n  bottom:0;\n  width:100%;\n  height:var(--gradient-height);\n  background: linear-gradient( transparent, var(--gradient-color) ) ;\n  z-index:1;\n}",
