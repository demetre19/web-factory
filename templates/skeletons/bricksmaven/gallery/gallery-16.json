   "settings": {
    "_cssCustom": "@media (min-width:768px) {\n\n.bm-gallery-16-item:first-child {\n  grid-column: 1/4;\n  grid-row:1/5;\n}\n\n.bm-gallery-16-item:nth-child(2) {\n  grid-column: 4/7;\n  grid-row:1/5;\n}\n\n.bm-gallery-16-item:nth-child(3) {\n  grid-column: 1/7;\n  grid-row:5/-1;\n}\n\n.bm-gallery-16-item:nth-child(4) {\n  grid-column: 7/ -1;\n  grid-row:1/9;\n}\n\n  .bm-gallery-16-item:nth-child(5) {\n  grid-column: 7/ 10;\n  grid-row:9/-1;\n}\n  \n  .bm-gallery-16-item:nth-child(6) {\n  grid-column: 10/-1;\n  grid-row:9/-1;\n}\n\n\n}\n\n@media (max-width:767px) {\n\n.bm-gallery-16-item:first-child {\n  grid-column: span 2;\n  grid-row:auto;\n}\n\n.bm-gallery-16-item:nth-child(2) {\n  grid-column: span 1;\n  grid-row:auto;\n}\n\n.bm-gallery-16-item:nth-child(3) {\n  grid-column: span 1;\n  grid-row:auto;\n}\n\n.bm-gallery-16-item:nth-child(4) {\n  grid-column: span 2;\n  grid-row:auto;\n}\n\n  .bm-gallery-16-item:nth-child(5) {\n  grid-column: span 1;\n  grid-row:auto;\n}\n  \n  .bm-gallery-16-item:nth-child(6) {\n  grid-column: span 1;\n  grid-row:auto;\n}\n\n\n}"
