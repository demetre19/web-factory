   "custom_css": ".bm-gallery-20-slider {\n   --icon-dimension: 64px; /* Change the icon dimensions*/\n  --icon-size: 16px; /* Change the icon size*/\n  --icon-opacity: 0.5;  /* Change the icon opacity*/\n  inline-size: var(--width-xl) !important;\n}\n\n\n.bm-gallery-20-slider .splide__track {\n  overflow:visible;\n}\n\n\n.bm-gallery-20-slider .is-active {\n  inline-size: 100% !important;\n  max-inline-size: 100% !important;\n}\n\n\n.bm-gallery-20-slider .splide__arrow--next {\n  left: var(--space-s);\n  transition: 0.5s ease;\n}\n\n.bm-gallery-20-slider .splide__arrow--prev {\n  left: calc(-1 * var(--icon-dimension));\n  transition: 0.5s ease;\n}\n\n.bm-gallery-20-slider .splide__arrows {\n    position: absolute;\n    inset-block-end: calc(-1 * var(--section-space-s));\n  \tinset-inline-start: var(--icon-dimension);\n  left:50%\n   \t\n}\n\n  .bm-gallery-20-slider .is-active .bm-gallery-20-media__video {\n  transform: scaleY(1.05) scaleX(1.05);\n    \n}\n  \n  .bm-gallery-20-slider .bm-gallery-20-media__video {\n  transform: scaleY(0.8) scaleX(0.8);\n    transition: 0.2s cubic-bezier(0.25, 0.1, 0.25, 1);\n}\n\n@media (max-width:767px) {\n  \n  .bm-gallery-20-slider {\n   --icon-dimension: 40px; /* Change the icon dimensions*/\n  --icon-size: 16px; /* Change the icon size*/\n  --icon-opacity: 0.5;  /* Change the icon opacity*/\n}\n\n\n}\n\n\n\n",
