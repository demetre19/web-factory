---
/**
 * bm-empty-cart — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (empty-cart.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-empty-cart__container">
      <div class="bm-empty-cart__content">
        {heading && <h1 class="text-fluid-4">{heading}</h1>}
        <span data-icon="lucide" aria-hidden="true"></span>
        <div class="cta-combo">
          <p class="mt-fluid-m"><a class="wf-cta-button" href={cta.href}>{cta.label || 'Continue'}</a></p>
        </div>
      </div>
    </div>
    <div class="bm-product-list-1__container">
      <div class="intro">
        {fs && <p class="text-fluid-0">{fs}</p>}
      </div>
      <div class="bm-product-list-1__list">
        <div class="bm-product-list-1-card grid-auto gap-fluid-l">
          <div class="bm-product-list-1-card__content">
            <div class="bm-product-list-1-card__top"></div>
            <div></div>
          </div>
          <div class="bm-product-list-notice__wrapper">
            <div class="bm-product-list-notice-circle__sale-badge"></div>
          </div>
          <figure class="bm-product-list-1-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
      </div>
    </div>
  </div>
</div>
