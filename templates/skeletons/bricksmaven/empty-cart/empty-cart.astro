    row-gap: calc( var(--flow-spacing) / 2 );
    object-fit: cover;
  }

  /* bm-custom */
  .bm-product-list-category a {
    	color: var(--text-primary);
    	background: transparent;
  }

  /* bm-custom */
  .bm-product-list-card__price del {
    	color: var(--bg-subtle);
  }
  
  .bm-product-list-card__price ins {
    	text-decoration: none;
  }
  .bm-product-list-card__price ins .amount {
    	text-decoration: none;
    	border-bottom: 0;
  }

  /* bm-custom */
  .bm-product-list-card__add-to-cart form.cart .quantity, form.woocommerce-cart-form .quantity {
      width: 100%;
  }
    
  form.cart .button, form.woocommerce-cart-form .button {
  
      width: 100%;
  }
}
</style>
