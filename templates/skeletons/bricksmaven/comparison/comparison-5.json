  {
   "id": "olvxcb",
   "name": "bm-comparison-5-step-item",
   "settings": {
    "_display": "flex",
    "_flexWrap": "nowrap",
    "_direction": "column",
    "_cssCustom": "/* Step item */\n\n.bm-comparison-5-step-item {\n  flex-basis:100%;\n  \n  --step-card-border:var(--base-light);\n  \n  --marker-circle-bg:var(--base-semi-light);\n  --marker-circle-radius:var(--radius-circle);\n  --marker-circle-bg-before:var(--base-light);\n  --marker-circle-radius-before:var(--radius-circle);\n  \n  --marker-arrow-bg:var(--base-semi-light);\n  --marker-arrow-border:var(--base-semi-light);\n}\n\n.bm-comparison-5-step-item:last-child {\n  flex-basis:65%;\n}\n\n.bm-comparison-5-step-item:last-child .bm-comparison-5-step-item__arrow {\n  display:none;\n}\n\n\n/* Marker Circle*/\n\n.bm-comparison-5-step-item  .bm-comparison-5-step-item__circle{\n  inline-size: 24px;\n  block-size:24px;\n  position:relative;\n  background-color: var(--marker-circle-bg);\n  border-radius: var(--marker-circle-radius);\n}\n\n.bm-comparison-5-step-item .bm-comparison-5-step-item__circle::before {\n  content:'';\n  position:absolute;\n  inset-block-start: 50%;\n  inset-inline-start: 50%;\n  inline-size: 8px;\n  block-size:8px;\n  background-color: var(--marker-circle-bg-before);\n  transform: translateY(-50%) translateX(-50%);\n  border-radius: var(--marker-circle-radius-before);\n}\n\n/* Marker Arrow */\n\n.bm-comparison-5-step-item  .bm-comparison-5-step-item__arrow{\n  inline-size: 100%;\n  block-size:1.5px;\n  position:relative;\n  background-color: var(--marker-arrow-bg);\n}\n\n.bm-comparison-5-step-item .bm-comparison-5-step-item__arrow::before {\n  content: \"\";\n  border: 4px solid var(--marker-arrow-border);\n  border-color: var(--marker-arrow-border) var(--marker-arrow-border) transparent transparent;\n  position: absolute;\n  inset-inline-end: 0;\n  transform: translateY(-40%) rotate(45deg);\n}\n\n@media (max-width:767px) {\n  \n  \n  .bm-comparison-5-step-item {\n    border-bottom: 1px solid var(--step-card-border);\n}\n\n.bm-comparison-5-step-item:last-child {\n  border-bottom: none;\n}\n  \n}",
