interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-comparison-2__container">
    <div class="intro">
      <h2 class="intro__heading">{heading}</h2>
      <p class="intro__subheading">{fs}</p>
      <p class="bm-accent-heading">Accent heading</p>
    </div>
    <div class="bm-comparison-2-list list--none">
      <div class="bm-comparison-2-card">
        <h2 class="bm-comparison-2-card__heading">You’re a great fit if…</h2>
        <div class="bm-comparison-2-check-list list--none">
          {items.map((it) => (
            <div class="bm-comparison-2-check-item">
              <div class="bm-comparison-2-check-item__icon-wrapper">
                <span class="bm-comparison-2-check-item__icon" data-icon="lucide" aria-hidden="true"></span>
              </div>
              <p>{it.text}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="bm-comparison-2-card">
        <h2 class="bm-comparison-2-card__heading">We’re not the right fit if…</h2>
        <div class="bm-comparison-2-check-list list--none">
          {items.map((it) => (
            <div class="bm-comparison-2-check-item">
              <div class="bm-comparison-2-check-item__icon-wrapper">
                <span class="bm-comparison-2-check-item__icon" data-icon="lucide" aria-hidden="true"></span>
              </div>
              <p>{it.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="bm-comparison-2__footer">
      <a class="btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
    </div>
  </div>
</div>

