---
/**
 * bm-comparison-1 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (comparison-1.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-conparison-1__container">
    <div class="intro">
      <h2 class="intro__heading">Long headline to turn your visitors into customers</h2>
      <p class="intro__subheading">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
      <p class="bm-accent-heading">Accent heading</p>
    </div>
    <div class="bm-conparison-1-list">
      <div class="bm-conparison-1-card bm-conparison-1-card--before">
        <div class="bm-conparison-status bm-conparison-status--before">
          <p class="bm-conparison-status__label">Before</p>
        </div>
        <div class="bm-conparison-1-card__media">
          <figure class="bm-conparison-1-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
        <div class="bm-list">
          {items.map((it) => (
            <div class="bm-list-item">
              <div class="bm-list-item__icon-wrapper bm-list-item__icon-wrapper--before">
                <span class="bm-list-item__icon" data-icon="lucide" aria-hidden="true"></span>
              </div>
              <p class="bm-list-item__text bm-list-item__text--alt">{it.text}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="bm-conparison-1-card">
        <div class="bm-conparison-status">
          <p class="bm-conparison-status__label">After</p>
        </div>
        <div class="bm-conparison-1-card__media">
          <figure class="bm-conparison-1-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
        <div class="bm-list list--none">
          {items.map((it) => (
            <div class="bm-list-item">
              <div class="bm-list-item__icon-wrapper bm-list-item__icon-wrapper--after">
                <span class="bm-list-item__icon" data-icon="lucide" aria-hidden="true"></span>
              </div>
              <p class="bm-list-item__text">{it.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="bm-conparison-1__footer">
      <p class="bm-conparison-1__footer-text">Final push to get the reader to take action</p>
      <div class="cta-combo">
        <a class="wf-cta-button" href={cta.href}>{cta.label}</a>
        <a href="#">Secondary action →</a>
      </div>
    </div>
  </div>
</div>

<style is:global>
