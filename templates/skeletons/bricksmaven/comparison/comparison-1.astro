    align-items: center;
    padding: var(--fs-0) var(--fs-0) var(--fs-0) var(--fs-0);
    background: var(--bg-subtle);
    border-radius: var(--fs-0) var(--fs-0) var(--fs-0) var(--fs-0);
  }

  .bm-conparison-status--before {
    background: var(--acss-dark-l-6);
  }

  .bm-conparison-1-card__image {
