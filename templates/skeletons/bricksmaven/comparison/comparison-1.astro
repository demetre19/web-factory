---
/**
 * bm-comparison-1 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (comparison-1.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-conparison-1__container">
      <div class="intro">
        {heading && <h2 class="text-fluid-2">{heading}</h2>}
        {fs && <p class="text-fluid-0">{fs}</p>}
      </div>
      <div class="bm-conparison-1-list">
        <div class="bm-conparison-1-card">
          <div class="bm-conparison-status"></div>
          <div>
            <figure class="bm-conparison-1-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
          <div class="bm-list">
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="bm-list-item card">
                  <div class="bm-list-item__icon-wrapper">
                    <span data-icon="lucide" aria-hidden="true"></span>
                  </div>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="bm-conparison-1-card">
          <div class="bm-conparison-status"></div>
          <div>
            <figure class="bm-conparison-1-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
          <div class="bm-list">
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="bm-list-item card">
                  <div class="bm-list-item__icon-wrapper">
                    <span data-icon="lucide" aria-hidden="true"></span>
                  </div>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
      <div class="bm-conparison-1__footer">
        <div class="cta-combo">
          <p class="mt-fluid-m"><a class="wf-cta-button" href={cta.href}>{cta.label || 'Continue'}</a></p>
        </div>
      </div>
    </div>
  </div>
</div>
