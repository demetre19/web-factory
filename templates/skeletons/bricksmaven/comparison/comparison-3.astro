          <div></div>
          <div class="bm-comparison-3-list">
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="bm-comparison-3-card card">
                  <div class="bm-comparison-3-card__icon-wrapper">
                    <span data-icon="lucide" aria-hidden="true"></span>
                  </div>
                  <div class="bm-comparison-3-card__content">
                    <h4 class="text-fluid-2">{it.title}</h4>
                    <p class="text-fluid-0">{it.text}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="bm-comparison-3__column">
          <div></div>
          <div class="bm-comparison-3-list">
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="bm-comparison-3-card card">
                  <div class="bm-comparison-3-card__icon-wrapper">
                    <span data-icon="lucide" aria-hidden="true"></span>
                  </div>
                  <div class="bm-comparison-3-card__content">
                    <h4 class="text-fluid-2">{it.title}</h4>
                    <p class="text-fluid-0">{it.text}</p>
                    <div class="bm-comparison-3-card__micro-wrapper">
                      <p class="text-fluid-0">{it.text}</p>
                      <span data-icon="lucide" aria-hidden="true"></span>
                    </div>
                  </div>
