---
/**
 * bm-comparison-3 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (comparison-3.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-comparison-3__container">
    <div class="intro">
      <h2 class="intro__heading">{heading}</h2>
      <p class="intro__subheading">{fs}</p>
      <p class="bm-accent-heading">Accent heading</p>
    </div>
    <div class="bm-comparison-3__grid">
      <div class="bm-comparison-3__column">
        <div class="bm-comparison-3__top">
          <h2 class="bm-comparison-3__top-heading">The challenges</h2>
          <p class="bm-comparison-3__top-text">Do you recognize these problems in your business?</p>
        </div>
        <div class="bm-comparison-3-list">
          {items.map((it) => (
            <div class="bm-comparison-3-card">
              <div class="bm-comparison-3-card__icon-wrapper">
                <span class="bm-comparison-3-card__icon" data-icon="lucide" aria-hidden="true"></span>
              </div>
              <div class="bm-comparison-3-card__content">
                <h4 class="bm-comparison-3-card__heading">{it.title}</h4>
                <p class="bm-comparison-3-card__text">{it.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="bm-comparison-3__column">
        <div class="bm-comparison-3__top">
          <h2 class="bm-comparison-3__top-heading">Our solution</h2>
          <p class="bm-comparison-3__top-text">We take repetitive tasks off your hands, so you can focus on growth.</p>
        </div>
        <div class="bm-comparison-3-list">
          {items.map((it) => (
            <div class="bm-comparison-3-card">
              <div class="bm-comparison-3-card__icon-wrapper">
                <span class="bm-comparison-3-card__icon" data-icon="lucide" aria-hidden="true"></span>
              </div>
              <div class="bm-comparison-3-card__content">
                <h4 class="bm-comparison-3-card__heading">{it.title}</h4>
                <p class="bm-comparison-3-card__text">{it.text}</p>
                <div class="bm-comparison-3-card__micro-wrapper">
                  <p class="bm-comparison-3-card__microcopy">{it.text}</p>
                  <span class="bm-comparison-3-card__micro-icon" data-icon="lucide" aria-hidden="true"></span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-comparison-3__container {
    row-gap: var(--space-s);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--flow-spacing);
    align-self: center;
    width: 100%;
  }

  .bm-comparison-3__grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 2);
  }

  .bm-comparison-3__column {
    row-gap: var(--flow-spacing);
  }

  .bm-comparison-3-list {
    margin: 0 0 0 0;
    padding: 0 0 0 0;
    row-gap: var(--flow-spacing);
  }

  .bm-comparison-3-card {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    column-gap: calc(var(--flow-spacing) / 2);
    background: var(--bg-canvas);
    border-top: 1px solid var(--fs-0);
    border-right: 1px solid var(--fs-0);
    border-bottom: 1px solid var(--fs-0);
    border-left: 1px solid var(--fs-0);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
  }

  .bm-comparison-3-card__icon-wrapper {
    width: 48px;
    height: 48px;
    justify-content: center;
    align-items: center;
    display: flex;
    background: var(--fs-0);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
  }

  .bm-comparison-3-card__content {
    display: flex;
    row-gap: calc(var(--flow-spacing) / 6);
  }

  .bm-comparison-3-card__micro-wrapper {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    column-gap: calc(var(--flow-spacing) / 4);
  }

  .bm-comparison-3-card__microcopy {
    font-size: var(--fs-0);
    font-weight: 700;
  }

  /* bm-custom */
  .bm-comparison-3-card[data-state='solution'] {
    background-color: var(--action-primary);
    border-color: var(--action-primary);
  }
  
  .bm-comparison-3-card[data-state='solution'] .bm-comparison-3-card__icon-wrapper {
    background-color: var(--action-primary);
  }
  
  .bm-comparison-3-card[data-state='solution'] .bm-comparison-3-card__icon {
    color: var(--action-primary);
  }
  
  .bm-comparison-3-card[data-state='solution'] .bm-comparison-3-card__micro-wrapper {
    color: var(--action-primary);
  }
</style>
