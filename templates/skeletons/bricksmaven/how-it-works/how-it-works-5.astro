---
/**
 * bm-how-it-works-5 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (how-it-works-5.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="hworks-5-container">
      <div class="hworks-5-content">
        <div class="hworks-intro hworks-intro--alt">
          {heading && <h2 class="hworks-intro__heading text-fluid-2">{heading}</h2>}
          {fs && <p class="text-fluid-0">{fs}</p>}
        </div>
        <div class="hworks-5-list">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="hworks-5-list-item card">
                <div>
                  <p class="text-fluid-0">{it.text}</p>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <p class="mt-fluid-m"><a class="wf-cta-button" href={cta.href}>{cta.label || 'Continue'}</a></p>
      </div>
      <div>
        <figure class="hworks-5-media__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
    </div>
  </div>
