   "name": "hworks-11-grid-list",
   "settings": {
    "_cssCustom": ".hworks-11-grid-list {\n/* Define & Initialize Counter */\n\tcounter-reset: hworks-counter;\n  \n}\n\n\n.hworks-11-grid-list li::before {\n  /* Increment Counter */\n  counter-increment: hworks-counter;\n  /* Display Counter */\n  content: counters(hworks-counter,\".\") \" \";\n  background-color: var(--primary-light-trans-40);\n  padding-inline:4rem;\n  padding-block:2rem;\n  color:var(--primary);\n  font-size: var(--text-xl);\n  border-radius: var(--radius-50);\n}",
    "_display": "grid",
    "_gridTemplateColumns": "repeat(3, minmax(0, 1fr))",
    "_gridGap": "var(--grid-gap)",
    "_alignItemsGrid": "center",
    "_gridTemplateColumns:mobile_landscape": "repeat(2, minmax(0, 1fr))",
    "_gridTemplateColumns:mobile_portrait": "repeat(1, minmax(0, 1fr))",
    "_position": "relative",
    "_zIndex": "1"
   }
