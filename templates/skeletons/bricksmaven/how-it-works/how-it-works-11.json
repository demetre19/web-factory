      "raw": "var(--box-shadow-l)"
     }
    },
    "_cssCustom": "\n\n@media (min-width:767px){\n\t.hworks-11-card:nth-child(3) {\n\tgrid-column-start: 2;\n}\n\n.hworks-11-card:last-child {\n\tgrid-column-start: 3;\n \n  grid-row: 1/3;\n}\n\n.hworks-11-card:first-child {\n  grid-row: span 2;\n}\n}"
