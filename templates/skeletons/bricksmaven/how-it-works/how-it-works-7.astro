interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="hworks-7-container">
    <div class="hworks-7-content list--none">
      {items.map((it) => (
        <div class="hworks-7-card">
          <div class="hworks-7-card__media">
            <figure class="hworks-7-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
          <h2 class="hworks-7-card__heading">{it.title}</h2>
          <p class="hworks-7-card__desc">{it.text}</p>
        </div>
      ))}
    </div>
    <span class="hworks-icon" data-icon="lucide" aria-hidden="true"></span>
  </div>
</div>

<style is:global>
@layer components {
  .hworks-7-content {
    position: relative;
    display: grid;
    gap: var(--section-space-xxl);
    grid-template-columns: repeat(3, 1fr);
  }

  .hworks-7-card {
    display: flex;
    flex-direction: column;
    row-gap: var(--space-s);
    text-align: center;
    align-items: center;
    position: relative;
    justify-content: center;
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
  }

  .hworks-7-card__media {
    display: flex;
    align-items: center;
  }

  .hworks-7-card__image {
    width: 14.8rem;
    height: 14.8rem;
    object-fit: cover;
    overflow: hidden;
    border-radius: 100% 100% 100% 100%;
  }

  .hworks-7-card__heading {
    text-transform: uppercase;
  }

  .hworks-icon {
    display: none;
  }

  /* bm-custom */
  .hworks-7-card::after  {
    content: "\e628";
    font-family: 'themify';
    color: var(--action-primary);
    position: absolute;
    right: -6rem;
  }
  
  .hworks-7-card:last-child::after  {
    content: none;
  }
}
</style>
