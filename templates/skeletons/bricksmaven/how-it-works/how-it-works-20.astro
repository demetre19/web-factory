    border-right: .1rem solid var(--bg-subtle);
    border-bottom: .1rem solid var(--bg-subtle);
    border-left: .1rem solid var(--bg-subtle);
  }

  .hworks-20-card__image {
    object-fit: cover;
    height: 20rem;
    width: 100%;
  }

  /* bm-custom */
  .hworks-20-list {
  /* Define & Initialize Counter */
  	counter-reset: hworks-counter;
    
  }
  
  
  .hworks-20-list li::before {
    /* Increment Counter */
    counter-increment: hworks-counter;
    /* Display Counter */
    content: counters(hworks-counter,".") " ";
    background-color: var(--action-primary);
    padding-inline:.9rem;
    padding-block:.3rem;
    color:var(--bg-canvas);
    font-size: var(--fs-0);
