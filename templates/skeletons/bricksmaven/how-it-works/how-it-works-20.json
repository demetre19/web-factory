  {
   "id": "mkfoum",
   "name": "hworks-20-list",
   "settings": {
    "_cssCustom": ".hworks-20-list {\n/* Define & Initialize Counter */\n\tcounter-reset: hworks-counter;\n  \n}\n\n\n.hworks-20-list li::before {\n  /* Increment Counter */\n  counter-increment: hworks-counter;\n  /* Display Counter */\n  content: counters(hworks-counter,\".\") \" \";\n  background-color: var(--primary);\n  padding-inline:.9rem;\n  padding-block:.3rem;\n  color:var(--white);\n  font-size: var(--text-xs);\n  font-weight: 400;\n  border-radius: var(--radius-50);\n  position:absolute;\n  left:50%;\n  transform: translateX(-50%);\n}\n\n@media (max-width:767px) {\n\n  .hworks-20-list li::before {\n  left:-1rem;\n  transform: translateX(0%);\n}\n}\n"
   }
  },
  {
   "id": "acss_import_list--none",
   "name": "list--none",
   "settings": []
  },
  {
   "id": "aijagw",
   "name": "hworks-20-card",
   "settings": {
    "_display": "grid",
    "_gridTemplateColumns": "repeat(12, minmax(0, 1fr))",
    "_gridGap": "var(--grid-gap)",
    "_position": "relative",
    "_cssCustom": ".hworks-20-card:nth-child(even) .hworks-20-card__media {\n\torder: -1;\n}\n\n.hworks-20-card:nth-child(even) .hworks-20-card__content {\n\torder: 1;\n}\n\n@media (max-width:767px) {\n\t.hworks-20-card:nth-child(even) .hworks-20-card__media {\n\torder: unset;\n  grid-column: span 11;\n}\n\n.hworks-20-card:nth-child(even) .hworks-20-card__content {\n\torder: 2;\n  grid-column: span 11;\n}\n  \n\t.hworks-20-card:nth-child(odd) .hworks-20-card__content {\n\torder: 2;\n  grid-column: span 11;\n}  \n  \n  \t.hworks-20-card:nth-child(odd) .hworks-20-card__media {\n\tgrid-column: span 11;\n}\n  \n  .hworks-20-card .hworks-20-card__line-wrapper {\n\torder: -1;\n}\n  \n  .hworks-20-card__line-wrapper {\n\tgrid-column: span 1 !important;\n  grid-row: span 2;\n}\n}"
   }
  },
