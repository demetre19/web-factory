 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="hworks-13-container">
    <div class="intro intro--left">
      <h2 class="intro__heading">{heading}</h2>
      <p class="intro__subheading">{fs}</p>
      <p class="intro__accent-heading">Tagline</p>
    </div>
    <div class="hworks-13-list list--none">
      {items.map((it) => (
        <div class="hworks-13-card">
          <div class="hworks-13-card__content">
            <h2 class="hworks-13-card__heading">{it.title}</h2>
            <p class="hworks-13-card__text">{it.text}</p>
          </div>
          <div class="hworks-13-card__media">
            <figure class="hworks-13-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .hworks-13-container {
    row-gap: var(--space-s);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .intro--left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    align-self: flex-start;
  }

  .hworks-13-list {
    row-gap: var(--flow-spacing);
  }

  .hworks-13-card {
    display: grid;
    grid-template-columns: calc(100% * 1 / 2);
    padding: var(--space-m) var(--space-m) var(--space-m) calc(var(--section-space-xxl) * 2);
    background: var(--bg-canvas);
  }

  .hworks-13-card__content {
    display: flex;
    flex-direction: column;
    row-gap: var(--flow-spacing);
    height: 100%;
    justify-content: center;
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    background: var(--action-primary);
  }

  .hworks-13-card__image {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  /* bm-custom */
  .hworks-13-list {
  /* Define & Initialize Counter */
  	counter-reset: hworks-counter;
    
  }
  
  
  .hworks-13-list li::before {
    /* Increment Counter */
    counter-increment: hworks-counter;
    /* Display Counter */
    content: counters(hworks-counter,".") " ";
    color:var(--bg-subtle);
    font-size: calc(var(--fs-4) * 4);
    font-weight: 400;
    position:absolute;
    left: var(--space-l);
    top:50%;
    transform: translateY(-50%);
    
  }

  /* bm-custom */
  /* Set all cards to position sticky */
  .hworks-13-card {
  	position: sticky;
    transition: .5s linear;
    --sticky-top: var(--space-l);
  }
  
  /* Set box shadow on Card hover */
  .hworks-13-card:hover {
  	box-shadow: var(--shadow-card);
  }
  
  .hworks-13-card:first-child {
  	top: var(--acss-sticky-top);
  }
  
  .hworks-13-card:nth-child(2) {
  	top: calc(var(--acss-sticky-top) * 3);
  }
  
  .hworks-13-card:nth-child(3) {
  	top: calc(var(--acss-sticky-top) * 5);
  }
  
  .hworks-13-card:last-child {
  	position: relative;
    top: calc(var(--acss-sticky-top));
  }
</style>
