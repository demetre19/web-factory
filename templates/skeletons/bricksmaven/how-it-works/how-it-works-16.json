   "name": "hworks-16-card",
   "settings": {
    "_rowGap": "var(--content-gap)",
    "_padding": {
     "top": "var(--space-m)",
     "right": "var(--space-m)",
     "bottom": "var(--space-m)",
     "left": "var(--space-m)"
    },
    "_display": "flex",
    "_direction": "column",
    "_alignItems": "center",
    "_typography": {
     "text-align": "center"
    },
    "_cssCustom": ".hworks-16-card::after {\n\tcontent: \"\";\n  position: absolute;\n  top: 50%;\n  right: calc(var(--grid-gap) * -1);\n  width: var(--grid-gap);\n  border: 1px dashed var(--shade);\n}\n\n.hworks-16-card:last-child::after {\n\tdisplay: none;\n}\n\n.hworks-16-card__icon {\n\ttransition: .5s linear;\n}\n\n.hworks-16-card:hover .hworks-16-card__icon {\n\tbackground-color: var(--primary);\n  color: var(--white);\n}\n\n\n@media (max-width:767px) {\n\t.hworks-16-card::after {\n\tcontent: \"\";\n  position: absolute;\n  top: 100%;\n  right: unset;\n  left: 50%;\n  width: 0;\n  height: var(--grid-gap);\n  border: 1px dashed var(--shade);\n}\n}",
    "_position": "relative"
   }
  },
