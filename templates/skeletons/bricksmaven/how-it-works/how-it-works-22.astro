 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="hworks-22-container">
    <div class="intro">
      <h2 class="intro__heading">{heading}</h2>
      <p class="intro__subheading">{fs}</p>
      <p class="intro__accent-heading">Accent heading</p>
    </div>
    <div class="hworks-22-tabs">
      <div class="hworks-22-tab-menu">
        {items.map((it) => (
          <div class="hworks-22-tabs__title">
            <p class="hworks-22-tabs__number">{it.text}</p>
          </div>
        ))}
      </div>
      <div class="hworks-22-tab-content">
        {items.map((it) => (
          <div class="hworks-22-tabs__pane">
            <div class="hworks-22-tabs__content">
              <div class="hworks-22-tabs__intro">
                <h2 class="hworks-22-tabs__heading">{it.title}</h2>
                <p class="hworks-22-tabs__text">{it.text}</p>
              </div>
              <div class="hworks-22-tabs__media">
                <figure class="hworks-22-tabs__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

