    "height": "auto",
    "gap": "var(--content-gap)",
    "prevArrowTop": "calc(100% + var(--space-xl))",
    "nextArrowTop": "calc(100% + var(--space-xl))",
    "arrowDisabledBackground": {
     "id": "acss_import_neutral-ultra-light",
     "name": "neutral-ultra-light",
