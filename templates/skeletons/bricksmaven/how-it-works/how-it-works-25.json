    "_cssCustom": ".bm-how-it-works-25__content::before {\n  content: '';\n  position: absolute;\n  inline-size: 100vw;\n  block-size: 100%;\n  background-color: var(--white);\n  margin-inline-start: calc(-1 * 100vw);\n  z-index: 1;\n  \n}",
