      "bottom": "1px",
      "left": "1px"
     },
     "style": "solid",
     "color": {
      "id": "acss_import_neutral-semi-light",
      "name": "neutral-semi-light",
      "raw": "var(--neutral-semi-light)"
     }
    },
    "_cssCustom": ".bm-how-it-works-25__slider-nested .splide__track {\n  overflow: visible;\n}\n\n.bm-how-it-works-25__slider-nested .splide__arrow--next {\n    left: 64px;\n}\n\n/* Counter for Card heading*/\n.bm-how-it-works-25__slider-nested {\n  counter-reset: hworks; /* Start counting from 0 */\n  --counter-size: 42px;\n}\n\n.bm-how-it-works-25__slider-nested .bm-how-it-works-25-card {\n  counter-increment: hworks; /* Add 1 each time we see an <h2> */\n  gap: var(--content-gap);\n  display: flex;\n  align-items: center;\n}\n\n\n.bm-how-it-works-25__slider-nested .bm-how-it-works-25-card .bm-how-it-works-25-card__heading {\n  padding-inline-start: calc(var(--counter-size) * 1.4);\n  position: relative;\n  \n}\n\n.bm-how-it-works-25__slider-nested .bm-how-it-works-25-card .bm-how-it-works-25-card__heading::before {\n  content: counter(hworks) \" \"; /* Display the number */\n  position: absolute;\n  inline-size: var(--counter-size);\n  block-size: var(--counter-size);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  inset-inline-start: 0;\n  inset-block-start: -4px;\n  font-size: var(--text-s);\n  background: var(--neutral-semi-light);\n  border-radius: var(--radius-circle);\n  \n}\n\n"
   },
