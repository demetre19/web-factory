   "custom_css": "/* Counter on step element */\n\n.bm-how-it-works-26-list {\n  --hw-vertical-line: var(--neutral-light);\n  --hw-counter-color: var(--neutral-light);\n  counter-reset: step;\n}\n\n.bm-how-it-works-26-list .bm-how-it-works-26-card__step {\n  counter-increment: step;\n}\n\n.bm-how-it-works-26-list .bm-how-it-works-26-card__step::before {\n  content: '0' counter(step);\n  color: var(--hw-counter-color);\n}\n\n/* Horizontal line full width */\n\n.bm-how-it-works-26-list::before {\n  content:'';\n  position: absolute;\n  inline-size: 100vw;\n  max-inline-size: 100vw;\n  margin-inline-start: -50vw;\n  margin-block-start: 50px;\n  inset-inline-start:50%;\n  block-size: 2px;\n  background-color: var(--hw-vertical-line);\n  z-index: -1;\n}\n\n@media (max-width:991px) {\n  \n  \n  .bm-how-it-works-26-list::before {\n  inline-size: 2px;\n  max-inline-size: 2px;\n  margin-inline-start: unset;\n  margin-block-start: unset;\n  inset-inline-start:calc(var(--gutter) + 0.9em);\n  block-size: 100%;\n}\n  \n}",
   "tokens": [
