    },
    "_rowGap:tablet_portrait": "calc(var(--content-gap) / 2)"
   },
   "sizing": {},
   "typography": {},
   "colour": {},
   "radius": {},
   "custom_css": ".bm-how-it-works-26-card {\n  --highlight-bg-color: var(--base);\n  --highlight-color: var(--white);\n  --highlight-border-color: var(--base-light);\n  \n  --box-shadow: var(--box-shadow-xl);\n  --hw-translate-y: calc(-1 * var(--space-xs));\n}\n\n@media (min-width:991px) {\n\n.bm-how-it-works-26-card .bm-how-it-works-26-card__inner {\n  transition: 0.2s ease;\n}\n\n.bm-how-it-works-26-card:hover .bm-how-it-works-26-card__inner {\n  box-shadow: var(--box-shadow);\n  transform: translateY(var(--hw-translate-y));\n}\n\n.bm-how-it-works-26-card:hover .bm-how-it-works-26-card__circle {\n  scale: 1.1;\n}\n  \n.bm-how-it-works-26-card[data-highlight='true']:hover .bm-how-it-works-26-card__circle {\n  scale: 1.3;\n}\n  \n  \n}\n\n/* Data-highlight styling */\n\n.bm-how-it-works-26-card[data-highlight='true'] .bm-how-it-works-26-card__inner {\n  background-color: var(--highlight-bg-color);\n}\n\n.bm-how-it-works-26-card[data-highlight='true'] .bm-how-it-works-26-card__circle {\n  scale: 1.2;\n  background-color: var(--highlight-bg-color);\n  border: 2px solid var(--highlight-border-color);\n  \n}\n\n\n.bm-how-it-works-26-card[data-highlight='true'] .bm-how-it-works-26-card__text {\n  color: var(--highlight-color);\n}\n\n\n.bm-how-it-works-26-card[data-highlight='true'] .bm-how-it-works-26-card__heading {\n  color: var(--highlight-color);\n}\n\n/* Show highlight */\n\n.bm-how-it-works-26-card[data-highlight='true'] .bm-how-it-works-26-card__highlight {\n  display:flex;\n}\n\n\n",
