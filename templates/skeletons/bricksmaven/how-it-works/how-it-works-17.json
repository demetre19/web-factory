    "_cssCustom": ".hworks-17-list {\n/* Define & Initialize Counter */\n\tcounter-reset: hworks-counter;\n}\n\n\n.hworks-17-list li::before {\n  /* Increment Counter */\n  counter-increment: hworks-counter;\n  /* Display Counter */\n  content: counters(hworks-counter,\".\") \" \";\n  background-color: var(--primary-light);\n  padding-inline:2.2rem;\n  padding-block:1.2rem;\n  color:var(--primary);\n  font-size: var(--text-m);\n  font-weight: 700;\n  border-radius: var(--radius-circle);\n  position:absolute;\n  left: var(--space-m);\n    top:var(--space-xl);\n  transform: translateY(-50%);\n}",
