    "_cssCustom": ".hworks-9-grid-ul {\n/* Define & Initialize Counter */\n\tcounter-reset: hworks-counter;\n  \n}\n\n\n.hworks-9-grid-ul li::before {\n  /* Increment Counter */\n   counter-increment: hworks-counter;\n  /* Display Counter */\n  content: counters(hworks-counter,\".\") \"\";\n  background-color: var(--primary);\n  padding-inline:1.8rem;\n  padding-block:1rem;\n  color:var(--white);\n  font-size: var(--text-m);\n  font-weight: 700;\n  border-radius: var(--radius-50)\n  \n}\n\n.hworks-9-grid-ul li::after {\n  content: \"step\";\n  padding-inline:1.8rem;\n  padding-block:1rem;\n  color:var(--base);\n  font-size: var(--text-m);\n  position: absolute;\n  left: -10px;\n  top: 60%;\n}",
