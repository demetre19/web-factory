---

<div class="wf-how-it-works-28">
  <div class="sec-inner">
    <div class="bm-how-it-works-28__container">
      {list.length > 0 &&       <div>
        {list.length > 0 && <div class="grid-auto gap-fluid-m">{(list || []).map((it) => (
