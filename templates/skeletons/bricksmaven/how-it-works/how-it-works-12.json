    "_cssCustom": ".hworks-12-grid-list {\n/* Define & Initialize Counter */\n\tcounter-reset: hworks-counter;\n  \n}\n\n\n.hworks-12-grid-list li::before {\n  /* Increment Counter */\n  counter-increment: hworks-counter;\n  /* Display Counter */\n  content: counters(hworks-counter,\".\") \" \";\n  background-color: var(--primary);\n  padding-inline:2rem;\n  padding-block:1rem;\n  color:var(--white);\n  font-size: var(--text-m);\n  font-weight: 700;\n  border-radius: var(--radius-50);\n  position:absolute;\n  left:-2.3rem;\n    top:50%;\n  transform: translateY(-50%);\n  \n}",
