  {
   "id": "oewvcw",
   "name": "hworks-13-list",
   "settings": {
    "_cssCustom": ".hworks-13-list {\n/* Define & Initialize Counter */\n\tcounter-reset: hworks-counter;\n  \n}\n\n\n.hworks-13-list li::before {\n  /* Increment Counter */\n  counter-increment: hworks-counter;\n  /* Display Counter */\n  content: counters(hworks-counter,\".\") \" \";\n  color:var(--shade-light);\n  font-size: calc(var(--text-xxl) * 4);\n  font-weight: 400;\n  position:absolute;\n  left: var(--space-l);\n  top:50%;\n  transform: translateY(-50%);\n  \n}",
    "_rowGap": "var(--content-gap)"
   }
  },
  {
   "id": "acss_import_list--none",
   "name": "list--none",
   "settings": []
  },
  {
   "id": "tkpman",
   "name": "hworks-13-card",
   "settings": {
    "_display": "grid",
    "_gridTemplateColumns": "var(--grid-2)",
    "_alignItemsGrid": "center",
    "_padding": {
     "left": "calc(var(--space-xxl) * 2)",
     "top": "var(--space-m)",
     "right": "var(--space-m)",
     "bottom": "var(--space-m)"
    },
    "_cssCustom": "/* Set all cards to position sticky */\n.hworks-13-card {\n\tposition: sticky;\n  transition: .5s linear;\n  --sticky-top: var(--space-l);\n}\n\n/* Set box shadow on Card hover */\n.hworks-13-card:hover {\n\tbox-shadow: var(--box-shadow-l);\n}\n\n.hworks-13-card:first-child {\n\ttop: var(--sticky-top);\n}\n\n.hworks-13-card:nth-child(2) {\n\ttop: calc(var(--sticky-top) * 3);\n}\n\n.hworks-13-card:nth-child(3) {\n\ttop: calc(var(--sticky-top) * 5);\n}\n\n.hworks-13-card:last-child {\n\tposition: relative;\n  top: calc(var(--sticky-top));\n}",
    "_background": {
     "color": {
      "raw": "var(--white)"
     }
    },
    "_gridTemplateColumns:mobile_landscape": "var(--grid-1)"
   }
  },
  {
