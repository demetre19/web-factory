   "custom_css": ".bm-how-it-works-28-nav {\n  counter-reset: nav-steps;\n}\n\n.bm-how-it-works-28-nav-item {\n  transition: 0.5s ease;\n  opacity: 0.7;\n}\n\n/* Active nav item */\n.bm-how-it-works-28-nav-item.is-active {\n  background-color: var(--base);\n  color: var(--text-light);\n  opacity: 1;\n  transform: translateX(0.25rem);\n}\n\n.bm-how-it-works-28-nav-item:hover.is-active, .bm-how-it-works-28-nav-item:focus-within.is-active {\n  background-color: var(--base-ultra-light);\n  color: var(--text-dark) !important;\n}\n\n.bm-how-it-works-28-nav-item:hover.is-active .bm-how-it-works-28-nav-item__link, .bm-how-it-works-28-nav-item:focus-within.is-active .bm-how-it-works-28-nav-item__link {\n  color: var(--text-dark) !important;\n}\n\n.bm-how-it-works-28-nav-item.is-active .bm-how-it-works-28-nav-item__duration {\n  border-color: var(--white);\n  background-color: var(--base);\n  color: var(--text-light);\n}\n\n.bm-how-it-works-28-nav-item:hover, .bm-how-it-works-28-nav-item:focus-within {\n  background-color: var(--base-ultra-light);\n}\n\n\n.bm-how-it-works-28-nav .bm-how-it-works-28-nav-item{\n  counter-increment: nav-steps;\n}\n\n.bm-how-it-works-28-nav .bm-how-it-works-28-nav-item .bm-how-it-works-28-nav-item__counter::before{\n  content: '0' counter(nav-steps);\n  font-size: var(--text-s);\n  \n}\n\n\n\n.bm-how-it-works-28-nav-item__duration {\n  transition: background 0.5s ease;\n}\n\n.bm-how-it-works-28-nav-item:hover .bm-how-it-works-28-nav-item__duration, .bm-how-it-works-28-nav-item:focus-within .bm-how-it-works-28-nav-item__duration {\n  background-color: var(--base);\n  color: var(--text-light);\n}\n\n.bm-how-it-works-28-nav-item__link {\n  transition:0.5s ease;\n}\n\n.bm-how-it-works-28-nav-item__link.is-active {\n\tcolor: var(--text-light);\n}\n\n\n.bm-how-it-works-28-nav-item__link::after {\n  content:'';\n  position:absolute;\n  inset:0;\n  display:flex;\n  cursor:pointer;\n  z-index:1;\n}\n\n",
