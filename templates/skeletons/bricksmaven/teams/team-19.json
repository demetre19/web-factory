   "name": "bm-team-19-card",
   "settings": {
    "_display": "grid",
    "_gridGap": "var(--grid-gap)",
    "_gridTemplateColumns": "var(--grid-2)",
    "_padding": {
     "top": "var(--space-m)",
     "left": "var(--space-m)",
