---
/**
 * bm-team-13 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (team-13.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="team-13-container">
      <div class="team-13__content">
        {heading && <h2 class="text-fluid-2">{heading}</h2>}
        {fs && <p class="text-fluid-0">{fs}</p>}
      </div>
      <div class="team-13__content"></div>
    </div>
    <div>
      <div class="team-13-list">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="team-13-card card">
              <div class="team-13-card__content">
                <h2 class="text-fluid-2">{it.title}</h2>
                <p class="text-fluid-0">{it.text}</p>
                <div>
                  <div class="bm-social-list">
                    <div class="grid-auto gap-fluid-m">
                      {((it.items || []) || []).map((it2) => (
                        <span class="card" data-icon="lucide" aria-hidden="true"></span>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
              <div class="team-13-card__media">
                <figure class="team-13-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
