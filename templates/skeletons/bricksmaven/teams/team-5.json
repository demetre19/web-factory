    "_width": "100%",
    "_display": "flex",
    "_direction": "column",
    "_cssCustom": ".team-5-card:nth-child(1) {\n\n\tgrid-column: 1 / 8;\n  grid-row-start: 1;\n  \n}\n\n.team-5-card:nth-child(2) {\n\n\tgrid-column: 6 / 14;\n  grid-row-start: 1;\n  position:absolute;\n  z-index:1;\n  top:-4rem;\n  box-shadow: var(--box-shadow-l);\n\n}\n\n.team-5-card:nth-child(3) {\n\n\tgrid-column: 12 / -1;\n  grid-row-start: 1;\n\n}\n\n@media (max-width:767px) {\n\n.team-5-card:nth-child(1),.team-5-card:nth-child(3) {\n\n\tgrid-column: 1 / -1;\n  grid-row-start: auto;\n  \n}\n\n.team-5-card:nth-child(2) {\n\n\tgrid-column: 1 / -1;\n  grid-row-start: auto;\n  position:relative;\n  z-index:0;\n  top:0;\n  box-shadow: none;\n\n}\n\n\n}"
   }
