   "id": "puruiy",
   "name": "bm-team-18-card",
   "settings": {
    "_display": "grid",
    "_gridGap": "var(--grid-gap)",
    "_gridTemplateColumns": "var(--grid-2-3)",
    "_gridTemplateColumns:tablet_portrait": "var(--grid-1)",
    "_cssCustom": "/* Sets vertical bar on desktop */\n.bm-team-18-card .bm-team-18-card__media:before {\n  content: '';\n  position: absolute;\n  inline-size: 50%;\n  block-size: 100%;\n  background-color: var(--neutral-ultra-light);\n  left: 0;\n  transition: 0.5s ease;\n  \n}\n\n/* Vertical bar fills the whole width on hover */\n.bm-team-18-card:hover .bm-team-18-card__media:before {\n  inline-size: 100%;\n}\n\n@media (max-width:991px) {\n   \n  /* Top and bottom padding on the media element to give the image some breathing space */\n  .bm-team-18-card .bm-team-18-card__media {\n    padding-block: var(--space-m);\n  }\n  \n  /* Flips vertical bar to horizontal on tablet breakpoint */\n  .bm-team-18-card .bm-team-18-card__media:before {\n\n    inline-size: 100%;\n    block-size: 50%;\n     top: 0; \n}\n  /* Horizontal bar fills the whole height on hover */\n  .bm-team-18-card:hover .bm-team-18-card__media:before {\n  block-size: 100%;\n}\n}"
   },
