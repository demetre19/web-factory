   "custom_css": ".bm-team-17-card {\n  --image-width: 49.1vw; /* Image width variable*/\n}\n\n@media (min-width:991px) {\n  \n\t.bm-team-17-card .bm-team-17-card__media {\n  \torder: -1; /* Flip media element to the left*/\n    align-items: end;\n\n}\n  \t/* Set image width*/\n  \t.bm-team-17-card .bm-team-17-card__image {\n    width: var(--image-width);\n    max-width: var(--image-width);\n\n}\n  /* Set even media card to align right*/\n  .bm-team-17-card:nth-child(even) .bm-team-17-card__media {\n  \torder: 0;\n    align-items: start;\n}\n  \n}\n\n@media (max-width:991px) {\n  \n  .bm-team-17-card {\n  --image-width: 100vw; /* Image width variable*/\n}\n  \n  .bm-team-17-card .bm-team-17-card__media {\n  \torder: -1; /* Flip media element to the Top*/\n    align-items: start;\n\n}\n  \n  /* Set image width */\n  \t.bm-team-17-card .bm-team-17-card__image {\n    width: var(--image-width);\n    max-width: var(--image-width);\n    margin-inline-start: -50vw;\n    left: 50%;  \n}\n   /* Flip text to the left */\n  .bm-team-17-card .bm-team-17-card__text {\n    \torder: -1;\n  }\n  \n}\n",
