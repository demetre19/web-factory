   "name": "team-11-card",
   "settings": {
    "_position": "relative",
    "_height": "28rem",
    "_overflow": "hidden",
    "_cssCustom": "/* Card */\n\n.team-11-card:focus-within :focus {\n\toutline: none;\n  box-shadow: none;\n}\n\n.team-11-card:focus-within {\n\tbox-shadow: 0 0 10px 0 var(--black-trans-10);\n\n}\n\n/* Overlay */\n.team-11-card__overlay {\n\ttransition: .5s ease-in-out;\n  opacity: 1;\n}\n\n.team-11-card:hover .team-11-card__overlay, .team-11-card:focus-within .team-11-card__overlay {\n  opacity: 0.3;\n}\n\n/* Image */\n.team-11-card__image {\n\ttransition: .8s ease-in-out;\n  filter: grayscale(1);\n}\n\n.team-11-card:hover .team-11-card__image, .team-11-card:focus-within .team-11-card__image {\n\tfilter: grayscale(0);\n  scale: 1.1;\n}",
    "_height:mobile_landscape": "46rem"
   }
  },
