  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="team-5-container">
    <div class="intro">
      <h2 class="intro__heading">Meet our team</h2>
      <p class="intro__subheading">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
      <p class="intro__accent-heading">We're hiring!</p>
    </div>
    <div class="team-5-list list--none">
      {items.map((it) => (
        <div class="team-5-card">
          <div class="team-5-card__box">
            <h3 class="team-5-box__name">{it.title}</h3>
            <p class="team-5-box__title">{it.text}</p>
          </div>
          <div class="team-5-card__image-wrapper">
            <figure class="team-5-box__img"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
@layer components {
  .team-5-container {
    display: flex;
    flex-direction: column;
    row-gap: var(--section-space-xxl);
    z-index: 1;
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .team-5-list {
    display: grid;
    grid-template-columns: repeat(18, 1fr);
    gap: var(--space-l);
    width: 100%;
    position: relative;
  }

  .team-5-card {
    text-align: center;
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .team-5-card__box {
    display: flex;
    flex-direction: column;
    padding: var(--space-xs) var(--space-xs) var(--space-xs) var(--space-xs);
    background: var(--bg-canvas);
  }

  .team-5-box__img {
    height: 30rem;
    object-fit: cover;
    width: 100%;
  }

  /* bm-custom */
  .team-5::after {
  
  	content:'';
    width:100%;
    height:40vh;
    position:absolute;
    bottom:0;
    clip-path: polygon(0 10%, 100% 0, 100% 100%, 0 100%);
    background-color: var(--bg-subtle);
    
  }

  /* bm-custom */
  .team-5-card:nth-child(1) {
  
  	grid-column: 1 / 8;
    grid-row-start: 1;
    
  }
  
  .team-5-card:nth-child(2) {
  
  	grid-column: 6 / 14;
    grid-row-start: 1;
    position:absolute;
    z-index:1;
    top:-4rem;
    box-shadow: var(--shadow-card);
  
  }
  
  .team-5-card:nth-child(3) {
  
  	grid-column: 12 / -1;
    grid-row-start: 1;
  
  }
  
  @media (max-width:767px) {
  
  .team-5-card:nth-child(1),.team-5-card:nth-child(3) {
  
  	grid-column: 1 / -1;
    grid-row-start: auto;
    
  }
  
  .team-5-card:nth-child(2) {
  
  	grid-column: 1 / -1;
    grid-row-start: auto;
    position:relative;
    z-index:0;
    top:0;
    box-shadow: none;
  
  }
  
  
  }
}
</style>
