---
/**
 * bm-team-11 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (team-11.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="team-11-container">
    <div class="intro">
      <h2 class="intro__heading">Long headline to turn your visitors into customers</h2>
      <p class="intro__subheading">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
      <p class="intro__accent-heading">Accent heading</p>
    </div>
    <div class="team-11-team-list list--none">
      {items.map((it) => (
        <div class="team-11-card">
          <div class="team-11-card__content">
            <h2 class="team-11-card__heading">{it.title}</h2>
            <p class="team-11-card__title">{it.text}</p>
          </div>
          <figure class="team-11-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          <div class="team-11-card__overlay"></div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
@layer components {
  .team-11-container {
    row-gap: var(--space-s);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .team-11-team-list {
    display: grid;
    grid-template-columns: calc(100% * 1 / 3);
    gap: var(--space-m);
  }

  .team-11-card {
    position: relative;
    height: 28rem;
    overflow: hidden;
  }

  .team-11-card__content {
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    position: absolute;
    z-index: 2;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    text-align: center;
    align-items: center;
    justify-content: flex-end;
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .team-11-card__image {
    object-fit: cover;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .team-11-card__overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
  }

  /* bm-custom */
  /* Card */
  
  .team-11-card:focus-within :focus {
  	outline: none;
    box-shadow: none;
  }
  
  .team-11-card:focus-within {
  	box-shadow: 0 0 10px 0 color-mix(in srgb, var(--text-primary) 10%, transparent);
  
  }
  
  /* Overlay */
  .team-11-card__overlay {
  	transition: .5s ease-in-out;
    opacity: 1;
  }
  
  .team-11-card:hover .team-11-card__overlay, .team-11-card:focus-within .team-11-card__overlay {
    opacity: 0.3;
  }
  
  /* Image */
  .team-11-card__image {
  	transition: .8s ease-in-out;
    filter: grayscale(1);
  }
  
  .team-11-card:hover .team-11-card__image, .team-11-card:focus-within .team-11-card__image {
  	filter: grayscale(0);
    scale: 1.1;
  }
}
</style>
