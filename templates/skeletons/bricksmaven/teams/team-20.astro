          </div>
          <div class="bm-team-20-slide__social-wrapper">
            <div class="bm-social-share list--none bm-social-share--left">
              {(it.items || []).map((it2) => (
                <div class="bm-social-share__icon-wrapper">
                  <span class="bm-social-share__icon" data-icon="lucide" aria-hidden="true"></span>
                </div>
              ))}
            </div>
          </div>
          <div class="bm-team-20-slide__media">
            <figure class="bm-team-20-slide__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
