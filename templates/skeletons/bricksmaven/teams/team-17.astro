    font-size: var(--fs-0);
    display: flex;
    flex-direction: row;
  }

  .bm-team-17-card__image {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  /* bm-custom */
  .bm-team-17-card {
    --image-width: 49.1vw; /* Image width variable*/
  }
  
  @media (min-width:991px) {
    
  	.bm-team-17-card .bm-team-17-card__media {
    	order: -1; /* Flip media element to the left*/
      align-items: end;
  
  }
    	/* Set image width*/
    	.bm-team-17-card .bm-team-17-card__image {
      width: var(--acss-image-width);
      max-width: var(--acss-image-width);
  
  }
    /* Set even media card to align right*/
    .bm-team-17-card:nth-child(even) .bm-team-17-card__media {
    	order: 0;
      align-items: start;
  }
    
  }
  
  @media (max-width:991px) {
    
    .bm-team-17-card {
    --image-width: 100vw; /* Image width variable*/
  }
    
    .bm-team-17-card .bm-team-17-card__media {
    	order: -1; /* Flip media element to the Top*/
      align-items: start;
  
  }
    
    /* Set image width */
    	.bm-team-17-card .bm-team-17-card__image {
      width: var(--acss-image-width);
      max-width: var(--acss-image-width);
      margin-inline-start: -50vw;
      left: 50%;  
  }
     /* Flip text to the left */
    .bm-team-17-card .bm-team-17-card__text {
      	order: -1;
    }
    
  }
}
</style>
