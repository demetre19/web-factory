    flex-direction: column;
    align-items: center;
    padding: var(--space-xs) var(--space-xs) var(--space-xs) var(--space-xs);
    background: var(--bg-canvas);
  }

  .team-7-card__img {
    object-fit: cover;
    width: 100%;
    height: 6em;
  }

  /* bm-custom */
  .team-7::after {
