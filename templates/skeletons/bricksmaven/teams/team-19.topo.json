   "custom_css": "/* CARD */\n.bm-team-19-card {\n  background-color: var(--neutral-ultra-light);\n  overflow: hidden;\n  transition: 1s linear;\n}\n\n/* Sets all color to white on hover */\n.bm-team-19-card:hover {\n\tcolor: var(--white);\n}\n\n/* IMAGE */\n.bm-team-19-card__image {\n  transition: 0.5s ease-out;\n  scale: 1.2;\n}\n\n.bm-team-19-card:hover .bm-team-19-card__image {\n  scale: 1;\n}\n\n/* PSUEDO ELEMENT */\n.bm-team-19-card:after {\n  content: '';\n  position:absolute;\n  width: 100%;\n  height: 100%;\n  top: 100%;\n  background-color: var(--neutral-ultra-light);\n  z-index: -1;\n  transition: 0.2s ease-out;\n}\n\n.bm-team-19-card:hover:after {\n  top: 0%;\n  background-color: var(--neutral);\n}",
