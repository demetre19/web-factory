---
/**
 * bm-author-page-2 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (author-page-2.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-author-page-2__container">
    <div class="bm-author-card-2">
      <figure class="bm-author-card-2__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      <div class="bm-author-card-2__bottom">
        <div class="bm-author-card-2__thumb">
          <figure class="bm-author-card-2__thumb-image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
        <div class="bm-author-card-2__content">
          <div class="bm-author-card-2__details">
            <p class="bm-author-card-2__name">{author_name}</p>
            <p class="bm-author-card-2__title">Co-founder/CEO</p>
          </div>
          <p class="bm-author-card-2__bio">{author_bio}</p>
          <div class="bm-social-share list--none bm-social-share--left">
            {items.map((it) => (
              <div class="bm-social-share__icon-wrapper">
                <span class="bm-social-share__icon" data-icon="lucide" aria-hidden="true"></span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
    <div class="bm-author-page-2__post-container">
      <h2 class="bm-author-page-2__heading">All Posts By {author_name}</h2>
      <div class="bm-author-page-2-post-list">
        <div class="bm-blog-archive-6-card">
          <div class="bm-blog-archive-6-card__media">
            <figure class="bm-blog-archive-6-card__thumb"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
          <div class="bm-blog-archive-6-card__meta">
            <p class="bm-blog-archive-6-card__term">{post_terms_category}</p>
            <h2 class="bm-blog-archive-6-card__title">{post_title}</h2>
            <a class="bm-blog-archive-6-card__read" href={cta.href}>{cta.label}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
@layer components {
  .bm-author-page-2__container {
    width: 100%;
    row-gap: var(--space-s);
  }

  .bm-author-card-2__image {
    object-fit: cover;
    height: 280px;
    width: 100%;
  }

  .bm-author-card-2__bottom {
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 2 / 1);
  }

  .bm-author-card-2__thumb {
    display: flex;
    justify-content: center;
    margin: calc(var(--section-space-xxl) * -1) 0 0 0;
  }

  .bm-author-card-2__thumb-image {
    width: 186px;
    height: 186px;
    object-fit: cover;
    border-top: 8px solid var(--bg-canvas);
    border-right: 8px solid var(--bg-canvas);
    border-bottom: 8px solid var(--bg-canvas);
    border-left: 8px solid var(--bg-canvas);
    border-radius: 100% 100% 100% 100%;
    margin: -200px 0 0 0;
  }

  .bm-author-card-2__content {
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-author-card-2__name {
    font-weight: 700;
    font-size: var(--fs-1);
  }

  .bm-social-share {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    column-gap: var(--flow-spacing);
  }

  .bm-social-share--left {
    justify-content: flex-start;
  }

  .bm-author-page-2__post-container {
    row-gap: var(--space-s);
  }

  .bm-author-page-2-post-list {
    row-gap: var(--flow-spacing);
  }

  .bm-blog-archive-6-card {
    grid-template-columns: calc(100% * 2 / 1);
    display: grid;
    gap: var(--space-m);
  }

  .bm-blog-archive-6-card__media {
    width: 100%;
  }

  .bm-blog-archive-6-card__thumb {
    width: 100%;
    object-fit: cover;
    height: 100%;
  }

  .bm-blog-archive-6-card__meta {
    display: flex;
    flex-direction: column;
    row-gap: var(--flow-spacing);
    align-items: flex-start;
  }

  .bm-blog-archive-6-card__term {
    padding: .4rem .8rem .4rem .8rem;
    background: var(--bg-subtle);
    font-size: var(--fs-0);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
  }

  .bm-blog-archive-6-card__read {
    padding: 0 0 0 0;
  }

  /* bm-custom */
  .bm-blog-archive-6-card__term a {
  	color: var(--fs-0);
  }
}
</style>
