 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-content-52__container">
    <div class="bm-content-52__content">
      <h2 class="bm-content-52__heading">{heading}</h2>
      <p class="accent-h">Accent heading</p>
      <p class="bm-content-52__text">{fs}</p>
    </div>
    <div class="bm-list list--none bm-list--inline">
      {items.map((it) => (
        <div class="bm-list-item">
          <div class="bm-list-item__icon-wrapper">
            <span class="bm-list-item__icon" data-icon="lucide" aria-hidden="true"></span>
          </div>
          <p class="bm-list-item__text">{it.text}</p>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-content-52__container {
    row-gap: var(--space-s);
    width: var(--content-width);
    text-align: center;
    align-items: center;
  }

  .bm-content-52__content {
    align-items: center;
    row-gap: var(--flow-spacing);
  }

  .bm-list {
    display: flex;
    flex-direction: column;
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-list--inline {
    flex-direction: row;
    column-gap: var(--flow-spacing);
  }

  .bm-list-item {
    flex-direction: row;
    display: flex;
    align-items: center;
    column-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-list-item__icon-wrapper {
    padding: var(--tap) var(--tap) var(--tap) var(--tap);
    background: var(--bg-subtle);
    border-radius: 50% 50% 50% 50%;
    position: relative;
  }

  .bm-list-item__icon {
    position: absolute;
    top: 50%;
    left: 50%;
  }

  .bm-list-item__text {
    text-align: left;
    font-size: var(--fs-0);
  }

  /* bm-custom */
  .bm-list-item {
  	--circle-size: var(--fs-0);
  }
</style>
