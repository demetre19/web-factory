    "_cssCustom": ".bm-content-69-image-wrapper {\n  border: 10px solid var(--white);\n  cursor: pointer;\n  transition: 0.2s ease;\n}\n\n.bm-content-69-image-wrapper:hover {\n  transform: scale(1.05);\n  z-index: 3;\n}\n\n.bm-content-69-image-wrapper:nth-child(2) {\n  position: absolute;\n  z-index: 2;\n  inset-inline-end: 0;\n  inset-block-start: 50%;\n  transform: translateY(-50%);\n}\n\n.bm-content-69-image-wrapper:nth-child(2):hover {\n  transform: translateY(-50%) scale(1.05);\n}\n\n.bm-content-69-image-wrapper:nth-child(3) {\n  margin-block-start: calc(-1 * var(--space-xxl));\n  margin-inline-start: var(--space-xl);\n  z-index: 1;\n}",
