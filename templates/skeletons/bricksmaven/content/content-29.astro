---
/**
 * bm-content-29 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (content-29.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="content-29-container">
      <div class="content-29__content">
        <div class="intro intro--left">
          {heading && <h2 class="text-fluid-2">{heading}</h2>}
          {fs && <p class="text-fluid-0">{fs}</p>}
        </div>
        <div class="content-29__2col">
          <div class="content-29__list-cta">
            <div class="bm-list">
              <div class="grid-auto gap-fluid-m">
                {(items || []).map((it) => (
                  <div class="bm-list__item card">
                    <span class="bm-list__item-icon" data-icon="lucide" aria-hidden="true"></span>
                    <p class="text-fluid-0">{it.text}</p>
                  </div>
                ))}
              </div>
            </div>
            <p class="mt-fluid-m"><a class="wf-cta-button" href={cta.href}>{cta.label || 'Continue'}</a></p>
          </div>
          <div class="content-29-stats">
            <div class="content-29-list-item">
              <div>
                <span data-icon="lucide" aria-hidden="true"></span>
              </div>
              <div class="content-29-list-item__data">
                <span></span>
              </div>
            </div>
            <div class="content-29-list-item">
              <div>
                <span data-icon="lucide" aria-hidden="true"></span>
              </div>
              <div class="content-29-list-item__data">
                <span></span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div>
        <figure class="content-29__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
    </div>
  </div>
</div>
