---
/**
 * bm-content-73 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (content-73.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-content-73__container">
    <div class="bm-content-73__content">
      <div class="bm-content-73__top">
        <h2 class="bm-content-73__heading">{heading}</h2>
        <p class="bm-accent-heading">Accent Heading</p>
      </div>
      <div class="bm-content-73__footer">
        <a class="btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
        <div class="bm-review-widget">
          <div class="bm-team-list list--none">
            {items.map((it) => (
              <div class="bm-team-media">
                <figure class="bm-team-media__image"><img src="/media/placeholder.svg" alt="Team Image" loading="lazy" width="900" height="600" /></figure>
              </div>
            ))}
          </div>
          <div class="bm-testimonial-38__star-ratings">
            <div class="bm-testimonial-38-star-list list--none">
              {items.map((it) => (
                <div class="bm-testimonial-38-star-li">
                  <span class="bm-testimonial-38-star-li__icon" data-icon="lucide" aria-hidden="true"></span>
                </div>
              ))}
            </div>
            <p class="bm-testimonial-38__meta-text">Rated 5 Stars on TrustPilot</p>
          </div>
        </div>
      </div>
    </div>
    <div class="bm-content-73__data-column">
      <div class="bm-content-73-data-list list--none">
        <div class="bm-content-73-data-card">
          <span class="bm-content-73-data-card__counter"></span>
          <p class="bm-content-73-data-card__text">{fs}</p>
        </div>
        <div class="bm-content-73-data-card">
          <span class="bm-content-73-data-card__counter"></span>
          <p class="bm-content-73-data-card__text">ROI business growth</p>
        </div>
      </div>
    </div>
  </div>
  <div class="bm-content-73__footer-container">
    <div class="bm-logo-12-carousel">
      <div class="bm-logo-12-track list--none">
        <div class="bm-logo-12-item">
          <svg class="bm-logo-12-item__brand"></svg>
        </div>
      </div>
      <div class="bm-logo-12-track list--none">
        <div class="bm-logo-12-item">
          <svg class="bm-logo-12-item__brand"></svg>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-content-73 {
    row-gap: var(--space-s);
  }

  .bm-content-73__container {
    display: flex;
    flex-direction: row;
    column-gap: var(--flow-spacing);
    row-gap: var(--flow-spacing);
  }

  .bm-content-73__content {
    row-gap: calc(var(--flow-spacing) * 2);
  }

  .bm-content-73__top {
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-content-73__heading {
    font-size: var(--fs-4);
  }

  .bm-content-73__footer {
    display: flex;
    flex-wrap: nowrap;
    flex-direction: row;
    column-gap: var(--flow-spacing);
    row-gap: var(--flow-spacing);
  }

  .bm-review-widget {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    column-gap: calc(var(--flow-spacing) / 2);
    text-align: center;
    align-items: center;
    width: auto;
  }

  .bm-team-list {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
  }

  .bm-team-media__image {
    object-fit: cover;
    width: 53;
    height: 52;
    border-top: .4rem solid var(--bg-canvas);
    border-right: .4rem solid var(--bg-canvas);
    border-bottom: .4rem solid var(--bg-canvas);
    border-left: .4rem solid var(--bg-canvas);
    border-radius: 100% 100% 100% 100%;
    overflow: hidden;
  }

  .bm-testimonial-38__star-ratings {
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    row-gap: 0;
  }

  .bm-testimonial-38-star-list {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    column-gap: calc(var(--flow-spacing) / 4);
  }

  .bm-content-73__data-column {
    align-items: flex-end;
  }

  .bm-content-73-data-list {
    row-gap: var(--flow-spacing);
    width: max-content;
  }

  .bm-content-73-data-card {
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-content-73-data-card__text {
    font-size: var(--fs-2);
  }

  .bm-content-73__footer-container {
    padding: var(--space-xl) 0 0 0;
    border-top: 1px solid var(--fs-0);
  }

  .bm-logo-12-carousel {
    flex-wrap: nowrap;
  }

  .bm-logo-12-track {
    flex-wrap: nowrap;
  }

  /* bm-custom */
  .bm-team-media:nth-child(even),.bm-team-media:nth-child(odd) {
  	margin-inline-start: -20px;
  }
  
  .bm-team-media:first-child {
  	margin-inline-start: 0px;
  }

  /* bm-custom */
  .bm-logo-12-carousel {
    --logo-gap: var(--flow-spacing);
    --scroll-duration: 35s;
  }
  
  /* Outer wrapper */
  .bm-logo-12-carousel {
    overflow: hidden;
    position: relative;
    flex-direction: row;
  }
  
  /* Track that scrolls */
  .bm-logo-12-carousel .bm-logo-12-track {
    display: flex;
    flex-direction: row;
    align-items: center;
    min-width: max-content;
    gap: var(--acss-logo-gap);
    will-change: transform;
    /* key part: content is as wide as needed */
    animation: scroll-logos var(--acss-scroll-duration) linear infinite;
  }
  
  /* Each logo */
  .bm-logo-12-item{
    flex: 0 0 300px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .bm-logo-12-item .bm-logo-12-item__brand {
    max-height: 40px; /* adjust to your design */
    filter: grayscale(1) opacity(0.4);
    transition: filter 0.3s ease, transform 0.3s ease;
  }
  
  /* Color + slight scale on hover */
  .bm-logo-12-item .bm-logo-12-item__brand:hover {
    filter: none;
    transform: scale(1.05);
  }
  
  /* Pause animation on hover of the whole carousel */
  .bm-logo-12-carousel:hover .bm-logo-12-track {
    animation-play-state: paused;
  }
  
  /* Also pause if user tabs into any logo (keyboard users) */
  .bm-logo-12-carousel:focus-within .bm-logo-12-track {
    animation-play-state: paused;
  }
  
  /* Animation: move track left by 50% (because we duplicated the content) */
  @keyframes scroll-logos {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }
  
  /* Respect users who prefer reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .bm-logo-12-track  {
      animation: none;
    }
  }
</style>
