   "custom_css": ".bm-logo-12-carousel {\n  --logo-gap: var(--content-gap);\n  --scroll-duration: 35s;\n}\n\n/* Outer wrapper */\n.bm-logo-12-carousel {\n  overflow: hidden;\n  position: relative;\n  flex-direction: row;\n}\n\n/* Track that scrolls */\n.bm-logo-12-carousel .bm-logo-12-track {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  min-width: max-content;\n  gap: var(--logo-gap);\n  will-change: transform;\n  /* key part: content is as wide as needed */\n  animation: scroll-logos var(--scroll-duration) linear infinite;\n}\n\n/* Each logo */\n.bm-logo-12-item{\n  flex: 0 0 300px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.bm-logo-12-item .bm-logo-12-item__brand {\n  max-height: 40px; /* adjust to your design */\n  filter: grayscale(1) opacity(0.4);\n  transition: filter 0.3s ease, transform 0.3s ease;\n}\n\n/* Color + slight scale on hover */\n.bm-logo-12-item .bm-logo-12-item__brand:hover {\n  filter: none;\n  transform: scale(1.05);\n}\n\n/* Pause animation on hover of the whole carousel */\n.bm-logo-12-carousel:hover .bm-logo-12-track {\n  animation-play-state: paused;\n}\n\n/* Also pause if user tabs into any logo (keyboard users) */\n.bm-logo-12-carousel:focus-within .bm-logo-12-track {\n  animation-play-state: paused;\n}\n\n/* Animation: move track left by 50% (because we duplicated the content) */\n@keyframes scroll-logos {\n  0% {\n    transform: translateX(0);\n  }\n  100% {\n    transform: translateX(-100%);\n  }\n}\n\n/* Respect users who prefer reduced motion */\n@media (prefers-reduced-motion: reduce) {\n  .bm-logo-12-track  {\n    animation: none;\n  }\n}",
   "tokens": [
