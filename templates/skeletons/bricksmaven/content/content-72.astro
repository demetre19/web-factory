---
/**
 * bm-content-72 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (content-72.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-content-72__container">
      <div class="bm-content-72__content">
        {heading && <h2 class="text-fluid-2">{heading}</h2>}
        <div class="bm-content-72-achievement-list">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="bm-content-72-achievement-list-item card">
                <p class="text-fluid-0">{it.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
    <div class="bm-content-72__beta-container">
      <div class="bm-card-floating-list">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="bm-card-floating card">
              <div class="bm-card-floating__content">
                <p class="text-fluid-0">{it.text}</p>
              </div>
              <div>
                <figure class="bm-card-floating__image ratio-portrait"><img src="/media/placeholder.svg" alt="Floating Image" loading="lazy" width="900" height="600" /></figure>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
