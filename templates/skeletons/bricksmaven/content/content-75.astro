interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-content-75__container">
    <div class="bm-content-75__intro">
      <div class="bm-content-75__top">
        <h2 class="bm-content-75__heading">{heading}</h2>
      </div>
      <div class="bm-content-75__content">
        <div class="bm-content-75__content-intro">
          <p class="bm-content-75__text">{fs}</p>
          <a class="btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
        </div>
        <div class="bm-content-75-media-list">
          <div class="bm-content-75-media-item">
            <figure class="bm-content-75-media-item__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
          <div class="bm-content-75-media-item">
            <figure class="bm-content-75-media-item__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      </div>
    </div>
    <div class="bm-content-75__footer">
      <div class="bm-content-75-data-list">
        {items.map((it) => (
          <div class="bm-content-75-data-item">
            <span class="bm-content-75-data-item__counter"></span>
            <p class="bm-content-75-data-item__text">{it.text}</p>
          </div>
        ))}
      </div>
      <p class="bm-content-75__footer-text">Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Aenean commodo ligula eget dolor. Aenean massa. Cum sociis natoque</p>
    </div>
  </div>
</div>

