---
/**
 * bm-content-61 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (content-61.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div>
      <div class="bm-content-61__inner">
        <div class="bm-content-61__intro">
          <div class="bm-content-61__top">
            {heading && <h2 class="text-fluid-2">{heading}</h2>}
          </div>
          <div class="bm-content-61__mid">
            {fs && <p class="text-fluid-0">{fs}</p>}
          </div>
        </div>
        <div class="bm-content-61__footer">
          <div class="bm-content-61__left-column"></div>
          <div class="bm-content-61__right-column">
            <div class="bm-social-share bm-social-share--left">
              <div class="grid-auto gap-fluid-m">
                {(items || []).map((it) => (
                  <div class="card">
                    <span data-icon="lucide" aria-hidden="true"></span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <figure class="bm-content-61__background-image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
  </div>
</div>
