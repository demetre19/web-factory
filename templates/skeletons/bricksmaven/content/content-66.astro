    display: grid;
    grid-template-columns: calc(100% * 1 / 2);
  }

  .bm-content-66__content {
    row-gap: calc(var(--flow-spacing) / 2);
    justify-content: center;
    padding: 0 0 0 var(--section-space-xxl);
  }

  .bm-content-66__slider-wrapper {
    align-items: flex-end;
  }

  .bm-content-66__slider-50vw {
    width: 50vw;
  }

  .bm-content-66__image {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  /* bm-custom */
  @media (min-width:991px) {
  
  .bm-content-66__slider-nested .splide__arrows--ltr {
