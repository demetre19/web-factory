---
/**
 * bm-item — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (item.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="content-20-container">
      <div class="content-20__content">
        {heading && <h2 class="text-fluid-2">{heading}</h2>}
        <div class="content-20-list-ul">
          <div class="content-20-list-card">
            {fs && <p class="text-fluid-0">{fs}</p>}
            <span data-icon="lucide" aria-hidden="true"></span>
          </div>
          <div class="content-20-list-card">
            <span data-icon="lucide" aria-hidden="true"></span>
          </div>
        </div>
      </div>
      <div class="content-20__media">
        <div class="content-20-image-wrapper--alt">
          <figure class="content-20-image-wrapper__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
        <div>
          <figure class="content-20-image-wrapper__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
      </div>
    </div>
  </div>
</div>
