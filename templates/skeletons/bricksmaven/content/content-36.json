   "id": "axgdrn",
   "name": "content-36-card",
   "settings": {
    "_position": "relative",
    "_cssCustom": ".content-36-card:focus-within :focus {\n\toutline:none;\n  box-shadow:none;\n}\n\n@media (min-width:767px) {\n\n.content-36-card:last-of-type {\n\tpadding-left: var(--space-xl);\n  padding-right: 0;\n}\n\n.content-36-card::before {\n  content: '';\n  position: absolute;\n  top:0;\n  right:0;\n  bottom:0;\n  width: 50vw;\n  height:100%;\n  background: linear-gradient( var(--neutral-trans-30), var(--neutral-dark));\n  transition: .3s ease-in-out;\n  border-top-right-radius: var(--radius-xl) ;\n  z-index:-1;\n}\n\n.content-36-card:last-of-type::before {\n  content: '';\n  position: absolute;\n  top:0;\n  left:0;\n  width: 50vw;\n  height:100%;\n  background: linear-gradient( var(--neutral-trans-30), var(--neutral-dark));\n  transition: .3s ease-in-out;\n  border-top-left-radius: var(--radius-xl) ;\n\t\n}\n  \n  .content-36-card:hover::before, .content-36-card:focus-within::before {\n  top: calc(-1 * var(--space-m));\n}\n\n.content-36-card::after {\n  content: '';\n  position: absolute;\n  bottom:0;\n  right:0;\n  width:0;\n  height:3px;\n  background: linear-gradient( 90deg, var(--neutral-trans-10), var(--neutral-trans-40));\n  transition: .3s ease-in-out;\n\t\n}\n\n.content-36-card:hover::after, .content-36-card:focus-within::after {\n\twidth: 50vw;\n}\n\n.content-36-card:last-of-type::after {\n  content: '';\n  position: absolute;\n  bottom:0;\n  left:0;\n  width:0;\n  height:3px;\n  background: linear-gradient( 90deg, var(--neutral-trans-40), var(--neutral-trans-10));\n  transition:1s ease-in-out;\n\t\n}\n\n.content-36-card:hover:last-of-type::after, .content-36-card:focus-within:last-of-type::after {\n\twidth: 50vw;\n}\n  \n}",
