---
/**
 * bm-content-25 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (content-25.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="content-25-container">
    <div class="intro intro--left">
      <h2 class="intro__heading">Long headline to turn your visitors into users</h2>
      <p class="intro__subheading">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
      <p class="intro__accent-heading">Tagline</p>
    </div>
    <div class="content-25-list list--none">
      {items.map((it) => (
        <div class="content-25-card">
          <div class="content-25-card__content">
            <h2 class="content-25-card__heading">{it.title}</h2>
            <a class="content-25-card__link" href="#">{it.text}</a>
          </div>
          <div class="content-25-card__media">
            <figure class="content-25-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
@layer components {
  .content-25-container {
    display: grid;
    gap: calc(var(--space-m) * 4);
    grid-template-columns: calc(100% * 2 / 3);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .intro--left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    align-self: flex-start;
  }

  .content-25-list {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }

  .content-25-card {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 3 / 2);
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    background: var(--bg-subtle);
  }

  .content-25-card__content {
    justify-content: center;
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .content-25-card__image {
    object-fit: cover;
  }

  /* bm-custom */
  .content-25-card:first-child {
  	grid-column: 3/-1;
  }
  
  .content-25-card:nth-child(2) {
  	grid-column: 2/12;
  }
  
  
  .content-25-card:last-child {
  	grid-column: 1/11;
  }
  
  @media (max-width:767px) {
    .content-25-card:first-child, .content-25-card:nth-child(2),  .content-25-card:last-child {
    	grid-column: span 12;
    }
  }
}
</style>
