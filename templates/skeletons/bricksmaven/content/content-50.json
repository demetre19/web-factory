   "name": "bm-content-50__image-wrapper",
   "settings": {
    "_cssCustom": ".bm-content-50__image-wrapper {\n  position: relative;\n}\n\n.bm-content-50__image-wrapper:nth-child(1) {\n  grid-column: 1/5;\n}\n\n.bm-content-50__image-wrapper:nth-child(2) {\n  grid-column: 5/9;\n}\n\n.bm-content-50__image-wrapper:nth-child(3) {\n  grid-column: 9/-1;\n}\n\n\n/* Breakout mid image */\n.bm-content-50__image-wrapper:nth-child(2) .bm-content-50__image {\n  margin-block-start: calc(-1 * var(--space-m));\n  height: calc(100% + var(--space-xl));\n  position: absolute;\n}\n\n@media (max-width: 767px) {\n  \n  .bm-content-50__image-wrapper:nth-child(1) {\n  grid-column: 1/6;\n  }\n\n  .bm-content-50__image-wrapper:nth-child(2) {\n    grid-column: 6/-1;\n  }\n\n  .bm-content-50__image-wrapper:nth-child(3) {\n    grid-column: 9/-1;\n    display: none;\n  }\n\n}",
    "_height": "100%"
   }
