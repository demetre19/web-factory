---
/**
 * bm-portoflio-section-17 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (portoflio-section-17.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-portoflio-section-17__container">
    <div class="intro">
      <h2 class="intro__heading">Long headline to turn your visitors into customers</h2>
      <p class="intro__subheading">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
      <p class="bm-accent-heading">Accent heading</p>
    </div>
  </div>
  <div class="bm-portfolio-section-17-case-container">
    <div class="bm-portfolio-section-17-case-container__inner">
      <div class="bm-portfolio-section-17-case-container__slider-nested">
        {items.map((it) => (
          <div class="bm-portfolio-section-17-case-container__slide">
            <div class="bm-portfolio-section-17-case-container__content">
              <h2 class="bm-portfolio-section-17-case-container__heading clickable-parent">{it.title}</h2>
              <div class="bm-portfolio-section-17-case-container__footer">
                <p class="bm-portfolio-section-17-case-container__text">{it.text}</p>
                <a class="bm-portfolio-section-17-case-container__link" href="#">{it.text}</a>
              </div>
            </div>
            <figure class="bm-portfolio-section-17-case-container__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style is:global>
@layer components {
  .bm-portoflio-section-17 {
    row-gap: var(--space-s);
    overflow: clip;
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--flow-spacing);
    align-self: center;
    width: 100%;
  }

  .bm-portfolio-section-17-case-container {
    align-items: flex-start;
    overflow: clip;
  }

  .bm-portfolio-section-17-case-container__slide {
    border-top: 1px solid var(--color-line-default);
    border-right: 1px solid var(--color-line-default);
    border-bottom: 1px solid var(--color-line-default);
    border-left: 1px solid var(--color-line-default);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    background: var(--bg-subtle);
  }

  .bm-portfolio-section-17-case-container__content {
    height: 100%;
    width: 100%;
    z-index: 1;
    position: absolute;
    padding: var(--space-l) var(--space-l) var(--space-l) var(--space-l);
    justify-content: flex-end;
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-portfolio-section-17-case-container__heading {
    font-size: calc(var(--fs-4) * 2);
  }

  .bm-portfolio-section-17-case-container__footer {
    overflow: clip;
    height: 28px;
    flex-wrap: nowrap;
  }

  .bm-portfolio-section-17-case-container__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
  }

  /* bm-custom */
  @media (min-width: 1329px) {
  
  .bm-portfolio-section-17-case-container {
    width: calc(((100vw - var(--content-width)) / 2) + var(--content-width));
    max-width: calc(((100vw - var(--content-width)) / 2) + var(--content-width));
    margin-inline-start:calc(((99.3% - var(--content-width)) / 2)) ;
    position: relative;
  }
  
  }

  /* bm-custom */
  /* Make Slide Cards visible */
  .bm-portfolio-section-17-case-container__slider-nested .splide__track {
      overflow: visible;
  }
  
  /* ARROWS */
  @layer bricks {
      .bm-portfolio-section-17-case-container__slider-nested .splide__arrows.custom {
      	display: flex !important;
        flex-direction: column;
    		gap: var(--space-s);
      }
    }
  
  .bm-portfolio-section-17-case-container__slider-nested .splide__arrows {
    position: absolute;
    top: 50%; 
    transform: translateY(-30%);
    left: var(--space-l);
    
  }
  
  .bm-portfolio-section-17-case-container__slider-nested .splide__arrow {
      position: static;
    transition: 1s ease;
  
  }
  
  .bm-portfolio-section-17-case-container__slider-nested .splide__arrow:hover {
      border: 1px solid var(--bg-subtle);
      border-radius: 100%;
    background-color: var(--action-primary);
    color: var(--bg-canvas);
  }
  
  
  /* SLIDE CARD */
  .bm-portfolio-section-17-case-container__slider-nested .bm-portfolio-section-17-case-container__slide {
    transition: .5s ease;
  }
  
  /* Add Blur to next slide */
  .bm-portfolio-section-17-case-container__slider-nested .bm-portfolio-section-17-case-container__slide:not(.is-visible) {
    filter: blur(3px);
    opacity: .5;
  }
  
  /* Move text out of the view */
  .bm-portfolio-section-17-case-container__slide .bm-portfolio-section-17-case-container__text {
    transition: .5s ease;
  }
  
  .bm-portfolio-section-17-case-container__slide:hover .bm-portfolio-section-17-case-container__text {
    margin-block-start: -30px;
  }
}
</style>
