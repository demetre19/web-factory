   "radius": {},
   "custom_css": "/* Card */\n.portfolio-section-3-card {\n\ttransition: .8s ease;\n  z-index:1;\n}\n\n.portfolio-section-3-card:hover {\n\tbackground-color: var(--shade-ultra-light);\n  border-color: var(--primary-light);\n}\n\n/* Heading */\n.portfolio-section-3-card__heading {\n\ttransition: .8s ease;\n}\n\n.portfolio-section-3-card:hover .portfolio-section-3-card__heading {\n\tcolor: var(--primary);\n}\n\n/* Image */\n.portfolio-section-3-card__image {\n\ttransition: .8s ease;\n}\n\n.portfolio-section-3-card:hover .portfolio-section-3-card__image {\n\tscale: 1.1;\n}\n\n\n.portfolio-section-3-card::after {\n\tcontent: '';\n  position: absolute;\n  top:100%;\n  bottom:0;\n  left:50%;\n  width: .1rem;\n  height: calc((var(--grid-gap) * 2) + (var(--space-xxl) * 2));\n  background-color: var(--primary-light);\n}\n\n.portfolio-section-3-card:last-child::after {\n\tdisplay:none;\n}\n\n.portfolio-section-3-card:nth-last-child(2)::after {\n\tdisplay:none;\n}\n\n.portfolio-section-3-card:nth-child(even) {\n\tmargin-block-start: calc(var(--space-xxl) * 2);\n}\n\n@media (max-width:478px) {\n\t.portfolio-section-3-card:nth-child(even) {\n\tmargin-block-start: 0;\n}\n  \n  .portfolio-section-3-card::after {\n\n  height: calc(var(--grid-gap) * 2);\n\n}\n}",
