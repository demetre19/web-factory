   "custom_css": ".portfolio-section-3-list {\n/* Define & Initialize Counter */\n\tcounter-reset: hworks-counter;\n  \n}\n\n\n.portfolio-section-3-list li::before {\n  /* Increment Counter */\n  counter-increment: hworks-counter;\n  /* Display Counter */\n  content: counters(hworks-counter,\".\") \" \";\n  padding-inline:1rem;\n  padding-block:.3rem;\n  color:var(--shade-light);\n  font-size: var(--text-m);\n  font-weight: 700;\n  position:absolute;\n  right: var(--space-s);\n    top:var(--space-s);\n  transition: .5s linear;\n  \n}",
