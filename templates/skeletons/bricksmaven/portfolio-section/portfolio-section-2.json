  {
   "id": "mktsch",
   "name": "portfolio-section-2-list",
   "settings": {
    "_cssCustom": ".portfolio-section-2-list {\n/* Define & Initialize Counter */\n\tcounter-reset: hworks-counter;\n  \n}\n\n\n.portfolio-section-2-list li::before {\n  /* Increment Counter */\n  counter-increment: hworks-counter;\n  /* Display Counter */\n  content: counters(hworks-counter,\".\") \" \";\n  background-color: var(--shade);\n  padding-inline:1rem;\n  padding-block:.3rem;\n  color:var(--white);\n  font-size: var(--text-xs);\n  font-weight: 700;\n  border-radius: var(--radius-50);\n  position:absolute;\n  left:3rem;\n    top:50%;\n  transform: translateY(-50%);\n  transition: .5s linear;\n  \n}\n\n.portfolio-section-2-list li:hover::before {\n  background-color: var(--primary);\n}\n\n@media (max-width:478px)  {\n\t.portfolio-section-2-list li::before {\n    left:-1.1rem;\n  }\n}"
   }
  },
  {
   "id": "acss_import_list--none",
   "name": "list--none",
   "settings": []
  },
  {
   "id": "qnxmmi",
   "name": "portfolio-section-2-card",
   "settings": {
    "_position": "relative",
    "_border": {
     "width": {
      "bottom": ".1rem",
      "top": ".1rem"
     },
     "style": "solid",
     "color": {
      "id": "acss_import_shade-ultra-light",
      "name": "shade-ultra-light",
      "raw": "var(--shade-ultra-light)"
     }
    },
    "_padding": {
     "top": "var(--space-l)",
     "bottom": "var(--space-l)",
     "left": "var(--space-xxl)",
     "right": "var(--space-l)"
    },
    "_display": "grid",
    "_gridTemplateColumns": "var(--grid-3)",
    "_gridGap": "var(--grid-gap)",
    "_alignItemsGrid": "center",
    "_cssCustom": "/* Card */\n\n.portfolio-section-2-card:focus-within :focus {\n\toutline: none;\n  box-shadow: none;\n}\n\n.portfolio-section-2-card:focus-within {\n\tbox-shadow: 0 0 10px 0 var(--black-trans-10);\n\n}\n\n.portfolio-section-2-card {\n\ttransition: .5s ease;\n}\n\n.portfolio-section-2-card:hover {\n\tbackground-color: var(--shade-light);\n}\n\n/* Image */\n\n.portfolio-section-2-card__image {\n\topacity: 0;\n  transition: .5s ease;\n}\n\n.portfolio-section-2-card:hover .portfolio-section-2-card__image, .portfolio-section-2-card:focus-within .portfolio-section-2-card__image{\n\topacity: 1;\n}\n\n/* Background Image */\n\n.portfolio-section-2-card__background-image {\n\topacity: 0.1;\n  transition: .5s ease;\n}\n\n.portfolio-section-2-card:hover .portfolio-section-2-card__background-image, .portfolio-section-2-card:focus-within .portfolio-section-2-card__background-image {\n\topacity: 0;\n}\n\n/* Icon */\n\n.portfolio-section-2-card__icon {\n  transition: .5s ease;\n}\n\n.portfolio-section-2-card:hover .portfolio-section-2-card__icon, .portfolio-section-2-card:focus-within .portfolio-section-2-card__icon {\n\tcolor: var(--primary);\n}\n\n@media (max-width:478px)  {\n\t.portfolio-section-2-card:hover .portfolio-section-2-card__image, .portfolio-section-2-card:focus-within .portfolio-section-2-card__image {\n\tdisplay: none;\n}\n\n}",
    "_gridTemplateColumns:mobile_landscape": "var(--grid-4)",
    "_padding:mobile_portrait": {
     "left": "var(--space-l)",
     "right": "var(--space-l)"
    },
    "_gridTemplateColumns:mobile_portrait": "repeat(12, minmax(0, 1fr))"
   }
  },
