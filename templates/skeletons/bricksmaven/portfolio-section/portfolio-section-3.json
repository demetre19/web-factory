  {
   "id": "amacle",
   "name": "portfolio-section-3-list",
   "settings": {
    "_display": "grid",
    "_gridGap": "calc(var(--grid-gap) * 2)",
    "_gridTemplateColumns": "var(--grid-2)",
    "_cssCustom": ".portfolio-section-3-list {\n/* Define & Initialize Counter */\n\tcounter-reset: hworks-counter;\n  \n}\n\n\n.portfolio-section-3-list li::before {\n  /* Increment Counter */\n  counter-increment: hworks-counter;\n  /* Display Counter */\n  content: counters(hworks-counter,\".\") \" \";\n  padding-inline:1rem;\n  padding-block:.3rem;\n  color:var(--shade-light);\n  font-size: var(--text-m);\n  font-weight: 700;\n  position:absolute;\n  right: var(--space-s);\n    top:var(--space-s);\n  transition: .5s linear;\n  \n}",
    "_alignItemsGrid": "flex-start",
    "_gridTemplateColumns:mobile_portrait": "var(--grid-1)"
   }
  },
  {
   "id": "acss_import_list--none",
   "name": "list--none",
   "settings": []
  },
  {
   "id": "qjpewt",
   "name": "portfolio-section-3-card",
   "settings": {
    "_border": {
     "width": {
      "left": ".1rem",
      "top": ".1rem",
      "right": ".1rem",
      "bottom": ".1rem"
     },
     "style": "solid",
     "color": {
      "id": "acss_import_neutral-light",
      "name": "neutral-light",
      "raw": "var(--neutral-light)"
     }
    },
    "_position": "relative",
    "_flexWrap": "nowrap",
    "_cssCustom": "/* Card */\n.portfolio-section-3-card {\n\ttransition: .8s ease;\n  z-index:1;\n}\n\n.portfolio-section-3-card:hover {\n\tbackground-color: var(--shade-ultra-light);\n  border-color: var(--primary-light);\n}\n\n/* Heading */\n.portfolio-section-3-card__heading {\n\ttransition: .8s ease;\n}\n\n.portfolio-section-3-card:hover .portfolio-section-3-card__heading {\n\tcolor: var(--primary);\n}\n\n/* Image */\n.portfolio-section-3-card__image {\n\ttransition: .8s ease;\n}\n\n.portfolio-section-3-card:hover .portfolio-section-3-card__image {\n\tscale: 1.1;\n}\n\n\n.portfolio-section-3-card::after {\n\tcontent: '';\n  position: absolute;\n  top:100%;\n  bottom:0;\n  left:50%;\n  width: .1rem;\n  height: calc((var(--grid-gap) * 2) + (var(--space-xxl) * 2));\n  background-color: var(--primary-light);\n}\n\n.portfolio-section-3-card:last-child::after {\n\tdisplay:none;\n}\n\n.portfolio-section-3-card:nth-last-child(2)::after {\n\tdisplay:none;\n}\n\n.portfolio-section-3-card:nth-child(even) {\n\tmargin-block-start: calc(var(--space-xxl) * 2);\n}\n\n@media (max-width:478px) {\n\t.portfolio-section-3-card:nth-child(even) {\n\tmargin-block-start: 0;\n}\n  \n  .portfolio-section-3-card::after {\n\n  height: calc(var(--grid-gap) * 2);\n\n}\n}"
   }
  },
