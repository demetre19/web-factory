---
/**
 * bm-portfolio-section-6 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (portfolio-section-6.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="portfolio-section-6__container">
    <div class="portfolio-section-6__content">
      <div class="portfolio-section-6__intro">
        <h2 class="portfolio-section-6__intro-heading">{heading}</h2>
        <p class="portfolio-section-6__intro-accent-heading">Accent heading</p>
        <p class="portfolio-section-6__intro-text">{fs}</p>
      </div>
      <div class="portfolio-section-6__footer">
        <div class="portfolio-section-6__account-manager">
          <div class="portfolio-section-6__top">
            <h3 class="portfolio-section-6__account-heading">Interested in a project?</h3>
            <p class="portfolio-section-6__account-text">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique.</p>
          </div>
          <div class="portfolio-section-6__team-profile">
            <figure class="portfolio-section-6__team-image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
          <div class="portfolio-section-6__team-profile">
            <div class="portfolio-section-6__team-top">
              <p class="portfolio-section-6__team-name">Jhonny Smith</p>
              <p class="portfolio-section-6__team-title">Account manager</p>
            </div>
            <div class="portfolio-section-6__team-cta-wrapper">
              <a class="portfolio-section-6__team-cta btn--black wf-cta-button" href={cta.href}>{cta.label}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="portfolio-section-6-list">
      {items.map((it) => (
        <div class="portfolio-section-6-card">
          <div class="portfolio-section-6-card__content">
            <h2 class="portfolio-section-6-card__heading clickable-parent">{it.title}</h2>
            <p class="portfolio-section-6-card__cta-link link--white">{it.text}</p>
          </div>
          <div class="portfolio-section-6-card__overlay"></div>
          <div class="portfolio-section-6-card__media">
            <figure class="portfolio-section-6-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .portfolio-section-6__container {
    padding: 0 0 var(--section-space-xxl) 0;
    display: grid;
    grid-template-columns: calc(100% * 1 / 12);
  }

  .portfolio-section-6__content {
    justify-content: space-between;
    padding: var(--space-xl) var(--space-xl) var(--space-xl) 0;
    height: 100%;
  }

  .portfolio-section-6__intro {
    row-gap: var(--flow-spacing);
  }

  .portfolio-section-6__account-manager {
    row-gap: var(--space-s);
  }

  .portfolio-section-6__top {
    row-gap: var(--space-m);
  }

  .portfolio-section-6__team-profile {
    row-gap: var(--space-s);
  }

  .portfolio-section-6__team-image {
    object-fit: cover;
    width: 64;
    height: 64;
    overflow: hidden;
    border-radius: 100% 100% 100% 100%;
  }

  .portfolio-section-6__team-name {
    font-weight: 700;
  }

  .portfolio-section-6-list {
    padding: 0 0 0 0;
    margin: 0 0 0 0;
    height: 100%;
    row-gap: calc(var(--flow-spacing) * 2);
  }

  .portfolio-section-6-card {
    position: sticky;
    top: var(--space-xl);
  }

  .portfolio-section-6-card__content {
    position: absolute;
    z-index: 2;
    left: 0;
    bottom: 0;
    right: 0;
    top: 0;
    padding: var(--space-xl) var(--space-xl) var(--space-xl) var(--space-xl);
    justify-content: flex-start;
    align-items: flex-end;
    width: 100%;
  }

  .portfolio-section-6-card__heading {
    font-size: calc(var(--fs-4) * 1.4);
  }

  .portfolio-section-6-card__overlay {
    z-index: 1;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .portfolio-section-6-card__media {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    height: 100%;
    width: 100%;
  }

  .portfolio-section-6-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* bm-custom */
  .portfolio-section-6-card {
  	width:calc(((var(--content-width) / 12) * 1.4) + 50vw);
    max-width:calc(((var(--content-width) / 12) * 1.4) + 50vw);
    height:75vh;
    overflow:hidden;
  }
  
  .portfolio-section-6-card:focus-within :focus {
  	outline: none;
    box-shadow: none;
  }
  
  /* Overlay */
  .portfolio-section-6-card__overlay {
  	transition: .5s ease-out;
    background: linear-gradient(color-mix(in srgb, var(--text-secondary) 70%, transparent), color-mix(in srgb, var(--text-secondary) 90%, transparent));
    opacity:0.6;
  }
  
  .portfolio-section-6-card:hover .portfolio-section-6-card__overlay, .portfolio-section-6-card:focus-within .portfolio-section-6-card__overlay {
  	opacity:1;
  }
  
  /* Image */
  .portfolio-section-6-card__image {
  	transition: .5s ease-out;
  }
  
  .portfolio-section-6-card:hover .portfolio-section-6-card__image, .portfolio-section-6-card:focus-within .portfolio-section-6-card__image {
  	scale:1.1;
  }
  
  
  /* Vertical heading and text */
  .portfolio-section-6-card .portfolio-section-6-card__heading {
  	writing-mode: vertical-lr;
  }
  
  .portfolio-section-6-card .portfolio-section-6-card__cta-link {
    position:absolute;
    color:var(--bg-canvas);
    font-size: var(--fs-1);
    bottom:var(--space-xl);
    left: var(--space-xl);
    transition: .5s ease;
    text-transform: uppercase;
    font-weight:700;
    letter-spacing: .2rem;
    transform: translateX(calc((var(--section-space-xxl) * 2) * -1));
  }
  
  .portfolio-section-6-card:hover .portfolio-section-6-card__cta-link, .portfolio-section-6-card:focus-within .portfolio-section-6-card__cta-link {
    transform: translateX(0);
  
  }
  
  @media (max-width:767px) {
  
  	.portfolio-section-6-card {
  	width:100%;
    max-width:100%;
    height:42rem !important;
  }
    
    /* horizontal heading and text */
  .portfolio-section-6-card .portfolio-section-6-card__heading {
  	writing-mode: horizontal-tb;
  }
  
  .portfolio-section-6-card .portfolio-section-6-card__cta-link {
    position:relative;
    bottom:0;
    left: 0;
    transform: translateX(0);
  }
  
  }
</style>
