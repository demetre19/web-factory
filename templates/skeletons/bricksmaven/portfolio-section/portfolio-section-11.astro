<style is:global>
@layer components {
  .bm-portfolio-section-11__container {
    row-gap: var(--space-s);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--flow-spacing);
    align-self: center;
    width: 100%;
  }

  .bm-portfolio-related-list {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 2);
  }

  .bm-portfolio-related-card {
    position: relative;
    justify-content: flex-end;
  }

  .bm-portfolio-related-card__content {
    position: relative;
    z-index: 1;
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    row-gap: calc(var(--flow-spacing) / 2);
    display: flex;
  }

  .bm-portfolio-related-card__image {
    object-fit: cover;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
  }

  /* bm-custom */
  .bm-portfolio-related-card {
    aspect-ratio: 4/3;
  }
}
</style>
