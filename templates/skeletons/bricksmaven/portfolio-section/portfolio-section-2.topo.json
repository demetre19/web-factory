   "custom_css": "/* Card */\n\n.portfolio-section-2-card:focus-within :focus {\n\toutline: none;\n  box-shadow: none;\n}\n\n.portfolio-section-2-card:focus-within {\n\tbox-shadow: 0 0 10px 0 var(--black-trans-10);\n\n}\n\n.portfolio-section-2-card {\n\ttransition: .5s ease;\n}\n\n.portfolio-section-2-card:hover {\n\tbackground-color: var(--shade-light);\n}\n\n/* Image */\n\n.portfolio-section-2-card__image {\n\topacity: 0;\n  transition: .5s ease;\n}\n\n.portfolio-section-2-card:hover .portfolio-section-2-card__image, .portfolio-section-2-card:focus-within .portfolio-section-2-card__image{\n\topacity: 1;\n}\n\n/* Background Image */\n\n.portfolio-section-2-card__background-image {\n\topacity: 0.1;\n  transition: .5s ease;\n}\n\n.portfolio-section-2-card:hover .portfolio-section-2-card__background-image, .portfolio-section-2-card:focus-within .portfolio-section-2-card__background-image {\n\topacity: 0;\n}\n\n/* Icon */\n\n.portfolio-section-2-card__icon {\n  transition: .5s ease;\n}\n\n.portfolio-section-2-card:hover .portfolio-section-2-card__icon, .portfolio-section-2-card:focus-within .portfolio-section-2-card__icon {\n\tcolor: var(--primary);\n}\n\n@media (max-width:478px)  {\n\t.portfolio-section-2-card:hover .portfolio-section-2-card__image, .portfolio-section-2-card:focus-within .portfolio-section-2-card__image {\n\tdisplay: none;\n}\n\n}",
