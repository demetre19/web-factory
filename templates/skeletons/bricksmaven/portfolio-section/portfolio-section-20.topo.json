   "custom_css": ".bm-portfolio-section-20-card {\n  overflow: clip;\n}\n\n@media (min-width:991px) {\n\n\n.bm-portfolio-section-20-card::before {\n  content: '';\n  position: absolute;\n  inline-size: 50px;\n  block-size: 50px;\n  z-index: 1;\n  transition: all 0.5s ease;\n  opacity: 0;\n  background-color: var(--base-trans-20);\n  border-radius: var(--radius-circle);\n}\n\n .bm-portfolio-section-20-card:hover::before {\n  inline-size: 200%;\n  block-size: 200%;\n  opacity: 1;\n  border-radius: var(--radius-circle);\n  background-color: var(--base-trans-70);\n  \n}\n\n.bm-portfolio-section-20-card__heading {\n  transform: translateY(400%);\n  transition: 0.2s ease-out;\n}\n\n.bm-portfolio-section-20-card:hover .bm-portfolio-section-20-card__heading {\n  transform: translateY(0%);\n}\n\n.bm-portfolio-section-20-card__text, .bm-portfolio-section-20-card__results, .bm-portfolio-section-20-card__text-link {\n  transform: translateY(100%);\n  transition: 0.2s ease;\n  opacity: 0;\n}\n\n.bm-portfolio-section-20-card:hover .bm-portfolio-section-20-card__text, .bm-portfolio-section-20-card:hover .bm-portfolio-section-20-card__results, .bm-portfolio-section-20-card:hover .bm-portfolio-section-20-card__text-link {\n  transform: translateY(0%);\n  opacity: 1;\n}\n\n}",
