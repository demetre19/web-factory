    "_cssCustom": ".bm-portfolio-section-23-card {\n  transition: 0.3s ease;\n  position: relative;\n  \n}\n\n@media (min-width:991px) {\n  \n  \n  .bm-portfolio-section-23-card:hover {\n    background-color: var(--at-neutral-l-1);\n  color: white;\n}\n  .bm-portfolio-section-23-card:hover .bricks-button[class*=\"primary\"] {\n        color: var(--at-black);\n    border-color: var(--at-white);\n    background-color: var(--at-white);\n  }\n  \n  .bm-portfolio-section-23-card:hover .bm-portfolio-section-23-term-item {\n    background-color: var(--at-black);\n    color: var(--at-white);\n  }\n\n  .bm-portfolio-section-23-card:hover .bm-portfolio-section-23-card__heading a {\n    color: var(--at-white) !important;\n    background-color: transparent;\n    border: none;\n  }\n  \n.bm-portfolio-section-23-card:hover .bm-portfolio-section-23-card__icon-wrapper {\n    background-color: var(--at-white);\n  }\n  \n  .bm-portfolio-section-23-card:hover .bm-portfolio-section-23-card__icon {\n    color: var(--at-black);\n  }\n  \n  .bm-portfolio-section-23-card:hover .bm-portfolio-section-23-card__image {\n    scale: 1.2;\n  }\n  \n}\n\n\n.bm-portfolio-section-23-card:nth-child(even) .bm-portfolio-section-23-card__media {\n  order: -1;\n}"
