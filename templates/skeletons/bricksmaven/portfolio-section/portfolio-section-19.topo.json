   "custom_css": "\n@supports (animation-timeline: view()) {\n  .bm-portfolio-section-19-card {\n\t\tposition: sticky;\n  \ttop: var(--space-xxl); /* where the card will stick */\n    backdrop-filter: blur(100px);\n  \ttransform-origin: center center;\n    will-change: transform, filter;\n    \n    \n    animation-name: shrink-blur;\n    animation-duration: 1s;  /* acts as a scale, not real time now */\n    animation-fill-mode: both;\n    animation-timing-function: linear;\n    /* Each card gets its own view-based timeline */\n    animation-timeline: view(block 90vh);\n\n    /* When should the animation run during its journey in the viewport? */\n    /* entry 0%  = when it just starts entering\n       exit 100% = when it has almost left */\n    animation-range: entry 0% exit 100%;\n  }\n}\n\n@keyframes shrink-blur {\n  from {\n    transform: scale(1);\n    filter: blur(0);\n    opacity: 1;\n  }\n\n  to {\n    transform: scale(0.5);\n    filter: blur(6px);\n    opacity: 0.8;\n  }\n}",
