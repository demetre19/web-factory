interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-portoflio-section-24__container">
    <div class="intro">
      <h2 class="intro__heading">{heading}</h2>
      <p class="intro__subheading">{fs}</p>
      <p class="bm-accent-heading">Accent heading</p>
    </div>
    <div class="bm-portoflio-section-24-list list--none">
      {items.map((it) => (
        <div class="bm-portoflio-section-24-card">
          <div class="bm-portoflio-section-24-card__content">
            <div class="bm-portoflio-section-24-card__intro">
              <h2 class="bm-portoflio-section-24-card__heading">{it.title}</h2>
              <div class="bm-portoflio-section-24-card__terms">
                <p class="bm-portoflio-section-24-card__term-text">{it.text}</p>
              </div>
            </div>
            <div class="bm-portfolio-meta-data-list list--none">
              {(it.items || []).map((it2) => (
                <div class="bm-portfolio-meta-data-item">
                  <h4 class="bm-portfolio-meta-data-item__heading">{it2.title}</h4>
                  <p class="bm-portfolio-meta-data-item__text">{it2.text}</p>
                </div>
              ))}
            </div>
          </div>
          <div class="bm-portoflio-section-24-card__media">
            <figure class="bm-portoflio-section-24-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      ))}
    </div>
    <div class="bm-portoflio-section-24__footer">
      <a class="btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
      <p class="bm-portoflio-section-24__micro-copy">If you want, we can walk through relevant samples on the call based on your niche.</p>
    </div>
  </div>
</div>

