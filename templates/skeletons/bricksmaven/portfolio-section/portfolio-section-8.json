   "children": [],
   "settings": {
    "cssCode": ".portfolio-section-8-card:nth-child(even) {\n  grid-template-columns: var(--grid-2-1);\n  \n}\n\n.portfolio-section-8-card:nth-child(even) .portfolio-section-8-card__media {\n  order:-1;\n  \n}\n\n@media (max-width:767px) {\n\n  .portfolio-section-8-card:nth-child(even) {\n    \n    grid-template-columns: var(--grid-1);\n    \n  }\n  \n  .portfolio-section-8-card:nth-child(even) .portfolio-section-8-card__media {\n  order:0;\n  \n}\n  \n}\n",
    "_display": "none"
   },
