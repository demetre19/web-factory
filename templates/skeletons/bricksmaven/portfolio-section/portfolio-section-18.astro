---
/**
 * bm-portfolio-section-18 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (portfolio-section-18.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-portfolio-section-18__container">
    <div class="intro intro--split">
      <div class="intro__left-column">
        <h2 class="intro__heading">{heading}</h2>
        <p class="bm-accent-heading">Tagline</p>
      </div>
      <div class="intro__right-column">
        <p class="intro__subheading">{fs}</p>
        <a class="btn--primary" href="#">Call to action</a>
      </div>
    </div>
    <div class="bm-portfolio-section-18__portfolio-list">
      <div class="bm-portfolio-section-18__slider-nested">
        {items.map((it) => (
          <div class="bm-portfolio-section-18-case-card">
            <div class="bm-portfolio-section-18-case-card__content">
              <div class="bm-portfolio-section-18-case-card__top">
                <div class="bm-portfolio-section-18-case-card__brand">
                  <svg class="bm-portfolio-section-18-case-card__svg"></svg>
                </div>
                <div class="bm-portfolio-section-18-case-card__icon-wrapper">
                  <span class="bm-portfolio-section-18-case-card__icon" data-icon="lucide" aria-hidden="true"></span>
                </div>
                <div class="bm-portfolio-section-18-case-card__result-wrapper">
                  <p class="bm-portfolio-section-18-case-card__result">{it.text}</p>
                </div>
              </div>
              <h2 class="bm-portfolio-section-18-case-card__heading clickable-parent">{it.title}</h2>
            </div>
            <div class="bm-portfolio-section-18-case-card__media">
              <figure class="bm-portfolio-section-18-case-card__case-image"><img src="/media/placeholder.svg" alt="Case Image" loading="lazy" width="900" height="600" /></figure>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-portfolio-section-18 {
    overflow: clip;
  }

  .bm-portfolio-section-18__container {
    row-gap: var(--space-s);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--flow-spacing);
    align-self: center;
    width: 100%;
  }

  .intro--split {
    display: grid;
    text-align: left;
    grid-template-columns: calc(100% * 1 / 2);
    gap: var(--space-m);
  }

  .intro__left-column {
    row-gap: var(--flow-spacing);
  }

  .intro__right-column {
    row-gap: var(--flow-spacing);
  }

  .bm-portfolio-section-18-case-card {
    row-gap: var(--flow-spacing);
  }

  .bm-portfolio-section-18-case-card__content {
    row-gap: var(--flow-spacing);
  }

  .bm-portfolio-section-18-case-card__top {
    flex-wrap: nowrap;
    column-gap: calc(var(--flow-spacing) / 2);
    flex-direction: row;
    align-items: center;
  }

  .bm-portfolio-section-18-case-card__brand {
    display: flex;
  }

  .bm-portfolio-section-18-case-card__icon-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 24px;
    height: 24px;
    background: var(--fs-0);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
  }

  .bm-portfolio-section-18-case-card__result {
    font-size: var(--fs-0);
  }

  .bm-portfolio-section-18-case-card__case-image {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  /* bm-custom */
  .bm-portfolio-section-18__slider-nested .splide__track {
    overflow: visible;
  }

  /* bm-custom */
  .bm-portfolio-section-18-case-card__media {
    overflow: clip;
  }
  
  
  /* Add scale to image */
  .bm-portfolio-section-18-case-card .bm-portfolio-section-18-case-card__case-image, .bm-portfolio-section-18-case-card:focus-within .bm-portfolio-section-18-case-card__case-image {
    transition: 0.5s ease;
  }
  
  .bm-portfolio-section-18-case-card:hover .bm-portfolio-section-18-case-card__case-image, .bm-portfolio-section-18-case-card:focus-within .bm-portfolio-section-18-case-card__case-image {
    scale: 1.1;
  }
</style>
