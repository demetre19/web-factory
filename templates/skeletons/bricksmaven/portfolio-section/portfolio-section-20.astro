---
/**
 * bm-portfolio-section-20 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (portfolio-section-20.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-portfolio-section-20__container">
      <div class="intro">
        {heading && <h2 class="text-fluid-2">{heading}</h2>}
        {fs && <p class="text-fluid-0">{fs}</p>}
      </div>
      <div>
        <div>
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="bm-portfolio-section-20-card card">
                <div class="bm-portfolio-section-20-card__content">
                  <h2 class="text-fluid-2">{it.title}</h2>
                  <p class="text-fluid-0">{it.text}</p>
                  <div class="bm-portfolio-section-20-card__results">
                    <p class="text-fluid-0">{it.text}</p>
                    <div class="bm-portfolio-section-20-card__icon-wrapper">
                      <span data-icon="lucide" aria-hidden="true"></span>
                    </div>
                  </div>
                  <a class="text-fluid-0" href={it.href}>{it.label}</a>
                </div>
                <figure class="bm-portfolio-section-20-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
