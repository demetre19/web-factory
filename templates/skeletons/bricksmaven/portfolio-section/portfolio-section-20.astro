    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
  }

  /* bm-custom */
  .bm-portfolio-section-20-card {
    overflow: clip;
  }
  
  @media (min-width:991px) {
  
  
  .bm-portfolio-section-20-card::before {
    content: '';
    position: absolute;
    inline-size: 50px;
    block-size: 50px;
    z-index: 1;
    transition: all 0.5s ease;
    opacity: 0;
    background-color: color-mix(in srgb, var(--fs-0) 20%, transparent);
    border-radius: 100%;
  }
  
   .bm-portfolio-section-20-card:hover::before {
