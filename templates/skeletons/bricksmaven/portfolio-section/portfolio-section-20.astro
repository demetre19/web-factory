 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-portfolio-section-20__container">
    <div class="intro">
      <h2 class="intro__heading">Long headline to turn your visitors into customers</h2>
      <p class="intro__subheading">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
      <p class="bm-accent-heading">Accent heading</p>
    </div>
    <div class="bm-portfolio-section-20__portfolio-slider">
      <div class="bm-portfolio-section-20__portfolio-carousel">
        {items.map((it) => (
          <div class="bm-portfolio-section-20-card">
            <div class="bm-portfolio-section-20-card__content">
              <h2 class="bm-portfolio-section-20-card__heading">{it.title}</h2>
              <p class="bm-portfolio-section-20-card__text">{it.text}</p>
              <div class="bm-portfolio-section-20-card__results">
                <p class="bm-portfolio-section-20-card__result-text">{it.text}</p>
                <div class="bm-portfolio-section-20-card__icon-wrapper">
                  <span class="bm-portfolio-section-20-card__icon" data-icon="lucide" aria-hidden="true"></span>
                </div>
              </div>
              <a class="bm-portfolio-section-20-card__text-link" href="#">{it.text}</a>
            </div>
            <figure class="bm-portfolio-section-20-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style is:global>
