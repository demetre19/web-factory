    padding: var(--space-l) var(--space-l) var(--space-l) var(--space-l);
  }

  .bm-portfolio-section-20-card__content {
    position: relative;
    z-index: 1;
    row-gap: var(--flow-spacing);
    height: 100%;
    justify-content: flex-end;
    flex-wrap: nowrap;
  }

  .bm-portfolio-section-20-card__results {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    column-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-portfolio-section-20-card__icon-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 32px;
    height: 32px;
    background: var(--bg-canvas);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
  }

