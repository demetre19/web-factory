   "typography": {},
   "colour": {},
   "radius": {},
   "custom_css": ".bm-portfolio-section-21__portfolio-carosuel .splide__track {\n  overflow: visible;\n}\n\n.bm-portfolio-section-21__portfolio-carosuel .splide__arrows {\n  position: absolute;\n  inset-block-start: var(--space-m);\n  inset-inline-end: var(--space-l);\n}\n\n.bm-portfolio-section-21__portfolio-carosuel .splide__arrow--next {\n  margin-block-start: 48px;\n}\n\n\n.bm-portfolio-section-21__portfolio-carosuel  {\n  --image-slide: 1.2; /* increase or decrease image scale */\n  --image-duration: 0.5s; /* transition duration raise for a slower scale and decrease to speed it up */\n  --image-timing-function: ease; \n  \n  --slide-blur: 6px; /* Slide blur intensity */\n  --slide-opacity: 0.7; /* Opacity temparature */\n  \n  --animation-timing-function: ease;\n  --animation-duration: 1s; /* lenghthen or shorten the animation duration */\n  --animation-play-state: forwards;\n  \n  --keyframe-content-start: 40%; /* Animation start content */\n  --keyframe-content-end: 0%; /* Animation end content */\n  \n  --keyframe-brand-start: 3%; /* Animation start brand */\n  --keyframe-brand-end: 0%; /* Animation end brand */\n  \n  z-index: 2;\n  will-change: blur transform opacity;\n}\n\n\n/* Blur and lower opacity on non-active slide  */\n.bm-portfolio-section-21__portfolio-carosuel .is-prev, .bm-portfolio-section-21__portfolio-carosuel .is-next {\n  \n  filter: blur(var(--slide-blur));\n  opacity: var(--slide-opacity);\n}\n\n/* Scale image */\n.bm-portfolio-section-21__portfolio-carosuel .bm-portfolio-section-21-card .bm-portfolio-section-21-card__image {\n  transition: var(--image-duration) var(--image-timing-function);\n}\n\n.bm-portfolio-section-21__portfolio-carosuel .bm-portfolio-section-21-card:hover .bm-portfolio-section-21-card__image {\n  scale: var(--image-slide);\n}\n\n/* Hide content */\n.bm-portfolio-section-21__portfolio-carosuel .bm-portfolio-section-21-card .bm-portfolio-section-21-card__content {\n  opacity: 0;\n}\n\n/* Animate card content  */\n.bm-portfolio-section-21__portfolio-carosuel .is-active .bm-portfolio-section-21-card__content {\n  animation: contentslide var(--animation-duration) var(--animation-timing-function) var(--animation-play-state) ;\n} \n\n@keyframes contentslide {\n  0% {\n   \n    transform: var(--keyframe-content-start);\n  }\n  \n  100% {\n    opacity: 1;\n    transform: var(--keyframe-content-end);\n  }\n}\n\n/* Hide brand */\n.bm-portfolio-section-21__portfolio-carosuel .bm-portfolio-section-21-card .bm-portfolio-section-21-card__brand {\n  opacity: 0;\n}\n\n/* Slide in Brand logo */\n.bm-portfolio-section-21__portfolio-carosuel .is-active .bm-portfolio-section-21-card__brand {\n  animation: brandslide-in var(--animation-duration) var(--animation-timing-function) var(--animation-play-state) ;\n  \n} \n\n@keyframes brandslide-in {\n  0% {\n    \n    margin-block-start: var(--keyframe-brand-start);\n  }\n  \n  100% {\n    opacity: 1;\n    margin-block-start: var(--keyframe-brand-end);\n  }\n}",
