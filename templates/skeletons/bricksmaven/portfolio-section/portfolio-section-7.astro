---
/**
 * bm-portfolio-section-7 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (portfolio-section-7.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="portfolio-section-7__container">
    <div class="intro intro--split portfolio-section-7__intro">
      <div class="intro__left-column">
        <h2 class="intro__heading">Long headline to turn your visitors into users</h2>
        <p class="intro__accent-heading portfolio-section-7__accent-heading">Tagline</p>
      </div>
      <div class="intro__right-column">
        <p class="intro__subheading">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
        <a class="btn--primary btn--white" href="#">Call to action</a>
      </div>
    </div>
    <div class="portfolio-section-7-portfolio-wrapper list--none">
      {items.map((it) => (
        <div class="portfolio-section-7-card">
          <div class="portfolio-section-7-card__content">
            <div class="portfolio-section-7-card__title">
              <h2 class="portfolio-section-7-card__heading clickable-parent">{it.title}</h2>
              <p class="portfolio-section-7-card__text">{it.text}</p>
            </div>
            <div class="portfolio-section-7-card__category-label">
              <p class="portfolio-section-7-card__category">{it.text}</p>
            </div>
          </div>
          <div class="portfolio-section-7-card__media">
            <figure class="portfolio-section-7-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
@layer components {
  .portfolio-section-7 {
    background: var(--text-secondary);
  }

  .portfolio-section-7__container {
    row-gap: var(--space-s);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--flow-spacing);
    align-self: center;
  }

  .intro--split {
    display: grid;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    align-self: flex-start;
    grid-template-columns: calc(100% * 1 / 2);
    gap: var(--space-m);
  }

  .intro__left-column {
    row-gap: var(--flow-spacing);
  }

  .intro__right-column {
    row-gap: var(--flow-spacing);
  }

  .btn--primary {
    padding: 1.25rem 1.875rem 1.25rem 1.875rem !important;
    width: auto;
  }

  .portfolio-section-7-portfolio-wrapper {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 2);
  }

  .portfolio-section-7-card {
    overflow: hidden;
    border-top: 1px solid var(--color-ink-secondary);
    border-right: 1px solid var(--color-ink-secondary);
    border-bottom: 1px solid var(--color-ink-secondary);
    border-left: 1px solid var(--color-ink-secondary);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    position: relative;
    background: var(--bg-subtle);
  }

  .portfolio-section-7-card__content {
    flex-direction: row;
    flex-wrap: nowrap;
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
  }

  .portfolio-section-7-card__title {
    row-gap: var(--flow-spacing);
  }

  .portfolio-section-7-card__category-label {
    background: var(--bg-subtle);
    padding: calc(var(--space-xs) / 2) var(--space-s) calc(var(--space-xs) / 2) var(--space-s);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .portfolio-section-7-card__category {
    font-size: var(--fs-0);
  }

  .portfolio-section-7-card__media {
    height: 56rem;
    overflow: hidden;
  }

  .portfolio-section-7-card__image {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  /* bm-custom */
  @media (min-width:991px) {
  
  .portfolio-section-7-portfolio-wrapper:hover .portfolio-section-7-card:not(:hover) {
  	opacity: 0.3;
    filter: grayscale(1);
    
  }
  
  }

  /* bm-custom */
  /* Card */
  .portfolio-section-7-card {
    transition: .7s linear;
    
  }
  
  /* Card Focus */
  .portfolio-section-7-card:focus-within :focus {
  	outline: none;
    box-shadow: none;
  }
  
  .portfolio-section-7-card:focus-within {
    box-shadow: 0 0 1rem 0 color-mix(in srgb, var(--color-line-default) 90%, transparent);
  }
  
  
  /* Card First child*/
  .portfolio-section-7-card:first-child {
  	height: 72rem; /* Change the height of the first child */
    grid-column: span 2; /* Spans the first child over 2 columns */
    transition: .5s linear;
    
  }
  
  /* Media */
  .portfolio-section-7-card:first-child .portfolio-section-7-card__media{
  	height: 100%; /* Sets the image height to 100% */
    position: absolute;
  }
  
  /* Content */
  .portfolio-section-7-card:first-child .portfolio-section-7-card__content {
    width: var(--measure); /* Change the width of content wrapper */
    height: 100%;
    flex-direction: column;
    justify-content: center;
    gap: var(--flow-spacing);
    z-index: 1;
    
  }
  
  /* Heading*/
  .portfolio-section-7-card:first-child .portfolio-section-7-card__heading {
  	font-size: calc(var(--fs-4) * 1.2);
    color: var(--bg-canvas);
    
  }
  
  /* Text */
  .portfolio-section-7-card:first-child .portfolio-section-7-card__text {
    color: var(--bg-canvas);
    
  }
  
  /* Category Label */
  .portfolio-section-7-card:first-child .portfolio-section-7-card__category-label {
    order: -1;
    
  }
  
  /* Image*/
  .portfolio-section-7-card__image {
  	transition: 2s ease;
  }
  
  .portfolio-section-7-card:hover .portfolio-section-7-card__image, .portfolio-section-7-card:focus-within .portfolio-section-7-card__image  {
  	scale: 1.3;
  }
  
  /* Media Query*/
  @media (max-width:991px) {
  	.portfolio-section-7-card:first-child {
    height: 52rem;
    grid-column: span 1;
    
  }
  }
}
</style>
