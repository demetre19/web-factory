---
/**
 * bm-portfolio-section-14 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (portfolio-section-14.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-portfolio-section-14__container">
      <div class="intro bm-portfolio-section-14__intro">
        {heading && <h2 class="text-fluid-2">{heading}</h2>}
        {fs && <p class="text-fluid-0">{fs}</p>}
      </div>
      <div class="bm-portfolio-section-14-feature-list">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="bm-portfolio-section-14-card card">
              <div class="bm-portfolio-section-14-card__cover">
                <div class="bm-portfolio-section-14-card__content">
                  <div class="bm-portfolio-section-14-card__top">
                    <h2 class="text-fluid-2">{it.title}</h2>
                    <p class="text-fluid-0">{it.text}</p>
                  </div>
                  <div class="bm-list">
                    <div class="grid-auto gap-fluid-m">
                      {((it.items || []) || []).map((it2) => (
                        <div class="bm-list-item card">
                          <div class="bm-list-item__icon-wrapper">
                            <span data-icon="lucide" aria-hidden="true"></span>
                          </div>
                          <p class="bm-list-item__text text-fluid-0">{it2.text}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
                <div class="bm-portfolio-section-14-card__testimonial">
                  <div class="bm-portfolio-section-14-card__top">
                    <p class="text-fluid-0">{it.text}</p>
                  </div>
                  <div class="testimonial-list-card__profile">
                    <div class="testimonial-list-card__meta">
                      <custom class="text-fluid-2">{it.title}</custom>
                      <p class="text-fluid-0">{it.text}</p>
                    </div>
                  </div>
                </div>
              </div>
              <div class="grid-auto gap-fluid-l">
                <figure class="bm-portfolio-section-14-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                <div></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div></div>
  </div>
</div>
