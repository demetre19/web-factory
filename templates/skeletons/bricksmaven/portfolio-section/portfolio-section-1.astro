---
/**
 * bm-portfolio-section-1 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (portfolio-section-1.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="portfolio-section-1-container">
      <div class="intro">
        {heading && <h2 class="text-fluid-2">{heading}</h2>}
        {fs && <p class="text-fluid-0">{fs}</p>}
      </div>
      <div class="portfolio-section-1-grid">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="portfolio-section-1-card card">
              <div class="portfolio-section-1-card__work grid-auto gap-fluid-l">
                <h2 class="text-fluid-2">{it.title}</h2>
                <figure class="portfolio-section-1-card__work-image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
              <div class="portfolio-section-1-card__testimonial-wrapper">
                <div>
                  <p class="text-fluid-0">{it.text}</p>
                  <p class="portfolio-section-1-card__review-text text-fluid-0">{it.text}</p>
                </div>
                <div class="portfolio-section-1-card__client">
                  <div>
                    <figure class="portfolio-section-1-card__client-image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                  </div>
                  <div>
                    <p class="text-fluid-0">{it.text}</p>
                    <p class="text-fluid-0">{it.text}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
