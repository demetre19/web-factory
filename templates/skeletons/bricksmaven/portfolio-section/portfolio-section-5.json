  {
   "id": "9m2wqa",
   "name": "portfolio-section-5-case-card",
   "settings": {
    "_height": "65vh",
    "_position": "relative",
    "_padding": {
     "top": "var(--space-xl)",
     "right": "var(--space-xl)",
     "bottom": "var(--space-xl)",
     "left": "var(--space-xl)"
    },
    "_overflow": "hidden",
    "_height:mobile_landscape": "64rem",
    "_cssCustom": "/* Card */\n.portfolio-section-5-case-card {\n  --move-content-down: calc(100% + var(--space-xl));\n  --blur-content: 1rem;\n  position:sticky;\n}\n\n.portfolio-section-5-case-card:focus-within :focus {\n\toutline: 0;\n  box-shadow: none;\n}\n\n.portfolio-section-5-case-card:focus-within {\n  box-shadow: 0 0 2rem 0 var(--neutral-trans-10);\n}\n\n  /* Content */\n.portfolio-section-5-case-card__content {\n\t\n  backdrop-filter: blur(10px);\n  color: var(--white);\n  border: 1px solid var(--white-trans-20) ;\n}\n\n\n/* Overlay */\n.portfolio-section-5-case-card__overlay {\n\ttransition: .3s ease;\n  opacity: 1;\n}\n\n.portfolio-section-5-case-card:hover .portfolio-section-5-case-card__overlay, .portfolio-section-5-case-card:focus-within .portfolio-section-5-case-card__overlay {\n  opacity: .6;\n}\n\n/* Image */\n.portfolio-section-5-case-card__image {\n\ttransition: .3s ease;\n  filter: grayscale(1);\n}\n\n.portfolio-section-5-case-card:hover .portfolio-section-5-case-card__image, .portfolio-section-5-case-card:focus-within .portfolio-section-5-case-card__image {\n\tfilter: grayscale(0);\n  \n}\n\n/* Sticky */\n.portfolio-section-5-case-card:nth-of-type(1) {\n\ttop: var(--space-xxl);\n}\n\n.portfolio-section-5-case-card:nth-of-type(2) {\n\ttop: calc(var(--space-xxl) * 1.4);\n}\n\n.portfolio-section-5-case-card:nth-of-type(3) {\n\ttop: calc(var(--space-xxl) * 1.6);\n}\n\n\n@media (min-width:991px) {\n\n  /* Content */\n.portfolio-section-5-case-card__content {\n\t\n  transform: translateY(var(--move-content-down));\n  transition: .5s ease;\n  filter:blur(var(--blur-content));\n  backdrop-filter: blur(10px);\n  color: var(--white);\n  border: 1px solid var(--white-trans-20) ;\n}\n\n.portfolio-section-5-case-card:hover .portfolio-section-5-case-card__content, .portfolio-section-5-case-card:focus-within .portfolio-section-5-case-card__content {\n  transform: translateY(0);\n  filter:blur(0);\n  \n}\n  \n  /* Heading */\n.portfolio-section-5-case-card__heading {\n\ttransition: .5s ease;\n  writing-mode: vertical-rl;\n\n}\n\n.portfolio-section-5-case-card:hover .portfolio-section-5-case-card__heading, .portfolio-section-5-case-card:focus-within .portfolio-section-5-case-card__heading {\n\topacity: 0;\n}\n}\n",
