---
/**
 * bm-product-section-5 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (product-section-5.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div>
      <div class="product-list-5__list">
        <div class="intro">
          {heading && <h2 class="text-fluid-2">{heading}</h2>}
          {fs && <p class="text-fluid-0">{fs}</p>}
        </div>
        <div class="product-list-5-card__group">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="product-list-5-card__container card">
                <div class="product-list-5__category-wrapper">
                  <p class="text-fluid-0">{it.text}</p>
                  <a class="text-fluid-0" href={it.href}>{it.label}</a>
                </div>
                <div class="product-list-5__card-list">
                  <div class="product-list-5-card">
                    <div class="product-list-5-card__content">
                      <div class="product-list-5-card__top">
                        <h3 class="product-list-5-card__heading text-fluid-2">{it.title}</h3>
                        <div></div>
                        <div></div>
                      </div>
                      <div class="product-list-notice-rect__sale-badge">
                        <p class="text-fluid-0">{it.text}</p>
                      </div>
                      <div class="product-list-5__button"></div>
                    </div>
                    <div class="product-list-5__image-container">
                      <figure class="product-list-5-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
