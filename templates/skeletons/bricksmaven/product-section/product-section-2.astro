  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="product-list-2__container">
    <div class="product-list-2__list">
      <div class="product-list-2__content">
        <h2 class="product-list-2__heading">{heading}</h2>
        <p class="product-list-2__headline">{fs}</p>
        <a class="btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
      </div>
      <div class="product-list-2__slider">
        <div class="product-list-2-card">
          <div class="product-list-2-card__content">
            <h3 class="product-list-2-card__heading">{post_title}</h3>
            <p class="product-list-category order--first">{post_terms_product_cat}</p>
            <p class="product-list-2-card__description">Here goes your text ... Select any part of your text to access the formatting toolbar.</p>
          </div>
          <div class="product-list-notice-rect__sale-badge">
            <p class="product-list-notice-rect__sale">{woo_product_on_sale}</p>
          </div>
          <custom class="product-list-card__price">{woo_product_price}</custom>
          <div class="product-list-2-card__media">
            <figure class="product-list-2-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      </div>
    </div>
