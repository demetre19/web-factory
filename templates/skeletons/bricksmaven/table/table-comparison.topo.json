   "custom_css": ".bm-table-2 {\n  --table-cell-width: 150px;\n  --table-border-color: var(--base-ultra-light);\n  --table-padding: var(--space-xs);\n  inline-size: 100%;\n  border-spacing: 0px;\n  border-collapse: collapse;\n}\n\n.bm-table-2__caption {\n  background-color: var(--base-ultra-light);\n  padding: var(--table-padding);\n  text-align: left;\n  font-size: var(--text-l);\n  font-weight: 700;\n  /* display: none; */\n  border-inline: 1px solid var(--table-border-color);\n  border-top: 1px solid var(--table-border-color);\n  text-transform: uppercase;\n}\n\n.bm-table-2 thead {\n  background-color: var(--base);\n  color: var(--text-light);\n}\n\n.bm-table-2 thead th {\n  border-bottom: 1px solid var(--table-border-color);\n}\n\n.bm-table-2 th, .bm-table-2 td {\n  padding: var(--table-padding);\n  text-align: left;\n  min-width: var(--table-cell-width);\n}\n\n.bm-table-2__tbody .bm-table-2__tr:nth-child(even) {\n  background-color: var(--base-ultra-light);\n}",
