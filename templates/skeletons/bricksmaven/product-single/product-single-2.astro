---
/**
 * bm-product-single-2 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (product-single-2.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div>
      <div>
        <div></div>
      </div>
    </div>
    <div class="bm-product-single-2__container">
      <div class="bm-product-single-2__breadcrumb-wrapper">
        <div></div>
        {fs && <p class="text-fluid-0">{fs}</p>}
      </div>
      <div class="bm-product-single-2__main">
        <div class="bm-product-single-2__content">
          <div class="bm-product-single-2__sticky-wrapper">
            <div class="bm-product-single-2__top">
              <div></div>
              <div></div>
            </div>
            <div class="bm-product-single-2__mid">
              <div></div>
              <div class="bm-product-single__product-stock"></div>
            </div>
            <div></div>
            <div></div>
            <div class="bm-payment-options-wrapper-1">
              <div class="bm-payment-options">
                <div class="grid-auto gap-fluid-m">
                  {(items || []).map((it) => (
                    <div class="card">
                      <figure class="bm-footer-option__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                    </div>
                  ))}
                </div>
              </div>
            </div>
            <div class="bm-product-single-usp-1">
              <div class="grid-auto gap-fluid-m">
                {(items || []).map((it) => (
                  <div class="bm-product-single-usp-1-list-item card">
                    <div>
                      <span data-icon="lucide" aria-hidden="true"></span>
                    </div>
                    <p class="text-fluid-0">{it.text}</p>
                  </div>
                ))}
              </div>
            </div>
            <div class="bm-product-single__product-meta"></div>
          </div>
        </div>
        <div class="bm-product-single-2__media">
          <div></div>
        </div>
      </div>
      <div class="bm-product-single-2__product-footer">
        <div class="bm-product-single-2__footer-wrapper">
          <div class="bm-product-single-2__column">
            <div></div>
          </div>
          <div class="bm-product-single-2__column">
            {heading && <h2 class="text-fluid-2">{heading}</h2>}
            <div></div>
          </div>
        </div>
        <div class="bm-product-single-2__review-wrapper">
          <div class="bm-product-single-2__review-top"></div>
          <div></div>
        </div>
      </div>
    </div>
    <div class="bm-product-single__related-products-container">
      <div class="bm-related-products-list-1__list">
        <div>
          <div class="bm-related-products-list-1-card">
            <div class="bm-related-products-list-1-card__content">
              <div class="bm-related-products-list-1-card__top"></div>
              <div></div>
            </div>
            <div>
              <figure class="bm-related-products-list-1-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            </div>
            <div class="bm-product-list-notice__wrapper">
              <div class="bm-product-list-notice-circle__sale-badge"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div></div>
  </div>
</div>
