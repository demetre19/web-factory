    "_position": "relative",
    "_aspectRatio": "6/4",
    "_overflow": "hidden",
    "_cssCustom": "/* CARD */ \n.bm-blog-section-23-card {\n  transition: 0.2s ease-out\n}\n\n.bm-blog-section-23-card:hover, .bm-blog-section-23-card:focus-within {\n  scale: 1.06;\n}\n\n.bm-blog-section-23-card:focus-within :focus {\n\toutline: none !important;\n  box-shadow: none;\n}\n\n\n/* OVERLAY */ \n.bm-blog-section-23-card__overlay {\n  background-color: var(--neutral-trans-60);\n  height: 100%;\n  position: absolute;\n  inset: 0;\n  z-index: 1;\n  transition: 0.2s ease-out;\n}\n\n.bm-blog-section-23-card:hover .bm-blog-section-23-card__overlay, .bm-blog-section-23-card:focus-within .bm-blog-section-23-card__overlay {\n  background-color: var(--neutral-trans-40);\n}\n\n@media (max-width:991px) {\n  .bm-blog-section-23-card:last-child {\n    grid-column: span 2;\n  }\n}\n\n@media (max-width:767px) {\n  .bm-blog-section-23-card:last-child {\n    grid-column: span 1;\n  }\n}",
