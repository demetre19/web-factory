             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="blog-section-15__container">
    <div class="intro intro--split">
      <div class="intro__left-column">
        <h2 class="intro__heading">{heading}</h2>
        <p class="intro__accent-heading">Tagline</p>
      </div>
      <div class="intro__right-column">
        <p class="intro__subheading">{fs}</p>
        <a class="btn--black wf-cta-button" href={cta.href}>{cta.label}</a>
      </div>
    </div>
    <div class="blog-section-15-grid-ul list--none">
      <div class="blog-section-15-card">
        <div class="blog-section-15-card__content">
          <div class="blog-section-15-card__head">
            <h2 class="blog-section-15-card__heading clickable-parent">{post_title}</h2>
            <div class="blog-section-15-card__excerpt"></div>
          </div>
          <div class="blog-section-15-card__meta-data">
            <div class="blog-section-15-card__author-wrapper">
              <p class="blog-section-15-card__author">{author_name}</p>
            </div>
            <div class="blog-section-15-card__date-wrapper">
              <p class="blog-section-15-card__date">{post_date}</p>
            </div>
          </div>
          <div class="blog-section-15-card__footer">
            <div class="blog-section-15-card__terms-wrapper">
              <p class="blog-section-15-card__terms">{post_terms_category:plain}</p>
            </div>
            <a class="blog-section-15-card__link" href="#">Read the full story</a>
          </div>
        </div>
        <div class="blog-section-15-card__media">
          <figure class="blog-section-15-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
      </div>
    </div>
  </div>
</div>

