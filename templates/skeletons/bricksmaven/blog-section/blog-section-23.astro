  .bm-blog-section-23-card__content {
    justify-content: space-between;
    height: 100%;
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    position: relative;
    z-index: 2;
    flex-wrap: nowrap;
  }

  .bm-blog-section-23-card__footer {
    flex-direction: row;
    justify-content: space-between;
  }

  .bm-blog-section-23-card__date {
    font-size: var(--fs-0);
  }

  .bm-blog-section-23-card__author {
    font-size: var(--fs-0);
  }

  .bm-blog-section-23-card__image {
    object-fit: cover;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
  }

  /* bm-custom */
  /* CARD */ 
  .bm-blog-section-23-card {
    transition: 0.2s ease-out
  }
  
