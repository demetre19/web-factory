        <div class="bm-blog-section-23-card__content">
          <h2 class="bm-blog-section-23-card__heading clickable-parent">{post_title}</h2>
          <div class="bm-blog-section-23-card__footer">
            <p class="bm-blog-section-23-card__date">{post_date}</p>
