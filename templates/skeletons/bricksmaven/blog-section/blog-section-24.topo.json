   "custom_css": "\n.bm-blog-section-24-card::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  inline-size: 100%;\n  block-size: 100%;\n  background-color: var(--base-trans-60);\n  z-index: 1;\n  opacity: 1;\n  transition: 0.5s ease;\n}\n\n@media (min-width:991px) {\n  .bm-blog-section-24-card:hover::before, .bm-blog-section-24-card:focus-within::before {\n\n  opacity: 0.2;\n}\n  \n  .bm-blog-section-24-card .bm-blog-section-24-card__content::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  inline-size: 100%;\n  block-size: 100%;\n  transition: 0.2s ease;\n  scale: 0.9;\n  border-radius: var(--radius-l);\n  \n}\n\n.bm-blog-section-24-card:hover .bm-blog-section-24-card__content::before, .bm-blog-section-24-card:focus-within .bm-blog-section-24-card__content::before {\n  background-color: var(--base);\n  scale: 1;\n}\n\n.bm-blog-section-24-card .bm-blog-section-24-card__post-title {\n  transform: translateY(75%);\n  transition: 0.5s ease;\n}\n\n.bm-blog-section-24-card .bm-blog-section-24-card__footer {\n  transform: translateY(100%);\n  transition: 0.5s ease;\n}\n\n\n.bm-blog-section-24-card:hover .bm-blog-section-24-card__post-title, .bm-blog-section-24-card:focus-within .bm-blog-section-24-card__post-title {\n  transform: translateY(0%);\n}\n\n.bm-blog-section-24-card .bm-blog-section-24-card__footer {\n  opacity: 0;\n}\n\n.bm-blog-section-24-card:hover .bm-blog-section-24-card__footer, .bm-blog-section-24-card:focus-within .bm-blog-section-24-card__footer {\n  opacity: 1;\n  transform: translateY(0%);\n}\n}",
