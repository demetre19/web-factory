interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="blog-section-10-container">
    <div class="blog-section-10-wrapper">
      <div class="blog-section-10-head">
        <p class="accent-h">Latest</p>
        <h2 class="blog-section-10-head__title">{heading}</h2>
        <p class="blog-section-10-head__desc">{fs}</p>
        <a class="blog-section-10-head__cta btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
      </div>
      <div class="blog-section-10-body list--none">
        <div class="blog-section-10-card">
          <div class="blog-section-10-card__media">
            <figure class="blog-section-10-card__thumb"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            <p class="blog-section-10-card__term">{post_terms_category}</p>
          </div>
          <div class="blog-section-10-card__meta">
            <div class="blog-section-10-card__author">
              <figure class="blog-section-10-card__author-image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              <p class="blog-section-10-card__name">{author_name}</p>
              <p class="blog-section-10-card__date">{post_date}</p>
            </div>
            <h2 class="blog-section-10-card__title">{post_title}</h2>
            <div class="blog-section-10-card__excerpt"></div>
            <p class="blog-section-10-card__read">Read the full story</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

