   "custom_css": ".bm-feature-76__list .bm-feature-76-media {\n  min-block-size: 100vh;\n}\n\n\n.bm-feature-76-media-item__image img {\n  display: block;\n  object-fit: cover;\n}\n\n@media (min-width:991px) {\n\n.bm-feature-76__list .bm-feature-76-media-item {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n\n  opacity: 0;\n  transform: scale(1.03);\n  transition: opacity 2s ease, transform 2s ease;\n}\n\n.bm-feature-76__list .bm-feature-76-media-item.is-active {\n  opacity: 1;\n  transform: scale(1);\n}\n\n  \n  .bm-feature-76__list .bm-feature-76-card {\n  opacity: 0.35;\n  transition: opacity 0.8s ease;\n}\n\n.bm-feature-76__list .bm-feature-76-card.is-active {\n  opacity: 1;\n}\n  \n}\n\n@media (max-width:991px) {\n\n.bm-feature-76__list .bm-feature-76-media {\n  display:none;\n}\n\n  \n}\n",
