    "_gridTemplateColumns:mobile_landscape": "repeat(1, minmax(0, 1fr))",
    "_gridGap:mobile_landscape": "var(--space-xl)",
    "_cssCustom": ".feature-11-feature-item::before {\n\tcontent:\"\";\n  position: absolute;\n  width: 60vw;\n  height:100%;\n  background-color: var(--primary);\n  margin-left: calc(-60vw + 60%);\n  clip-path: polygon(0% 0%, 100% 0%, 90% 100%, 0% 100%);\n}\n\n.feature-11-feature-item:nth-child(even)::before {\n\tcontent:\"\";\n  position: absolute;\n  width: 60vw;\n  height:100%;\n  right:0; \n  background-color: var(--primary);\n  margin-right: calc(-60vw + 60%);\n  clip-path: polygon(10% 0%, 100% 0%, 100% 100%, 0% 100%);\n}\n\n\n.feature-11-feature-item:nth-child(even) .feature-11-feature-item__media-wrapper {\n\torder:-1;\n}\n\n.feature-11-feature-item:nth-child(even) .feature-11-feature-item__content {\n\tpadding-left: var(--space-xl);\n  padding-right: 0px;\n}\n\n@media (max-width:767px) {\n\t.feature-11-feature-item::before {\n\tcontent:\"\";\n  position: absolute;\n  width: 100vw;\n  height:75%;\n  background-color: var(--primary);\n  margin-left: calc(-60vw + 60%);\n  clip-path: polygon(0% 0%, 100% 0%, 100% 70%, 0% 100%);\n}\n  \n  .feature-11-feature-item:nth-child(even)::before {\n\tcontent:\"\";\n  position: absolute;\n  width: 100vw;\n  height:75%;\n  right:0; \n  background-color: var(--primary);\n  margin-right: calc(-60vw + 60%);\n  clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 70%);\n}\n  \n  .feature-11-feature-item:nth-child(even) .feature-11-feature-item__media-wrapper {\n\torder:1;\n}\n  \n  .feature-11-feature-item:nth-child(even) .feature-11-feature-item__content {\n\tpadding-left: 0rem;\n}\n}",
    "_alignItemsGrid": "center",
