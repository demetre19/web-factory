---
/**
 * bm-feature-3 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (feature-3.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="intro">
    <h2 class="intro__heading">{heading}</h2>
    <p class="intro__subheading">{fs}</p>
    <p class="intro__accent-heading">Tagline</p>
  </div>
  <div class="list--none feature-3-ul">
    {items.map((it) => (
      <div class="feature-3-li">
        <div class="feature-3-li__content">
          <h2 class="feature-3-li__title">{it.title}</h2>
          <p class="feature-3-li__desc">{it.text}</p>
          <span class="feature-3-li__icon" data-icon="lucide" aria-hidden="true"></span>
          <a class="feature-3-li__cta wf-cta-button" href={it.href}>{it.label}</a>
        </div>
        <div class="feature-3-li__media-container">
          <figure class="feature-3-li__thumb"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
      </div>
    ))}
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .feature-3 {
    row-gap: var(--space-s);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .feature-3-li {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .feature-3-li__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    row-gap: var(--space-xs);
    padding: var(--section-space-xxl) var(--section-space-xxl) var(--section-space-xxl) var(--section-space-xxl);
    margin: 0 0 0 auto;
  }

  .feature-3-li__title {
    flex-direction: column;
    row-gap: var(--space-xs);
  }

  .feature-3-li__icon {
    padding: var(--space-xs) var(--space-xs) var(--space-xs) var(--space-xs);
    background: color-mix(in srgb, var(--action-primary) 40%, transparent);
    border-radius: 10rem 10rem 10rem 10rem;
  }

  .feature-3-li__cta {
    background: var(--bg-canvas);
    padding: 0 0 0 0;
  }

  .feature-3-li__media-container {
    width: 100%;
  }

  .feature-3-li__thumb {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  /* bm-custom */
  .feature-3-li:nth-of-type(even) .feature-3-li__media-container {
  	order:-1;
  }
</style>
