        <a class="bm-feature-71-cta-card__btn" href={cta.href}>{cta.label}</a>
        <div class="bm-feature-71-cta-card__icon-wrapper">
          <span class="bm-feature-71-cta-card__icon" data-icon="lucide" aria-hidden="true"></span>
        </div>
      </div>
    </div>
