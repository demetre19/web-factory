    <div class="intro intro--left">
      <h2 class="intro__heading">{heading}</h2>
      <p class="intro__subheading">{fs}</p>
      <p class="bm-accent-heading">Tagline</p>
    </div>
    <div class="bm-feature-71-grid-ul">
      {items.map((it) => (
        <div class="bm-feature-71-card">
          <div class="bm-feature-71-card__content">
            <h2 class="bm-feature-71-card__heading">{it.title}</h2>
            <p class="bm-feature-71-card__text">{it.text}</p>
          </div>
          <p class="bm-feature-71-card__accent-heading">{it.text}</p>
          <a class="bm-feature-71-card__btn wf-cta-button" href={it.href}>{it.label}</a>
          <div class="bm-feature-71-card__icon-wrapper">
            <span class="bm-feature-71-card__icon" data-icon="lucide" aria-hidden="true"></span>
          </div>
        </div>
