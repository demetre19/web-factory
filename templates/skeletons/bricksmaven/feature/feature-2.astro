        grid-column: 1 / -1;
        grid-row-start: 1;
        order:-1;
      }
    
    .feature-2-li:nth-of-type(even) .feature-2-li__media-container{
  		grid-column: 1 / -1;
    	grid-row-start: 1;
      align-items: start;
  }
  
      .feature-2-li:nth-of-type(even) .feature-2-li__content{
          grid-column: 1 / -1;
          grid-row-start: 2;
      }
  }
