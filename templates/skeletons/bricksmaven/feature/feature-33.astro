    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    align-self: flex-start;
  }

  .feature-33-list {
    row-gap: var(--space-s);
  }

  .feature-33-card {
    row-gap: var(--flow-spacing);
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
  }

  .feature-33-card__content {
    row-gap: calc(var(--flow-spacing) / 4);
    z-index: 1;
  }

  .feature-33-card__image {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  /* bm-custom */
  /* Set position sticky on cards */
  .feature-33-card {
  	position: sticky;
    --sticky-top: var(--space-l);
    transition: .5s ease;
    background-color: var(--bg-subtle);
    border-top: 1px solid var(--action-primary);
    box-shadow: 0rem -1rem 1rem 0 color-mix(in srgb, var(--text-primary) 10%, transparent);
  }
  
  .feature-33-card:hover, .feature-33-card:focus-within {
  	background-color: var(--bg-canvas);
    box-shadow: var(--shadow-card);
  }
  
  .feature-33-card:focus-within :focus {
  	outline: none;
    box-shadow: none;
  }
  
  .feature-33-card:focus-within {
    box-shadow: var(--shadow-card);
  }
  
  
  /* Set top value of the first child */
  .feature-33-card:first-child {
  	top: var(--acss-sticky-top);
  }
  
  .feature-33-card:nth-child(2) {
  	top: calc(var(--acss-sticky-top) + var(--space-l));
  }
  
  .feature-33-card:nth-child(3) {
  	top: calc(var(--acss-sticky-top) + var(--space-l) + 5rem);
  }
  
  .feature-33-card:nth-child(4) {
  	top: calc(var(--acss-sticky-top) + var(--space-l) + 10rem);
  }
  
  
  /* Make last child position relative */
  .feature-33-card:last-child {
    position: relative;
    top: calc(var(--acss-sticky-top) - var(--space-s))
  }
  
  /* Image & media */
  .feature-33-card__media {
  	overflow: hidden;
  }
  
  .feature-33-card__image {
  	transition: .5s ease;
  }
  
  .feature-33-card:hover .feature-33-card__image, .feature-33-card:focus-within .feature-33-card__image {
  	scale: 1.1;
  }
}
</style>
