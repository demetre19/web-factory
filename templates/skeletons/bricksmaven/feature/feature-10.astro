---
/**
 * bm-feature-10 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (feature-10.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-feature-10__container">
    <div class="intro">
      <h2 class="intro__heading">Long headline to turn your visitors into customers</h2>
      <p class="intro__subheading">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
      <p class="intro__accent-heading">Tagline</p>
    </div>
    <div class="bm-feature-10-grid list--none">
      {items.map((it) => (
        <div class="bm-feature-10-card">
          <div class="bm-feature-10-card__content">
            <h3 class="bm-feature-10-card__heading">{it.title}</h3>
            <p class="bm-feature-10__box-desc">{it.text}</p>
            <a class="bm-feature-10-card__cta btn--primary wf-cta-button" href={it.href}>{it.label}</a>
          </div>
          <div class="bm-feature-10-card__media">
            <figure class="bm-feature-10__thumb-img"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
@layer components {
  .bm-feature-10__container {
    display: flex;
    flex-direction: column;
    row-gap: var(--space-s);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--flow-spacing);
    align-self: center;
  }

  .bm-feature-10-grid {
    row-gap: calc( var(--space-s) * 1.4);
  }

  .bm-feature-10-card__content {
    padding: var(--section-space-xxl) var(--section-space-xxl) var(--section-space-xxl) calc(var(--section-space-xxl) * 1.6);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    row-gap: var(--flow-spacing);
    background: var(--bg-subtle);
  }

  .bm-feature-10-card__media {
    display: flex;
    align-items: center;
    width: 100%;
  }

  .bm-feature-10__thumb-img {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  /* bm-custom */
  .bm-feature-10-card {
  	display:grid;
    grid-template-columns: calc(100% * 1 / 12);
    align-items:center;
  }
  
  .bm-feature-10-card .bm-feature-10-card__content{
  	grid-column: 6 / -1;
    grid-row:1;
    aspect-ratio: 4/3;
  }
  
  .bm-feature-10-card .bm-feature-10-card__media{
  	grid-column: 1 / 7;
    grid-row: 1;
    
  }
  
  .bm-feature-10-card:nth-of-type(even) .bm-feature-10-card__content {
  	grid-column: 1 / 8;
    grid-row:1;
    padding-inline-start: var(--space-xl);
    padding-inline-end: calc(var(--section-space-xxl) * 1.6);
  }
  
  .bm-feature-10-card:nth-of-type(even) .bm-feature-10-card__media {
  	grid-column: 7 / -1;
    grid-row:1;
  }
  
  @media (max-width: 768px) {
      .bm-feature-10-card {
      grid-template-columns: calc(100% * 1 / 1);
    }
    
    .bm-feature-10-card .bm-feature-10-card__content{
  	grid-column: 1 / -1;
    grid-row-start:2;
    aspect-ratio: unset;
    padding-inline-start: var(--space-xl);
  }
  
    .bm-feature-10-card .bm-feature-10-card__media{
      grid-column: 1 / -1;
      grid-row-start:1;
      margin-block-end: 0;
    }
    
    .bm-feature-10-card:nth-of-type(even) .bm-feature-10-card__content {
  	grid-column: 1 / -1;
    grid-row-start:2;
    padding-inline-end: var(--space-xl);
  }
  
    .bm-feature-10-card:nth-of-type(even) .bm-feature-10-card__media {
      grid-column: 1 / -1;
      grid-row-start:1;
    }
    
  }
}
</style>
