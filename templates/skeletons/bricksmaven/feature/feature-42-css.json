  {
   "id": "vuuxsw",
   "name": "code",
   "parent": "cuwjip",
   "children": [],
   "settings": {
    "code": "<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n    const cards = document.querySelectorAll('.bm-feature-42-card');\n\n    function isMiddleInViewport(el) {\n        const rect = el.getBoundingClientRect();\n        const middle = rect.top + rect.height / 2;\n        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;\n        return (\n            middle >= 0 &&\n            middle <= viewportHeight\n        );\n    }\n\n    function animateCards() {\n        cards.forEach(card => {\n            const rect = card.getBoundingClientRect();\n            const middle = rect.top + rect.height / 2;\n            const viewportHeight = window.innerHeight || document.documentElement.clientHeight;\n            // Calculate if the middle of the card is near the middle of the viewport\n            const nearMiddle = Math.abs(viewportHeight / 3 - middle) < viewportHeight / 4; // Adjust this threshold as needed\n\n            if (nearMiddle) {\n                card.classList.add('onview');\n                const lineHeight = viewportHeight / 2 - rect.top;\n                card.style.setProperty('--line-height', `${lineHeight}%`);\n            } else {\n                card.classList.remove('onview');\n            }\n        });\n    }\n\n    window.addEventListener('scroll', animateCards);\n    animateCards(); // Initial check on load\n});\n</script>",
    "executeCode": true,
    "signature": "70883c007e0e1402089241e8408f4cef",
    "user_id": 7,
    "time": 1724105132
   },
   "label": "Script"
  }
