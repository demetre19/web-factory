   "custom_css": ".bm-feature-75-accordion-item.brx-open {\n  /* block-size:calc(100% - (50px * 2)); */\n  flex-grow:1;\n}  \n\n.bm-feature-75-accordion-item.brx-open .bm-feature-75-accordion-item__title {\n  background-color: var(--neutral-ultra-light);\n  color: var(--neutral) ;\n\n}\n\n.bm-feature-75-accordion-item:first-child .bm-feature-75-accordion-item__title {\n  border:none;\n}\n\n\n.bm-feature-75-accordion-item.brx-open .bm-feature-75-accordion-item__content {\n  animation: tabPaneFadeIn 1s ease both;\n  opacity:1;\n}\n\n.bm-feature-75-accordion-item.brx-open .bm-feature-75-accordion-item__heading {\n  color: var(--neutral) ;\n}\n\n/* .bm-feature-75-accordion-item.brx-open {\n  animation: tabPaneFadeIn 1s ease both;\n} */\n\n@keyframes tabPaneFadeIn {\n  from {\n    opacity: 0;\n    transform: translateY(1px);\n  }\n\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n",
