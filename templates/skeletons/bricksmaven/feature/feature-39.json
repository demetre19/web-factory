   "name": "feature-39-card",
   "settings": {
    "_display": "grid",
    "_gridTemplateColumns": "repeat(12, minmax(0, 1fr))",
    "_cssCustom": ".feature-39-card:nth-child(odd) {\n\tgrid-column:1/5;\n}\n\n.feature-39-card:nth-child(even) {\n\tgrid-column:9/-1;\n}\n\n.feature-39-card:nth-child(even) .feature-39-card__content {\n\tpadding-inline-end: var(--space-m);\n  padding-inline-start: var(--space-xl);\n  grid-column: 3/-1;\n}\n\n.feature-39-card:nth-child(even) .feature-39-card__icon-wrapper {\n\tgrid-column: 1/4;\n}\n\n@media (max-width:991px) {\n\t\n  .feature-39-card:nth-child(odd) {\n\tgrid-column:1/7;\n  }\n\n  .feature-39-card:nth-child(even) {\n    grid-column:7/-1;\n  }\n\n  \n}\n\n@media (max-width:767px) {\n\t\n  .feature-39-card:nth-child(odd) {\n\t\tgrid-column:span 12;\n  }\n  \n   .feature-39-card:nth-child(odd) .feature-39-card__content {\n    padding-inline-end: calc(var(--space-xxl) * 1.8);\n  \tgrid-column: 1/12;\n  }\n\n  .feature-39-card:nth-child(odd) .feature-39-card__icon-wrapper {\n    grid-column: 9/-1;\n  }\n\n  .feature-39-card:nth-child(even) {\n    grid-column:span 12;\n  }\n\t\n  .feature-39-card:nth-child(even) .feature-39-card__content {\n    padding-inline-end: calc(var(--space-xxl) * 1.8);\n  \tpadding-inline-start: var(--space-m);\n  \tgrid-column: 1/12;\n  }\n\n  .feature-39-card:nth-child(even) .feature-39-card__icon-wrapper {\n    grid-column: 9/-1;\n  }\n  \n}",
    "_alignItemsGrid": "center"
   }
  },
