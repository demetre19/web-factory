    "_cssCustom": ".feature-13-phases-list {\n/* Define & Initialize Counter */\n\tcounter-reset: hworks-counter;\n  \n}\n\n\n.feature-13-phases-list li::before {\n  /* Increment Counter */\n  counter-increment: hworks-counter;\n  /* Display Counter */\n  content: \"0\"counters(hworks-counter,\".\") \" \";\n  color:rgba(0, 0, 0, 0);\n  position: absolute;\n  right:2rem;\n  top:-1rem;\n  -webkit-text-stroke-width: 1px;\n  -webkit-text-stroke-color: var(--primary);\n  font-size: 6rem;\n  font-weight:700;\n}\n\n.feature-13-phases-list .feature-13-phases-item:nth-child(even) {\n\tmargin-block-start: -8rem;\n}\n\n@media (max-width:991px) {\n\t.feature-13-phases-list .feature-13-phases-item:nth-child(even) {\n\tmargin-block-start: 0rem;\n}\n}",
