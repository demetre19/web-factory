   "custom_css": ".bm-feature-51-feature-card {\n  --content-height: var(--width-xs);\n  --content-block-margin: calc( (var(--width-xs) / 2.5) * -1);\n}\n/* Reset Focus */\n.bm-feature-51-feature-card:focus-within :focus{\n  outline: none;\n  border: none;\n}\n\n/* Set focus on card */\n.bm-feature-51-feature-card:hover, .bm-feature-51-feature-card:focus-within {\n  box-shadow: var(--box-shadow-xl);\n}\n\n/* Custom Focus on Link */\n.bm-feature-51-feature-card__heading a:focus-visible {\n  outline: 3px solid var(--primary-trans-50) !important;\n  outline-offset: 3px;\n  border-radius: 4px;\n}\n\n@media (min-width:767px) {\n\n/* Card */\n.bm-feature-51-feature-card {\n  transition: all 0.2s ease-in;\n  overflow: hidden;\n} \n\n/* Expand card on hover */\n.bm-feature-51-feature-card:hover, .bm-feature-51-feature-card:focus-within  {\n  width: 75%;\n} \n\n\n/* Background image */\n.bm-feature-51-feature-card__background-image {\n  transition: 2s ease;\n  transform: scale(1);\n}\n\n.bm-feature-51-feature-card:hover .bm-feature-51-feature-card__background-image, .bm-feature-51-feature-card:focus-within .bm-feature-51-feature-card__background-image {\n  transform: scale(1.2);\n}\n\n/* Content */\n.bm-feature-51-feature-card__content {\n  height: var(--content-height);\n  margin-block-end: var(--content-block-margin);\n  transition: all 0.2s ease;\n}\n\n.bm-feature-51-feature-card:hover .bm-feature-51-feature-card__content, .bm-feature-51-feature-card:focus-within .bm-feature-51-feature-card__content {\n margin-block-end: 0rem;\n}\n \n  \n  /* Text */\n.bm-feature-51-feature-card__text {\n  transition: 0.5s ease;\n  opacity: 0;\n}\n\n.bm-feature-51-feature-card:hover .bm-feature-51-feature-card__text, .bm-feature-51-feature-card:focus-within .bm-feature-51-feature-card__text {\n  display: block;\n  opacity: 0.5;\n}\n\n}\n\n@media (max-width:767px) {\n.bm-feature-51-feature-card .bm-feature-51-feature-card__text {\n  opacity: 0.5;\n}\n\n}",
