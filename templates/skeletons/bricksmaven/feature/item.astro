---
/**
 * bm-item — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (item.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="feature-29-conatiner">
    <div class="intro">
      <h2 class="intro__heading">{heading}</h2>
      <p class="intro__subheading">{fs}</p>
      <p class="intro__accent-heading">Tagline</p>
    </div>
    <div class="bm-gamma-feature-list-ul list--none">
      {items.map((it) => (
        <div class="bm-gamma-feature-list-card">
          <h2 class="bm-gamma-feature-list-card__heading">{it.title}</h2>
          <p class="bm-gamma-feature-list-card__text">{it.text}</p>
          <span class="bm-gamma-feature-list-card__icon" data-icon="lucide" aria-hidden="true"></span>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .feature-29-conatiner {
    display: flex;
    flex-direction: column;
    row-gap: var(--section-space-xxl);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .bm-gamma-feature-list-ul {
    background: var(--bg-subtle);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-l);
  }

  .bm-gamma-feature-list-card {
    display: flex;
    flex-direction: column;
    row-gap: var(--space-s);
    align-items: center;
    padding: var(--space-l) var(--space-l) var(--space-l) var(--space-l);
    text-align: center;
  }

  /* bm-custom */
  .bm-gamma-feature-list-card:nth-child(2) {
  	background-color: var(--action-primary);
    transform: translateY(-4rem);
  }
  
  .bm-gamma-feature-list-card:nth-child(odd) {
    color: var(--bg-canvas);
  }
  
  @media (max-width:767px) {
  	.bm-gamma-feature-list-card:nth-child(2) {
    transform: translateY(0rem);
  }
  }
</style>
