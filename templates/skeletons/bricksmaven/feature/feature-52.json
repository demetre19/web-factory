    "_cssCustom": "@media (min-width:767px) {\n  .bm-feature-52-card {\n    position: sticky;\n  \t--sticky-top: var(--section-space-l);\n  }\n  \n    /* Set top value of the first child */\n  .bm-feature-52-card:first-child {\n    top: 0;\n  }\n\n  .bm-feature-52-card:nth-child(2) {\n    top: calc(var(--sticky-top) * 1.2);\n  }\n\n  .bm-feature-52-card:nth-child(3) {\n    top: calc(var(--sticky-top) * 2.4);\n  }\n\n}\n\n.bm-feature-52-card:nth-child(1) {\n  background-color: var(--neutral-semi-dark);\n}\n\n.bm-feature-52-card:nth-child(2) {\n  background-color: var(--neutral-dark);\n}\n\n.bm-feature-52-card:nth-child(3) {\n  background-color: var(--neutral-ultra-dark);\n}",
