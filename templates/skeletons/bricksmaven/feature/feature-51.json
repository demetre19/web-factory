    "_cssCustom": ".bm-feature-51-feature-grid:hover .feature-51-feature-card:not(:hover), .bm-feature-51-feature-grid:focus-within .feature-51-feature-card:not(:focus-within) {\n\topacity: 0.8;\n  filter: grayscale(1);\n  \n}"
