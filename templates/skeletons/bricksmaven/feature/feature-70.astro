---
/**
 * bm-feature-70 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (feature-70.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-feature-70__container">
      <div class="intro intro--left">
        {heading && <h2 class="text-fluid-2">{heading}</h2>}
        {fs && <p class="text-fluid-0">{fs}</p>}
      </div>
      <div class="bm-feature-70-grid">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="bm-feature-70-card card">
              <div class="bm-feature-70-card__counter"></div>
              <div class="bm-feature-70-card__dot-wrapper">
                <div class="bm-feature-70-card__dot-cover">
                  <div class="bm-feature-70-card__dot"></div>
                </div>
              </div>
              <div class="bm-feature-70-card__content">
                <h2 class="text-fluid-2">{it.title}</h2>
                <p class="text-fluid-0">{it.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
