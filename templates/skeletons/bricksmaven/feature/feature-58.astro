---
/**
 * bm-feature-58 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (feature-58.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-feature-58__container">
      <div class="intro intro--split">
        <div class="intro__left-column">
          {heading && <h2 class="text-fluid-2">{heading}</h2>}
        </div>
        <div class="intro__right-column">
          {fs && <p class="text-fluid-0">{fs}</p>}
        </div>
      </div>
      <div class="bm-feature-58-feature-list">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="bm-feature-58-feature-card card">
              <div class="bm-feature-58-feature-card__content">
                <div class="bm-feature-58-feature-card__inner">
                  <h2 class="text-fluid-2">{it.title}</h2>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
                <div class="bm-feature-58-feature-card__icon-wrapper">
                  <span data-icon="lucide" aria-hidden="true"></span>
                </div>
              </div>
              <div></div>
              <figure class="bm-feature-58-feature-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="Feature Image" loading="lazy" width="900" height="600" /></figure>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
