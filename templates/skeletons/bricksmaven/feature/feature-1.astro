---
/**
 * bm-feature-1 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (feature-1.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div>
      <div class="intro">
        {heading && <h2 class="text-fluid-2">{heading}</h2>}
        {fs && <p class="text-fluid-0">{fs}</p>}
      </div>
    </div>
    <div class="feature-1-ul">
      <div class="grid-auto gap-fluid-m">
        {(items || []).map((it) => (
          <div class="feature-1-li card">
            <div class="feature-1-li__content">
              <h2 class="text-fluid-2">{it.title}</h2>
              <p class="text-fluid-0">{it.text}</p>
              <div class="bm-list">
                <div class="grid-auto gap-fluid-m">
                  {((it.items || []) || []).map((it2) => (
                    <div class="bm-list__item card">
                      <span class="bm-list__item-icon" data-icon="lucide" aria-hidden="true"></span>
                      <p class="text-fluid-0">{it2.text}</p>
                    </div>
                  ))}
                </div>
              </div>
              <span class="feature-1__content-icon" data-icon="lucide" aria-hidden="true"></span>
            </div>
            <div class="feature-1-li__media-container">
              <figure class="feature-1-li__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
