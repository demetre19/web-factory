   "custom_css": "/* Counter Card */\n\n.bm-feature-73-grid-ul {\n  counter-reset: card;\n}\n\n.bm-feature-73-grid-ul .bm-feature-73-card {\n  counter-increment: card;\n}\n\n.bm-feature-73-grid-ul .bm-feature-73-card::before {\n  content: '0' counter(card);\n  position: absolute;\n  inset-inline-end:var(--space-m);\n  inset-block-start: calc(var(--space-s) + var(--space-xs));\n  font-size:calc(var(--text-xxl) * 1.6);\n  font-weight: 700;\n  color:var(--text-light);\n  opacity: 0.2;\n}\n\n\n/* Counter Badge */\n\n.bm-feature-73-grid-ul {\n  counter-reset: badge;\n}\n\n.bm-feature-73-grid-ul .bm-feature-73-card__badge {\n  counter-increment: badge;\n}\n\n.bm-feature-73-grid-ul .bm-feature-73-card__badge::before {\n  content: '0' counter(badge);\n}",
