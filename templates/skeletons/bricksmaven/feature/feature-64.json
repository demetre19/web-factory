  {
   "id": "iiqcza",
   "name": "bm-feature-64-list",
   "settings": {
    "_cssCustom": "/* Create the counter on Parent */\n.bm-feature-64-list {\n  counter-reset: cards ; /* starts at 0 */\n}\n\n/* Every card we meet \u2192 add +1 to the counter */\n\n.bm-feature-64-list .bm-feature-64-card {\n  counter-increment: cards ;\n}\n\n/* Show the number BEFORE each card */\n.bm-feature-64-list .bm-feature-64-card::before {\n  content: \"0\"counter(cards);\n  position: absolute;\n  inset-block-start: var(--space-m);\n  font-size: var(--text-m);\n  color: var(--neutral-light);\n}\n\n/* CARD */\n.bm-feature-64-list  .bm-feature-64-card {\n  transition: 0.5s ease;\n}\n\n.bm-feature-64-list .bm-feature-64-card:hover, .bm-feature-64-list .bm-feature-64-card:focus-within {\n  background-color: var(--neutral);\n  color: var(--white);\n}\n\n.bm-feature-64-list .bm-feature-64-card:hover::before, .bm-feature-64-list .bm-feature-64-card:focus-within::before {\n  color: var(--white);\n}\n\n/* Make whole CARD clickable */\n.bm-feature-64-list  .bm-feature-64-card .bm-feature-64-card__heading > a {\n  transition: 0.1s ease;\n}\n\n.bm-feature-64-list  .bm-feature-64-card .bm-feature-64-card__heading:not(a) > a::after {\n  content: '';\n  position: absolute;\n  display: flex;\n  inset: 0;\n  cursor: pointer;\n}",
    "_display": "grid",
    "_gridTemplateColumns": "var(--grid-2)",
    "_gridGap": "var(--grid-gap)",
    "_gridTemplateColumns:mobile_portrait": "var(--grid-1)"
   },
