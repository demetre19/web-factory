    "_aspectRatio": "16/9",
    "_cssCustom": ".bm-feature-60-card {\n  --card-height: 42rem;\n  --slider-height: 42rem;\n  block-size: var(--card-height);\n}\n\n\n\n.bm-feature-60-card:nth-child(even) {\n  grid-template-columns: var(--grid-2-1);\n}\n\n\n.bm-feature-60-card:nth-child(even) .bm-feature-60-card__carousel {\n  order: -1;\n}\n\n@media (max-width:991px) {\n  .bm-feature-60-card {\n  --card-height: auto;\n}\n  \n  .bm-feature-60-card:nth-child(odd) .bm-feature-60-card__carousel {\n  order: -1;\n}\n  \n  .bm-feature-60-card:nth-child(even) {\n  grid-template-columns: var(--grid-1);\n}\n}",
