    "_order:nth-child(odd) .feature-10-thumb": "-1",
    "_cssCustom": ".bm-feature-10-card {\n\tdisplay:grid;\n  grid-template-columns: var(--grid-12);\n  align-items:center;\n}\n\n.bm-feature-10-card .bm-feature-10-card__content{\n\tgrid-column: 6 / -1;\n  grid-row:1;\n  aspect-ratio: 4/3;\n}\n\n.bm-feature-10-card .bm-feature-10-card__media{\n\tgrid-column: 1 / 7;\n  grid-row: 1;\n  \n}\n\n.bm-feature-10-card:nth-of-type(even) .bm-feature-10-card__content {\n\tgrid-column: 1 / 8;\n  grid-row:1;\n  padding-inline-start: var(--space-xl);\n  padding-inline-end: calc(var(--space-xxl) * 1.6);\n}\n\n.bm-feature-10-card:nth-of-type(even) .bm-feature-10-card__media {\n\tgrid-column: 7 / -1;\n  grid-row:1;\n}\n\n@media (max-width: 768px) {\n    .bm-feature-10-card {\n    grid-template-columns: var(--grid-1);\n  }\n  \n  .bm-feature-10-card .bm-feature-10-card__content{\n\tgrid-column: 1 / -1;\n  grid-row-start:2;\n  aspect-ratio: unset;\n  padding-inline-start: var(--space-xl);\n}\n\n  .bm-feature-10-card .bm-feature-10-card__media{\n    grid-column: 1 / -1;\n    grid-row-start:1;\n    margin-block-end: 0;\n  }\n  \n  .bm-feature-10-card:nth-of-type(even) .bm-feature-10-card__content {\n\tgrid-column: 1 / -1;\n  grid-row-start:2;\n  padding-inline-end: var(--space-xl);\n}\n\n  .bm-feature-10-card:nth-of-type(even) .bm-feature-10-card__media {\n    grid-column: 1 / -1;\n    grid-row-start:1;\n  }\n  \n}\n\n"
