  {
   "id": "yagdmx",
   "name": "bm-feature-slider",
   "settings": {
    "_cssCustom": ".bm-feature-slider {\n  --icon-dimension: 32px; /* Change the icon dimensions*/\n  --icon-size: 16px; /* Change the icon size*/\n  --icon-opacity: 0.5;  /* Change the icon opacity*/\n}\n\n.bm-feature-slider .splide__track {\n  overflow: visible;\n}\n\n.bm-feature-slider .splide__arrow--next {\n  left: 0;\n  transition: 0.2s ease;\n}\n\n.bm-feature-slider .splide__arrow--prev {\n  left: calc(-1 * (var(--at-space--xs) + var(--icon-dimension)));\n  transition: 0.2s ease;\n}\n\n.bm-feature-slider .splide__arrows {\n    position: absolute;\n    inset-block-start: 42px; \n  \tinset-inline-end: calc(var(--icon-dimension) + var(--at-space--s));\n   \t\n}\n\n.bm-feature-slider .is-prev, .bm-feature-slider .is-next {\n  scale: 0.9;\n}",
