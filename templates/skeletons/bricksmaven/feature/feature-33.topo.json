   "colour": {},
   "radius": {},
   "custom_css": "/* Set position sticky on cards */\n.feature-33-card {\n\tposition: sticky;\n  --sticky-top: var(--space-l);\n  transition: .5s ease;\n  background-color: var(--shade-ultra-light);\n  border-top: 1px solid var(--primary-light);\n  box-shadow: 0rem -1rem 1rem 0 var(--black-trans-10);\n}\n\n.feature-33-card:hover, .feature-33-card:focus-within {\n\tbackground-color: var(--white);\n  box-shadow: var(--box-shadow-m);\n}\n\n.feature-33-card:focus-within :focus {\n\toutline: none;\n  box-shadow: none;\n}\n\n.feature-33-card:focus-within {\n  box-shadow: var(--box-shadow-l);\n}\n\n\n/* Set top value of the first child */\n.feature-33-card:first-child {\n\ttop: var(--sticky-top);\n}\n\n.feature-33-card:nth-child(2) {\n\ttop: calc(var(--sticky-top) + var(--space-l));\n}\n\n.feature-33-card:nth-child(3) {\n\ttop: calc(var(--sticky-top) + var(--space-l) + 5rem);\n}\n\n.feature-33-card:nth-child(4) {\n\ttop: calc(var(--sticky-top) + var(--space-l) + 10rem);\n}\n\n\n/* Make last child position relative */\n.feature-33-card:last-child {\n  position: relative;\n  top: calc(var(--sticky-top) - var(--space-s))\n}\n\n/* Image & media */\n.feature-33-card__media {\n\toverflow: hidden;\n}\n\n.feature-33-card__image {\n\ttransition: .5s ease;\n}\n\n.feature-33-card:hover .feature-33-card__image, .feature-33-card:focus-within .feature-33-card__image {\n\tscale: 1.1;\n}",
