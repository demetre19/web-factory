   "custom_css": "/* CARD */\n\n.bm-feature-61-feature-card {\n  --card-radius: var(--radius-xl); /* change border radius */\n  --margin-bottom: 10vh; /* change margin-block-size of card */\n  --transition-duration: 0.5s;\n  --timing-function: ease;\n  --psuedo-size: 100%;\n  position: sticky;\n  block-size: 100%;\n  bottom: var(--section-space-s);\n  transition: 0.5s ease;\n  border-radius: var(--card-radius);\n  overflow: clip;\n}\n\n.bm-feature-61-feature-card::before {\n  content: '';\n  position: absolute;\n  inline-size: var(--psuedo-size);\n  block-size: var(--psuedo-size);\n  background: linear-gradient(transparent, var(--base));\n  z-index: 1;\n  inset: 0;\n}\n\n\n.bm-feature-61-feature-card:nth-of-type(1) {\n  z-index: 6;\n  margin-block-end: var(--margin-bottom);\n}\n\n.bm-feature-61-feature-card:nth-of-type(2) {\n  z-index: 5;\n  margin-block-end: var(--margin-bottom);\n}\n\n.bm-feature-61-feature-card:nth-of-type(3) {\n  z-index: 4;\n  margin-block-end: var(--margin-bottom);\n}\n\n.bm-feature-61-feature-card:nth-of-type(4) {\n  z-index: 3;\n  margin-block-end: 0;\n}\n\n/* CONTENT */\n.bm-feature-61-feature-card .bm-feature-61-feature-card__feature-content {\n  color: var(--text-light);\n  transition: var(--transition-duration) var(--timing-function);\n  padding: var(--space-m);\n}\n\n.bm-feature-61-feature-card:hover .bm-feature-61-feature-card__feature-content, .bm-feature-61-feature-card:focus-within .bm-feature-61-feature-card__feature-content {\n  color: var(--text-dark);\n}\n\n.bm-feature-61-feature-card .bm-feature-61-feature-card__feature-content::before {\n  content: '';\n  position: absolute;\n  inline-size: var(--psuedo-size);\n  block-size: var(--psuedo-size);\n  z-index: -1;\n  inset: 0;\n  border-radius: var(--card-radius);\n  transition: var(--transition-duration) var(--timing-function);\n}\n\n.bm-feature-61-feature-card:hover .bm-feature-61-feature-card__feature-content::before, .bm-feature-61-feature-card:focus-within .bm-feature-61-feature-card__feature-content::before {\n  background-color: var(--white);\n}\n\n/* HEADING */\n.bm-feature-61-feature-card .bm-feature-61-feature-card__feature-heading {\n  transform: translateY(500%);\n  transition: var(--transition-duration) var(--timing-function);\n}\n\n.bm-feature-61-feature-card:hover .bm-feature-61-feature-card__feature-heading, .bm-feature-61-feature-card:focus-within .bm-feature-61-feature-card__feature-heading {\n  transform: translateY(0%);\n}\n\n/* TEXT & LINK */\n .bm-feature-61-feature-card .bm-feature-61-feature-card__feature-text, .bm-feature-61-feature-card .bm-feature-61-feature-card__feature-link {\n  opacity: 0;\n  transform: translateY(100%);\n  transition: var(--transition-duration) var(--timing-function);\n}\n\n .bm-feature-61-feature-card:hover .bm-feature-61-feature-card__feature-text, .bm-feature-61-feature-card:focus-within .bm-feature-61-feature-card__feature-text, .bm-feature-61-feature-card:hover .bm-feature-61-feature-card__feature-link, .bm-feature-61-feature-card:focus-within .bm-feature-61-feature-card__feature-link {\n  opacity: 1;\n  transform: translateY(0%);\n}\n\n\n\n\n\n",
