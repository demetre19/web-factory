  {
   "id": "ziizlb",
   "name": "feature-35-card",
   "settings": {
    "_display": "grid",
    "_gridGap": "var(--grid-gap)",
    "_gridTemplateColumns": "var(--grid-12)",
    "_alignItemsGrid": "center",
    "_cssCustom": "/* Card Locally scoped variable */ \n.feature-35-card {\n\t--image-desktop-height: 64rem;\n  --image-mobile-height: 32rem;\n  --image-desktop-width: calc(50vw + (2 * (var(--content-width) / 12)));\n  --image-mobile-width: 100%;\n  --image-left-margin: calc(((50vw + (2 * (var(--content-width) / 12))) * -1) + 100%);\n}\n\n/* Image height */ \n.feature-35-card .feature-35-card__image {\n\theight: var(--image-desktop-height);\n}\n\n/* Odd cards */ \n.feature-35-card:nth-child(odd) .feature-35-card__content {\n\tgrid-column: span 4;\n}\n\n.feature-35-card:nth-child(odd) .feature-35-card__media {\n\tgrid-column: span 8;\n}\n\n.feature-35-card:nth-child(odd) .feature-35-card__image {\n\twidth: var(--image-desktop-width);\n  max-width: var(--image-desktop-width);\n  margin-left: var(--image-left-margin);\n}\n\n/* Even cards */ \n.feature-35-card:nth-child(even) .feature-35-card__content {\n\torder: -1;\n  grid-column: span 4;\n}\n\n.feature-35-card:nth-child(even) .feature-35-card__media {\n\tgrid-column: span 8;\n}\n\n.feature-35-card:nth-child(even) .feature-35-card__image {\n  width: var(--image-desktop-width);\n  max-width: var(--image-desktop-width);\n}\n\n@media (max-width:767px) {\n\n  /* Mobile Image Height */ \n  .feature-35-card .feature-35-card__image {\n\theight: var(--image-mobile-height);\n}\n  \n/* Odd cards */   \n  .feature-35-card:nth-child(odd) .feature-35-card__content {\n    grid-column: span 1;\n  }\n\n  .feature-35-card:nth-child(odd) .feature-35-card__media {\n    grid-column: span 1;\n  }\n  \n  .feature-35-card:nth-child(odd) .feature-35-card__image {\n    width: var(--image-mobile-width) ;\n    max-width: var(--image-mobile-width) ;\n    margin-left: unset;\n  }\n  \n/* Even cards */ \n  \n  .feature-35-card:nth-child(even) {\n\tgrid-column: span 1;\n}\n  \n  .feature-35-card:nth-child(even) .feature-35-card__media {\n\tgrid-column: span 1;\n  order: -1;\n}\n  \n.feature-35-card:nth-child(even) .feature-35-card__image {\n  width: var(--image-mobile-width) ;\n  max-width: var(--image-mobile-width) ;\n  margin-right: unset;\n  margin-left: 0;\n}\n  \n  \n  .feature-35-card:nth-child(even) .feature-35-card__content {\n      grid-column: span 1;\n    \torder: 1;\n  }\n\n\n}",
    "_gridTemplateColumns:mobile_landscape": "var(--grid-1)"
   }
  },
