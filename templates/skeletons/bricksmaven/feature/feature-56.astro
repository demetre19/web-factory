---
/**
 * bm-feature-56 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (feature-56.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-feature-56__container">
      <div class="intro intro--split">
        <div class="intro__left-column">
          {heading && <h2 class="text-fluid-2">{heading}</h2>}
        </div>
        <div class="intro__right-column">
          {fs && <p class="text-fluid-0">{fs}</p>}
        </div>
      </div>
      <div class="bm-feature-56-feature-list">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="bm-feature-56-feature-card card">
              <figure class="bm-feature-56-feature-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              <div class="bm-feature-56-feature-card__content">
                <h2 class="text-fluid-2">{it.title}</h2>
                <p class="text-fluid-0">{it.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="bm-feature-56__footer">
        <div></div>
        <div class="bm-feature-56__sub-feature-list">
          <div class="bm-list">
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="bm-list-item card">
                  <div class="bm-list-item__icon-wrapper">
                    <span data-icon="lucide" aria-hidden="true"></span>
                  </div>
                  <div>
                    <h4 class="text-fluid-2">{it.title}</h4>
                    <p class="bm-list-item__text text-fluid-0">{it.text}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <p class="mt-fluid-m"><a class="wf-cta-button" href={cta.href}>{cta.label || 'Continue'}</a></p>
        </div>
      </div>
    </div>
  </div>
</div>
