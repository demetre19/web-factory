        <div>
          <h2 class="text-fluid-2">Highlight other features you do not want to be prominent:</h2>
        </div>
        <div>
          <div>
            {(items || []).map((it) => (
              <div>
                <div>
                  <span data-icon="lucide" aria-hidden="true"></span>
                </div>
                <div>
                  <h4 class="text-fluid-2">{it.title}</h4>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
              </div>
            ))}
