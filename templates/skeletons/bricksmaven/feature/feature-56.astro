 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-feature-56__container">
    <div class="intro intro--split">
      <div class="intro__left-column">
        <h2 class="intro__heading">Long headline to turn your visitors into users</h2>
        <p class="bm-accent-heading">Tagline</p>
      </div>
      <div class="intro__right-column">
        <p class="intro__subheading">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
        <a class="btn--primary" href="#">Call to action</a>
      </div>
    </div>
    <div class="list--none bm-feature-56-feature-list">
      {items.map((it) => (
        <div class="bm-feature-56-feature-card">
          <figure class="bm-feature-56-feature-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          <div class="bm-feature-56-feature-card__content">
            <h2 class="bm-feature-56-feature-card__heading">{it.title}</h2>
            <p class="bm-feature-56-feature-card__text">{it.text}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="bm-feature-56__footer">
      <div class="bm-feature-56__heading-wrapper">
        <h2 class="bm-feature-56__footer-heading">Highlight other features you do not want to be prominent:</h2>
      </div>
      <div class="bm-feature-56__sub-feature-list">
        <div class="bm-list list--none">
          {items.map((it) => (
            <div class="bm-list-item">
              <div class="bm-list-item__icon-wrapper">
                <span class="bm-list-item__icon" data-icon="lucide" aria-hidden="true"></span>
              </div>
              <div class="bm-list-item__column">
                <h4 class="bm-list-item__heading">{it.title}</h4>
                <p class="bm-list-item__text">{it.text}</p>
              </div>
            </div>
          ))}
        </div>
        <a class="btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
      </div>
    </div>
  </div>
</div>

<style is:global>
