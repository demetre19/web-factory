    }
   }
  },
  {
   "id": "zqvkzb",
   "name": "feature-14-list-ul",
   "settings": {
    "_display": "grid",
    "_gridTemplateColumns": "repeat(24, minmax(0, 1fr))",
    "_gridGap": "var(--grid-gap)",
    "_gridTemplateColumns:mobile_portrait": "repeat(1, minmax(0, 1fr))",
    "_gridGap:mobile_landscape": "var(--grid-gap)",
    "_gridTemplateColumns:tablet_portrait": "var(--grid-2)"
   }
  },
  {
   "id": "acss_import_list--none",
   "name": "list--none",
   "settings": []
  },
  {
   "id": "qfexuc",
   "name": "feature-14-list-item",
   "settings": {
    "_display": "flex",
    "_direction": "row",
    "_alignItems": "center",
    "_columnGap": "var(--content-gap)",
    "_position": "relative",
    "_zIndex": "1",
    "_cssCustom": ".feature-14-list-item:nth-child(even) {\n\ttext-align: left;\n  justify-content: start;\n}\n\n.feature-14-list-item:nth-child(even) .feature-14-list-item__media  {\n\torder:-1;\n}\n\n.feature-14-list-item:nth-child(1) {\n\tgrid-column: 2 / 10;\n  grid-row: 1;\n}\n\n.feature-14-list-item:nth-child(2) {\n\tgrid-column: 16 / 24;\n  grid-row: 1;\n}\n\n.feature-14-list-item:nth-child(3) {\n\tgrid-column: 1 / 9;\n  grid-row: 2;\n}\n\n.feature-14-list-item:nth-child(4) {\n\tgrid-column: 17 / -1;\n  grid-row: 2;\n}\n\n.feature-14-list-item:nth-child(5) {\n\tgrid-column: 2 / 10;\n  grid-row: 3;\n}\n\n.feature-14-list-item:nth-child(6) {\n\tgrid-column: 16 / 24;\n  grid-row: 3;\n}\n\n@media (max-width:991px) {\n\n\t.feature-14-list-item:nth-child(1), .feature-14-list-item:nth-child(2), .feature-14-list-item:nth-child(3), .feature-14-list-item:nth-child(4), .feature-14-list-item:nth-child(5), .feature-14-list-item:nth-child(6) {\n\tgrid-column: auto / auto;\n  grid-row: auto / auto;\n  background-color: var(--white);\n  padding: var(--space-s);\n}\n  \n  .feature-14-list-item:nth-child(odd) .feature-14-list-item__media  {\n\torder:-1;\n}\n  .feature-14-list-item:nth-child(odd) {\n\ttext-align: left;\n  justify-content: start;\n}\n\n}",
    "_typography": {
     "text-align": "right"
    },
    "_justifyContent": "flex-end",
    "_flexWrap:mobile_landscape": "nowrap"
   }
  },
