  {
   "id": "bizivf",
   "name": "bm-feature-58-feature-list",
   "settings": {
    "_display": "grid",
    "_gridGap": "var(--grid-gap)",
    "_gridTemplateColumns": "var(--grid-7)",
    "_cssCustom": "\n\n@media (min-width:991px) {\n  \n  /* Card */\n  \n  .bm-feature-58-feature-list .bm-feature-58-feature-card .bm-feature-58-feature-card__image {\n  transition: 0.5s ease;\n}\n  \n  .bm-feature-58-feature-list .bm-feature-58-feature-card:hover .bm-feature-58-feature-card__image,.bm-feature-58-feature-list .bm-feature-58-feature-card:focus-within .bm-feature-58-feature-card__image {\n  scale: 1.2;\n}\n\n  /* Overlay */\n\n.bm-feature-58-feature-list .bm-feature-58-feature-card .bm-feature-58-feature-card__overlay {\n  transition: 0.5s ease;\n}\n\n.bm-feature-58-feature-list:has(.bm-feature-58-feature-card:hover) .bm-feature-58-feature-card:not(:hover) .bm-feature-58-feature-card__overlay, .bm-feature-58-feature-list:has(.bm-feature-58-feature-card:focus-within) .bm-feature-58-feature-card:not(:focus-within) .bm-feature-58-feature-card__overlay {\n  background-color: var(--base-trans-90); /* dark overlay only on non-hovered cards */\n}\n  \n  .bm-feature-58-feature-list .bm-feature-58-feature-card:hover .bm-feature-58-feature-card__overlay, .bm-feature-58-feature-list .bm-feature-58-feature-card:focus-within .bm-feature-58-feature-card__overlay {\n  background-color: var(--base-trans-70); /* make hovered card lighter so it stands out */\n}\n  \n  /* Icon */\n  \n  .bm-feature-58-feature-list .bm-feature-58-feature-card .bm-feature-58-feature-card__icon-wrapper {\n  transition: 0.2s ease;\n}\n  \n  .bm-feature-58-feature-list:has(.bm-feature-58-feature-card:hover) .bm-feature-58-feature-card:not(:hover) .bm-feature-58-feature-card__icon-wrapper, .bm-feature-58-feature-list:has(.bm-feature-58-feature-card:focus-within) .bm-feature-58-feature-card:not(:focus-within) .bm-feature-58-feature-card__icon-wrapper {\n  transform: translateY(-200%); /* Move icon out of the card */\n}\n  \n  /* Heading & Text */\n  \n    .bm-feature-58-feature-list .bm-feature-58-feature-card .bm-feature-58-feature-card__text, .bm-feature-58-feature-list .bm-feature-58-feature-card .bm-feature-58-feature-card__heading {\n  transition: 0.2s ease;\n}\n  \n  .bm-feature-58-feature-list:has(.bm-feature-58-feature-card:hover) .bm-feature-58-feature-card:not(:hover) .bm-feature-58-feature-card__text, .bm-feature-58-feature-list:has(.bm-feature-58-feature-card:focus-within) .bm-feature-58-feature-card:not(:focus-within) .bm-feature-58-feature-card__text, .bm-feature-58-feature-list:has(.bm-feature-58-feature-card:hover) .bm-feature-58-feature-card:not(:hover) .bm-feature-58-feature-card__heading, .bm-feature-58-feature-list:has(.bm-feature-58-feature-card:focus-within) .bm-feature-58-feature-card:not(:focus-within) .bm-feature-58-feature-card__heading {\n  transform: translateY(145%); /* Move text and heading down */\n}\n  \n  \n}",
