---
/**
 * bm-feature-55 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (feature-55.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-feature-55__container">
    <div class="intro">
      <h2 class="intro__heading">{heading}</h2>
      <p class="intro__subheading">{fs}</p>
      <p class="bm-accent-heading">Accent heading</p>
    </div>
    <div class="bm-feature-55__fixed-scroll">
      <div class="bm-feature-55-featured-list list--none">
        {items.map((it) => (
          <div class="bm-feature-55-card">
            <div class="bm-feature-55-card__inner">
              <h2 class="bm-feature-55-card__heading">{it.title}</h2>
              <span class="bm-feature-55-card__icon" data-icon="lucide" aria-hidden="true"></span>
              <p class="bm-feature-55-card__text">{it.text}</p>
              <a class="btn--primary wf-cta-button" href={it.href}>{it.label}</a>
            </div>
          </div>
        ))}
      </div>
      <div class="bm-feature-55__media">
        <figure class="bm-feature-55__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-feature-55__container {
    row-gap: var(--space-s);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--flow-spacing);
    align-self: center;
    width: 100%;
  }

  .bm-feature-55__fixed-scroll {
    display: grid;
    grid-template-columns: calc(100% * 1 / 2);
    gap: var(--space-m);
  }

  .bm-feature-55-featured-list {
    row-gap: calc(var(--flow-spacing) * 4);
    position: relative;
  }

  .bm-feature-55-card {
    height: 100vh;
  }

  .bm-feature-55-card__inner {
    row-gap: var(--flow-spacing);
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    background: var(--bg-subtle);
  }

  .bm-feature-55__media {
    height: 100vh;
    position: sticky;
    top: 0;
  }

  .bm-feature-55__image {
    object-fit: cover;
    height: 100%;
    width: calc(50vw - (var(--space-m) / 1.3)) ;
  }
</style>
