   "custom_css": ".bm-feature-62-feature-list {\n  --before-inline-size: calc(((50vw + (var(--content-width) / 2) + var(--space-xl)))); /* Change width of the psuedo before element*/\n  --inset-left: calc(-1 * ((100vw - var(--content-width)) / 2)) ; /* Negative left space */\n  --inset-top: var(--space-m);  /* Top margin */\n  --border-radius: var(--radius-xl); /* Set the border radius */\n  --before-background-color: var(--base); /* set the background color of the psuedo element */\n}\n\n.bm-feature-62-feature-list::before {\n  content: '';\n  position: absolute;\n  inset-inline-start: var(--inset-left);\n  inset-block-start: var(--inset-top);\n  inline-size: var(--before-inline-size);\n  block-size: 100%;\n  background-color: var(--before-background-color);\n  border-start-end-radius: var(--border-radius);\n  border-end-end-radius: var(--border-radius);\n  z-index: -1;\n}\n\n@media (max-width:1400px) {\n  .bm-feature-62-feature-list {\n  --before-inline-size: calc(100% + var(--space-xl));\n  --inset-left: calc(-1 * var(--gutter));\n  --inset-top: var(--space-m);\n}\n  \n  .bm-feature-62-feature-list::before {\n  inset-inline-start: var(--inset-left);\n  inset-block-start: var(--inset-top);\n  inline-size: var(--before-inline-size);\n}\n}\n\n\n",
