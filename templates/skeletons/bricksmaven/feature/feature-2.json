   "name": "feature-2-li",
   "settings": {
    "_cssCustom": ".feature-2-li {\n\t\tdisplay:grid;\n  \tgrid-template-columns:repeat(12, minmax(0, 1fr));\n  \talign-items:center;\n  \tmargin-bottom:var(--space-xl);\n}\n\n.feature-2-li:last-of-type {\n  \tmargin-bottom:0;\n}\n\n.feature-2-li:nth-of-type(even) .feature-2-li__media-container{\n\t\tgrid-column: 1 / 10;\n  \tgrid-row-start: 1;\n  display:flex;\n  flex-direction: column;\n  align-items: end;\n}\n\n.feature-2-li:nth-of-type(even) .feature-2-li__content{\n\t\tgrid-column: 8 / -1;\n  \tgrid-row-start: 1;\n}\n\n.feature-2-li .feature-2-li__content{\n\tgrid-column: 1 / 6;\n  grid-row-start: 1;\n  z-index:1;\n}\n\n.feature-2-li .feature-2-li__media-container{\n\tgrid-column: 4 / -1;\n  grid-row-start: 1;\n}\n\n\n@media (max-width: 768px){\n      .feature-2-li {\n        grid-template-columns:repeat(1, minmax(0, 1fr));\n        margin-bottom:0;\n    }\n\n    .feature-2-li .feature-2-li__content{\n      grid-column: 1 / -1;\n      grid-row-start: 2;\n    }\n\n    .feature-2-li .feature-2-li__media-container{\n      grid-column: 1 / -1;\n      grid-row-start: 1;\n      order:-1;\n    }\n  \n  .feature-2-li:nth-of-type(even) .feature-2-li__media-container{\n\t\tgrid-column: 1 / -1;\n  \tgrid-row-start: 1;\n    align-items: start;\n}\n\n    .feature-2-li:nth-of-type(even) .feature-2-li__content{\n        grid-column: 1 / -1;\n        grid-row-start: 2;\n    }\n}"
