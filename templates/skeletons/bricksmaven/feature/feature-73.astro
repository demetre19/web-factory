interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-feature-73__container">
    <div class="intro">
      <h2 class="intro__heading">Long headline to turn your visitors into customers</h2>
      <p class="intro__subheading">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
      <p class="bm-accent-heading">Accent heading</p>
    </div>
    <div class="bm-feature-73-grid-ul">
      {items.map((it) => (
        <div class="bm-feature-73-card">
          <div class="bm-feature-73-card__content">
            <h2 class="bm-feature-73-card__heading">{it.title}</h2>
            <p class="bm-feature-73-card__text">{it.text}</p>
          </div>
          <div class="bm-feature-73-card__badge">
            <p class="bm-feature-73-card__label">{it.text}</p>
          </div>
          <div class="bm-feature-service-list">
            {(it.items || []).map((it2) => (
              <div class="bm-feature-service-item">
                <p class="bm-feature-service-item__label clickable-parent">{it2.text}</p>
                <span class="bm-feature-service-item__icon" data-icon="lucide" aria-hidden="true"></span>
              </div>
            ))}
          </div>
          <div class="bm-feature-73-card__footer">
            <a class="bm-feature-73-card__cta btn--primary wf-cta-button" href={it.href}>{it.label}</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
@layer components {
