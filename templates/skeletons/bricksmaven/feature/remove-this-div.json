   "name": "code",
   "parent": "rkwxrb",
   "children": [],
   "settings": {
    "code": "<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n    const originalPositions = {};\n    document.querySelectorAll(\".feature-40__feature-container\").forEach((container, index) => {\n        originalPositions[index] = container.getBoundingClientRect().top + window.pageYOffset;\n    });\n\n    document.querySelectorAll(\".feature-40-nav-item__link\").forEach((link, index) => {\n        link.addEventListener(\"click\", function(event) {\n            event.preventDefault();\n            window.scrollTo({\n                top: originalPositions[index],\n                behavior: 'smooth'\n            });\n        });\n    });\n});\n</script>",
    "executeCode": true,
