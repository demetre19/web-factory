  	grid-column:1/7;
    }
  
    .feature-39-card:nth-child(even) {
      grid-column:7/-1;
    }
  
    
  }
  
  @media (max-width:767px) {
  	
    .feature-39-card:nth-child(odd) {
  		grid-column:span 12;
    }
    
     .feature-39-card:nth-child(odd) .feature-39-card__content {
      padding-inline-end: calc(var(--section-space-xxl) * 1.8);
    	grid-column: 1/12;
    }
  
