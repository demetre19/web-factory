      padding-inline-end: calc(var(--section-space-xxl) * 1.8);
    	padding-inline-start: var(--space-m);
    	grid-column: 1/12;
    }
  
    .feature-39-card:nth-child(even) .feature-39-card__icon-wrapper {
      grid-column: 9/-1;
    }
    
  }
</style>
