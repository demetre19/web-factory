   "custom_css": "/* Card */\n.feature-38-card {\n\ttransition: 1s ease;\n}\n\n.feature-38-card:focus-within :focus {\n\toutline: none;\n  box-shadow: none;\n}\n\n.feature-38-card:focus-within {\n  box-shadow: 0 0 1rem 0 var(--shade-light-trans-10);\n}\n\n.feature-38-card:hover {\n\tbackground-color: var(--shade-light);\n}\n\n.feature-38-card:nth-child(1), .feature-38-card:nth-child(7) {\n\tgrid-column: 1/7;\n}\n\n.feature-38-card:nth-child(3) {\n\tgrid-column: 1/6;\n}\n\n.feature-38-card:nth-child(4) {\n\tgrid-column: 6/-1;\n}\n.feature-38-card:nth-child(5) {\n\tgrid-column: 1/8;\n}\n\n.feature-38-card:nth-child(6) {\n\tgrid-column: 8/-1;\n}\n\n.feature-38-card:nth-child(2),.feature-38-card:nth-child(8) {\n\tgrid-column: 7/-1;\n}\n\n/* Image */\n.feature-38-card__image {\n\ttransition: 1s ease;\n}\n\n.feature-38-card:hover .feature-38-card__image, .feature-38-card:focus-within .feature-38-card__image {\n  scale: 1.1;\n}\n\n@media (max-width:767px) {\n\t.feature-38-card {\n\theight:32rem !important;\n}\n  \n  .feature-38-card:nth-child(1), .feature-38-card:nth-child(2), .feature-38-card:nth-child(3), .feature-38-card:nth-child(4), .feature-38-card:nth-child(5), .feature-38-card:nth-child(6),.feature-38-card:nth-child(7), .feature-38-card:nth-child(8) {\n\tgrid-column: span 1;\n}\n\n}\n",
