---
/**
 * bm-feature-63 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (feature-63.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-feature-63__container">
    <div class="intro intro--split">
      <div class="intro__left-column">
        <h2 class="intro__heading">{heading}</h2>
        <p class="bm-accent-heading">Tagline</p>
      </div>
      <div class="intro__right-column">
        <p class="intro__subheading">{fs}</p>
        <a class="btn--primary" href="#">Call to action</a>
      </div>
    </div>
    <div class="bm-feature-63-list list--none">
      {items.map((it) => (
        <div class="bm-feature-63-card">
          <div class="bm-feature-63-card__content">
            <h2 class="bm-feature-63-card__heading">{it.title}</h2>
            <span class="bm-feature-63-card__icon" data-icon="lucide" aria-hidden="true"></span>
            <p class="bm-feature-63-card__text">{it.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-feature-63__container {
    row-gap: var(--space-s);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--flow-spacing);
    align-self: center;
    width: 100%;
  }

  .intro--split {
    display: grid;
    text-align: left;
    grid-template-columns: calc(100% * 1 / 2);
    gap: var(--space-m);
  }

  .intro__left-column {
    row-gap: var(--flow-spacing);
  }

  .intro__right-column {
    row-gap: var(--flow-spacing);
  }

  .bm-feature-63-list {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 3);
  }

  .bm-feature-63-card {
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    justify-content: flex-end;
    height: 320px;
    background: var(--fs-0);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    position: relative;
  }

  .bm-feature-63-card__content {
    row-gap: calc(var(--flow-spacing) / 2);
  }

  /* bm-custom */
  /* Create the counter on Parent */
  .bm-feature-63-list {
    counter-reset: cards ; /* starts at 0 */
  }
  
  /* Every card we meet → add +1 to the counter */
  
  .bm-feature-63-list .bm-feature-63-card {
    counter-increment: cards ;
  }
  
  /* Show the number BEFORE each card */
  .bm-feature-63-list .bm-feature-63-card::before {
    content: "0"counter(cards);
    position: absolute;
    inset-block-start: var(--space-m);
    inset-inline-end: var(--space-m);
    font-size: calc(var(--fs-4) * 1.6);
    color: var(--color-line-default);
  }
  
  .bm-feature-63-list .bm-feature-63-card::after {
    content: "●";
    position: absolute;
    inset-block-start: var(--space-xs);
    color: var(--action-primary);
  }
  
  /* CARD */
  .bm-feature-63-list  .bm-feature-63-card {
    transition: 0.5s ease;
  }
  
  .bm-feature-63-list .bm-feature-63-card:hover, .bm-feature-63-list .bm-feature-63-card:focus-within {
    background-color: var(--text-secondary);
    color: var(--bg-canvas);
  }
  
  .bm-feature-63-list .bm-feature-63-card:hover::before, .bm-feature-63-list .bm-feature-63-card:focus-within::before, .bm-feature-63-list .bm-feature-63-card:hover::after, .bm-feature-63-list .bm-feature-63-card:focus-within::after {
    color: var(--bg-canvas);
  }
  
  /* Make whole CARD clickable */
  .bm-feature-63-list  .bm-feature-63-card .bm-feature-63-card__heading > a {
    transition: 0.1s ease;
  }
  
  .bm-feature-63-list  .bm-feature-63-card .bm-feature-63-card__heading:not(a) > a::after {
    content: '';
    position: absolute;
    display: flex;
    inset: 0;
    cursor: pointer;
  }
</style>
