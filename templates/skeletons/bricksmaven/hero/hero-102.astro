---
/**
 * bm-hero-102 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (hero-102.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-hero-102__container grid-auto gap-fluid-l">
      <div class="bm-hero-102__inner-content">
        <div class="bm-hero-102__intro">
          {heading && <h1 class="text-fluid-4">{heading}</h1>}
          <div class="bm-hero-102__cta-cover">
            <p class="mt-fluid-m"><a class="wf-cta-button" href={cta.href}>{cta.label || 'Continue'}</a></p>
          </div>
        </div>
        <div class="bm-hero-102-card">
          <div class="bm-hero-102-card__content">
            {fs && <p class="text-fluid-0">{fs}</p>}
          </div>
          <div>
            <figure class="bm-hero-102-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      </div>
      <div class="bm-hero-102__footer">
        <div class="bm-list bm-list--inline bm-hero-102__hero-list">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="bm-list-item card">
                <div class="bm-list-item__icon-wrapper">
                  <span data-icon="lucide" aria-hidden="true"></span>
                </div>
                <p class="bm-list-item__text text-fluid-0">{it.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
      <figure class="bm-hero-102__background-image ratio-portrait"><img src="/media/placeholder.svg" alt="Background Image" loading="lazy" width="900" height="600" /></figure>
    </div>
  </div>
</div>
