   "custom_css": ".hero-47__carousel {\n\t--animation-duration-up: 45s;\n  --animation-duration-down: 45s;\n  --scroll-up-end-position: -50%;\n  --scroll-down-start-position: -35%;\n  --animation-iteration-count: infinite;\n  --animation-direction: alternate;\n  --animation-timing-function-up: linear;\n  --animation-timing-function-down: linear;\n}\n\n\n/* Define the animation for the first child */\n.hero-47__carousel:first-child .hero-47-carousel-ul {\n  animation: scrollUp var(--animation-duration-up) var(--animation-iteration-count) var(--animation-direction) var(--animation-timing-function-up);\n}\n\n/* Define the animation for the last child */\n.hero-47__carousel:last-child .hero-47-carousel-ul {\n  animation: scrollDown var(--animation-duration-down) var(--animation-iteration-count) var(--animation-direction) var(--animation-timing-function-down);\n}\n\n/* Define the animations ending point for the first child */\n@keyframes scrollUp {\n  0% {\n    transform: translateX(0%);\n  }\n  100% {\n    transform: translateX(var(--scroll-up-end-position));\n  }\n}\n\n/* Define the animations starting point for the last child */\n@keyframes scrollDown {\n  0% {\n    transform: translateX(var(--scroll-down-start-position));\n  }\n  100% {\n    transform: translateX(0%);\n  }\n}",
