---

<div>
  <div class="sec-inner">
    <div class="bm-hero-92__container">
      <div class="bm-hero-92__intro">
        <div class="bm-hero-92__top">
          {heading && <h1 class="bm-hero-92__heading text-fluid-4">{heading}</h1>}
          {fs && <p class="text-fluid-0">{fs}</p>}
