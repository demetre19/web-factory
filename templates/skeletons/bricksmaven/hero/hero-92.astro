                <div class="bm-hero-90-case__footer"></div>
              </div>
              <div></div>
              <figure class="bm-hero-90-case__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            </div>
            <div class="bm-hero-90-testimonial">
              <div class="bm-testimonial-38-star-list">
                <div class="grid-auto gap-fluid-m">
                  {(items || []).map((it) => (
                    <div class="card">
                      <span data-icon="lucide" aria-hidden="true"></span>
                    </div>
                  ))}
                </div>
              </div>
              <div class="bm-hero-90-testimonial__client-meta grid-auto gap-fluid-l">
                <div></div>
                <figure class="bm-hero-90-testimonial__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
