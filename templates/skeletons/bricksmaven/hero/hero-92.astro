      </div>
      <div>
        <figure class="bm-hero-92__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
    </div>
    <div></div>
    <div></div>
  </div>
</div>
