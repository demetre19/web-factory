   "name": "hero-53",
   "settings": {
    "_position": "relative",
    "_cssCustom": ".hero-53::before {\n\tcontent:'';\n  position:absolute;\n  inset:0;\n  background-color: var(--white);\n  clip-path: polygon(0 0, 79% 0, 51% 100%, 0% 100%);\n  z-index:1;\n}\n\n@media (max-width:767px) {\n\n.hero-53::before {\n\tcontent:'';\n  position:absolute;\n  inset:0;\n  background-color: var(--white);\n  clip-path: polygon(0 0, 100% 0, 100% 50%, 75% 100%, 0 100%, 0% 50%);\n  z-index:1;\n}\n  \n}",
    "_isolation": "isolate",
    "_height": "75vh",
