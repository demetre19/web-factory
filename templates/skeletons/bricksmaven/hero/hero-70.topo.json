   "custom_css": ".bm-hero-70-media-card:nth-child(1) {\n  grid-column: 1 / 3;\n  grid-row: 1 / 5;\n}\n\n.bm-hero-70-media-card:nth-child(2) {\n  grid-column: 3 / 5;\n  grid-row: 1 / 9;\n}\n\n.bm-hero-70-media-card:nth-child(3) {\n  grid-column: 5 / 7;\n  grid-row: 1 / 5;\n}\n\n.bm-hero-70-media-card:nth-child(4) {\n  grid-column: 7 / 9;\n  grid-row: 1 / 9;\n}\n\n.bm-hero-70-media-card:nth-child(5) {\n  grid-column: 9 / -1;\n  grid-row: 1 / 5;\n}\n\n.bm-hero-70-media-card:nth-child(6) {\n  grid-column: 1 / 3;\n  grid-row: 5 / -1;\n}\n\n.bm-hero-70-media-card:nth-child(7) {\n  grid-column: 3 / 5;\n  grid-row: 9 / -1;\n}\n\n.bm-hero-70-media-card:nth-child(8) {\n  grid-column: 5 / 7;\n  grid-row: 5 / -1;\n}\n\n.bm-hero-70-media-card:nth-child(9) {\n  grid-column: 7 / 9;\n  grid-row: 9 / -1;\n}\n\n.bm-hero-70-media-card:nth-child(10) {\n  grid-column: 9 / -1;\n  grid-row: 5 / -1;\n}\n\n/* Offset Top Margin*/\n.bm-hero-70-media-card {\n  --offset-top-margin: var(--space-xl);\n}\n\n.bm-hero-70-media-card:nth-child(2) {\n  margin-block-start: var(--offset-top-margin);\n}\n\n.bm-hero-70-media-card:nth-child(4) {\n  margin-block-start: var(--offset-top-margin);\n}\n\n/* Hide on tablet*/\n@media (max-width:991px) {\n  .bm-hero-70-media-card:nth-child(7), .bm-hero-70-media-card:nth-child(8), .bm-hero-70-media-card:nth-child(9), .bm-hero-70-media-card:nth-child(10) {\n    display: none;\n  }\n  \n  .bm-hero-70-media-card:nth-child(1) {\n  grid-column: 1 / 3;\n  grid-row: 1 / 5;\n}\n\n.bm-hero-70-media-card:nth-child(2) {\n  grid-column: 3 / 5;\n  grid-row: 1 / 9;\n}\n\n.bm-hero-70-media-card:nth-child(3) {\n  grid-column: 5 / -1;\n  grid-row: 1 / 5;\n}\n\n.bm-hero-70-media-card:nth-child(4) {\n  grid-column: 1 / 3;\n  grid-row: 5 / -1;\n}\n\n.bm-hero-70-media-card:nth-child(5) {\n  grid-column: 3 / 5;\n  grid-row: 9 / -1;\n}\n\n.bm-hero-70-media-card:nth-child(6) {\n  grid-column: 5 / -1;\n  grid-row: 5 / -1;\n}\n\n  .bm-hero-70-media-card:nth-child(2) {\n  margin-block-start: var(--offset-top-margin);\n}\n\n.bm-hero-70-media-card:nth-child(4) {\n  margin-block-start: 0;\n}\n  \n}\n\n/* Hide on mobile*/\n@media (max-width:767px) {\n  .bm-hero-70-media-card:nth-child(5), .bm-hero-70-media-card:nth-child(6) {\n    display: none;\n  }\n  \n  .bm-hero-70-media-card:nth-child(1) {\n  grid-column: 1 / 3;\n  grid-row: 1 / 5;\n}\n\n.bm-hero-70-media-card:nth-child(2) {\n  grid-column: 3 / -1;\n  grid-row: 1 / 9;\n}\n\n.bm-hero-70-media-card:nth-child(3) {\n  grid-column: 1 / 3;\n  grid-row: 5 / -1;\n}\n\n.bm-hero-70-media-card:nth-child(4) {\n  grid-column: 3 / -1;\n  grid-row: 9 / -1;\n}\n\n\n  .bm-hero-70-media-card:nth-child(2) {\n  margin-block-start: 0;\n}\n\n  \n}",
