    "code": "<script>\nfunction changeWidth() {\n\tconst hero = document.querySelector('.hero-50'),\n    heroData = hero.getBoundingClientRect(),\n  \timageWrapper = document.querySelector('.hero-50__image-wrapper'),\n  \timageData = imageWrapper.getBoundingClientRect();\n\n  if (window.innerWidth >= 767 && heroData.top < 0) {\n    const heroHeight = imageData.height,\n\t\t\thtml = document.documentElement,\n\t\t\twinScroll = heroData.top * -1,\n\t\t\theight = imageData.bottom,\n\t\t\tscrolled = (winScroll / height) * 100,\n\t\t\tnewWidth = Math.min(50 + scrolled / 2, 100);\n\n    imageWrapper.style.width = newWidth + '%';\n  }\n}\n\nwindow.addEventListener('scroll', function() {\n\trequestAnimationFrame(changeWidth);\n});\n</script>",
