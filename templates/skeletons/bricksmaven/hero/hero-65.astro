---
/**
 * bm-hero-65 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (hero-65.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-hero-65__container grid-auto gap-fluid-l">
      <div class="bm-hero-65__content">
        <div class="bm-hero-65__top">
          {heading && <h1 class="text-fluid-4">{heading}</h1>}
          {fs && <p class="text-fluid-0">{fs}</p>}
        </div>
        <div class="cta-combo"></div>
      </div>
      <figure class="bm-hero-65__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      <div class="bm-hero-65__footer">
        <div class="bm-hero-65-contact-list">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="bm-hero-65-contact-card card">
                <div class="bm-hero-65-contact-card__icon-wrapper">
                  <span data-icon="lucide" aria-hidden="true"></span>
                </div>
                <div class="bm-hero-65-contact-card__content">
                  <p class="text-fluid-0">{it.text}</p>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
                <span data-icon="lucide" aria-hidden="true"></span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
