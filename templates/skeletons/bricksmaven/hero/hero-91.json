   "id": "cymahf",
   "name": "bm-gallery-19-hero-li",
   "settings": {
    "_cssCustom": ".bm-gallery-19-hero-li:nth-child(1) {\n  grid-column: 1 / 6;\n  grid-row: 1 / 14;\n}\n\n.bm-gallery-19-hero-li:nth-child(2) {\n  grid-column: 6 / 10;\n  grid-row: 1 / 8;\n}\n\n.bm-gallery-19-hero-li:nth-child(3) {\n  grid-column: 10 / -1;\n  grid-row: 1 / 8;\n}\n\n.bm-gallery-19-hero-li:nth-child(4) {\n  grid-column: 6 / -1;\n  grid-row: 8 / 14;\n}\n\n@media (max-width:767px) {\n  .bm-gallery-19-hero-li:nth-child(1) {\n  grid-column: 1 / -1;\n  grid-row: 1 / 7;\n}\n\n.bm-gallery-19-hero-li:nth-child(2) {\n  grid-column: 1 / 8;\n  grid-row: 7 / 12;\n}\n\n.bm-gallery-19-hero-li:nth-child(3) {\n  grid-column: 8 / -1;\n  grid-row: 7 / 12;\n}\n\n.bm-gallery-19-hero-li:nth-child(4) {\n  grid-column: 1 / -1;\n  grid-row: 12 / 16;\n}\n}"
