    z-index: 1;
    margin: 0 0 calc(-1 * var(--space-xl)) 0;
  }

  .bm-hero-89-case {
    position: relative;
    overflow: clip;
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    height: 100%;
  }

  .bm-hero-89-case__case-content {
    position: relative;
    z-index: 1;
    height: 100%;
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    justify-content: flex-end;
    row-gap: calc(var(--flow-spacing) / 4);
  }

  .bm-hero-89-case__heading {
