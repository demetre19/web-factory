    row-gap: var(--flow-spacing);
    justify-content: space-between;
  }

  .bm-hero-89__intro {
    row-gap: var(--flow-spacing);
  }

  .bm-hero-89__heading {
    font-size: calc(var(--fs-4) * 1.6);
  }

  .bm-hero-89__subheading {
    font-size: var(--fs-2);
  }

  .bm-hero-89__case-container {
    position: relative;
    width: 120%;
  }

  .bm-hero-89-case-cover {
    position: relative;
    display: grid;
    gap: var(--space-m);
