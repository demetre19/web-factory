---
/**
 * bm-hero-89 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (hero-89.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-hero-89__container">
    <div class="bm-hero-89__content">
      <div class="bm-hero-89__intro">
        <h1 class="bm-hero-89__heading">Long headline to turn your visitors into customers</h1>
        <p class="bm-hero-89__subheading">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
        <a class="btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
      </div>
      <div class="bm-hero-89__case-container">
        <div class="bm-hero-89-case-cover">
          <div class="bm-hero-89-case">
            <div class="bm-hero-89-case__case-content">
              <h2 class="bm-hero-89-case__heading">Decreased development time by 65%</h2>
              <a class="bm-hero-89-case__cta-link link--white" href="#">Read case</a>
            </div>
            <figure class="bm-hero-89-case__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
          <div class="bm-hero-89-testimonial">
            <p class="bm-hero-89-testimonial__review">"I am truly impressed with Bricksmaven's pattern library. Their tools make creating responsive designs effortless and fast, saving me valuable time. I highly recommend their services for anyone looking to streamline their design process."</p>
            <div class="bm-hero-89-testimonial__client-meta">
              <div class="bm-hero-89-testimonial__client-data">
                <p class="bm-hero-89-testimonial__name">John Smith</p>
                <p class="bm-hero-89-testimonial__title">CEO, RubyBlaze</p>
              </div>
              <figure class="bm-hero-89-testimonial__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            </div>
          </div>
          <div class="bm-hero-89__icon-wrapper">
            <span class="bm-hero-89__icon" data-icon="lucide" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </div>
    <div class="bm-hero-89__media">
      <figure class="bm-hero-89__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
    </div>
    <div></div>
  </div>
</div>

<style is:global>
@layer components {
  .bm-hero-89__container {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 2);
  }

