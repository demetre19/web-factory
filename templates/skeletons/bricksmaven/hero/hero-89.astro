    align-items: center;
    column-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-hero-89-testimonial__name {
    font-weight: 700;
    font-size: var(--fs-0);
  }

  .bm-hero-89-testimonial__title {
    font-size: var(--fs-0);
  }

  .bm-hero-89-testimonial__image {
    width: 48px;
    border-radius: 100% 100% 100% 100%;
    object-fit: cover;
  }

  .bm-hero-89__icon-wrapper {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    padding: calc(var(--space-xs) / 2) calc(var(--space-xs) / 2) calc(var(--space-xs) / 2) calc(var(--space-xs) / 2);
    border-radius: 100% 100% 100% 100%;
