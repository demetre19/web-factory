  /* bm-custom */
  .bm-hero-89-case .bm-hero-89-case__image {
    transition: 0.2s linear;
  }
  
  .bm-hero-89-case:hover .bm-hero-89-case__image {
    scale: 1.4;
  }
}
</style>
