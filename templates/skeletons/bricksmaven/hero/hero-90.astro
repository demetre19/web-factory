---
/**
 * bm-hero-90 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (hero-90.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-hero-90__container">
      <div class="bm-hero-90__content">
        {heading && <h1 class="text-fluid-4">{heading}</h1>}
        {fs && <p class="text-fluid-0">{fs}</p>}
        <p class="mt-fluid-m"><a class="wf-cta-button" href={cta.href}>{cta.label || 'Continue'}</a></p>
        <div class="bm-review-widget bm-hero-90__review-widget">
          <div class="bm-team-list">
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="card">
                  <figure class="bm-team-media__image ratio-portrait"><img src="/media/placeholder.svg" alt="Team Image" loading="lazy" width="900" height="600" /></figure>
                </div>
              ))}
            </div>
          </div>
          <div class="bm-testimonial-38__star-ratings">
            <div class="bm-testimonial-38-star-list">
              <div class="grid-auto gap-fluid-m">
                {(items || []).map((it) => (
                  <div class="card">
                    <span data-icon="lucide" aria-hidden="true"></span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
      <div>
        <div>
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="bm-hero-90-slide card">
                <div class="bm-hero-90-case grid-auto gap-fluid-l">
                  <div class="bm-hero-90-case__content">
                    <h2 class="text-fluid-2">{it.title}</h2>
                    <div class="bm-hero-90-case__footer">
                      <p class="text-fluid-0">{it.text}</p>
                      <a class="text-fluid-0" href={it.href}>{it.label}</a>
                    </div>
                  </div>
                  <div></div>
                  <figure class="bm-hero-90-case__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                </div>
                <div class="bm-hero-90-testimonial">
                  <div class="bm-testimonial-38-star-list">
                    <div class="grid-auto gap-fluid-m">
                      {((it.items || []) || []).map((it2) => (
                        <div class="card">
                          <span data-icon="lucide" aria-hidden="true"></span>
                        </div>
                      ))}
                    </div>
                  </div>
                  <p class="text-fluid-0">{it.text}</p>
                  <div class="bm-hero-90-testimonial__client-meta grid-auto gap-fluid-l">
                    <div>
                      <p class="text-fluid-0">{it.text}</p>
                      <p class="text-fluid-0">{it.text}</p>
                    </div>
                    <figure class="bm-hero-90-testimonial__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
