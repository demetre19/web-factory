   "id": "ffgabb",
   "name": "bm-carousel-list",
   "settings": {
    "_width": "calc(100% + (var(--gutter) * 2))",
    "_cssCustom": ".bm-carousel-list {\n  --logo-gap: var(--content-gap);\n  --scroll-duration: 100s;\n}\n\n/* Outer wrapper */\n.bm-carousel-list {\n  overflow: hidden;\n  position: relative;\n  flex-direction: row;\n  flex-wrap: nowrap;\n}\n\n/* Track that scrolls */\n.bm-carousel-list .bm-media-carousel-list {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  min-width: max-content;\n  gap: var(--logo-gap);\n  will-change: transform;\n  /* key part: content is as wide as needed */\n  animation: scroll-logos var(--scroll-duration) linear infinite;\n}\n\n/* Pause animation on hover of the whole carousel */\n.bm-carousel-list:hover .bm-media-carousel-list {\n  animation-play-state: paused;\n}\n\n/* Also pause if user tabs into any logo (keyboard users) */\n.bm-carousel-list:focus-within .bm-media-carousel-list {\n  animation-play-state: paused;\n}\n\n/* Animation: move track left by 50% (because we duplicated the content) */\n@keyframes scroll-logos {\n  0% {\n    transform: translateX(0);\n  }\n  100% {\n    transform: translateX(-50%);\n  }\n}\n\n/* Respect users who prefer reduced motion */\n@media (prefers-reduced-motion: reduce) {\n  .bm-media-carousel-list  {\n    animation: none;\n  }\n}\n\n",
    "_widthMax": "calc(100% + (var(--gutter) * 2))",
    "_flexWrap": "nowrap",
    "_width:mobile_landscape": "100%",
    "_widthMax:mobile_landscape": "100%"
   },
