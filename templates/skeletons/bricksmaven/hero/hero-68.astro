  .bm-hero-68__container {
    height: 100%;
    position: relative;
    align-items: center;
    justify-content: center;
  }

  .bm-hero-68__content {
    display: flex;
    flex-wrap: nowrap;
    row-gap: var(--flow-spacing);
    align-items: center;
    text-align: center;
    width: var(--content-width);
    z-index: 2;
    top: var(--section-space-xxl);
    position: absolute;
  }

  .bm-hero-68__heading {
    font-size: calc(var(--fs-4) * 2);
  }

  .cta-combo {
    display: flex;
    align-items: center;
    column-gap: var(--flow-spacing);
  }

  .bm-hero-68-slide__image {
    object-fit: cover;
    width: 100%;
  }

  .bm-hero-68__ovarlay {
    position: absolute;
    z-index: 1;
    background: color-mix(in srgb, var(--text-secondary) 60%, transparent);
    height: 100%;
    bottom: 0;
    top: 0;
    right: 0;
    left: 0;
  }

  /* bm-custom */
  .bm-hero-68__slider  .splide__track{
  	overflow:visible;
  }
  
  .bm-hero-68__slider .splide__list {
    gap: var(--flow-spacing);
    align-items: center;
  }
  
  .bm-hero-68__slider :where(.splide__list, .splide__slide){
    transition-timing-function: linear !important;
  }
}
