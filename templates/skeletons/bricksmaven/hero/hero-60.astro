 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (hero-60.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-hero-60__container">
    <div class="bm-hero-60__content">
      <div class="bm-hero-60__top">
        <h1 class="bm-hero-60__heading">Long headline to turn your visitors into customers</h1>
        <p class="accent-h accent-h--alt">Accent heading</p>
        <p class="bm-hero-60__subheading">Unlock your potential and take the next step toward your dreams. Every small action brings you closer to the life you’ve always envisioned</p>
      </div>
      <div class="cta-combo">
        <a class="btn--white" href="#">Call to action</a>
        <a class="btn--link" href="#">Secondary action →</a>
      </div>
    </div>
    <figure class="bm-hero-60__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
    <div class="bm-hero-60__footer">
      <div class="bm-hero-60-contact-usp list--none">
        <div class="bm-hero-60-contact-usp-card">
          <div class="bm-hero-60-contact-usp-card__icon-wrapper">
            <span class="bm-hero-60-contact-usp-card__icon" data-icon="lucide" aria-hidden="true"></span>
          </div>
          <div class="bm-hero-60-contact-usp-card__content">
            <p class="bm-hero-60-contact-usp-card__heading">Call us</p>
            <p class="bm-hero-60-contact-usp-card__text">+000 123 456 789</p>
          </div>
        </div>
        <div class="bm-hero-60-contact-usp-card">
          <div class="bm-hero-60-contact-usp-card__icon-wrapper">
            <span class="bm-hero-60-contact-usp-card__icon" data-icon="lucide" aria-hidden="true"></span>
          </div>
          <div class="bm-hero-60-contact-usp-card__content">
            <p class="bm-hero-60-contact-usp-card__heading">E-mail</p>
            <p class="bm-hero-60-contact-usp-card__text">info@clienturl.com</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="bm-social-list__wrapper">
    <div class="bm-social-list-text list--none">
      {items.map((it) => (
        <div class="bm-social-list-text-item">
          <a class="bm-social-list-text-item__link" href="#">{it.text}</a>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
@layer components {
