---
/**
 * bm-hero-60 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (hero-60.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-hero-60__container grid-auto gap-fluid-l">
      <div class="bm-hero-60__content">
        <div class="bm-hero-60__top">
          {heading && <h1 class="text-fluid-4">{heading}</h1>}
          {fs && <p class="bm-hero-60__subheading text-fluid-0">{fs}</p>}
        </div>
        <div class="cta-combo"></div>
      </div>
      <figure class="bm-hero-60__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      <div class="bm-hero-60__footer">
        <div class="bm-hero-60-contact-usp">
          <div class="bm-hero-60-contact-usp-card">
            <div class="bm-hero-60-contact-usp-card__icon-wrapper">
              <span data-icon="lucide" aria-hidden="true"></span>
            </div>
            <div class="bm-hero-60-contact-usp-card__content"></div>
          </div>
          <div class="bm-hero-60-contact-usp-card">
            <div class="bm-hero-60-contact-usp-card__icon-wrapper">
              <span data-icon="lucide" aria-hidden="true"></span>
            </div>
            <div class="bm-hero-60-contact-usp-card__content"></div>
          </div>
        </div>
      </div>
    </div>
    <div class="bm-social-list__wrapper">
      <div class="bm-social-list-text">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="bm-social-list-text-item card">
              <a class="text-fluid-0" href={it.href}>{it.label}</a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
