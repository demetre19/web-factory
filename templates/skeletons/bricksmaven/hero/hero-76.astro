<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-hero-76 {
    overflow: hidden;
  }

  .bm-hero-76__container {
    row-gap: var(--space-s);
  }

  .bm-hero-76__content {
    align-items: center;
    text-align: center;
    width: 100%;
    align-self: center;
    row-gap: var(--flow-spacing);
