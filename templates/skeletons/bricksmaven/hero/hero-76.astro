    display:none;
  }
  
  .bm-hero-76-image-wrapper:nth-child(2) {
    grid-column:span 1;
    grid-row:auto;
  }
  
  .bm-hero-76-image-wrapper:nth-child(3) {
    display:none;
  }
  }
</style>
