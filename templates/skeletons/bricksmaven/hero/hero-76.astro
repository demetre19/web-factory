    align-items: center;
    column-gap: var(--flow-spacing);
  }

  .bm-hero-76-media {
    padding: 0 0 0 0;
    margin: 0 0 0 -50vw;
    display: grid;
    grid-template-columns: calc(100% * 1 / 12);
    grid-template-rows: calc(100% * 1 / 12);
    width: 100vw;
    position: relative;
    height: 720px;
    left: 50%;
    gap: var(--space-m);
  }

  .bm-hero-76-image-wrapper__image {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  /* bm-custom */
  .bm-hero-76-image-wrapper:nth-child(1) {
    grid-column:1/4 ;
    grid-row:3/10;
  }
  
  .bm-hero-76-image-wrapper:nth-child(2) {
    grid-column:4/10 ;
    grid-row:1/-1;
  }
  
  .bm-hero-76-image-wrapper:nth-child(3) {
    grid-column:10/-1 ;
    grid-row:2/12;
  }
  
  @media (max-width:767px) {
    
