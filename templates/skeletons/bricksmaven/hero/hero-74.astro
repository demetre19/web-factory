---
/**
 * bm-hero-74 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (hero-74.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-hero-74__container">
    <div class="bm-hero-74__content">
      <div class="bm-hero-74__top">
        <h1 class="bm-hero-74__heading">{heading}</h1>
        <p class="bm-accent-heading">Accent Heading</p>
        <p class="bm-hero-74__text">{fs}</p>
        <a class="bm-hero-74__button btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
      </div>
      <div class="bm-hero-74__footer">
        <div class="bm-review-widget">
          <div class="bm-team-list list--none">
            {items.map((it) => (
              <div class="bm-team-media">
                <figure class="bm-team-media__image"><img src="/media/placeholder.svg" alt="Team Image" loading="lazy" width="900" height="600" /></figure>
              </div>
            ))}
          </div>
          <div class="bm-testimonial-38__star-ratings">
            <div class="bm-testimonial-38-star-list list--none">
              {items.map((it) => (
                <div class="bm-testimonial-38-star-li">
                  <span class="bm-testimonial-38-star-li__icon" data-icon="lucide" aria-hidden="true"></span>
                </div>
              ))}
            </div>
            <p class="bm-testimonial-38__meta-text">Rated 5 Stars on TrustPilot</p>
          </div>
        </div>
      </div>
    </div>
    <div class="bm-media-group">
      {items.map((it) => (
        <div class="bm-media-group__image-wrapper">
          <figure class="bm-media-group__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-hero-74__container {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 3 / 2);
  }

  .bm-hero-74__content {
    justify-content: space-between;
    row-gap: var(--flow-spacing);
  }

  .bm-hero-74__top {
    row-gap: var(--flow-spacing);
  }

  .bm-hero-74__heading {
    font-size: calc(var(--fs-4) * 1.4);
  }

  .bm-hero-74__text {
    font-size: var(--fs-2);
  }

  .bm-review-widget {
    flex-direction: row;
    display: flex;
    flex-wrap: nowrap;
    column-gap: calc(var(--flow-spacing) / 2);
    text-align: center;
    align-items: center;
  }

  .bm-team-list {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
  }

  .bm-team-media__image {
    object-fit: cover;
    width: 53;
    height: 52;
    border-top: .4rem solid var(--bg-canvas);
    border-right: .4rem solid var(--bg-canvas);
    border-bottom: .4rem solid var(--bg-canvas);
    border-left: .4rem solid var(--bg-canvas);
    border-radius: 100% 100% 100% 100%;
    overflow: hidden;
  }

  .bm-testimonial-38__star-ratings {
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    row-gap: calc(var(--flow-spacing) / 4);
  }

  .bm-testimonial-38-star-list {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    column-gap: calc(var(--flow-spacing) / 4);
  }

  .bm-media-group {
    padding: 0 0 0 0;
    margin: 0 0 0 0;
    display: grid;
    grid-template-columns: calc(100% * 1 / 2);
    gap: var(--space-m);
  }

  .bm-media-group__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* bm-custom */
  .bm-team-media:nth-child(even),.bm-team-media:nth-child(odd) {
  	margin-inline-start: -20px;
  }
  
  .bm-team-media:first-child {
  	margin-inline-start: 0px;
  }

  /* bm-custom */
  .bm-media-group__image-wrapper:first-child {
    grid-column: span 2;
  }
</style>
