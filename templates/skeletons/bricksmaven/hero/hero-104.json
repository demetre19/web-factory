    "_display": "grid",
    "_gridGap": "calc(var(--grid-gap) * 3)",
    "_gridTemplateColumns": "var(--grid-12)",
    "_gridTemplateRows": "var(--grid-1)",
    "_cssCustom": "@media (min-width:1155px) {\n  .bm-hero-104-grid-review .bm-testimonial-44-review-card:nth-child(1) {\n  grid-column: 1/5;\n  grid-row: 1;\n}\n\n.bm-hero-104-grid-review .bm-testimonial-44-review-card:nth-child(2) {\n  grid-column: 9/-1;\n  grid-row: 1;\n}\n}\n\n@media (max-width:1155px) {\n  .bm-hero-104-grid-review {\n    grid-template-columns: repeat(24, minmax(0, 1fr));\n    gap: var(--grid-gap);\n  }\n  \n  .bm-hero-104-grid-review .bm-testimonial-44-review-card:nth-child(1) {\n  grid-column: 2/13;\n  grid-row: 1;\n}\n\n.bm-hero-104-grid-review .bm-testimonial-44-review-card:nth-child(2) {\n  grid-column: 13/24;\n  grid-row: 1;\n}\n}\n\n@media (max-width:796px) {\n  .bm-hero-104-grid-review {\n    display: none;\n  }\n  \n}",
    "_position": "relative",
    "_zIndex": "2"
