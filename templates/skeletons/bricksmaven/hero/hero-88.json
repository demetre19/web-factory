   "name": "bm-hero-88__slider-nested",
   "settings": {
    "_cssCustom": ".bm-hero-88__slider-nested {\n  --mask-height: calc(var(--width-xs) / 2);\n  --mask-radius: var(--radius-50);\n}\n\n.bm-hero-88__slider-nested .splide__track {\n  overflow: visible;\n}\n\n.bm-hero-88__slider-nested::before {\n  content: '';\n  position: absolute;\n  inset-block-start: 0;\n  inset-inline-start: 50%;\n  background-color: var(--white);\n  inline-size: 100vw;\n  max-inline-size: 100vw;\n  margin-inline-start: -50vw;\n  border-end-end-radius: var(--mask-radius);\n  border-end-start-radius: var(--mask-radius);\n  block-size: var(--mask-height);\n  z-index: 99;\n}\n\n.bm-hero-88__slider-nested::after {\n  content: '';\n  position: absolute;\n  inset-block-end: 0;\n  inset-inline-start: 50%;\n  background-color: var(--white);\n  inline-size: 100vw;\n  max-inline-size: 100vw;\n  margin-inline-start: -50vw;\n  border-start-start-radius: var(--mask-radius);\n  border-start-end-radius: var(--mask-radius);\n  block-size: var(--mask-height);\n  z-index: 99;\n}"
