---
/**
 * bm-hero-84 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (hero-84.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-hero-84__container">
    <div class="bm-hero-84__intro">
      <div class="bm-hero-84__intro-top">
        <h1 class="bm-hero-84__heading">{heading}</h1>
        <p class="bm-hero-84__subheading">{fs}</p>
        <div class="cta-combo">
          <a class="btn--primary" href="#">Call to action</a>
          <a class="link--black" href="#">Secondary action →</a>
        </div>
      </div>
      <div class="bm-hero-84__footer-media">
        <div class="bm-hero-84__foot-media">
          <figure class="bm-hero-84__foot-image"><img src="/media/placeholder.svg" alt="Foot Image" loading="lazy" width="900" height="600" /></figure>
        </div>
        <div class="bm-hero-84__misc">
          <div class="bm-hero-84__testimonial">
            <div class="bm-review-card bm-review-card--left-aligned">
              <div class="bm-review-star list--none">
                {items.map((it) => (
                  <div class="bm-review-star-list">
                    <span class="bm-review-star-list__icon" data-icon="lucide" aria-hidden="true"></span>
                  </div>
                ))}
              </div>
              <p class="bm-review-card__text">“Way easier than Notepad.”</p>
            </div>
            <div class="testimonial-36-card__head">
              <div class="testimonial-36-card__avatar">
                <figure class="testimonial-36-card__avatar-image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
              <div class="testimonial-36-card__client-data">
                <custom class="testimonial-36-card__client-name">John Smith</custom>
                <p class="testimonial-36-card__client-title">Secure Marketing</p>
              </div>
            </div>
          </div>
          <div class="bm-hero-84__misc-media">
            <figure class="bm-hero-84__misc-image"><img src="/media/placeholder.svg" alt="Misc Image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      </div>
    </div>
    <div class="bm-hero-84__media">
      <div class="bm-hero-84__intro-media">
        <figure class="bm-hero-84__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
      <div class="bm-hero-84__top-media">
        <figure class="bm-hero-84__top-image"><img src="/media/placeholder.svg" alt="Top Image" loading="lazy" width="900" height="600" /></figure>
      </div>
    </div>
  </div>
</div>

