---
/**
 * bm-hero-84 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (hero-84.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-hero-84__container">
      <div class="bm-hero-84__intro">
        <div class="bm-hero-84__intro-top">
          {heading && <h1 class="text-fluid-4">{heading}</h1>}
          {fs && <p class="text-fluid-0">{fs}</p>}
          <div class="cta-combo"></div>
        </div>
        <div class="bm-hero-84__footer-media">
          <div>
            <figure class="bm-hero-84__foot-image ratio-portrait"><img src="/media/placeholder.svg" alt="Foot Image" loading="lazy" width="900" height="600" /></figure>
          </div>
          <div class="bm-hero-84__misc">
            <div class="bm-hero-84__testimonial">
              <div class="bm-review-card bm-review-card--left-aligned">
                <div class="bm-review-star">
                  <div class="grid-auto gap-fluid-m">
                    {(items || []).map((it) => (
                      <div class="card">
                        <span data-icon="lucide" aria-hidden="true"></span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
              <div class="testimonial-36-card__head">
                <div class="testimonial-36-card__avatar">
                  <figure class="testimonial-36-card__avatar-image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                </div>
                <div class="testimonial-36-card__client-data"></div>
              </div>
            </div>
            <div>
              <figure class="bm-hero-84__misc-image ratio-portrait"><img src="/media/placeholder.svg" alt="Misc Image" loading="lazy" width="900" height="600" /></figure>
            </div>
          </div>
        </div>
      </div>
      <div class="bm-hero-84__media">
        <div>
          <figure class="bm-hero-84__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
        <div>
          <figure class="bm-hero-84__top-image ratio-portrait"><img src="/media/placeholder.svg" alt="Top Image" loading="lazy" width="900" height="600" /></figure>
        </div>
      </div>
    </div>
  </div>
</div>
