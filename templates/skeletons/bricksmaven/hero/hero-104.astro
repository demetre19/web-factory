<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-hero-104__container {
    row-gap: var(--space-s);
    align-items: center;
    padding: var(--section-space-xxl) var(--space-l) var(--space-xl) var(--space-l);
    background: color-mix(in srgb, var(--fs-0) 30%, transparent);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
  }

  .bm-hero-104__intro {
    flex-wrap: nowrap;
    row-gap: var(--flow-spacing);
    align-items: center;
    text-align: center;
  }

  .bm-hero-104__heading {
    font-size: calc(var(--fs-4) * 2);
  }

  .bm-hero-104__text {
    font-size: var(--fs-2);
  }

  .bm-hero-104-owner {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    column-gap: calc(var(--flow-spacing) / 2);
    align-items: center;
  }

  .bm-hero-104-owner__avatar {
    object-fit: cover;
    width: 56px;
    height: 56px;
    border-radius: 100% 100% 100% 100%;
  }

  .bm-hero-104__review-media {
    position: relative;
  }

  .bm-hero-104-grid-review {
    display: grid;
    gap: calc(var(--space-m) * 3);
    grid-template-columns: calc(100% * 1 / 12);
    grid-template-rows: calc(100% * 1 / 1);
    position: relative;
    z-index: 2;
  }

  .bm-testimonial-44-review-card {
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    border-top: 1px solid var(--color-line-default);
    border-right: 1px solid var(--color-line-default);
    border-bottom: 1px solid var(--color-line-default);
    border-left: 1px solid var(--color-line-default);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    row-gap: var(--flow-spacing);
    background: var(--bg-canvas);
  }

  .testimonial-list-card__profile {
    display: flex;
    column-gap: 1rem;
    align-items: center;
  }

  .testimonial-list-card__meta {
    display: flex;
    flex-direction: column;
    row-gap: calc(--content-gap / 2);
  }

  .testimonial-list-card__name {
    font-weight: 700;
  }

  .testimonial-list-card__jobtitle {
    font-size: var(--fs-0);
  }

  .testimonial-list-card__image {
    object-fit: cover;
    width: 5rem;
    height: 5rem;
    overflow: hidden;
    border-radius: 50% 50% 50% 50%;
  }

  .bm-testimonial-38-star-list {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    column-gap: calc(var(--flow-spacing) / 4);
  }

  .bm-hero-104__media {
    position: absolute;
    z-index: 1;
    width: 100%;
    top: 0;
    left: 50%;
  }

  .bm-hero-104-owner__image {
    object-fit: cover;
    height: 640px;
    width: 100%;
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    /* bm: box-shadow omitted — token layer owns elevation */
  }

  /* bm-custom */
  @media (max-width:1155px) {
    .bm-hero-104__review-media {
      padding-block-start: var(--space-xl);
    }
    
  }

  /* bm-custom */
  @media (min-width:1155px) {
    .bm-hero-104-grid-review .bm-testimonial-44-review-card:nth-child(1) {
    grid-column: 1/5;
    grid-row: 1;
  }
  
  .bm-hero-104-grid-review .bm-testimonial-44-review-card:nth-child(2) {
    grid-column: 9/-1;
    grid-row: 1;
  }
  }
  
  @media (max-width:1155px) {
    .bm-hero-104-grid-review {
      grid-template-columns: repeat(24, minmax(0, 1fr));
      gap: var(--space-m);
    }
    
    .bm-hero-104-grid-review .bm-testimonial-44-review-card:nth-child(1) {
    grid-column: 2/13;
    grid-row: 1;
  }
  
  .bm-hero-104-grid-review .bm-testimonial-44-review-card:nth-child(2) {
    grid-column: 13/24;
    grid-row: 1;
  }
  }
  
  @media (max-width:796px) {
    .bm-hero-104-grid-review {
      display: none;
    }
    
  }

  /* bm-custom */
  @media (max-width:1155px) {
    .bm-hero-104__media {
      max-inline-size: 100%; 
    }
  }
  
  @media (max-width:796px) {
    .bm-hero-104__media {
      position: relative;
      block-size: 420px;
    }
  }
</style>
