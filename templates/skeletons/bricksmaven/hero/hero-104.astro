---
/**
 * bm-hero-104 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (hero-104.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-hero-104__container">
      <div class="bm-hero-104__intro">
        {heading && <h1 class="text-fluid-4">{heading}</h1>}
        {fs && <p class="text-fluid-0">{fs}</p>}
        <div class="bm-hero-104-owner">
          <div>
            <figure class="bm-hero-104-owner__avatar ratio-portrait"><img src="/media/placeholder.svg" alt="Avatar" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      </div>
      <div>
        <div class="bm-hero-104-grid-review">
          <div class="bm-testimonial-44-review-card">
            <div>
              <div class="testimonial-list-card__profile">
                <div class="testimonial-list-card__meta"></div>
                <div>
                  <figure class="testimonial-list-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                </div>
              </div>
              <div class="bm-testimonial-38-star-list">
                <div class="grid-auto gap-fluid-m">
                  {(items || []).map((it) => (
                    <div class="card">
                      <span data-icon="lucide" aria-hidden="true"></span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
          <div class="bm-testimonial-44-review-card">
            <div>
              <div class="testimonial-list-card__profile">
                <div class="testimonial-list-card__meta"></div>
                <div>
                  <figure class="testimonial-list-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                </div>
              </div>
              <div class="bm-testimonial-38-star-list">
                <div class="grid-auto gap-fluid-m">
                  {(items || []).map((it) => (
                    <div class="card">
                      <span data-icon="lucide" aria-hidden="true"></span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="bm-hero-104__media">
          <figure class="bm-hero-104-owner__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
      </div>
    </div>
  </div>
</div>
