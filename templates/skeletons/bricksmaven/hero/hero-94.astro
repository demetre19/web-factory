    </div>
  </div>
  <div class="bm-hero-94-footer-container">
    <div class="bm-hero-94-footer-container__logo-cover">
      <h2 class="bm-hero-94-footer-container__heading">Since 2022, we've created hundreds of patterns for agencies and freelancers</h2>
      <div class="bm-hero-94-logo-list list--none">
        {items.map((it) => (
          <div class="bm-hero-94-logo-wrapper">
            <svg class="bm-hero-94-logo-wrapper__svg"></svg>
          </div>
        ))}
      </div>
    </div>
  </div>
