---
/**
 * bm-hero-81 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (hero-81.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-hero-81__container">
    <div class="bm-hero-81__intro">
      <h1 class="bm-hero-81__heading">{heading}</h1>
      <p class="bm-hero-81__accent-heading">Your go-to pattern library</p>
    </div>
    <div class="bm-media-group-2 list--none">
      {items.map((it) => (
        <div class="bm-media-group-2__item">
          <figure class="bm-media-group-2__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
      ))}
    </div>
    <div class="bm-hero-81__footer">
      <p class="bm-hero-81__text">{fs}</p>
      <a class="btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
    </div>
  </div>
  <div></div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-hero-81__container {
    row-gap: var(--space-s);
  }

  .bm-hero-81__intro {
    align-items: center;
    text-align: center;
    row-gap: var(--flow-spacing);
  }

  .bm-hero-81__heading {
    font-size: calc(var(--fs-4) * 4);
  }

  .bm-hero-81__accent-heading {
    font-size: var(--fs-3);
  }

  .bm-media-group-2 {
    display: grid;
    grid-template-columns: repeat(24, minmax(0, 1fr));
    gap: 0;
    grid-template-rows: calc(100% * 1 / 6);
  }

  .bm-media-group-2__image {
    object-fit: cover;
    width: 100%;
    height: 100%;
    /* bm: box-shadow omitted — token layer owns elevation */
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
  }

  .bm-hero-81__footer {
    flex-direction: row;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: var(--section-space-xxl) 0 0 0;
    row-gap: var(--flow-spacing);
  }

  /* bm-custom */
  .bm-media-group-2__item:nth-child(1) {
    grid-column:1 / 9 ;
    grid-row:1/-1;
    transform: rotate(-10deg) translateY(var(--space-m));
    
  }
  
  .bm-media-group-2__item:nth-child(2) {
    grid-column:6 / 14 ;
    grid-row:1/-1;
    transform: rotate(5deg) ;
  }
  
  .bm-media-group-2__item:nth-child(3) {
    grid-column:12 / 20 ;
    grid-row:1/-1;
    transform: rotate(-10deg) translateY(var(--space-m));
  }
  
  .bm-media-group-2__item:nth-child(4) {
    grid-column:17 / -1 ;
    grid-row:1/-1;
    transform: rotate(5deg);
  }
</style>
