    "_gridTemplateColumns": "var(--grid-2)"
   }
  },
  {
   "id": "tplipx",
   "name": "hero-46__carousel",
   "settings": {
    "_position": "relative",
    "_cssCustom": ".hero-46__carousel {\n\t--animation-duration-up: 35s;\n  --animation-duration-down: 35s;\n  --scroll-up-end-position: -50%;\n  --scroll-down-start-position: -50%;\n  --animation-iteration-count: infinite;\n  --animation-direction: alternate;\n  --animation-timing-function-up: linear;\n  --animation-timing-function-down: linear;\n  --image-desktop: 50rem;\n  --image-mobile: 32rem;\n}\n\n/* Define the animation for the first child */\n.hero-46__carousel:first-child .hero-46-carousel-ul {\n  animation: scrollUp var(--animation-duration-up) var(--animation-iteration-count) var(--animation-timing-function-up) var(--animation-direction);\n}\n\n/* Define the animation for the last child */\n.hero-46__carousel:last-child .hero-46-carousel-ul {\n  animation: scrollDown var(--animation-duration-down) var(--animation-iteration-count) var(--animation-timing-function-down) var(--animation-direction);\n}\n\n/* Define the animations ending point for the first child */\n@keyframes scrollUp {\n  0% {\n    transform: translateY(0%);\n  }\n  100% {\n    transform: translateY(var(--scroll-up-end-position));\n  }\n}\n\n/* Define the animations starting point for the last child */\n@keyframes scrollDown {\n  0% {\n    transform: translateY(var(--scroll-down-start-position));\n  }\n  100% {\n    transform: translateY(0%);\n  }\n}",
    "_display": "flex"
   }
  },
