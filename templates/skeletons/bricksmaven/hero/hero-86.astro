---
/**
 * bm-hero-86 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (hero-86.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-hero-86__container">
      <div class="bm-hero-86__content">
        <div class="bm-hero-86__top">
          {heading && <h1 class="text-fluid-4">{heading}</h1>}
          {fs && <p class="text-fluid-0">{fs}</p>}
          <p class="mt-fluid-m"><a class="wf-cta-button" href={cta.href}>{cta.label || 'Continue'}</a></p>
        </div>
        <div>
          <div>
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="bm-hero-86-card card">
                  <div class="bm-hero-86-card__thumb">
                    <figure class="bm-hero-86-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                  </div>
                  <div class="bm-hero-86-card__content">
                    <div class="bm-hero-86-card__top">
                      <p class="text-fluid-0">{it.text}</p>
                      <span data-icon="lucide" aria-hidden="true"></span>
                    </div>
                    <p class="bm-hero-86-card__review text-fluid-0">{it.text}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
      <div>
        <div class="bm-hero-86-media">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="card">
                <figure class="bm-hero-86-image-wrapper__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div></div>
    </div>
  </div>
</div>
