    gap: var(--flow-spacing);
    align-items: center;
  }
  
  .bm-hero-67__slider :where(.splide__list, .splide__slide){
    transition-timing-function: linear !important;
  }

  /* bm-custom */
  .bm-hero-67-slide {
  	transition: .5s linear;
  }
  
  .bm-hero-67-slide:hover {
  	box-shadow: 0 0 2rem 0 rgb(0,0,0,0.2);
  }
</style>
