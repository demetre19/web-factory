---
/**
 * bm-hero-67 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (hero-67.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-hero-67__container">
    <div class="bm-hero-67__intro">
      <h1 class="bm-hero-67__heading">{heading}</h1>
      <p class="accent-h">Accent Heading</p>
      <p class="bm-hero-67__text">{fs}</p>
      <div class="cta-combo">
        <a class="btn--primary btn--white" href="#">Call to action</a>
        <a class="btn--link bm-hero-67__link" href="#">Secondary action →</a>
      </div>
    </div>
    <div class="bm-hero-67__media">
      <figure class="bm-hero-67__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
    </div>
    <div class="bm-hero-67__slider-wrapper">
      <div class="bm-hero-67__slider">
        {items.map((it) => (
          <div class="bm-hero-67-slide">
            <p class="bm-hero-67-slide__quote">{it.text}</p>
            <div class="bm-hero-67-slide__footer">
              <div class="bm-hero-67-slide__client-wrapper">
                <div class="bm-hero-67-slide__media">
                  <figure class="bm-hero-67-slide__client-image"><img src="/media/placeholder.svg" alt="Client Image" loading="lazy" width="900" height="600" /></figure>
                </div>
                <div class="bm-hero-67-slide__meta-data">
                  <h2 class="bm-hero-67-slide__heading">{it.title}</h2>
                  <p class="bm-hero-67-slide__text">{it.text}</p>
                </div>
              </div>
              <div class="list--none bm-hero-67-slide__rating-wrapper">
                {(it.items || []).map((it2) => (
                  <div class="bm-hero-67-slide__rating-li">
                    <span class="bm-hero-67-slide__rating-icon" data-icon="lucide" aria-hidden="true"></span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-hero-67 {
    background: var(--text-secondary);
    overflow: hidden;
  }

  .bm-hero-67__container {
    row-gap: var(--space-s);
  }

  .bm-hero-67__intro {
    display: flex;
    flex-wrap: nowrap;
    row-gap: var(--flow-spacing);
    align-items: center;
    text-align: center;
  }

