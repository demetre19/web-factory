---
/**
 * bm-hero-67 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (hero-67.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-hero-67__container">
      <div class="bm-hero-67__intro">
        {heading && <h1 class="text-fluid-4">{heading}</h1>}
        {fs && <p class="text-fluid-0">{fs}</p>}
        <div class="cta-combo"></div>
      </div>
      <div>
        <figure class="bm-hero-67__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
      <div class="bm-hero-67__slider-wrapper">
        <div>
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="bm-hero-67-slide card">
                <p class="bm-hero-67-slide__quote text-fluid-0">{it.text}</p>
                <div class="bm-hero-67-slide__footer">
                  <div class="bm-hero-67-slide__client-wrapper">
                    <div class="bm-hero-67-slide__media">
                      <figure class="bm-hero-67-slide__client-image ratio-portrait"><img src="/media/placeholder.svg" alt="Client Image" loading="lazy" width="900" height="600" /></figure>
                    </div>
                    <div>
                      <h2 class="text-fluid-2">{it.title}</h2>
                      <p class="text-fluid-0">{it.text}</p>
                    </div>
                  </div>
                  <div class="bm-hero-67-slide__rating-wrapper">
                    <div class="grid-auto gap-fluid-m">
                      {((it.items || []) || []).map((it2) => (
                        <div class="bm-hero-67-slide__rating-li card">
                          <span data-icon="lucide" aria-hidden="true"></span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
