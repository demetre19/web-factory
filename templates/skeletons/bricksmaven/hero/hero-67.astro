    align-items: center;
    column-gap: var(--flow-spacing);
  }

  .btn--link {
    background: transparent;
    padding: 0 0 0 0;
  }

  .bm-hero-67__media {
    height: 760;
  }

  .bm-hero-67__image {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  .bm-hero-67__slider-wrapper {
    margin: calc(-1 * (var(--section-space-xxl) * 2)) 0 0 0;
  }

  .bm-hero-67-slide {
    display: flex;
    flex-direction: column;
    row-gap: var(--flow-spacing);
    justify-content: space-between;
    border-top: .1rem solid var(--color-line-default);
    border-right: .1rem solid var(--color-line-default);
    border-bottom: .1rem solid var(--color-line-default);
    border-left: .1rem solid var(--color-line-default);
    background: var(--bg-subtle);
    height: 100%;
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
  }

  .bm-hero-67-slide__quote {
