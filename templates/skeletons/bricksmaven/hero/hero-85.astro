---
/**
 * bm-hero-85 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (hero-85.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-hero-85__container">
    <div class="bm-hero-85__content">
      <div class="bm-hero-85__top">
        <h1 class="bm-hero-85__heading">Tired of building from scratch? Get Bricksmaven today!</h1>
        <p class="bm-accent-heading bm-hero-85__accent">Accent heading</p>
        <p class="bm-hero-85__subheading">Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
        <a class="bm-hero-85__cta btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
      </div>
      <div class="bm-hero-85-testimonial">
        <div class="bm-hero-85-client">
          <div class="bm-hero-85-client__data">
            <p class="bm-hero-85-client__name">John Smith</p>
            <p class="bm-hero-85-client__title">Add your title</p>
          </div>
          <div class="bm-hero-85-client__media">
            <figure class="bm-hero-85-client__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
        <p class="bm-hero-85-testimonial__review">"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."</p>
      </div>
    </div>
    <div class="bm-hero-85__form-cover">
      <div class="bm-hero-85__form-container">
        <form class="bm-contact-25__form-content bm-hero-85__form" novalidate>
        </form>
      </div>
    </div>
    <div></div>
  </div>
</div>

<style is:global>
@layer components {
  .bm-hero-85 {
    background: var(--bg-subtle);
  }

  .bm-hero-85__container {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 3 / 2);
  }

  .bm-hero-85__content {
    row-gap: var(--flow-spacing);
  }

  .bm-hero-85__top {
    row-gap: var(--flow-spacing);
  }

  .bm-hero-85-testimonial {
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    row-gap: var(--flow-spacing);
    background: var(--bg-canvas);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
  }

  .bm-hero-85-client {
    display: flex;
    flex-wrap: nowrap;
    flex-direction: row;
    column-gap: calc(var(--flow-spacing) / 2);
    align-items: center;
  }

  .bm-hero-85-client__name {
    font-weight: 700;
  }

  .bm-hero-85-client__title {
    font-size: var(--fs-0);
  }

  .bm-hero-85-client__image {
    object-fit: cover;
    width: 64px;
    height: 64px;
    border-radius: 100% 100% 100% 100%;
  }

  .bm-hero-85__form-cover {
    align-items: flex-end;
  }

  .bm-hero-85__form-container {
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    width: 100%;
    background: var(--bg-canvas);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    /* bm: box-shadow omitted — token layer owns elevation */
    row-gap: var(--flow-spacing);
  }
}
</style>
