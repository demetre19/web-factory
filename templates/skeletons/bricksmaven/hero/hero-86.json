   "settings": {
    "_display": "none",
    "cssCode": "@media (min-width:991px) {\n\n.bm-hero-86__container {\n  grid-template-columns: var(--grid-2-1);\n}\n\n.bm-hero-86__media-wrapper {\n  order:-1;\n}\n\n}\n\n.bm-hero-86-image-wrapper:nth-child(1) {\n  grid-column:17/-1;\n  grid-row:1/12;\n  border-start-start-radius: unset;\n  border-start-end-radius: var(--radius-50);\n  border-end-start-radius: var(--radius-xxl);\n  border-end-end-radius: unset;\n}\n\n.bm-hero-86-image-wrapper:nth-child(2) {\n  grid-column:17/-1;\n  grid-row:12/-1;\n  border-start-end-radius: var(--radius-xxl);\n  border-end-start-radius: var(--radius-xxl);\n}\n\n.bm-hero-86-image-wrapper:nth-child(3) {\n  grid-column:10/17;\n  grid-row:3/16;\n  border-start-start-radius: var(--radius-50);\n  border-start-end-radius: unset;\n}\n\n.bm-hero-86-image-wrapper:nth-child(4) {\n  grid-column:10/17;\n  grid-row:16/-1;\n  border-radius: var(--radius-xxl);\n}\n\n.bm-hero-86-image-wrapper:nth-child(5) {\n  grid-column:1/10;\n  grid-row:9/-1;\n  border-start-start-radius: var(--radius-50);\n  border-start-end-radius: unset;\n  border-end-start-radius: var(--radius-50);\n  border-end-end-radius: unset;\n}"
   },
   "label": "Reverse Items"
