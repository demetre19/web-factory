 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-hero-80__container">
    <div class="bm-hero-80__intro">
      <h1 class="bm-hero-80__heading">For 15 years we have been helping service-based businesses grow online</h1>
      <p class="bm-hero-80__text">Lorem ipsum dolor sit amet. At eaque fugiat id autem voluptatum ea earum illo. Non excepturi similique qui quia nihil eos suscipit nihil aut dignissimos blanditiis et sunt aliquid aut nemo inventore est sequi aliquam?</p>
    </div>
  </div>
  <div class="bm-hero-80__bottom-container">
    <div class="bm-hero-80__media">
      <figure class="bm-hero-80__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
    </div>
    <div class="bm-hero-80__content">
      <div class="bm-hero-80-data-list list--none">
        {items.map((it) => (
          <div class="bm-hero-80-data-card">
            <div class="bm-hero-80-data-card__top">
              <p class="bm-hero-80-data-card__number">{it.text}</p>
              <p class="bm-hero-80-data-card__sign">{it.text}</p>
            </div>
            <p class="bm-hero-80-data-card__meta">{it.text}</p>
          </div>
        ))}
      </div>
      <p class="bm-hero-80__content-text">Qui ipsum nisi cum voluptas praesentium est minus autem ut mollitia nostrum? Et facilis quia et enim nisi ut odio molestiae.</p>
      <a class="bm-hero-80__content-link" href="#">Free consultation</a>
    </div>
  </div>
</div>

<style is:global>
