            </div>
          </div>
          <p class="bm-off-canvas-6__contact-address">10333 Freeman Ave Ste 1000, Boston TX 34542, USA</p>
        </div>
        <div class="bm-off-canvas-6__socials">
          <div class="bm-social-share list--none bm-social-share--column">
            {items.map((it) => (
              <div class="bm-social-share__icon-wrapper">
                <span class="bm-social-share__icon" data-icon="lucide" aria-hidden="true"></span>
              </div>
            ))}
          </div>
          <p class="bm-off-canvas-6__social-heading">Social</p>
        </div>
      </div>
      <div class="bm-off-canvas-6__backdrop"></div>
    </div>
  </div>
</div>

