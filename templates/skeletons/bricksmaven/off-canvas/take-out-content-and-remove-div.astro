---

<div>
  <div>
    <div class="bm-off-canvas-6__toggle"></div>
    <div class="bm-off-canvas-6">
      <div class="bm-off-canvas-6__content">
        <div class="bm-off-canvas-6__close"></div>
        <h2 class="bm-off-canvas-6__heading">Menu</h2>
        <div class="bm-off-canvas-nav-ul list--none">
          {items.map((it) => (
            <div class="bm-off-canvas-nav-li">
              <a class="bm-off-canvas-nav-li__link bm-off-canvas-nav-li__link--larger" href="#">{it.text}</a>
