}
import { inline } from '../_shared/inline';
import { Image } from 'astro:assets';
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
  image,
  copy,
  h1 = false,
} = Astro.props;
// §4.3 — a copy slot binds verbatim article copy onto
