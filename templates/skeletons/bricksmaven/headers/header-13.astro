          {list.length > 6 && <nav class="nav-links nav-mega" aria-label="Primary"><div class="nav-sheet-head"><span class="logo nav-sheet-brand">{brand}</span><button class="nav-close" type="button" aria-label="Close menu">×</button></div><form class="nav-search" role="search"><input class="nav-search-input" type="search" placeholder="Search" aria-label="Search site" /></form><div class="nav-mega-cols">{[list.slice(0, Math.ceil(list.length / 2)), list.slice(Math.ceil(list.length / 2))].map((grp, gi) => (<div class="nav-group"><p class="nav-group-head">{'Menu ' + (gi + 1)}</p><ul class="row gap-fluid-m list-plain">{grp.map((it, i) => <li><a class="nav-link" href={it.href}><span>{it.label || it.term || it.title || it.text}</span><span class="nav-num" aria-hidden="true">{String((gi > 0 ? Math.ceil(list.length / 2) : 0) + i + 1).padStart(2, '0')}</span></a></li>)}</ul></div>))}</div></nav>}
