---
/**
 * bm-header-21 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (header-21.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <span class="logo">{brand}</span>
  <div class="sec-inner">
    <div class="header-21__container row between">
      <div class="header-21__nav">
        <div></div>
      </div>
      <div class="header-21__brand">
        <figure class="ratio-portrait"><img src="/media/placeholder.svg" alt="Image" loading="lazy" width="900" height="600" /></figure>
      </div>
      <div class="header-21__cta row between">
        <span data-icon="lucide" aria-hidden="true"></span>
        <div class="row between">
          <div></div>
          <div>
            <div class="bm-off-canvas-6__content row between">
              <div></div>
              {heading && <h2 class="text-fluid-2">{heading}</h2>}
              <div class="bm-off-canvas-nav-ul row between">
                <div class="row gap-fluid-m">
                  {(items || []).map((it) => (
                    <div>
                      <a class="text-fluid-0" href={it.href}>{it.label}</a>
                    </div>
                  ))}
                </div>
              </div>
              <div class="bm-off-canvas-6__contact-footer row between">
                <div class="bm-off-canvas-contact row between">
                  <div class="row gap-fluid-m">
                    {(items || []).map((it) => (
                      <div class="bm-off-canvas-contact-item row between">
                        <div>
                          <span data-icon="lucide" aria-hidden="true"></span>
                        </div>
                        <a class="text-fluid-0" href={it.href}>{it.label}</a>
                      </div>
                    ))}
                  </div>
                </div>
                {fs && <p class="bm-off-canvas-6__contact-address text-fluid-0">{fs}</p>}
              </div>
              <div class="bm-off-canvas-6__socials row between">
                <div class="bm-social-share bm-social-share--column row between">
                  <div class="row gap-fluid-m">
                    {(items || []).map((it) => (
                      <div>
                        <span data-icon="lucide" aria-hidden="true"></span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
            <div></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
