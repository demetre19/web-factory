---
/**
 * bm-header-7 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (header-7.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string; term?: string;
             label?: string; href?: string;
             icon?: string; items?: any[] }[];
  image?: { src: string; alt: string };
  copy?: any;
}
import { inline } from '../_shared/inline';
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
  image,
  copy,
} = Astro.props;
// §4.3 — a copy slot binds verbatim article copy onto
// the skeleton's native props (F.1 — nothing dropped)
const cp = copy || {};
const head = cp.heading || heading;
const sub = cp.answer || cp.text || fs;
const before = cp.before || [];
const list = (cp.items && cp.items.length
  ? cp.items : items) || [];
const qas = cp.qa || [];
const links = cp.links || [];
const after = cp.after || [];
const act = cp.cta || cta;
const phone = cp.phone || '';
const tel = phone ? 'tel:' + phone.replace(/[^0-9+]/g, '') : '';
---

<div class="wf-header-7">
  {sub && <p class="mt-stack lede" set:html={inline(sub)} />}
  {before.map((p) => <p class="mt-stack text-fluid-0" set:html={inline(p)} />)}
  <div class="sec-inner">
    <div class="bm-header-7__topbar row between">
      {list.length > 0 && <nav class="nav-links" aria-label="Primary"><ul class="row gap-fluid-m list-plain">{(list || []).map((it) => <li><a class="nav-link" href={it.href}>{it.label || it.term || it.title || it.text}</a></li>)}</ul></nav>}
      {list.length > 0 && <button class="burger wf-cta-button" type="button" aria-label="Menu">Menu</button>}
      {list.length > 0 && <nav class="nav-links" aria-label="Primary"><ul class="row gap-fluid-m list-plain">{(list || []).map((it) => <li><a class="nav-link" href={it.href}>{it.label || it.term || it.title || it.text}</a></li>)}</ul></nav>}
      {list.length > 0 && <button class="burger wf-cta-button" type="button" aria-label="Menu">Menu</button>}
    </div>
    <div class="bm-header-7__container row between">
      <div>
        <span class="logo brand-mark">{brand}</span>
      </div>
      <div class="bm-header-7__nav-wrapper">
        {list.length > 0 && <nav class="nav-links" aria-label="Primary"><ul class="row gap-fluid-m list-plain">{(list || []).map((it) => <li><a class="nav-link" href={it.href}>{it.label || it.term || it.title || it.text}</a></li>)}</ul></nav>}
        {list.length > 0 && <button class="burger wf-cta-button" type="button" aria-label="Menu">Menu</button>}
      </div>
      <div class="bm-header-7__cta-wrapper row between">
        {act.label && <p class="mt-fluid-m"><a class="wf-cta-button nav-cta" href={act.href}>{act.label}</a></p>}
        {act.label && <p class="mt-fluid-m"><a class="wf-cta-button nav-cta" href={act.href}>{act.label}</a></p>}
      </div>
    </div>
  </div>
  {qas.length > 0 && <dl class="mt-stack">{qas.map((qa) => <><dt class="text-fluid-0" set:html={inline(qa.q)} /><dd class="text-fluid-0" set:html={inline(qa.a)} /></>)}</dl>}
  {links.map((l) => <p class="mt-stack text-fluid-0" set:html={inline(l.text || `[${l.anchor}](${l.href})`)} />)}
  {after.map((p) => <p class="mt-stack text-fluid-0" set:html={inline(p)} />)}
  {tel && <p class="mt-stack"><a class="link-quiet" href={tel}>{phone}</a></p>}
</div>
