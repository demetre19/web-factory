              </div>
            </div>
            <a class="btn--primary wf-cta-button" href={it.href}>{it.label}</a>
          </div>
          <div class="bm-event-section-7-event-card__media">
            <figure class="bm-event-section-7-event-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            <div class="bm-event-section-5__meta-placement">
