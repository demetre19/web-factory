---
/**
 * bm-event-section-7 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (event-section-7.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-event-section-7__container">
      <div class="bm-event-section__intro">
        {heading && <h2 class="text-fluid-2">{heading}</h2>}
        <p class="mt-fluid-m"><a class="wf-cta-button" href={cta.href}>{cta.label || 'Continue'}</a></p>
      </div>
      <div class="bm-event-section-7-event-list">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="bm-event-section-7-event-card card">
              <div class="bm-event-section-7-event-card__date">
                <p class="text-fluid-0">{it.text}</p>
                <p class="text-fluid-0">{it.text}</p>
                <p class="text-fluid-0">{it.text}</p>
              </div>
              <div class="bm-event-section-7-event-card__content">
                <h2 class="text-fluid-2">{it.title}</h2>
                <div class="bm-event-section-7-event-card__details-wrapper">
                  <p class="text-fluid-0">{it.text}</p>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
                <div class="bm-event-section-7-card__speaker-wrapper">
                  <p class="text-fluid-0">{it.text}</p>
                  <div class="bm-event-speaker-list">
                    <div class="grid-auto gap-fluid-m">
                      {((it.items || []) || []).map((it2) => (
                        <div class="card">
                          <figure class="bm-event-speaker-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
              <div class="grid-auto gap-fluid-l">
                <figure class="bm-event-section-7-event-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                <div>
                  <div class="bm-event-meta-info">
                    <span data-icon="lucide" aria-hidden="true"></span>
                    <p class="text-fluid-0">{it.text}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
