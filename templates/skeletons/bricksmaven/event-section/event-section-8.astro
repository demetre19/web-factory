---
/**
 * bm-event-section-8 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (event-section-8.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-event-section-8__container">
    <div class="bm-event-section__intro">
      <h2 class="bm-event-section__heading">{heading}</h2>
      <a class="btn--primary bm-event-section__cta wf-cta-button" href={cta.href}>{cta.label}</a>
    </div>
    <div class="bm-event-section-8__event-list">
      <div class="bm-event-section-8-slider">
        {items.map((it) => (
          <div class="bm-event-section-8-card">
            <div class="bm-event-section-8-card__date">
              <p class="bm-event-section-8-card__day-week">{it.text}</p>
              <p class="bm-event-section-8-card__day">{it.text}</p>
              <p class="bm-event-section-8-card__month-year">{it.text}</p>
            </div>
            <div class="bm-event-section-8-card__content">
              <div class="bm-event-section-8-card__head">
                <h2 class="bm-event-section-8-card__heading clickable-parent">{it.title}</h2>
                <p class="bm-event-section-8-card__pricing">{it.text}</p>
              </div>
              <div class="bm-event-section-1-card__mid--alt">
                <div class="bm-event-section-1-card__date--alt">
                  <div class="bm-event-section-1-card__icon-wrapper--alt">
                    <span class="bm-event-section-1-card__icon--alt" data-icon="lucide" aria-hidden="true"></span>
                  </div>
                  <div class="bm-event-section-1-card__date-time--alt">
                    <div class="bm-event-section-1-card__date-wrapper--alt">
                      <p class="bm-event-section-1-card__date-text--alt">{it.text}</p>
                    </div>
                    <div class="bm-event-section-1-card__time-wrapper--alt">
                      <p class="bm-event-section-1-card__time--alt">{it.text}</p>
                    </div>
                  </div>
                </div>
                <div class="bm-event-section-1-card__location--alt">
                  <div class="bm-event-section-1-card__icon-wrapper--alt">
                    <span class="bm-event-section-1-card__icon--alt" data-icon="lucide" aria-hidden="true"></span>
                  </div>
                  <p class="bm-event-section-1-card__location-text--alt">{it.text}</p>
                </div>
              </div>
              <div class="bm-event-section-8-card__footer">
                <a class="bm-event-section-8-card__btn btn--white wf-cta-button" href={it.href}>{it.label}</a>
                <div class="bm-event-section-8__fav-placement">
                  <div class="bm-event-hart-molecule">
                    <span class="bm-event-hart-molecule__unactive" data-icon="lucide" aria-hidden="true"></span>
                  </div>
                  <div class="bm-event-hart-molecule-active">
                    <span class="bm-event-hart-molecule-active__icon" data-icon="lucide" aria-hidden="true"></span>
                  </div>
                </div>
              </div>
            </div>
            <figure class="bm-event-section-8-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-event-section-8__container {
