                  <div>
                    <div class="grid-auto gap-fluid-m">
                      {(items || []).map((it) => (
                        <div class="card">
                          <div class="bm-event-section-table__td">
                            <p class="text-fluid-0">{it.text}</p>
                          </div>
                          <div class="bm-event-section-table__td">
                            <p class="text-fluid-0">{it.text}</p>
