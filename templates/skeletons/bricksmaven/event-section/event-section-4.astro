---
/**
 * bm-event-section-4 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (event-section-4.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-event-section-4__container">
    <div class="bm-event-section__intro">
      <h2 class="bm-event-section__heading">New events in your city</h2>
      <a class="btn--primary bm-event-section__cta wf-cta-button" href={cta.href}>{cta.label}</a>
    </div>
    <div class="bm-event-section-4-list list--none">
      {items.map((it) => (
        <div class="bm-event-section-4-card">
          <div class="bm-event-section-4-card__content">
            <div class="bm-event-meta-info bm-event-meta-info--alt">
              <span class="bm-event-meta-info__icon" data-icon="lucide" aria-hidden="true"></span>
              <p class="bm-event-meta-info__location">{it.text}</p>
            </div>
            <div class="bm-event-section-4-card__heading-wrapper">
              <h2 class="bm-event-section-4-card__heading">{it.title}</h2>
              <p class="bm-event-section-4-card__text">{it.text}</p>
            </div>
            <div class="bm-event-section-4-card__speaker-wrapper">
              <p class="bm-event-section-4-card__speaker-label">{it.text}</p>
              <div class="bm-event-speaker-list list--none">
                {(it.items || []).map((it2) => (
                  <div class="bm-event-speaker-card">
                    <figure class="bm-event-speaker-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                  </div>
                ))}
              </div>
            </div>
            <div class="bm-event-section-4-card__footer">
              <a class="btn--primary wf-cta-button" href={it.href}>{it.label}</a>
            </div>
            <div class="bm-event-section-4___fav-placement">
              <div class="bm-event-hart-molecule">
                <span class="bm-event-hart-molecule__unactive" data-icon="lucide" aria-hidden="true"></span>
              </div>
              <div class="bm-event-hart-molecule-active">
                <span class="bm-event-hart-molecule-active__icon" data-icon="lucide" aria-hidden="true"></span>
              </div>
            </div>
          </div>
          <div class="bm-event-section-4__media">
            <figure class="bm-event-section-4__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            <div class="bm-event-section-4__meta-placement">
              <div class="bm-event-meta-info">
                <span class="bm-event-meta-info__icon" data-icon="lucide" aria-hidden="true"></span>
                <p class="bm-event-meta-info__location">{it.text}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
@layer components {
  .bm-event-section-4__container {
    row-gap: var(--space-s);
  }

  .bm-event-section__intro {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: space-between;
    align-items: center;
  }

  .bm-event-section-4-list {
    row-gap: var(--flow-spacing);
  }

  .bm-event-section-4-card {
    display: grid;
    grid-template-columns: calc(100% * 1 / 2);
  }

  .bm-event-section-4-card__content {
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    row-gap: var(--flow-spacing);
    position: relative;
    border-top: 1 solid var(--bg-subtle);
    border-right: 1 solid var(--bg-subtle);
    border-bottom: 1 solid var(--bg-subtle);
    justify-content: center;
  }

  .bm-event-meta-info {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    column-gap: calc(var(--flow-spacing) / 4);
    background: var(--bg-subtle);
    padding: calc(var(--space-xs) / 2) calc(var(--space-xs) / 2) calc(var(--space-xs) / 2) calc(var(--space-xs) / 2);
  }

  .bm-event-meta-info--alt {
    padding: 0 0 0 0;
    background: transparent;
    width: auto;
  }

  .bm-event-section-4-card__heading-wrapper {
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-event-section-4-card__speaker-wrapper {
    flex-direction: row;
    align-items: center;
    column-gap: calc(var(--flow-spacing) / 2);
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-event-section-4-card__speaker-label {
    font-weight: 700;
  }

  .bm-event-speaker-list {
    flex-direction: row;
    flex-wrap: nowrap;
  }

  .bm-event-speaker-card__image {
    width: 48;
    height: 48;
    border-top: 1 solid var(--bg-canvas);
    border-right: 1 solid var(--bg-canvas);
    border-bottom: 1 solid var(--bg-canvas);
    border-left: 1 solid var(--bg-canvas);
    border-radius: 100% 100% 100% 100%;
  }

  .bm-event-section-4___fav-placement {
    position: absolute;
    right: var(--space-m);
    top: var(--space-m);
  }

  .bm-event-hart-molecule {
    width: 40px;
    height: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-top: 1 solid var(--bg-subtle);
    border-right: 1 solid var(--bg-subtle);
    border-bottom: 1 solid var(--bg-subtle);
    border-left: 1 solid var(--bg-subtle);
    border-radius: 100% 100% 100% 100%;
    background: var(--bg-canvas);
  }

  .bm-event-hart-molecule-active {
    width: 40px;
    height: 40px;
    justify-content: center;
    align-items: center;
    border-top: 1 solid var(--bg-subtle);
    border-right: 1 solid var(--bg-subtle);
    border-bottom: 1 solid var(--bg-subtle);
    border-left: 1 solid var(--bg-subtle);
    border-radius: 100% 100% 100% 100%;
    background: var(--text-secondary);
    display: none;
  }

  .bm-event-section-4__media {
    position: relative;
  }

  .bm-event-section-4__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bm-event-section-4__meta-placement {
    position: absolute;
    top: var(--space-s);
    left: var(--space-s);
  }

  /* bm-custom */
  .bm-event-speaker-card:not(:first-child) {
    margin-inline-start: calc(-1 * (var(--space-xs) / 3));
  }
}
</style>
