              </div>
              <div class="bm-event-section-10-card__footer">
                <p class="bm-event-section-10-card__text">{it.text}</p>
                <a class="btn--white wf-cta-button" href={it.href}>{it.label}</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

