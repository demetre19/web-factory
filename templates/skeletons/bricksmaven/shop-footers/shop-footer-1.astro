---
/**
 * bm-shop-footer-1 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (shop-footer-1.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-shop-footer-1__usp-container">
      <div class="bm-usp-1-list">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="bm-usp-1-list-card card">
              <div class="bm-usp-1-list-card__icon-wrapper">
                <span data-icon="lucide" aria-hidden="true"></span>
              </div>
              <div class="bm-usp-1-list-card__content">
                <h2 class="text-fluid-2">{it.title}</h2>
                <p class="text-fluid-0">{it.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="bm-shop-footer-1__container">
      <div class="bm-shop-footer-1__content">
        {heading && <h2 class="text-fluid-2">{heading}</h2>}
        {fs && <p class="text-fluid-0">{fs}</p>}
        <form novalidate>
        </form>
      </div>
      <div class="bm-shop-footer-1__nav">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="bm-footer-nav-column card">
              <h3 class="text-fluid-2">{it.title}</h3>
              <div class="bm-footer-menu">
                <div class="grid-auto gap-fluid-m">
                  {((it.items || []) || []).map((it2) => (
                    <div class="card">
                      <a class="text-fluid-0" href={it2.href}>{it2.label}</a>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="bm-shop-footer-1__bottom-container">
      <div class="bm-shop-footer-1__footer">
        <div>
          <div class="bm-social-share bm-social-share--right">
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="card">
                  <span data-icon="lucide" aria-hidden="true"></span>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div></div>
        <div class="bm-payment-options">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="card">
                <figure class="bm-footer-option__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
