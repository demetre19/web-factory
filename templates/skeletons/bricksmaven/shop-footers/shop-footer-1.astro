  }

  .bm-social-share {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    column-gap: var(--flow-spacing);
  }

  .bm-social-share--right {
    justify-content: flex-end;
  }

  .bm-footer-copyright {
    font-size: var(--fs-0);
  }

  .bm-payment-options {
    display: flex;
    flex-wrap: nowrap;
    column-gap: var(--flow-spacing);
    flex-direction: row;
    width: auto;
  }

  .bm-footer-option__image {
    object-fit: contain;
    width: 32;
    height: 32;
  }

  /* bm-custom */
  .bm-footer-newsletter__form {
  	flex-wrap: nowrap;
    gap: 1rem;
  }
  .bm-footer-newsletter__form [type="submit"] {
  	height: 100%;
  }
}
</style>
