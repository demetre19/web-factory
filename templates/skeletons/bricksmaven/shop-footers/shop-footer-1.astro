---
/**
 * bm-shop-footer-1 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (shop-footer-1.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string; term?: string;
             label?: string; href?: string;
             icon?: string; items?: any[] }[];
  image?: { src: string; alt: string };
  copy?: any;
}
import { inline } from '../_shared/inline';
import IconChip from '../_shared/IconChip.astro';
import { Image } from 'astro:assets';
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
  image,
  copy,
} = Astro.props;
// §4.3 — a copy slot binds verbatim article copy onto
// the skeleton's native props (F.1 — nothing dropped)
const cp = copy || {};
const head = cp.heading || heading;
const sub = cp.answer || cp.text || fs;
const before = cp.before || [];
const list = (cp.items && cp.items.length
  ? cp.items : items) || [];
const qas = cp.qa || [];
const links = cp.links || [];
const after = cp.after || [];
const act = cp.cta || cta;
const phone = cp.phone || '';
const tel = phone ? 'tel:' + phone.replace(/[^0-9+]/g, '') : '';
// V.8/P.12 — rasters resolve through src/assets/media/
// so <Image> compiles AVIF/WebP srcsets
const _media = import.meta.glob('../assets/media/*.{jpg,jpeg,png,webp}', { eager: true });
const _mn = image ? String(image.src).split('/').pop() : null;
const mediaSrc = _mn ? (_media[`../assets/media/${_mn}`]?.default ?? null) : null;
---

<div>
  <div class={image && image.src ? 'split' : undefined}>
    <div class="stack">
  <div class="sec-inner">
    {list.length > 0 &&     <div class="bm-shop-footer-1__usp-container">
      {list.length > 0 &&       <div class="bm-usp-1-list">
        {list.length > 0 && <div class="grid-auto gap-fluid-m">{(list || []).map((it) => (
            <div class="bm-usp-1-list-card card">
              <div class="bm-usp-1-list-card__icon-wrapper">
                {it.icon && <IconChip name={it.icon} />}
              </div>
              <div class="bm-usp-1-list-card__content">
                <h3 class="text-fluid-2">{it.icon && <IconChip name={it.icon} />} {it.term || it.title}</h3>
                <p class="text-fluid-0">{it.text}</p>
              </div>
            </div>
          ))}</div>}
      </div>
      }
    </div>
    }
    <div class="bm-shop-footer-1__container">
      <div class="bm-shop-footer-1__content">
        {head && <h2 class="text-fluid-2">{head}</h2>}
        {sub && <p class="text-fluid-0" set:html={inline(sub)} />}
        {before.map((p) => <p class="mt-stack text-fluid-0" set:html={inline(p)} />)}
        <form novalidate>
        </form>
      </div>
      {links.length > 0 &&       <div class="bm-shop-footer-1__nav">
        {links.length > 0 && <div class="grid-auto gap-fluid-m">{(links || []).map((it) => (
            <div class="bm-footer-nav-column card">
              <h3 class="text-fluid-2">{it.icon && <IconChip name={it.icon} />} {it.term || it.title}</h3>
              {(it.items || []).length > 0 &&               <div class="bm-footer-menu">
                {(it.items || []).length > 0 && <div class="grid-auto gap-fluid-m">{((it.items || []) || []).map((it2) => (
                    <div class="card">
                      <a class="text-fluid-0" href={it2.href}>{it2.label || it2.anchor || it2.text}</a>
                    </div>
                  ))}</div>}
              </div>
              }
            </div>
          ))}</div>}
      </div>
      }
    </div>
    {links.length > 0 &&     <div class="bm-shop-footer-1__bottom-container">
      {links.length > 0 &&       <div class="bm-shop-footer-1__footer">
        {links.length > 0 &&         <div>
          {links.length > 0 &&           <div class="bm-social-share bm-social-share--right">
            {links.length > 0 && <div class="grid-auto gap-fluid-m">{(links || []).map((it) => (
                <div class="card">
                  {it.icon && <IconChip name={it.icon} />}
                </div>
              ))}</div>}
          </div>
          }
        </div>
        }
      </div>
      }
    </div>
    }
  </div>
    </div>
    {image && image.src && <div class="media-round" data-ratio={image.ratio || null}><Image src={mediaSrc || image.src} alt={image.alt || ''} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 50vw, 100vw" width={900} height={600} loading="lazy" /></div>}
  </div>
  {qas.length > 0 && <dl class="mt-stack">{qas.map((qa) => <><dt class="text-fluid-0" set:html={inline(qa.q)} /><dd class="text-fluid-0" set:html={inline(qa.a)} /></>)}</dl>}
  {links.map((l) => <p class="mt-stack text-fluid-0" set:html={inline(l.text || `[${l.anchor}](${l.href})`)} />)}
  {after.map((p) => <p class="mt-stack text-fluid-0" set:html={inline(p)} />)}
  {tel && <p class="mt-stack"><a class="link-quiet" href={tel}>{phone}</a></p>}
</div>
