---
/**
 * bm-shop-footer-1 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (shop-footer-1.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-shop-footer-1__usp-container">
    <div class="bm-usp-1-list list--none">
      {items.map((it) => (
        <div class="bm-usp-1-list-card">
          <div class="bm-usp-1-list-card__icon-wrapper">
            <span class="bm-usp-1-list-card__icon" data-icon="lucide" aria-hidden="true"></span>
          </div>
          <div class="bm-usp-1-list-card__content">
            <h2 class="bm-usp-1-list-card__heading">{it.title}</h2>
            <p class="bm-usp-1-list-card__text">{it.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="bm-shop-footer-1__container">
    <div class="bm-shop-footer-1__content">
      <h2 class="bm-shop-footer-1__heading">Stay in the know</h2>
      <p class="bm-shop-footer-1__text">Sign up for our newsletter and receive 10% off your first order!</p>
      <form class="bm-footer-newsletter__form" novalidate>
      </form>
    </div>
    <div class="bm-shop-footer-1__nav">
      {items.map((it) => (
        <div class="bm-footer-nav-column">
          <h3 class="bm-footer-nav-heading">{it.title}</h3>
          <div class="bm-footer-menu list--none">
            {(it.items || []).map((it2) => (
              <div class="bm-footer-menu__link">
                <a class="bm-footer-menu__link-text" href="#">{it2.text}</a>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="bm-shop-footer-1__bottom-container">
    <div class="bm-shop-footer-1__footer">
      <div class="bm-footer-social-wrapper">
        <div class="bm-social-share list--none bm-social-share--right">
          {items.map((it) => (
            <div class="bm-social-share__icon-wrapper">
              <span class="bm-social-share__icon" data-icon="lucide" aria-hidden="true"></span>
            </div>
          ))}
        </div>
      </div>
      <div class="bm-footer-bottom__copyright">
        <p class="bm-footer-copyright">© {current_date:Y} Alpha. All right reserved.</p>
      </div>
      <div class="bm-payment-options list--none">
        {items.map((it) => (
          <div class="bm-footer-option">
            <figure class="bm-footer-option__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style is:global>
@layer components {
  .bm-shop-footer-1__usp-container {
    padding: var(--space-xl) var(--section-space-s) var(--space-xl) var(--section-space-s);
    border-top: 1 solid var(--color-line-default);
    border-bottom: 1 solid var(--color-line-default);
    width: 100vw;
    margin: 0 0 0 -50vw;
    left: 50%;
    position: relative;
    align-items: center;
  }

  .bm-usp-1-list {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 4);
    width: var(--content-width);
  }

  .bm-usp-1-list-card {
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    row-gap: var(--flow-spacing);
    align-items: center;
  }

  .bm-usp-1-list-card__icon-wrapper {
    padding: var(--space-s) var(--space-s) var(--space-s) var(--space-s);
    border-top: 1 solid var(--bg-subtle);
    border-right: 1 solid var(--bg-subtle);
    border-bottom: 1 solid var(--bg-subtle);
    border-left: 1 solid var(--bg-subtle);
    border-radius: 100% 100% 100% 100%;
  }

  .bm-usp-1-list-card__content {
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    justify-content: center;
    text-align: center;
  }

  .bm-usp-1-list-card__heading {
    font-size: var(--fs-1);
  }

  .bm-shop-footer-1__container {
    display: grid;
    grid-template-columns: calc(100% * 3 / 1);
  }

  .bm-shop-footer-1__content {
    display: flex;
    flex-direction: column;
    row-gap: var(--flow-spacing);
    padding: var(--section-space-xxl) var(--space-m) var(--section-space-xxl) 0;
  }

  .bm-shop-footer-1__nav {
    display: grid;
    gap: var(--space-m);
