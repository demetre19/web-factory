   "custom_css": "/* Thank you element  */\n.bm-thank-you-3__element {\n  display: grid;\n  grid-template-columns: var(--grid-2);\n  align-items: start;\n  gap: var(--grid-gap);\n}\n\n\n/* RESET */\n.woocommerce-checkout .shop_table td, .woocommerce-checkout .shop_table th {\n    line-height: 1;\n}\n\n\n/* Woocommerce Notice  */\n.bm-thank-you-3__element .woocommerce-notice {\n  font-size: calc(var(--text-xxl) * 1.4);\n  font-weight: 700;\n  grid-column: span 2;\n  grid-row: auto;\n  display: flex;\n  align-items: start;\n  text-align: left;\n  max-width: var(--width-l);\n}\n\n/* Woocommerce Order Overview  */\n.bm-thank-you-3__element ul.woocommerce-order-overview {\n  grid-column: span 2;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  position: relative;\n  margin-block-start: var(--space-xl);\n}\n\n.bm-thank-you-3__element ul.woocommerce-order-overview::before {\n  content: 'Order overview';\n  position: absolute;\n  font-size: var(--h2);\n  \n  line-height: var(--heading-line-height);\n  font-weight: 700;\n  inset-block-start: calc(-1 * var(--space-xl));\n}\n\n/* Woocommerce Order Details  */\n.bm-thank-you-3__element .woocommerce-order-details {\n  grid-column: span 1;\n  display: flex;\n  flex-direction: column;\n  gap: var(--content-gap);\n  order: 4;\n}\n\n.bm-thank-you-3__element .woocommerce-table__product-name {\n  font-weight: 700; /* Style font-weight price name */ \n}\n\n.bm-thank-you-3__element .woocommerce-Price-amount {\n  font-weight: 400; /* Style font-weight price amount */ \n}\n\n/* Woocommerce Customer Details  */\n.bm-thank-you-3__element .woocommerce-customer-details {\n  grid-column: span 1;\n  margin-block: 0px;\n  background-color: var(--neutral-ultra-light);\n border: 1px solid var(--neutral-light);\n  order: 3;\n}\n\n.bm-thank-you-3__element .woocommerce-customer-details .woocommerce-columns--addresses{\n    flex-direction: column;\n  gap: 0;\n  }\n\n.bm-thank-you-3__element .woocommerce-customer-details .woocommerce-column--billing-address, .bm-thank-you-3__element .woocommerce-customer-details .woocommerce-column--shipping-address {\n  display: flex;\n  flex-direction: column;\n  gap: var(--content-gap);\n  padding: var(--space-m);\n}\n\n\n@media (max-width:991px) {\n  /* Thank you element  */\n  .bm-thank-you-3__element {\n    grid-template-columns: var(--grid-1);\n  }\n  \n  /* Woocommerce Notice  */\n  .bm-thank-you-3__element .woocommerce-notice {\n    grid-column: span 1;\n  }\n  \n  /* Woocommerce Order Overview  */\n  .bm-thank-you-3__element ul.woocommerce-order-overview {\n    grid-column: span 1;\n    grid-row: auto;\n    grid-template-columns: repeat(1, minmax(0, 1fr));\n  }\n  \n  /* Woocommerce Order Details  */\n  .bm-thank-you-3__element .woocommerce-order-details {\n    grid-column: span 1;\n    grid-row: auto;\n  }\n  \n  /* Woocommerce Customer Details  */\n  .bm-thank-you-3__element .woocommerce-customer-details {\n    grid-column: span 1;\n    grid-row: auto;\n  }\n\n}\n",
