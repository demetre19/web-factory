 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-newsletter-11__container">
    <div class="bm-newsletter-11__newsletter">
      <div class="bm-newsletter-11__top">
        <h2 class="bm-newsletter-11__heading">{heading}</h2>
        <p class="bm-newsletter-11__text">{fs}</p>
      </div>
      <form class="bm-form-widget bm-form-widget--width" novalidate>
      </form>
      <div class="bm-review-widget bm-review-widget--center">
        <div class="bm-team-list list--none">
          {items.map((it) => (
            <div class="bm-team-media">
              <figure class="bm-team-media__image"><img src="/media/placeholder.svg" alt="Team Image" loading="lazy" width="900" height="600" /></figure>
            </div>
          ))}
        </div>
        <div class="bm-testimonial-38__star-ratings">
          <p class="bm-testimonial-38__meta-text">Join 1,400+ readers who are boosting their development speed!</p>
        </div>
      </div>
    </div>
    <div class="bm-testimonial-40-list bm-testimonial-40-list--alt list--none">
      {items.map((it) => (
        <div class="bm-testimonial-40-card bm-testimonial-40-card--alt">
          <div class="bm-testimonial-40-card__content">
            <div class="bm-testimonial-40-card__top">
              <div class="bm-testimonial-38-star-list list--none">
                {(it.items || []).map((it2) => (
                  <div class="bm-testimonial-38-star-li">
                    <span class="bm-testimonial-38-star-li__icon" data-icon="lucide" aria-hidden="true"></span>
                  </div>
                ))}
              </div>
              <p class="bm-testimonial-40-card__review-text">{it.text}</p>
            </div>
            <div class="bm-testimonial-40-card__client">
              <p class="bm-testimonial-40-card__name">{it.text}</p>
              <p class="bm-testimonial-40-card__title">{it.text}</p>
            </div>
          </div>
          <div class="bm-testimonial-40-card__media">
            <figure class="bm-testimonial-40-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

