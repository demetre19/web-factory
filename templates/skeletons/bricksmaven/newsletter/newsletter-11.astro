---
/**
 * bm-newsletter-11 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (newsletter-11.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-newsletter-11__container">
      <div class="bm-newsletter-11__newsletter">
        <div class="bm-newsletter-11__top">
          {heading && <h2 class="text-fluid-2">{heading}</h2>}
          {fs && <p class="text-fluid-0">{fs}</p>}
        </div>
        <form class="bm-form-widget bm-form-widget--width" novalidate>
        </form>
        <div class="bm-review-widget bm-review-widget--center">
          <div class="bm-team-list">
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="card">
                  <figure class="bm-team-media__image ratio-portrait"><img src="/media/placeholder.svg" alt="Team Image" loading="lazy" width="900" height="600" /></figure>
                </div>
              ))}
            </div>
          </div>
          <div class="bm-testimonial-38__star-ratings"></div>
        </div>
      </div>
      <div class="bm-testimonial-40-list bm-testimonial-40-list--alt">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="bm-testimonial-40-card card">
              <div class="bm-testimonial-40-card__content">
                <div class="bm-testimonial-40-card__top">
                  <div class="bm-testimonial-38-star-list">
                    <div class="grid-auto gap-fluid-m">
                      {((it.items || []) || []).map((it2) => (
                        <div class="card">
                          <span data-icon="lucide" aria-hidden="true"></span>
                        </div>
                      ))}
                    </div>
                  </div>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
                <div class="bm-testimonial-40-card__client">
                  <p class="text-fluid-0">{it.text}</p>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
              </div>
              <div>
                <figure class="bm-testimonial-40-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
