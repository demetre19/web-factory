 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-newsletter-12__container">
    <div class="bm-newsletter-12__content">
      <div class="bm-newsletter-12__top">
        <h2 class="bm-newsletter-12__heading">Build, Grow & Earn your keep</h2>
        <p class="bm-newsletter-12__text">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
      </div>
      <div class="bm-newsletter-12__footer">
        <div class="bm-author-card">
          <div class="bm-author-card__media">
            <figure class="bm-author-card__thumb"><img src="/media/placeholder.svg" alt="Author thumb" loading="lazy" width="900" height="600" /></figure>
          </div>
          <p class="bm-author-card__text">Add an inspiring text about yourself and the community that will inspire a potential lead fill in the form.</p>
        </div>
      </div>
    </div>
    <div class="bm-newsletter-form-wrapper">
      <h2 class="bm-newsletter-form-wrapper__heading">Subscribe to the Bricksmaven newsletter</h2>
      <p class="bm-newsletter-form-wrapper__text">Add an inspiring text that will inspire a potential lead fill in the form.</p>
      <form class="bm-form-widget bm-form-widget--stacked" novalidate>
      </form>
      <div class="bm-review-widget bm-review-widget--stacked-centered">
        <div class="bm-team-list list--none">
          {items.map((it) => (
            <div class="bm-team-media">
              <figure class="bm-team-media__image"><img src="/media/placeholder.svg" alt="Team Image" loading="lazy" width="900" height="600" /></figure>
            </div>
          ))}
        </div>
        <div class="bm-testimonial-38__star-ratings">
          <p class="bm-testimonial-38__meta-text">Join 1,400+ readers who are boosting their development speed!</p>
        </div>
      </div>
    </div>
  </div>
  <div>
    <div class="bm-hero-75-logo-ul list--none">
      {items.map((it) => (
        <div class="bm-hero-75-logo-item">
          <figure class="bm-hero-75-logo-item__brand"><img src="/media/placeholder.svg" alt="Brand" loading="lazy" width="900" height="600" /></figure>
        </div>
      ))}
    </div>
  </div>
</div>

