---
/**
 * bm-newsletter-12 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (newsletter-12.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-newsletter-12__container">
      <div class="bm-newsletter-12__content">
        <div class="bm-newsletter-12__top">
          {heading && <h2 class="text-fluid-2">{heading}</h2>}
          {fs && <p class="text-fluid-0">{fs}</p>}
        </div>
        <div class="bm-newsletter-12__footer">
          <div class="bm-author-card">
            <div>
              <figure class="bm-author-card__thumb ratio-portrait"><img src="/media/placeholder.svg" alt="Author thumb" loading="lazy" width="900" height="600" /></figure>
            </div>
          </div>
        </div>
      </div>
      <div class="bm-newsletter-form-wrapper">
        <form class="bm-form-widget bm-form-widget--stacked" novalidate>
        </form>
        <div class="bm-review-widget bm-review-widget--stacked-centered">
          <div class="bm-team-list">
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="card">
                  <figure class="bm-team-media__image ratio-portrait"><img src="/media/placeholder.svg" alt="Team Image" loading="lazy" width="900" height="600" /></figure>
                </div>
              ))}
            </div>
          </div>
          <div class="bm-testimonial-38__star-ratings"></div>
        </div>
      </div>
    </div>
    <div>
      <div class="bm-hero-75-logo-ul">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="bm-hero-75-logo-item card">
              <figure class="bm-hero-75-logo-item__brand ratio-portrait"><img src="/media/placeholder.svg" alt="Brand" loading="lazy" width="900" height="600" /></figure>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
