---
/**
 * bm-coming-soon-2 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (coming-soon-2.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="coming-soon-2__container">
    <div class="bm-coming-soon-2__content">
      <div class="coming-soon__brand">
        <svg class="coming-soon-2__logo"></svg>
      </div>
      <div class="bm-coming-soon-2__intro">
        <h1 class="bm-coming-soon-2__heading">{heading}</h1>
        <p class="bm-coming-soon-2__text">{fs}</p>
        <div class="bm-form">
          <h2 class="bm-coming-soon__heading-form">Drop your email to get notified!</h2>
          <form class="bm-form-widget" novalidate>
          </form>
          <p class="bm-form__terms">Notify me when project is launched</p>
        </div>
      </div>
      <div class="bm-social-share list--none">
        {items.map((it) => (
          <div class="bm-social-share__icon-wrapper">
            <span class="bm-social-share__icon" data-icon="lucide" aria-hidden="true"></span>
          </div>
        ))}
      </div>
    </div>
    <div class="bm-coming-soon-2__media">
      <figure class="bm-coming-soon-2__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
    </div>
    <div></div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-coming-soon-2 {
    padding: 0 0 0 0;
    height: 100vh;
    overflow: hidden;
  }

  .coming-soon-2__container {
    display: grid;
    grid-template-columns: calc(100% * 1 / 2);
    height: 100vh;
  }

  .bm-coming-soon-2__content {
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: flex-start;
    text-align: left;
    row-gap: var(--flow-spacing);
    justify-content: space-between;
    padding: var(--space-m) 0 var(--space-m) 0;
  }

  .coming-soon__brand {
    position: relative;
    z-index: 1;
  }

  .coming-soon-2__logo {
    object-fit: contain;
  }

  .bm-coming-soon-2__intro {
    width: var(--measure);
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    row-gap: var(--flow-spacing);
  }

  .bm-form {
    display: flex;
    flex-direction: column;
    row-gap: var(--flow-spacing);
    width: 100%;
  }

  .bm-coming-soon__heading-form {
    font-size: var(--fs-1);
  }

  .bm-form-widget {
    display: flex;
    gap: var(--space-xs);
    flex-direction: row;
    align-items: center;
  }

  .bm-form__terms {
    font-size: var(--fs-0);
  }

  .bm-social-share {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    column-gap: var(--flow-spacing);
  }

  .bm-coming-soon-2__media {
    height: 100%;
    position: relative;
  }

  .bm-coming-soon-2__image {
    object-fit: cover;
    width: 50vw;
    height: 100%;
    position: absolute;
  }

  /* bm-custom */
  .bm-form-widget {
  flex-wrap: nowrap;
  }
  
  .bm-form-widget input:focus {
  	outline-offset: 0;
  } 
  
  .bm-form-widget button[type=submit].bricks-button {
      height: 100% !important;
  }
  
  .bm-form-widget .submit-button-wrapper {
      height: 100% !important;
  }
</style>
