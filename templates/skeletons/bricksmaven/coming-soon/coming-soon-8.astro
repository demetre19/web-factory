  	.bm-coming-soon-8__media-wrapper {
    	transform: translateX(-50%) translateY(0%) rotateZ(5deg);
  		top: 0%;
  	}
  
  
  }

  /* bm-custom */
  .bm-coming-soon-8__media:first-child {
  	grid-column: span 2;
    grid-row: span 2;
  }
}
</style>
