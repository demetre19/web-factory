  {
   "id": "jakxly",
   "name": "code",
   "parent": "fgsoao",
   "children": [],
   "settings": {
    "_display": "none",
    "cssCode": "/* Set section top padding to 0px*/\n.bm-header-page-11 {\n  padding-block-start: 0px;\n  overflow:hidden;\n}\n\n/* Set container padding inline(left and right padding) to 0px*/\n.bm-header-page-11__container {\n  padding-inline: 0px;\n}\n\n/* Stretch psuedo element to the edges of the screen */\n.bm-header-page-11__container::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left:50%;\n  width: 100vw;\n  max-width:100vw;\n  height: 50%;\n  margin-inline-start: -50vw;\n  background-color: var(--neutral-ultra-light);\n  z-index: -1;\n}"
   },
   "label": "Stretch Block"
  },
  {
   "id": "oepzgn",
   "name": "code",
   "parent": "fgsoao",
   "children": [],
   "settings": {
    "_display": "none",
    "cssCode": "@media (min-width:991px) {\n\n.bm-header-page-11__container {\n  grid-template-columns: var(--grid-2-1);\n}\n\n.bm-header-page-11__media {\n  order:-1;\n}\n\n}"
   },
   "label": "Flip columns"
  }
