---
/**
 * bm-delete-me — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (delete-me.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="sec-inner">
      <div class="footer-cta-container">
        <div class="footer-cta__content">
          {heading && <h2 class="text-fluid-2">{heading}</h2>}
          {fs && <p class="text-fluid-0">{fs}</p>}
          <p class="mt-fluid-m"><a class="wf-cta-button" href={cta.href}>{cta.label || 'Continue'}</a></p>
        </div>
        <div>
          <figure class="footer-cta__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
      </div>
    </div>
  </div>
  <div class="sec-inner">
    <div>
      <div class="footer-nav-wrapper">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="footer-nav-column card">
              <h3 class="text-fluid-2">{it.title}</h3>
              <div class="footer-menu">
                <div class="grid-auto gap-fluid-m">
                  {((it.items || []) || []).map((it2) => (
                    <div class="card">
                      <a class="text-fluid-0" href={it2.href}>{it2.label}</a>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="footer-14-bottom-container">
      <div class="footer-bottom__left">
        <div>
          <span class="logo">{brand}</span>
        </div>
        <div></div>
      </div>
      <div>
        <div class="footer-legal-nav">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="card">
                <a class="text-fluid-0" href={it.href}>{it.label}</a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
