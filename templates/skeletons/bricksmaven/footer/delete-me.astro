---

<div>
  <div class="footer-cta-container">
    <div class="footer-cta__content">
      <h2 class="footer-cta__heading">{heading}</h2>
      <p class="footer-cta__text">{fs}</p>
      <a class="btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
    </div>
    <div class="footer-cta__media">
      <figure class="footer-cta__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
    </div>
  </div>
  <div class="footer-14-container">
    <div class="footer-nav-wrapper">
      {items.map((it) => (
        <div class="footer-nav-column">
          <h3 class="footer-nav-heading">{it.title}</h3>
          <div class="footer-menu list--none">
            {(it.items || []).map((it2) => (
              <div class="footer-menu__link">
                <a class="footer-menu__link-text" href="#">{it2.text}</a>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="footer-14-bottom-container">
    <div class="footer-bottom__left">
      <div class="footer-brand">
        <img class="footer-brand__logo"></img>
      </div>
      <div class="footer-bottom__copyright">
        <p class="footer-copyright">© 2022 Alpha. All right reserved.</p>
      </div>
    </div>
    <div class="footer-nav-legal">
      <div class="footer-legal-nav list--none">
        {items.map((it) => (
          <div class="footer-legal__li">
            <a class="footer-legal__link-text" href="#">{it.text}</a>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

