---
/**
 * bm-footer-17 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (footer-17.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-footer-17__container row between">
      <div class="bm-footer-17__nav-wrapper">
        <div class="bm-footer-17-nav-menu row between">
          <div class="row gap-fluid-m">
            {(items || []).map((it) => (
              <div class="bm-footer-17-nav-list">
                <a class="text-fluid-0" href={it.href}>{it.label}</a>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="bm-footer-17__contact-info row between">
        <div class="row gap-fluid-m">
          {(items || []).map((it) => (
            <div class="bm-footer-17-address-list">
              <a class="text-fluid-0" href={it.href}>{it.label}</a>
            </div>
          ))}
        </div>
      </div>
      <div class="bm-footer-17__footer row between">
        <div class="bm-social-share bm-social-share--left-center row between">
          <div class="row gap-fluid-m">
            {(items || []).map((it) => (
              <div>
                <span data-icon="lucide" aria-hidden="true"></span>
              </div>
            ))}
          </div>
        </div>
        <div class="bm-footer-17__copyright-wrapper">
          {fs && <p class="text-fluid-0">{fs}</p>}
        </div>
        <div class="bm-footer-17__payment-option-wrapper">
          <div class="bm-footer-payment-options row between">
            <div class="row gap-fluid-m">
              {(items || []).map((it) => (
                <div>
                  <figure class="bm-footer-option__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
