---
/**
 * bm-footer-20 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (footer-20.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-footer-20__container row between">
      <div class="bm-footer-20__top row between">
        <div>
          <span class="logo">{brand}</span>
        </div>
        <div>
          <form novalidate>
          </form>
        </div>
      </div>
      <div class="bm-footer-20__content row between">
        <div class="bm-footer-20__left row between">
          <div class="bm-footer-20__left-top row between">
            {fs && <p class="text-fluid-0">{fs}</p>}
          </div>
          <div class="row between"></div>
          <div class="bm-footer-20__social-wrapper row between">
            {heading && <h2 class="text-fluid-2">{heading}</h2>}
            <div class="bm-social-share bm-social-share--left row between">
              <div class="row gap-fluid-m">
                {(items || []).map((it) => (
                  <div>
                    <span data-icon="lucide" aria-hidden="true"></span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
        <div>
          <div class="footer-nav-wrapper bm-footer-nav-wrapper--grid-2 row between">
            <div class="row gap-fluid-m">
              {(items || []).map((it) => (
                <div class="footer-nav-column row between">
                  <h3 class="text-fluid-2">{it.title}</h3>
                  <div class="footer-menu row between">
                    <div class="row gap-fluid-m">
                      {((it.items || []) || []).map((it2) => (
                        <div>
                          <a class="text-fluid-0" href={it2.href}>{it2.label}</a>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
      <div class="bm-footer-20__footer row between">
        <div></div>
        <div class="bm-footer-20__payment-options-wrapper">
          <div class="bm-footer-payment-options row between">
            <div class="row gap-fluid-m">
              {(items || []).map((it) => (
                <div>
                  <figure class="bm-footer-option__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
