---
/**
 * bm-footer-20 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (footer-20.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string; term?: string;
             label?: string; href?: string;
             icon?: string; items?: any[] }[];
  image?: { src: string; alt: string };
  images?: { src: string; alt: string }[];
  copy?: any;
  h1?: boolean;
}
import { inline } from '../_shared/inline';
import IconChip from '../_shared/IconChip.astro';
import { Image } from 'astro:assets';
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
  image,
  images = [],
  copy,
  h1 = false,
} = Astro.props;
// §4.3 — a copy slot binds verbatim article copy onto
// the skeleton's native props (F.1 — nothing dropped)
const cp = copy || {};
const head = cp.heading || heading;
const sub = cp.answer || cp.text || fs;
const before = cp.before || [];
const list = (cp.items && cp.items.length
  ? cp.items : items) || [];
// N.select — the desktop bar keeps the leading links whose
// labels fit its budget; the rest open behind "More"
const _lbl = (it) => String(it.label || it.term || it.title || it.text || '');
const navFit = (() => { let w = 0, n = 0;
  for (const it of list) { w += _lbl(it).length + 2;
    if (w > 56) break; n++; }
  return n; })();
const navOver = list.length > 6 || navFit < list.length;
const navCut = Math.max(1, Math.min(navFit, 4));
const qas = cp.qa || [];
const links = cp.links || [];
const after = cp.after || [];
const act = cp.cta || cta;
const phone = cp.phone || '';
const tel = phone ? 'tel:' + phone.replace(/[^0-9+]/g, '') : '';
// V.8/P.12 — rasters resolve through src/assets/media/
// so <Image> compiles AVIF/WebP srcsets
const _media = import.meta.glob('../assets/media/*.{jpg,jpeg,png,webp}', { eager: true });
const _mn = image ? String(image.src).split('/').pop() : null;
const mediaSrc = _mn ? (_media[`../assets/media/${_mn}`]?.default ?? null) : null;
const mediaOf = (m) => _media[`../assets/media/${String(m.src).split('/').pop()}`]?.default ?? m.src;
---

<div class="wf-footer-20">
  <div class={image && image.src ? 'split' : undefined}>
    <div class="stack">
  <div class="sec-inner">
    <div class="bm-footer-20__container row between">
      <div class="bm-footer-20__top row between">
        <div>
          <span class="logo brand-mark">{brand}</span>
        </div>
        <div>
          <form novalidate>
          </form>
        </div>
      </div>
      <div class="bm-footer-20__content row between">
        <div class="bm-footer-20__left row between">
          <div class="bm-footer-20__left-top row between">
            {sub && <p class="text-fluid-0" set:html={inline(sub)} />}
                      </div>
          {before.length > 0 && <div class="flow mt-stack">
{before.map((p) => <p class="mt-flow text-fluid-0" set:html={inline(p)} />)}
          </div>}

          {head &&           <div class="bm-footer-20__social-wrapper row between">
            {head && (h1 ? <h1 class="text-fluid-4">{head}</h1> : <h2 class="text-fluid-2">{head}</h2>)}
          </div>
          }
        </div>
        {links.length >= 0 &&         <div>
          {links.length >= 0 &&           <div class="footer-nav-wrapper bm-footer-nav-wrapper--grid-2 row between">
            {links.length > 0 && <div class="row gap-fluid-m">{(links || []).map((it) => (
                <div class="footer-nav-column row between">
                  {it.icon && <IconChip name={it.icon} />}
                  <h3 class="text-fluid-1">{it.term || it.title}</h3>
                  {(it.items || []).length > 0 && <div class="footer-menu row between">
                    <div class="row gap-fluid-m">{((it.items || []) || []).map((it2) => (
                        <div>
                          <a class="text-fluid-0" href={it2.href}>{it2.icon && <IconChip name={it2.icon} />} {it2.label || it2.term || it2.anchor || it2.text}</a>
                          {(it2.label || it2.term || it2.anchor) && it2.text && <p class="text-fluid-0">{it2.text}</p>}
                        </div>
                      ))}</div>
                  </div>}
                </div>
              ))}</div>}
            {links.length === 0 && <p class="footer-legal-nav text-fluid-0">Copyright {new Date().getFullYear()} {brand}</p>}
          </div>
          }
        </div>
        }
      </div>
    </div>
  </div>
    </div>
    {image && image.src && <div class="media-round" data-ratio={image.ratio || null}><Image src={mediaSrc || image.src} alt={image.alt || ''} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 50vw, 100vw" width={900} height={600} loading="lazy" /></div>}
  </div>
  {list.length > 0 && <dl class="mt-stack list-plain flow-list">{list.map((it) => <div class="flow-row">{it.icon && <IconChip name={it.icon} />}<dt class="text-fluid-0" set:html={inline(it.term || it.title || it.label || '')} />{it.text && <dd class="text-fluid-0" set:html={inline(it.text)} />}</div>)}</dl>}
  {qas.length > 0 && <dl class="mt-stack">{qas.map((qa) => <><dt class="text-fluid-0" set:html={inline(qa.q)} /><dd class="text-fluid-0" set:html={inline(qa.a)} /></>)}</dl>}
  {links.length > 0 && <div class="flow mt-stack">{links.map((l) => <p class="text-fluid-0" set:html={inline(l.text || `[${l.anchor}](${l.href})`)} />)}</div>}
  {after.length > 0 && <div class="flow mt-stack">{after.map((p) => <p class="text-fluid-0" set:html={inline(p)} />)}</div>}
  {tel && <p class="mt-stack"><a class="link-quiet" href={tel}>{phone}</a></p>}
</div>
