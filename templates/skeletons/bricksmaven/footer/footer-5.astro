---
/**
 * bm-footer-5 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (footer-5.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="footer-5-container">
    <div class="footer-5-alpha">
      <img class="footer-5__logo"></img>
      <p class="footer-5__address">{fs}</p>
      <div class="footer-5__social"></div>
    </div>
    <div class="footer-nav-wrapper footer-nav-wrapper-5">
      {items.map((it) => (
        <div class="footer-nav-column">
          <h3 class="footer-nav-heading">{it.title}</h3>
          <div class="footer-menu list--none">
            {(it.items || []).map((it2) => (
              <div class="footer-menu__link">
                <a class="footer-menu__link-text" href="#">{it2.text}</a>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="footer-5-epsilon">
      <h4 class="footer-5__title">{heading}</h4>
      <div class="footer-5__apps">
        <div class="footer-5__apps-btn">
          <span class="footer-5__apps-ic" data-icon="lucide" aria-hidden="true"></span>
          <div class="footer-5__apps-box">
            <p class="footer-5__apps-tag">Download on the</p>
            <p class="footer-5__apps-title">App Store</p>
          </div>
        </div>
        <div class="footer-5__apps-btn">
          <span class="footer-5__apps-ic" data-icon="lucide" aria-hidden="true"></span>
          <div class="footer-5__apps-box text--white">
            <p class="footer-5__apps-tag text--s">Download on the</p>
            <p class="footer-5__apps-title text--700 text--l">Google Play</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-5-bottom">
    <div class="footer-5-bottom__alpha">
      <p class="footer-5__copyright">© 2022 Alpha. All right reserved.</p>
    </div>
    <div class="footer-5-bottom__beta">
      <div class="footer-nav-legal">
        <div class="footer-legal-nav list--none">
          {items.map((it) => (
            <div class="footer-legal__li">
              <a class="footer-legal__link-text" href="#">{it.text}</a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

