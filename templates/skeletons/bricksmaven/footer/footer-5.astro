---
/**
 * bm-footer-5 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (footer-5.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="footer-5-container row between">
      <div class="footer-5-alpha row between">
        <span class="logo">{brand}</span>
        {fs && <p class="text-fluid-0">{fs}</p>}
        <div class="footer-5__social"></div>
      </div>
      <div class="footer-nav-wrapper footer-nav-wrapper-5 row between">
        <div class="row gap-fluid-m">
          {(items || []).map((it) => (
            <div class="footer-nav-column row between">
              <h3 class="text-fluid-2">{it.title}</h3>
              <div class="footer-menu row between">
                <div class="row gap-fluid-m">
                  {((it.items || []) || []).map((it2) => (
                    <div>
                      <a class="text-fluid-0" href={it2.href}>{it2.label}</a>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="footer-5-epsilon row between">
        {heading && <h4 class="text-fluid-2">{heading}</h4>}
        <div class="footer-5__apps row between">
          <div class="row gap-fluid-m">
            {(items || []).map((it) => (
              <div class="footer-5__apps-btn row between">
                <span data-icon="lucide" aria-hidden="true"></span>
                <div class="row between">
                  <p class="text-fluid-0">{it.text}</p>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
    <div class="footer-5-bottom row between">
      <div class="footer-5-bottom__alpha"></div>
      <div class="footer-5-bottom__beta">
        <div>
          <div class="footer-legal-nav row between">
            <div class="row gap-fluid-m">
              {(items || []).map((it) => (
                <div>
                  <a class="text-fluid-0" href={it.href}>{it.label}</a>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
