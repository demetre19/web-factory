---
/**
 * bm-footer-15 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (footer-15.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="footer-15-container row between">
      <div class="footer-15__cta row between">
        {heading && <h2 class="footer-15__cta-heading text-fluid-2">{heading}</h2>}
        <p class="mt-fluid-m"><a class="wf-cta-button" href={cta.href}>{cta.label || 'Continue'}</a></p>
      </div>
      <div class="footer-15__header row between">
        <div>
          <span class="logo">{brand}</span>
        </div>
        <div class="footer-15__social-wrapper row between">
          <div></div>
          <div class="footer-15__socials row between">
            <div class="row gap-fluid-m">
              {(items || []).map((it) => (
                <div>
                  <span data-icon="lucide" aria-hidden="true"></span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
      <div class="footer-15__footer row between">
        <div class="footer-15__footer-intro row between">
          <div class="footer-15__newsletter row between">
            {fs && <p class="text-fluid-0">{fs}</p>}
            <form novalidate>
            </form>
          </div>
          <div>
            <div class="footer-nav-wrapper footer-nav-wrapper-15 row between">
              <div class="row gap-fluid-m">
                {(items || []).map((it) => (
                  <div class="footer-nav-column row between">
                    <h3 class="text-fluid-2">{it.title}</h3>
                    <div class="footer-menu row between">
                      <div class="row gap-fluid-m">
                        {((it.items || []) || []).map((it2) => (
                          <div>
                            <a class="text-fluid-0" href={it2.href}>{it2.label}</a>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
        <div class="footer-15__copy-legal row between">
          <div class="footer-bottom__left">
            <div></div>
          </div>
          <div>
            <div class="footer-legal-nav row between">
              <div class="row gap-fluid-m">
                {(items || []).map((it) => (
                  <div>
                    <a class="text-fluid-0" href={it.href}>{it.label}</a>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
