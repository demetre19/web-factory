interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-footer-18__container">
    <div class="bm-footer-18__newsletter-block">
      <div class="bm-footer-18__newsletter-intro">
        <h2 class="bm-footer-18__newsletter-heading">{heading}</h2>
        <p class="bm-footer-18__newsletter-text">{fs}</p>
      </div>
      <div class="bm-footer-18__newsletter-form">
        <form class="footer-newsletter__form" novalidate>
        </form>
      </div>
      <figure class="bm-footer-18__newsletter-background-image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
    </div>
    <div class="bm-footer-18__content">
      <div class="bm-footer-18__left">
        <div class="bm-footer-18__brand">
          <img class="bm-footer-18__logo"></img>
        </div>
        <p class="bm-footer-18__content-text">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
        <div class="bm-footer-18___content-footer">
          <a class="bm-footer-18__content-phone" href="#">000 346 7569</a>
          <p class="bm-footer-18__content-address">5029 Killard Mill, Boston WA 04292 United States</p>
          <a class="bm-footer-18__content-link" href="#">hello@clienturl.com</a>
        </div>
      </div>
      <div class="bm-footer-18__nav-wrapper">
        <div class="footer-nav-wrapper bm-footer-nav-wrapper--grid-3">
          {items.map((it) => (
            <div class="footer-nav-column">
              <h3 class="footer-nav-heading">{it.title}</h3>
              <div class="footer-menu list--none">
                {(it.items || []).map((it2) => (
                  <div class="footer-menu__link">
                    <a class="footer-menu__link-text" href="#">{it2.text}</a>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="bm-footer-18__footer">
      <div class="bm-social-share list--none bm-social-share--left">
        {items.map((it) => (
          <div class="bm-social-share__icon-wrapper">
            <span class="bm-social-share__icon" data-icon="lucide" aria-hidden="true"></span>
          </div>
        ))}
      </div>
      <div class="bm-footer-18__copyright-wrapper">
        <p class="footer-copyright">© {current_date:Y} Alpha. All right reserved.</p>
      </div>
    </div>
  </div>
</div>

