---

<div>
  <div class="sec-inner">
    <div class="bm-footer-22__top-container row between">
      <div class="bm-footer-22__top row between">
        {heading && <h2 class="text-fluid-2">{heading}</h2>}
      </div>
      <div class="row between">
        <div class="bm-footer-22-social-links row between">
          <div class="row gap-fluid-m">
            {(items || []).map((it) => (
              <div>
                <a class="text-fluid-0" href={it.href}>{it.label}</a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
    <div class="bm-footer-22__mid-container row between">
      <div>
        <svg></svg>
      </div>
      <div>
        <div class="footer-nav-wrapper footer-nav-wrapper-21 row between">
          <div class="row gap-fluid-m">
            {(items || []).map((it) => (
              <div class="footer-nav-column row between">
                <h3 class="text-fluid-2">{it.title}</h3>
                <div class="footer-menu row between">
                  <div class="row gap-fluid-m">
                    {((it.items || []) || []).map((it2) => (
                      <div>
                        <a class="text-fluid-0" href={it2.href}>{it2.label}</a>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div>
        <div class="bm-footer-22__newsletter row between">
          {fs && <p class="text-fluid-0">{fs}</p>}
          <form novalidate>
          </form>
        </div>
      </div>
    </div>
    <div class="bm-footer-22__footer-container">
      <div class="bm-footer-22__start row between">
        <div></div>
        <div class="footer-nav-legal">
          <div class="footer-legal-nav row between">
            <div class="row gap-fluid-m">
              {(items || []).map((it) => (
                <div class="footer-legal__li">
                  <a class="text-fluid-0" href={it.href}>{it.label}</a>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
