---

<div>
  <div class="bm-footer-22__top-container">
    <div class="bm-footer-22__top">
      <h2 class="bm-footer-22__top-heading">Let's discuss your project and ideas. Don't worry if you're not fully prepared yet. I can determine the potential of our partnership</h2>
      <a class="bm-footer-22__top-link" href="#">hello@bricksmaven.com</a>
    </div>
    <div class="bm-footer-22__social">
      <h2 class="bm-footer-22__social-heading">Socials</h2>
      <div class="bm-footer-22-social-links list--none">
        {items.map((it) => (
          <div class="bm-footer-22-social-item">
            <a class="bm-footer-22-social-item__link" href="#">{it.text}</a>
          </div>
        ))}
      </div>
    </div>
  </div>
  <div class="bm-footer-22__mid-container">
    <div class="bm-footer-22__brand-cover">
      <svg class="bm-footer-22__brand"></svg>
    </div>
    <div class="bm-footer-22__mid">
      <div class="footer-nav-wrapper footer-nav-wrapper-21">
        <div class="footer-nav-column">
          <h3 class="footer-nav-heading bm-footer-22__footer-heading">1st column</h3>
          <div class="footer-menu list--none">
