          <div class="footer-menu list--none">
            {items.map((it) => (
              <div class="footer-menu__link">
                <a class="footer-menu__link-text" href="#">{it.text}</a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
    <div class="bm-footer-22__end">
      <div class="bm-footer-22__newsletter">
        <h2 class="bm-footer-22__footer-heading">Subscribe</h2>
        <p>Join our newsletter to stay up to date on features and releases</p>
        <form class="footer-newsletter__form" novalidate>
        </form>
      </div>
    </div>
  </div>
  <div class="bm-footer-22__footer-container">
    <div class="bm-footer-22__start">
      <div class="footer-bottom__copyright">
        <p class="footer-copyright">© {current_date:Y} Alpha. All right reserved.</p>
      </div>
      <div class="footer-nav-legal">
        <div class="footer-legal-nav list--none">
          {items.map((it) => (
            <div class="footer-legal__li">
              <a class="footer-legal__link-text" href="#">{it.text}</a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

