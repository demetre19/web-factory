---
/**
 * bm-footer-16 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (footer-16.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-footer-16__container row between">
      <div class="bm-footer-16__intro row between">
        <div class="bm-footer-16__media">
          <svg></svg>
        </div>
        {fs && <p class="text-fluid-0">{fs}</p>}
      </div>
      <div class="bm-footer-16__content row between">
        <div class="row gap-fluid-m">
          {(items || []).map((it) => (
            <div class="bm-footer-16-card row between">
              <h2 class="bm-footer-16-card__heading text-fluid-2">{it.title}</h2>
              <div class="bm-social-share row between">
                <div class="row gap-fluid-m">
                  {((it.items || []) || []).map((it2) => (
                    <div>
                      <span data-icon="lucide" aria-hidden="true"></span>
                    </div>
                  ))}
                </div>
              </div>
              <div class="bm-footer-payment-options row between">
                <div class="row gap-fluid-m">
                  {((it.items || []) || []).map((it2) => (
                    <div>
                      <figure class="bm-footer-option__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="bm-footer-16__nav row between">
        <div class="bm-footer-16-nav-menu row between">
          <div class="row gap-fluid-m">
            {(items || []).map((it) => (
              <div class="bm-footer-16-nav-list">
                <a class="text-fluid-0" href={it.href}>{it.label}</a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
