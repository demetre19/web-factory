  cta, items = [],
} = Astro.props;
---

<div>
  <div class="footer-12-newsletter-container">
    <div class="footer-12-newsletter">
      <div class="footer-newsletter__content">
        <h2 class="footer-newsletter__heading">{heading}</h2>
        <p class="footer-newsletter__text">{fs}</p>
      </div>
      <div class="footer-newsletter__form-wrapper">
        <form class="footer-newsletter__form" novalidate>
