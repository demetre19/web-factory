  <div class="footer-12-nav-container">
    <div class="footer-nav-wrapper">
      {items.map((it) => (
        <div class="footer-nav-column">
          <h3 class="footer-nav-heading">{it.title}</h3>
          <div class="footer-menu list--none">
            {(it.items || []).map((it2) => (
              <div class="footer-menu__link">
                <a class="footer-menu__link-text" href="#">{it2.text}</a>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="footer-12-bottom-container">
    <div class="footer-bottom__left">
      <div class="footer-brand">
        <img class="footer-brand__logo"></img>
      </div>
      <div class="footer-bottom__copyright">
        <p class="footer-copyright">© 2022 Alpha. All right reserved.</p>
      </div>
    </div>
    <div class="footer-nav-legal">
      <div class="footer-legal-nav list--none">
        {items.map((it) => (
          <div class="footer-legal__li">
            <a class="footer-legal__link-text" href="#">{it.text}</a>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

