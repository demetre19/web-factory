<div>
  <div class="sec-inner">
    <div class="checkout-page-2__container">
      <div class="checkout-page-2__details">
        <div class="intro intro--left">
          {head && <h1 class="text-fluid-4">{head}</h1>}
  {sub && <p class="mt-stack lede" set:html={inline(sub)} />}
  {before.map((p) => <p class="mt-stack text-fluid-0" set:html={inline(p)} />)}
        </div>
        <div>
          <div></div>
        </div>
        <div class="checkout-page-2__customer-details"></div>
      </div>
      <div class="checkout-page-2__order">
        <div class="checkout-page-2__order-review"></div>
      </div>
      <div></div>
    </div>
  </div>
  {list.length > 0 && <dl class="mt-stack list-plain flow-list">{list.map((it) => <div class="flow-row">{it.icon && <IconChip name={it.icon} />}<dt class="text-fluid-0" set:html={inline(it.term || it.title || '')} />{it.text && <dd class="text-fluid-0" set:html={inline(it.text)} />}</div>)}</dl>}
