---
/**
 * bm-checkout-page-2 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (checkout-page-2.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="checkout-page-2__container">
    <div class="checkout-page-2__details">
      <div class="intro intro--left">
        <h1 class="intro__heading">Checkout</h1>
        <p class="intro__accent-heading">Accent heading</p>
      </div>
      <div class="bm-woo-notice-container">
        <div class="bm-woo-notice"></div>
      </div>
      <div class="checkout-page-2__customer-details"></div>
    </div>
    <div class="checkout-page-2__order">
      <div class="checkout-page-2__order-review"></div>
    </div>
    <div></div>
  </div>
</div>

<style is:global>
@layer components {
  .checkout-page-2__container {
    display: grid;
    grid-template-columns: calc(100% * 2 / 3);
  }

  .checkout-page-2__details {
    display: flex;
    flex-direction: column;
    row-gap: var(--flow-spacing);
    padding: 0 var(--space-l) var(--space-xl) 0;
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--flow-spacing);
    align-self: center;
  }

  .intro--left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    align-self: flex-start;
  }

  .bm-woo-notice-container {
    position: relative;
  }

  .checkout-page-2__customer-details {
    width: 100%;
  }

  .checkout-page-2__order {
    background: var(--bg-subtle);
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
  }

  .checkout-page-2__order-review {
    width: 100%;
  }

  /* bm-custom */
  .checkout-page-2__customer-details {
  
  		--customer-details--primary: var(--text-primary);
    	--focus-color: var(--action-primary);
    
  
    	/* Change accent color of checkbox and radio */
    	input[type="checkbox"],
      input[type="radio"] {
        accent-color: var(--action-primary);
      }
    	
    	/* Set container of billing and shiiping fiedls to display flex */
    	.col2-set {
      display: flex;
      flex-direction: column;
      gap: var(--flow-spacing);
  }
    
    .col-2 {
      display: flex;
      flex-direction: column;
      gap: var(--flow-spacing);
  }
    
    	/* Sets margin-bottom of h3 element */
  		.woocommerce-shipping-fields > h3, .woocommerce-billing-fields > h3 {
        margin-bottom: var(--space-m);
      }
    
    #ship-to-different-address label {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
    
    .woocommerce-shipping-fields h3 span {
      font-size: var(--fs-2) !important;
      order: -1;
      color: var(--action-primary);
      font-weight: 700;
      
    }
    
  
  
  
    
  }

  /* bm-custom */
  .checkout-page-2__order-review {  	
    	--order-review--primary: var(--text-primary);
    	--order-review--border: var(--color-line-default);
    	--focus-color: var(--action-primary);
    
    	/* Removes border around checkout element */
    	#order_review {
      	border: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-m);
    	}  	
    
    	#payment .payment_methods input[type="checkbox"],
    	#payment .payment_methods input[type="radio"]  {
        	accent-color: var(--action-primary);
  
    	}  	
    
  		#order_review_heading {
  				display: none;
  		}
    
    
  		/* Shop table styling */
  		.shop_table {
       		text-align: left;
        	border-spacing: 0;
        	border: 0;
    	}		
    
    	/* Style shop table table cell */
  		.shop_table thead th {
          text-align: left;
          background-color: var(--acss-order-review--border);
          width: 50%;
      }
    
      /* Align subtotal column to the right */
    .shop_table .cart-subtotal td, .shop_table .order-total td, .shop_table .cart_item .product-total, .shop_table .product-total {
      	text-align: end;
    }
    
      /* Right align the shipping methods*/
    ul.woocommerce-shipping-methods li {
      display: flex;
      flex-direction: row;
      justify-content: end;
  	}
    	/* Sets padding on td and th elements */
  		.shop_table td,
    	.shop_table th {
      		padding: var(--space-xs);
    	}
    	
    	/* Sets the border-bottom of the shop table to 0 */
    	.shop_table tfoot {
        	border-bottom: 0;
    	}
  
    	/* Sets table rows background color */
      .shop_table tbody tr {
        	background-color: var(--bg-canvas);
      }
  
    	/* Sets left and bottom border of product name */
    	#order_review .product-name {
  				border-left: 1px solid var(--acss-order-review--border);
  		}
    
    	/* Sets left and bottom border of product total */
      #order_review .product-total {
  				border-right: 1px solid var(--acss-order-review--border);
  				font-weight: bold;
  		}
  		
    	/* Sets bottom border of last of type cart item */
    	#order_review .cart_item:last-of-type td {
        	border-bottom: 1px solid var(--acss-order-review--border);
    	}
  
    	/* Sets bottom border of cart subtotal */
  		.cart-subtotal th,
    	.cart-subtotal td {
        	border-bottom: 1px solid var(--acss-order-review--border) !important;
    	} 
  	
    	/* Styles Subtotal font weight */
      .shop_table tfoot th {
        	font-weight: normal;
      }
    
    	/* Styles Subtotal price font weight */
      .shop_table tfoot td {
        	font-weight: bold;            
      }			
    
    	/* Styles order total font size and weight */
      .order-total th {
        	font-size: var(--fs-2);
        	font-weight: 500;
      }
    
    	/* Styles order total price font size */
      .order-total .amount {
        	font-size: var(--fs-2);
      }
    
    	/* Styles payment content wrapper */
      #payment ul {
        list-style-type: none;
        padding-inline: 0;
  
        
      }
  
    	/* Styles payment label */
      #payment label {
          display: inline;
          color: var(--action-primary);
          font-weight: bold;
        	font-size: var(--fs-1) !important;
      }		
        
    	/* Styles payment Paragraph */  
      #payment .payment_box p {
       margin: var(--space-xs) 0;
        padding: var(--space-xs);
        font-size: var(--fs-0);
      }
    
    /* Styles woo privacy policy margin */  
      #payment .woocommerce-privacy-policy-text p {
        	margin: var(--space-xs) 0;
        	font-size: var(--fs-0);
      }
  
    	/* Styles input checkbox */  
      #payment .input-checkbox {
        	accent-color: var(--action-primary);
        	margin-right: 0.6rem;
      }
            
    	/* Styles input checkbox span element */  
      #payment .input-checkbox span {
        	margin-left: 1rem;
      }
  
    	/* Styles privacy policy link */  
      #payment .woocommerce-privacy-policy-link {
          color: var(--action-primary);
          font-weight: 600;
      }  
         
    	/* Styles payment button */  
      #payment button {
        padding: var(--space-xs) var(--space-xs); 
        background-color: var(--action-primary);
        color: var(--bg-canvas);
        font-weight: normal;
        font-size: var(--fs-1);
        line-height: 1.5rem;
        text-align: center;
        width: 100%;
      }
  
  }
}
</style>
