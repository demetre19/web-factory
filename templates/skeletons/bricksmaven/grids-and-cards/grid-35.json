    "_cssCustom": ".bm-grid-35-card::after {\n\tcontent: '';\n  display: flex;\n  position: absolute;\n  width: 1px;\n  height: 100%;\n  background-color: var(--neutral-light);\n  right: calc(-1 * (var(--grid-gap) / 2));\n  z-index: 1;\n}\n\n.bm-grid-35-card:last-child::after {\n  display: none; \n}\n\n@media (max-width:767px) {\n  \n  .bm-grid-35-card::after {\n  width: 100%;\n  height: 1px;\n  right: unset;\n  bottom: calc(-1 * (var(--grid-gap) / 2));\n}\n  \n}",
