   "custom_css": ".grid-25-slider .splide__track {\n\toverflow: visible;\n}\n\n.grid-25-slider::before {\n\tcontent: \"\";\n  width: 100vw;\n  max-width: 100vw;\n  height: 100%;\n  min-height: 100%;\n  max-height: 100%;\n  position: absolute;\n  top: 0;\n  right: 100%;\n  z-index: 1;\n  background-color: var(--white);\n  \n}\n\n\n.grid-25-slider .splide__arrows {\n  display: flex!important;\n  position: absolute;\n  gap: var(--space-xs);\n  top: calc(100% + var(--space-l));\n \tleft: 50%;\n  width: 100%;\n  justify-content: center;\n  transform: translateX(-50%);\n  z-index: 0;\n}\n\n.grid-25-slider .splide__arrow {\n    position: relative !important;\n}\n",
