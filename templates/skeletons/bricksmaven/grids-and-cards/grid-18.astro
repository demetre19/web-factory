---
/**
 * bm-grid-18 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (grid-18.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="gridcard-18-container">
    <div class="intro">
      <p class="intro__subheading">Lorem ipsum set dolor amet</p>
      <h2 class="intro__heading">This is a service block</h2>
    </div>
    <div class="gridcard-18-ct list--none">
      {items.map((it) => (
        <div class="gridcard-18-box">
          <div class="gridcard-18-article">
            <div class="gridcard-18-article__meta">
              <div class="gridcard-18-article__detail">
                <p class="gridcard-18-article__date">{it.text}</p>
                <h2 class="gridcard-18-article__title clickable-parent">{it.title}</h2>
              </div>
              <span class="gridcard-18-article__icon" data-icon="lucide" aria-hidden="true"></span>
            </div>
            <div class="gridcard-18-article__media">
              <figure class="gridcard-18-article__thumb"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
@layer components {
  .gridcard-18-container {
    row-gap: var(--space-s);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .gridcard-18-ct {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.875em;
    grid-template-rows: repeat(2, minmax(0, auto));
  }

  .gridcard-18-article {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    grid-template-rows: auto 7.5em;
    position: relative;
    height: 100%;
  }

  .gridcard-18-article__meta {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-template-rows: repeat(1, minmax(0, auto));
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    background: var(--bg-canvas);
    /* bm: box-shadow omitted — token layer owns elevation */
  }

  .gridcard-18-article__detail {
    display: grid;
  }

  .gridcard-18-article__icon {
    background: var(--action-primary);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: var(--space-s) var(--space-s) var(--space-s) var(--space-s);
    margin: 0 0 0 auto;
  }

  .gridcard-18-article__thumb {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  /* bm-custom */
  .gridcard-18-box:nth-child(1) {
  	grid-column: span 8;
  }
  .gridcard-18-box:nth-child(2) {
  	grid-column: span 4;
    grid-row: span 2;
  }
  .gridcard-18-box:nth-child(3) {
  	grid-column: span 4;
  }
  .gridcard-18-box:nth-child(4) {
  	grid-column: span 4;
  }

  /* bm-custom */
  .gridcard-18-article:hover a {
  	color: var(--action-primary);
  }

  /* bm-custom */
  .gridcard-18-article__title > a::after {
  	z-index: 1;
  }
}
</style>
