---
/**
 * bm-grid-16 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (grid-16.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="gridcard-16-container">
      <div class="gridcard-16-head">
        {heading && <h2 class="text-fluid-2">{heading}</h2>}
        {fs && <p class="text-fluid-0">{fs}</p>}
      </div>
      <div class="gridcard-16-articles">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="card">
              <div class="gridcard-16-card">
                <div class="gridcard-16-card__box">
                  <p class="text-fluid-0">{it.text}</p>
                  <div class="gridcard-16-card__title">
                    <h2 class="text-fluid-2">{it.title}</h2>
                    <span data-icon="lucide" aria-hidden="true"></span>
                  </div>
                </div>
                <div class="gridcard-16-card__media">
                  <figure class="gridcard-16-card__img ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
