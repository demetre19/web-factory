  {
   "id": "jqkqqd",
   "name": "bm-grid-34-list",
   "settings": {
    "_cssCustom": ".bm-grid-34-list:nth-child(1) {\n  grid-column: 1/4;\n  grid-row: 1/8;\n}\n\n.bm-grid-34-list:nth-child(2) {\n  grid-column: 1/4;\n  grid-row: 8/-1;\n}\n\n.bm-grid-34-list:nth-child(3) {\n  grid-column: 4/8;\n  grid-row: 1/5;\n}\n\n.bm-grid-34-list:nth-child(4) {\n  grid-column: 4/8;\n  grid-row: 5/-1;\n}\n\n.bm-grid-34-list:nth-child(5) {\n  grid-column: 8/-1;\n  grid-row: 1/-1;\n}\n\n@media (max-width:991px) {\n  \n  .bm-grid-34-list:nth-child(1) {\n  grid-column: 1/7;\n  grid-row: 2;\n}\n\n.bm-grid-34-list:nth-child(2) {\n  grid-column: 1/-1;\n  grid-row: 1;\n}\n\n.bm-grid-34-list:nth-child(3) {\n  grid-column: 1/-1;\n  grid-row: 3;\n}\n\n.bm-grid-34-list:nth-child(4) {\n  grid-column: 7/-1;\n  grid-row: 2;\n}\n\n.bm-grid-34-list:nth-child(5) {\n  grid-column: 1/-1;\n  grid-row: 4;\n  aspect-ratio: 2/1;\n}\n}"
   }
  },
