---
/**
 * bm-item-ehunkw — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (item-ehunkw.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="gridcard-8-container">
    <div class="list--none gridcard-8-grid-ul">
      {items.map((it) => (
        <div class="gridcard-8-card">
          <div class="gridcard-8-card__box">
            <h2 class="gridcard-8-card__heading">{it.title}</h2>
            <p class="gridcard-8-card__desc">{it.text}</p>
            <a class="gridcard-8-card-btn wf-cta-button" href={it.href}>{it.label}</a>
          </div>
          <div class="gridcard-8-card__media">
            <figure class="gridcard-8-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
@layer components {
  .gridcard-8-grid-ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-m);
  }

  .gridcard-8-card {
    display: flex;
    flex-direction: column;
    row-gap: var(--space-s);
  }

  .gridcard-8-card__box {
    display: flex;
    flex-direction: column;
    row-gap: var(--space-xs);
  }

  .gridcard-8-card-btn {
    align-self: flex-start;
    padding: 0 0 0 0;
  }

  .gridcard-8-card__image {
    height: 25.3rem;
    width: 100%;
    object-fit: cover;
  }
}
</style>
