      "raw": "var(--white)"
     }
    },
    "_cssCustom": ".grid-28-card:nth-child(3) {\n\tgrid-column: 1/-1;\n  flex-direction: row;\n  gap: var(--container-gap);\n\n}\n\n.grid-28-card:nth-child(3) .grid-28-card__intro {\n\tflex-direction: column-reverse;\n  align-items: start;\n  gap: var(--content-gap);\n}\n\n.grid-28-card:nth-child(3) .grid-28-card__image {\n\taspect-ratio: 1/1;\n  height: 24rem;\n}\n\n@media (max-width:767px) {\n\t.grid-28-card:nth-child(3) .grid-28-card__intro {\n\tflex-direction: row;\n  align-items: space-between;\n}\n  \n  .grid-28-card:nth-child(3) .grid-28-card__image {\n  height: 16rem;\n}\n  \n  \n}"
   }
