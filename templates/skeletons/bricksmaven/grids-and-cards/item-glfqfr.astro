---
/**
 * bm-item-glfqfr — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (item-glfqfr.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div>
      <div class="gridcard-11-wrapper">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="gridcard-11-media card">
              <div class="gridcard-11-media__figure">
                <figure class="gridcard-11-media__img ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="gridcard-11-wrapper">
        <div class="gridcard-11-heading">
          {heading && <h2 class="text-fluid-2">{heading}</h2>}
          {fs && <p class="text-fluid-0">{fs}</p>}
          <p class="mt-fluid-m"><a class="wf-cta-button" href={cta.href}>{cta.label || 'Continue'}</a></p>
        </div>
        <div class="gridcard-11-profile">
          <div class="gridcard-11-profile__author">
            <div class="gridcard-11-profile__figure">
              <figure class="gridcard-11-profile__photo ratio-portrait"><img src="/media/placeholder.svg" alt="Photo" loading="lazy" width="900" height="600" /></figure>
            </div>
            <div class="gridcard-11-profile__meta"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
