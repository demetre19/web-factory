 "globalClasses": [
  {
   "id": "nyqtfb",
   "name": "gridcard-19",
   "settings": []
  },
  {
   "id": "wxpsom",
   "name": "gridcard-19-container",
   "settings": []
  },
  {
   "id": "otrebq",
   "name": "gridcard-19-ct",
   "settings": {
    "_display": "grid",
    "_width": "100%",
    "_gridGap": "3.125em",
    "_gridTemplateColumns": "repeat(12, minmax(0, 1fr))",
    "_gridTemplateRows": "repeat(2, minmax(0, 1fr))",
    "_gridGap:mobile_landscape": "1.5em 0em"
   }
  },
  {
   "id": "acss_import_list--none",
   "name": "list--none",
   "settings": []
  },
  {
   "id": "bfuhhh",
   "name": "gridcard-19-box",
   "settings": {
    "_gridItemColumnSpan": "span 4",
    "_cssCustom": ".gridcard-19-box:nth-child(2) {\n\tgrid-row: span 2;\n}",
    "_cssCustom:mobile_landscape": ".gridcard-19-box:nth-child(2) {\n\tgrid-row: span 1;\n}",
    "_gridItemColumnSpan:mobile_landscape": "span 12"
   }
  },
  {
   "id": "ffopzw",
   "name": "gridcard-19-article",
   "settings": {
    "_display": "grid",
    "_gridTemplateColumns": "repeat(1, minmax(0, 1fr))",
    "_gridTemplateRows": "auto 7.5em",
    "_position": "relative",
    "_cssCustom": ".gridcard-19-article:hover a {\n\tcolor: var(--primary);\n}",
    "_height": "100%",
    "_gridTemplateRows:mobile_landscape": "20em 7.5em"
   }
  },
  {
   "id": "omspng",
   "name": "gridcard-19-article__meta",
   "settings": {
    "_order": "1",
    "_display": "grid",
    "_gridTemplateColumns": "repeat(5, minmax(0, 1fr))",
    "_gridTemplateRows": "repeat(1, minmax(0, auto))",
    "_padding": {
     "top": "var(--space-s)",
     "bottom": "var(--space-s)",
     "right": "var(--space-s)",
     "left": "var(--space-s)"
    },
    "_background": {
     "color": {
      "raw": "var(--white)"
     }
    },
    "_boxShadow": {
     "values": {
      "offsetX": "0",
      "offsetY": "4px",
      "blur": "28px"
     },
     "color": {
      "hex": "#282625",
      "rgb": "rgba(40, 38, 37, 0.1)",
      "hsl": "hsla(20, 4%, 15%, 0.1)"
     }
    },
    "_alignItemsGrid": "center"
   }
  },
  {
   "id": "qinrfh",
   "name": "gridcard-19-article__detail",
   "settings": {
    "_gridItemColumnSpan": "span 4",
    "_display": "grid",
    "_gridGap": ".5em"
   }
  },
  {
   "id": "qkdtyk",
   "name": "gridcard-19-article__term",
   "settings": {
    "_typography": {
     "color": {
      "hex": "#525252",
      "raw": "var(--primary)"
     }
    }
   }
  },
  {
   "id": "ytwdnq",
   "name": "gridcard-19-article__title",
   "settings": {
    "_cssCustom": ".gridcard-19-article__title > a::after {\n\tz-index: 1;\n}"
   }
  },
  {
   "id": "acss_import_clickable-parent",
   "name": "clickable-parent",
   "settings": []
  },
  {
   "id": "skeomh",
   "name": "gridcard-19-article__media",
   "settings": []
  },
  {
