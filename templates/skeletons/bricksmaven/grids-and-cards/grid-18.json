   "id": "yhekke",
   "name": "gridcard-18-ct",
   "settings": {
    "_width": "100%",
    "_display": "grid",
    "_gridTemplateColumns": "repeat(12, minmax(0, 1fr))",
    "_gridGap": "1.875em",
    "_gridTemplateRows": "repeat(2, minmax(0, auto))",
    "_gridGap:mobile_landscape": "1em"
   }
  },
  {
   "id": "acss_import_list--none",
   "name": "list--none",
   "settings": []
  },
  {
   "id": "dllesv",
   "name": "gridcard-18-box",
   "settings": {
    "_cssCustom": ".gridcard-18-box:nth-child(1) {\n\tgrid-column: span 8;\n}\n.gridcard-18-box:nth-child(2) {\n\tgrid-column: span 4;\n  grid-row: span 2;\n}\n.gridcard-18-box:nth-child(3) {\n\tgrid-column: span 4;\n}\n.gridcard-18-box:nth-child(4) {\n\tgrid-column: span 4;\n}",
    "_cssCustom:mobile_landscape": ".gridcard-18-box:nth-child(1) {\n\tgrid-column: span 12;\n}\n.gridcard-18-box:nth-child(2) {\n\tgrid-column: span 12;\n  grid-row: span 1;\n}\n.gridcard-18-box:nth-child(3) {\n\tgrid-column: span 12;\n}\n.gridcard-18-box:nth-child(4) {\n\tgrid-column: span 12;\n}"
   }
  },
  {
   "id": "zwqhha",
   "name": "gridcard-18-article",
   "settings": {
    "_display": "grid",
    "_gridTemplateColumns": "repeat(1, minmax(0, 1fr))",
    "_gridTemplateRows": "auto 7.5em",
    "_position": "relative",
    "_cssCustom": ".gridcard-18-article:hover a {\n\tcolor: var(--primary);\n}",
    "_height": "100%",
    "_gridTemplateRows:mobile_landscape": "20em 7.5em"
   }
  },
  {
   "id": "ziqdnf",
   "name": "gridcard-18-article__meta",
   "settings": {
    "_order": "1",
    "_display": "grid",
    "_gridTemplateColumns": "repeat(5, minmax(0, 1fr))",
    "_gridTemplateRows": "repeat(1, minmax(0, auto))",
    "_padding": {
     "top": "var(--space-m)",
     "bottom": "var(--space-m)",
     "right": "var(--space-m)",
     "left": "var(--space-m)"
    },
    "_background": {
     "color": {
      "raw": "var(--white)"
     }
    },
    "_boxShadow": {
     "values": {
      "offsetX": "0",
      "offsetY": "4px",
      "blur": "28px"
     },
     "color": {
      "hex": "#282625",
      "rgb": "rgba(40, 38, 37, 0.1)",
      "hsl": "hsla(20, 4%, 15%, 0.1)"
     }
    },
    "_alignItemsGrid": "center"
   }
  },
