      "id": "acss_import_neutral-light",
      "name": "neutral-light",
      "raw": "var(--neutral-light)"
     }
    },
    "_cssCustom": "/* CARD */\n.grid-32-card {\n\ttransition: .6s ease;\n  position:relative;\n}\n\n.grid-32-card:focus-within :focus{\n\toutline:0;\n}\n\n.grid-32-card:hover, .grid-32-card:focus-within {\n\tbox-shadow: var(--box-shadow-xl);\n  transform: translateY(calc(-1 * var(--space-xs)));\n}\n\n/* CARD Heading */\n.grid-32-card .grid-32-card__heading:not(a) > a:after {\n\tcontent:'';\n  position: absolute;\n  inset:0;\n  cursor: pointer;\n}"
   }
