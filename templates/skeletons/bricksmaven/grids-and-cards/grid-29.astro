---
/**
 * bm-grid-29 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (grid-29.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="grid-29-container">
    <div class="intro intro--left">
      <h2 class="intro__heading">{heading}</h2>
      <p class="intro__subheading">{fs}</p>
      <p class="intro__accent-heading">Tagline</p>
    </div>
    <div class="grid-29-list list--none">
      {items.map((it) => (
        <div class="grid-29-card">
          <h2 class="grid-29-card__heading">{it.title}</h2>
          <span class="grid-29-card__icon" data-icon="lucide" aria-hidden="true"></span>
          <p class="grid-29-card__text">{it.text}</p>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .grid-29-container {
    row-gap: var(--space-s);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .intro--left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    align-self: flex-start;
  }

  .grid-29-list {
    display: grid;
    grid-template-rows: repeat(21, minmax(0, 1fr));
    grid-template-columns: calc(100% * 1 / 3);
  }

  .grid-29-card {
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    row-gap: var(--flow-spacing);
    border-top: .1rem solid var(--color-line-default);
    border-right: .1rem solid var(--color-line-default);
    border-bottom: .1rem solid var(--color-line-default);
    border-left: .1rem solid var(--color-line-default);
    flex-wrap: nowrap;
  }

  /* bm-custom */
  @media (max-width:600px) {
  	.grid-29-list {
    grid-template-columns: repeat(1, minmax(0, 1fr)) !important;
      grid-template-rows: auto !important;
    }
  }

  /* bm-custom */
  .grid-29-card {
  	transition: .5s ease;
  }
  
  .grid-29-card:hover {
  	box-shadow: var(--shadow-card);
    position:relative;
    z-index: 99;
  }
  
  .grid-29-card:nth-child(1) {
  	grid-area: 1 / 1 / 10 / 2 ;
  }
  
  .grid-29-card:nth-child(2) {
  	grid-area: 3 / 2 / 12 / 3;
  }
  
  .grid-29-card:nth-child(3) {
  	grid-area: 5 / 3 / 14 / -1;
  }
  
  .grid-29-card:nth-child(4) {
  	grid-area: 10 / 1 / 20 / 2;
  }
  
  .grid-29-card:nth-child(5) {
  	grid-area: 12 / 2 / 21 / 3;
  }
  
  @media (max-width:600px) {
  	.grid-29-card:nth-child(1), .grid-29-card:nth-child(2), .grid-29-card:nth-child(3), .grid-29-card:nth-child(4), .grid-29-card:nth-child(5) {
    grid-column: span 1;
      grid-row: span 1;
    }
  }
</style>
