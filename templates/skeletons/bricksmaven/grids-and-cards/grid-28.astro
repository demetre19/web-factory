             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="grid-28-container">
    <div class="intro intro--left">
      <h2 class="intro__heading">Long headline to turn your visitors into users</h2>
      <p class="intro__subheading">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
      <p class="intro__accent-heading">Tagline</p>
    </div>
    <div class="grid-28-list list--none">
      {items.map((it) => (
        <div class="grid-28-card">
          <div class="grid-28-card__content">
            <div class="grid-28-card__intro">
              <h2 class="grid-28-card__heading">{it.title}</h2>
              <span class="grid-28-card__icon" data-icon="lucide" aria-hidden="true"></span>
            </div>
            <p class="grid-28-card__text">{it.text}</p>
          </div>
          <figure class="grid-28-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
      ))}
    </div>
  </div>
