    align-self: flex-start;
  }

  .grid-28-list {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--space-m);
  }

  .grid-28-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-l) var(--space-l) 0 var(--space-l);
    row-gap: var(--space-s);
    background: var(--bg-canvas);
  }

  .grid-28-card__content {
    row-gap: var(--flow-spacing);
  }

  .grid-28-card__intro {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .grid-28-card__icon {
    padding: var(--space-xs) var(--space-xs) var(--space-xs) var(--space-xs);
    border-radius: 50% 50% 50% 50%;
    background: var(--action-primary);
  }

  .grid-28-card__image {
    object-fit: cover;
    height: 16rem;
    width: 100%;
  }

  /* bm-custom */
  .grid-28-card:nth-child(3) {
  	grid-column: 1/-1;
    flex-direction: row;
    gap: var(--space-s);
  
  }
  
  .grid-28-card:nth-child(3) .grid-28-card__intro {
  	flex-direction: column-reverse;
