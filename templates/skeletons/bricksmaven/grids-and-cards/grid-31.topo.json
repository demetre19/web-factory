   "custom_css": "/* Card styling */\n.grid-31-card:focus-within :focus {\n\toutline: none;\n  box-shadow: none;\n}\n\n.grid-31-card:focus-within {\n  box-shadow: 0 0 1rem 0 var(--shade-light-trans-10);\n}\n\n.grid-31-card__image {\n\ttransition: 1.4s ease;\n}\n\n.grid-31-card:hover .grid-31-card__image, .grid-31-card:focus-within .grid-31-card__image {\n\tscale: 1.1;\n}\n\n/* Grid Item 1 */\n.grid-31-card:nth-child(1) {\n\talign-items:start;\n  transform: translate(0, 0);\n}\n\n.grid-31-card:nth-child(1) .grid-31-card__wrapper {\n\twidth:100%;\n}\n\n.grid-31-card:nth-child(1) .grid-31-card__image {\n\taspect-ratio: 4/3;\n}\n\n/* Grid Item 2 */\n.grid-31-card:nth-child(2) {\n\talign-items:center;\n  transform: translate(0, var(--space-xxl));\n}\n\n.grid-31-card:nth-child(2) .grid-31-card__wrapper {\n\twidth:85%;\n}\n\n.grid-31-card:nth-child(2) .grid-31-card__image {\n\taspect-ratio: 4/5;\n}\n\n/* Grid Item 3 */\n.grid-31-card:nth-child(3) {\n\talign-items:center;\n  transform: translate(0, calc(var(--space-m) * -1));\n}\n\n.grid-31-card:nth-child(3) .grid-31-card__wrapper {\n\twidth:65%;\n}\n\n.grid-31-card:nth-child(3) .grid-31-card__image {\n\taspect-ratio: 1/1;\n}\n\n/* Grid Item 4 */\n.grid-31-card:nth-child(4) {\n\talign-items:end;\n  transform: translate(0, calc(var(--space-xxl) * -1));\n}\n\n.grid-31-card:nth-child(4) .grid-31-card__wrapper {\n\twidth:85%;\n}\n\n.grid-31-card:nth-child(4) .grid-31-card__image {\n\taspect-ratio: 1/1;\n}\n\n/* Grid Item 5 */\n.grid-31-card:nth-child(5) {\n\talign-items:start;\n  transform: translate(0, calc(var(--space-xxl) * 1.4));\n}\n\n.grid-31-card:nth-child(5) .grid-31-card__wrapper {\n\twidth:65%;\n}\n\n.grid-31-card:nth-child(5) .grid-31-card__image {\n\taspect-ratio: 4/5;\n}\n\n/* Grid Item 6 */\n.grid-31-card:nth-child(6) {\n\talign-items:start;\n  transform: translate(0, calc(var(--space-xxl) * 1));\n}\n\n.grid-31-card:nth-child(6) .grid-31-card__wrapper {\n\twidth:100%;\n}\n\n.grid-31-card:nth-child(6) .grid-31-card__image {\n\taspect-ratio: 4/3;\n}\n\n@media (max-width:767px) {\n  /* Grid Item 2 */\n.grid-31-card:nth-child(2) {\n  transform: translate(0, var(--space-l));\n}\n  \n\t/* Grid Item 4 */\n    .grid-31-card:nth-child(4) {\n      transform: translate(0, calc(var(--space-xxl) * 1.2));\n    }\n  \n  \n\t/* Grid Item 6 */\n  .grid-31-card:nth-child(6) {\n  transform: translate(0, calc(var(--space-xxl) * 1.6));\n}\n  \n}",
