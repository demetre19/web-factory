  {
   "id": "rjaaeq",
   "name": "bm-grid-33-list",
   "settings": {
    "_cssCustom": ".bm-grid-33-list:nth-child(1) {\n  grid-column: 1 / 5;\n  grid-row: 1/2;\n}\n\n.bm-grid-33-list:nth-child(2) {\n  grid-column: 5 / 9;\n  grid-row: 1/2;\n}\n\n.bm-grid-33-list:nth-child(3) {\n  grid-column: 9 / -1;\n  grid-row: 1/2;\n}\n\n.bm-grid-33-list:nth-child(4) {\n  grid-column: 1 / 5;\n  grid-row: 2/-1;\n}\n\n.bm-grid-33-list:nth-child(5) {\n  grid-column: 5 / 9;\n  grid-row: 2/-1;\n}\n\n.bm-grid-33-list:nth-child(6) {\n  grid-column: 9 / -1;\n  grid-row: 2/-1;\n}\n\n@media (max-width:991px) {\n  .bm-grid-33-list:nth-child(1) {\n  grid-column: span 6;\n  grid-row: auto;\n}\n\n.bm-grid-33-list:nth-child(2) {\n  grid-column: span 6;\n  grid-row: auto;\n}\n\n.bm-grid-33-list:nth-child(3) {\n  grid-column: 1 / -1;\n  grid-row: 1;\n  aspect-ratio: 2 / 1;\n}\n\n.bm-grid-33-list:nth-child(4) {\n  grid-column: 1 / -1;\n  grid-row: auto;\n  aspect-ratio: 2 / 1;\n}\n\n.bm-grid-33-list:nth-child(5) {\n  grid-column: span 6;\n  grid-row: auto;\n}\n\n.bm-grid-33-list:nth-child(6) {\n  grid-column: span 6;\n  grid-row: auto;\n}\n}\n\n@media (max-width:478px) {\n  .bm-grid-33-list:nth-child(odd), .bm-grid-33-list:nth-child(even) {\n  grid-column: span 12;\n  grid-row: auto;\n    aspect-ratio: 1 / 1;\n}\n  \n  .bm-grid-33-list:nth-child(3) {\n  grid-row: 1;\n}\n\n\n}"
   },
