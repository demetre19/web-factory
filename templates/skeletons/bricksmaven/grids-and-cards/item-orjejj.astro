 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="gridcard-9-container">
    <div class="gridcard-9-grid-ul list--none">
      {items.map((it) => (
        <div class="gridcard-9-card">
          <div class="gridcard-9-card__box">
            <h2 class="gridcard-9-card__heading">{it.title}</h2>
            <p class="gridcard-9-card__desc">{it.text}</p>
            <a class="btn--primary wf-cta-button" href={it.href}>{it.label}</a>
          </div>
          <div class="gridcard-9-card__media">
            <figure class="gridcard-9-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .gridcard-9-grid-ul {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-m);
  }

  .gridcard-9-card {
    /* bm: box-shadow omitted — token layer owns elevation */
    display: flex;
    flex-direction: column;
  }

  .gridcard-9-card__box {
    align-items: flex-start;
    display: flex;
    flex-direction: column;
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    row-gap: var(--space-s);
  }

  .btn--primary {
    padding: 1.25rem 1.875rem 1.25rem 1.875rem !important;
    width: auto;
  }

  .gridcard-9-card__image {
    height: 25.3rem;
    width: 100%;
    object-fit: cover;
  }
</style>
