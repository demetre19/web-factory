    object-fit: cover;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .gridcard-14-media__img {
    object-fit: cover;
    width: 100%;
    height: 100%;
    position: relative;
  }

  /* bm-custom */
  .gridcard-14-media {
  	grid-column: 6/ 12;
  }
  .gridcard-14-media::before {
  	content: '';
    position: absolute;
    top: 50%;
    right: -10%;
    transform: translateY(-50%);
    height: 120%;
    width: 15em;
    background-color: var(--action-primary);
    z-index: -1;
  }
</style>
