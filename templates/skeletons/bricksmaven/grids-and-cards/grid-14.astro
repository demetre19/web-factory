<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .gridcard-14-container {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-m);
  }

  .gridcard-14-ct {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    row-gap: var(--space-xs);
  }

