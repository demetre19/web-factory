  },
  {
   "id": "dyjfok",
   "name": "grid-23-card",
   "settings": {
    "_position": "relative",
    "_overflow": "hidden",
    "_height": "50rem",
    "_display": "flex",
    "_direction": "column",
    "_justifyContent": "flex-end",
    "_cssCustom": "/* Card */\n.grid-23-card {\n\t --heading-wrapper-padding: var(--space-m);\n  --heading-arrow-top: calc(var(--space-s) * -1);\n  --heading-color: var(--white);\n}\n\n.grid-23-card:focus-within :focus {\n\toutline: none;\n  box-shadow: none;\n}\n\n.grid-23-card:focus-within {\n  box-shadow: 0 0 1rem 0 var(--shade-light-trans-10);\n}\n\n/* Heading Wrapper */\n.grid-23-card__heading-wrapper {\n  position: absolute;\n  z-index: 2;\n  left: 50%;\n  transform: translate(-50%, calc(var(--space-m) * -1));\n  align-content: center;\n  transition: .3s ease;\n}\n\n/* Add arrows to the left (pointing right) */\n.grid-23-card__heading-wrapper::before {\n    content: \" \";\n    height: 0px;\n    position: absolute;\n    top: var(--heading-arrow-top);\n    width: 0;\n    z-index: 1;\n    left: 50%;\n    opacity: 0;\n  \ttransform: translateX(-50%);\n    border: medium solid var(--primary);\n    border-width: 10px 10px 10px 10px;\n    border-color: transparent transparent var(--heading-color) transparent;\n  }\n\n.grid-23-card__heading-wrapper::after {\n    content: \" \";\n    height: 0px;\n    position: absolute;\n    top: 100%;\n    bottom: 0;\n    width: 0;\n    z-index: 1;\n    left: 50%;\n  \ttransform: translateX(-50%);\n    opacity: 1;\n    border: medium solid var(--primary);\n    border-width: 10px 10px 10px 10px;\n    border-color: var(--heading-color) transparent transparent transparent;\n  }\n\n.grid-23-card:hover .grid-23-card__heading-wrapper, .grid-23-card:focus-within .grid-23-card__heading-wrapper {\n  transform: translate(-50%, 100%);\n}\n\n.grid-23-card:hover .grid-23-card__heading-wrapper::before, .grid-23-card:focus-within .grid-23-card__heading-wrapper::before {\n  opacity: 0;\n}\n\n.grid-23-card:hover .grid-23-card__heading-wrapper::before, .grid-23-card:focus-within .grid-23-card__heading-wrapper::before {\n  opacity: 1;\n}\n\n\n\n.grid-23-card__heading {\n  padding: var(--space-s);\n    color: var(--shade);\n  align-content: center;\n  text-align: center;\n  background-color: var(--heading-color);\n}\n\n/* Content */\n.grid-23-card__content {\n\tposition: relative;\n  z-index: 2;\n  transition: .4s ease;\n  transform: translate(0%, 100%);\n  padding: var(--space-m);\n  color: var(--white);\n  text-align: center;\n  align-items: center;\n  opacity: 0;\n}\n\n.grid-23-card:hover .grid-23-card__content, .grid-23-card:focus-within .grid-23-card__content {\n  transform: translate(0%, 0%);\n  opacity: 1;\n}\n/* Overlay */\n.grid-23-card__overlay {\n\ttransition: 1s ease;\n}\n\n.grid-23-card:hover .grid-23-card__overlay, .grid-23-card:focus-within .grid-23-card__overlay {\n  background-image: linear-gradient(var(--shade-trans-40), var(--shade-trans-90));\n}\n\n/* Image */\n.grid-23-card__image {\n\ttransition: 1s ease;\n}\n\n.grid-23-card:hover .grid-23-card__image, .grid-23-card:focus-within .grid-23-card__image {\n  scale: 1.1;\n}",
    "_height:mobile_landscape": "35rem"
   }
