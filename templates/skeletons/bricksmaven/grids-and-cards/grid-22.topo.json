   "custom_css": "/* Card */\n\n.grid-22-card:focus-within :focus {\n\toutline: none;\n  box-shadow: none;\n}\n\n.grid-22-card:focus-within {\n\tbox-shadow: 0 0 10px 0 var(--black-trans-10);\n\n}\n\n/* Front */\n\n.grid-22-card__front {\n\ttransition: .5s ease-in-out;\n  backdrop-filter: blur(10px);\n}\n\n.grid-22-card:hover .grid-22-card__front, .grid-22-card:focus-within .grid-22-card__front {\n\ttransform: translateY(100%);\n}\n\n.grid-22-card__heading {\n\ttransition: .4s ease-in-out;\n  writing-mode: vertical-rl;\n}\n\n.grid-22-card:hover .grid-22-card__heading, .grid-22-card:focus-within .grid-22-card__heading {\n\topacity: 0;\n}\n\n\n/* Back */\n.grid-22-card__back {\n\ttransition: .5s ease-in-out;\n  transform: translateY(100%);\n  opacity: 0;\n}\n\n.grid-22-card:hover .grid-22-card__back, .grid-22-card:focus-within .grid-22-card__back {\n\ttransform: translateY(0%);\n  opacity: 1;\n}\n\n/* Overlay */\n.grid-22-card__overlay {\n\ttransition: .5s ease-in-out;\n  opacity: 0;\n}\n\n.grid-22-card:hover .grid-22-card__overlay, .grid-22-card:focus-within .grid-22-card__overlay {\n  opacity: 1;\n}\n\n/* Image */\n.grid-22-card__image {\n\ttransition: .8s ease-in-out;\n  filter: blur(10px) grayscale(1);\n}\n\n.grid-22-card:hover .grid-22-card__image, .grid-22-card:focus-within .grid-22-card__image {\n\tfilter: blur(0px) grayscale(0);\n  scale: 1.1;\n}",
