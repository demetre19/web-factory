 "source": "bricksCopiedElements",
 "sourceUrl": "https://acss.bricksmaven.com",
 "version": "1.9.7.1",
 "globalClasses": [
  {
   "id": "itqvty",
   "name": "grid-26",
   "settings": []
  },
  {
   "id": "borxzl",
   "name": "grid-26-container",
   "settings": {
    "_rowGap": "var(--container-gap)"
   }
  },
  {
   "id": "muadbq",
   "name": "intro",
   "settings": {
    "_typography": {
     "text-align": "center"
    },
    "_direction": "column",
    "_display": "flex",
    "_alignItems": "center",
    "_rowGap": "var(--space-s)",
    "_width:mobile_landscape": "100%",
    "_alignSelf": "center"
   }
  },
  {
   "id": "wnpikx",
   "name": "intro__heading",
   "settings": []
  },
  {
   "id": "prgilv",
   "name": "intro__subheading",
   "settings": []
  },
  {
   "id": "samysq",
   "name": "intro__accent-heading",
   "settings": {
    "_typography": {
     "color": {
      "id": "acss_import_primary",
      "name": "primary",
      "raw": "var(--primary)"
     }
    },
    "_order": "-1"
   }
  },
  {
   "id": "acss_import_list--none",
   "name": "list--none",
   "settings": []
  },
  {
   "id": "ekxmry",
   "name": "grid-26-list",
   "settings": {
    "_display": "grid",
    "_gridTemplateColumns": "var(--grid-3)",
    "_gridGap": "var(--grid-gap)",
    "_gridTemplateRows": "repeat(14, minmax(5rem, 1fr))",
    "_gridTemplateColumns:mobile_landscape": "var(--grid-2)",
    "_gridTemplateRows:mobile_landscape": "unset",
    "_gridTemplateColumns:mobile_portrait": "var(--grid-1)"
   }
  },
  {
   "id": "dcmucx",
   "name": "grid-26-card",
   "settings": {
    "_position": "relative",
    "_overflow": "hidden",
    "_cssCustom": ".grid-26-card:nth-child(1) {\n\tgrid-area: 1 / 1 / 7 / 2;\n}\n\n.grid-26-card:nth-child(2) {\n\tgrid-area: 1 / 2 / 5 / 3;\n}\n\n.grid-26-card:nth-child(3) {\n\tgrid-area: 1 / 3 / 7 / -1;\n}\n\n.grid-26-card:nth-child(4) {\n\tgrid-area: 7 / 1 / 12 / 2;\n}\n\n.grid-26-card:nth-child(5) {\n\tgrid-area: 5 / 2 / 12 / 3;\n}\n\n.grid-26-card:nth-child(6) {\n\tgrid-area: 7 / 3 / 12 / -1;\n}\n\n\n/* Card */\n\n.grid-26-card:focus-within :focus {\n\toutline: none;\n  box-shadow: none;\n}\n\n.grid-26-card:focus-within {\n\tbox-shadow: 0 0 10px 0 var(--black-trans-10);\n\n}\n\n\n/* Content */\n.grid-26-card__content {\n\ttransition: .4s ease-in-out;\n  transform: translateY(100%);\n  opacity: 0;\n}\n\n.grid-26-card:hover .grid-26-card__content, .grid-26-card:focus-within .grid-26-card__content {\n\topacity: 1;\n  transform: translateY(0);\n}\n\n/* Heading Wrapper */\n.grid-26-card__heading-wrapper {\n\ttransition: .4s ease-in-out;\n  transform: translateX(0);\n}\n\n.grid-26-card:hover .grid-26-card__heading-wrapper, .grid-26-card:focus-within .grid-26-card__heading-wrapper {\n\topacity: 0;\n  transform: translateX(calc((100% + var(--space-m)) * -1));\n}\n\n.grid-26-card__heading {\n\ttransition: .4s ease-in-out;\n  writing-mode: vertical-rl;\n}\n\n.grid-26-card:hover .grid-26-card__heading, .grid-26-card:focus-within .grid-26-card__heading {\n\topacity: 0;\n}\n\n/* Overlay */\n.grid-26-card__overlay {\n\ttransition: .5s ease-in-out;\n  opacity: 0.4;\n}\n\n.grid-26-card:hover .grid-26-card__overlay, .grid-26-card:focus-within .grid-26-card__overlay {\n  opacity: 1;\n}\n\n/* Image */\n.grid-26-card__image {\n\ttransition: .8s ease-in-out;\n  filter: blur(.1rem) grayscale(1);\n}\n\n.grid-26-card:hover .grid-26-card__image, .grid-26-card:focus-within .grid-26-card__image {\n\tfilter: blur(0px) grayscale(0);\n  scale: 1.1;\n}\n\n@media (max-width: 767px) {\n  \n  .grid-26-card {\n\theight: 34rem;\n}\n  \n\t.grid-26-card:nth-child(odd), .grid-26-card:nth-child(even) {\n\tgrid-area: span 1;\n}\n}\n\n",
    "_justifyContent": "flex-end"
   }
  },
  {
   "id": "nszzkd",
   "name": "grid-26-card__heading-wrapper",
