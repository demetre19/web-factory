---
/**
 * bm-grid-19 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (grid-19.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="gridcard-19-container">
    <div class="gridcard-19-ct list--none">
      {items.map((it) => (
        <div class="gridcard-19-box">
          <div class="gridcard-19-article">
            <div class="gridcard-19-article__meta">
              <div class="gridcard-19-article__detail">
                <p class="gridcard-19-article__term">{it.text}</p>
                <h2 class="gridcard-19-article__title clickable-parent">{it.title}</h2>
              </div>
            </div>
            <div class="gridcard-19-article__media">
              <figure class="gridcard-19-article__thumb"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .gridcard-19-ct {
    display: grid;
    width: 100%;
    gap: 3.125em;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
  }

  .gridcard-19-article {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    grid-template-rows: auto 7.5em;
    position: relative;
    height: 100%;
  }

  .gridcard-19-article__meta {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-template-rows: repeat(1, minmax(0, auto));
    padding: var(--space-s) var(--space-s) var(--space-s) var(--space-s);
    background: var(--bg-canvas);
    /* bm: box-shadow omitted — token layer owns elevation */
  }

  .gridcard-19-article__detail {
    display: grid;
    gap: .5em;
  }

  .gridcard-19-article__thumb {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  /* bm-custom */
  .gridcard-19-box:nth-child(2) {
  	grid-row: span 2;
  }

  /* bm-custom */
  .gridcard-19-article:hover a {
  	color: var(--action-primary);
  }

  /* bm-custom */
  .gridcard-19-article__title > a::after {
  	z-index: 1;
  }
</style>
