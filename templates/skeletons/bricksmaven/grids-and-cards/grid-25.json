  {
   "id": "lpouii",
   "name": "grid-25-slider",
   "settings": {
    "_cssCustom": ".grid-25-slider .splide__track {\n\toverflow: visible;\n}\n\n.grid-25-slider::before {\n\tcontent: \"\";\n  width: 100vw;\n  max-width: 100vw;\n  height: 100%;\n  min-height: 100%;\n  max-height: 100%;\n  position: absolute;\n  top: 0;\n  right: 100%;\n  z-index: 1;\n  background-color: var(--white);\n  \n}\n\n\n.grid-25-slider .splide__arrows {\n  display: flex!important;\n  position: absolute;\n  gap: var(--space-xs);\n  top: calc(100% + var(--space-l));\n \tleft: 50%;\n  width: 100%;\n  justify-content: center;\n  transform: translateX(-50%);\n  z-index: 0;\n}\n\n.grid-25-slider .splide__arrow {\n    position: relative !important;\n}\n",
    "arrowSize": "2.4rem",
    "arrowColor": {
     "id": "acss_import_primary",
     "name": "primary",
     "raw": "var(--primary)"
    },
    "arrowDisabledColor": {
     "id": "acss_import_shade-light",
     "name": "shade-light",
     "raw": "var(--shade-light)"
    }
   }
  },
  {
   "id": "nasrbe",
   "name": "grid-25-card",
   "settings": {
    "_position": "relative",
    "_display": "flex",
    "_direction": "column",
    "_justifyContent": "flex-end",
    "_overflow": "hidden",
    "_cssCustom": "/* Card */\n\n.grid-25-card:focus-within :focus {\n\toutline: none;\n  box-shadow: none;\n}\n\n.grid-25-card:focus-within {\n\tbox-shadow: 0 0 10px 0 var(--black-trans-10);\n\n}\n\n/* Content */\n.grid-25-card__inner-content {\n  transition: .4s linear;\n\tbackdrop-filter: blur(1px);\n}\n\n.grid-25-card:hover .grid-25-card__inner-content, .grid-25-card:focus-within .grid-25-card__inner-content {\n\tbackdrop-filter: blur(0px);\n}\n\n.grid-25-card__heading {\n  transition: .4s linear;\n}\n\n.grid-25-card:hover .grid-25-card__heading, .grid-25-card:focus-within .grid-25-card__heading {\n\tcolor: var(--primary);\n}\n\n/* Image */\n.grid-25-card__image {\n\ttransition: .6s linear;\n}\n\n.grid-25-card:hover .grid-25-card__image, .grid-25-card:focus-within .grid-25-card__image {\n\tscale: 1.1;\n}\n\n/* Overlay */\n.grid-25-card__overlay {\n\ttransition: .8s linear;\n  opacity: 0.8;\n}\n\n.grid-25-card:hover .grid-25-card__overlay, .grid-25-card:focus-within .grid-25-card__overlay {\n\tbackground-image: linear-gradient(var(--shade-trans-10), var(--shade-trans-90));\n  opacity: 1;\n}"
   }
  },
