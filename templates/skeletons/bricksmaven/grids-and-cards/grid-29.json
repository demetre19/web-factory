   "id": "gvipbw",
   "name": "grid-29-card",
   "settings": {
    "_padding": {
     "top": "var(--space-m)",
     "right": "var(--space-m)",
     "bottom": "var(--space-m)",
     "left": "var(--space-m)"
    },
    "_rowGap": "var(--content-gap)",
    "_cssCustom": ".grid-29-card {\n\ttransition: .5s ease;\n}\n\n.grid-29-card:hover {\n\tbox-shadow: var(--box-shadow-l);\n  position:relative;\n  z-index: 99;\n}\n\n.grid-29-card:nth-child(1) {\n\tgrid-area: 1 / 1 / 10 / 2 ;\n}\n\n.grid-29-card:nth-child(2) {\n\tgrid-area: 3 / 2 / 12 / 3;\n}\n\n.grid-29-card:nth-child(3) {\n\tgrid-area: 5 / 3 / 14 / -1;\n}\n\n.grid-29-card:nth-child(4) {\n\tgrid-area: 10 / 1 / 20 / 2;\n}\n\n.grid-29-card:nth-child(5) {\n\tgrid-area: 12 / 2 / 21 / 3;\n}\n\n@media (max-width:600px) {\n\t.grid-29-card:nth-child(1), .grid-29-card:nth-child(2), .grid-29-card:nth-child(3), .grid-29-card:nth-child(4), .grid-29-card:nth-child(5) {\n  grid-column: span 1;\n    grid-row: span 1;\n  }\n}\n",
    "_border": {
     "width": {
      "top": ".1rem",
      "right": ".1rem",
      "bottom": ".1rem",
      "left": ".1rem"
     },
     "style": "solid",
