   "settings": {
    "_overflow": "hidden",
    "_flexWrap": "nowrap",
    "_cssCustom": "/* Card */\n.grid-30-card {\n\ttransition: .5s ease;\n  height: 46rem;\n  position: relative;\n  justify-content: end;\n  align-items: center;\n}\n\n.grid-30-card:focus-within :focus {\n\toutline: none;\n  box-shadow: none;\n}\n\n.grid-30-card:focus-within {\n  box-shadow: 0 0 1rem 0 var(--shade-light-trans-10);\n}\n\n/* Media */\n.grid-30-card__media {\n\tposition: absolute;\n  top: 0;\n  left:0;\n  bottom:0;\n  right:0;\n  transition: .5s ease;\n}\n\n/* Overlay */\n\n.grid-30-card__overlay {\n\tposition: absolute;\n  top: 0;\n  left:0;\n  bottom:0;\n  right:0;\n  z-index: 1;\n  transition: .5s ease;\n  opacity: .8;\n}\n\n.grid-30-card:hover .grid-30-card__overlay, .grid-30-card:focus-within .grid-30-card__overlay {\n\topacity: 1;\n}\n\n/* Content */\n\n.grid-30-card__content {\n\twidth:90%;\n  position: relative;\n  z-index: 2;\n  color: var(--white);\n}\n\n.grid-30-card__cta {\n\ttransition: .5s ease;\n  opacity: .3;\n}\n\n.grid-30-card:hover .grid-30-card__cta, .grid-30-card:focus-within .grid-30-card__cta {\n\topacity: 1;\n}\n\n"
   }
