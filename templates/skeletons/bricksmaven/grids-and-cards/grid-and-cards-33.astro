<style is:global>
@layer components {
  .bm-grid-33__container {
    row-gap: var(--space-s);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--flow-spacing);
    align-self: center;
  }

  .intro--split {
    display: grid;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    align-self: flex-start;
    grid-template-columns: calc(100% * 1 / 2);
    gap: var(--space-m);
  }

  .intro__left-column {
    row-gap: var(--flow-spacing);
  }

  .intro__right-column {
    row-gap: var(--flow-spacing);
  }

  .bm-grid-33-grid-ul {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 12);
    grid-template-rows: auto;
  }

  .bm-grid-33-card__image {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  .bm-grid-33-card {
    justify-content: space-between;
    background: var(--bg-subtle);
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    row-gap: var(--flow-spacing);
  }

  .bm-grid-33-card__intro {
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-grid-33-card__cta-wrapper {
    margin: auto 0 0 0;
  }

  /* bm-custom */
  .bm-grid-33-list:nth-child(1) {
    grid-column: 1 / 5;
    grid-row: 1/2;
  }
  
  .bm-grid-33-list:nth-child(2) {
    grid-column: 5 / 9;
    grid-row: 1/2;
  }
  
  .bm-grid-33-list:nth-child(3) {
    grid-column: 9 / -1;
    grid-row: 1/2;
  }
  
  .bm-grid-33-list:nth-child(4) {
    grid-column: 1 / 5;
    grid-row: 2/-1;
  }
  
  .bm-grid-33-list:nth-child(5) {
    grid-column: 5 / 9;
    grid-row: 2/-1;
  }
  
  .bm-grid-33-list:nth-child(6) {
    grid-column: 9 / -1;
    grid-row: 2/-1;
  }
  
  @media (max-width:991px) {
    .bm-grid-33-list:nth-child(1) {
    grid-column: span 6;
    grid-row: auto;
  }
  
  .bm-grid-33-list:nth-child(2) {
    grid-column: span 6;
    grid-row: auto;
  }
  
  .bm-grid-33-list:nth-child(3) {
    grid-column: 1 / -1;
    grid-row: 1;
    aspect-ratio: 2 / 1;
  }
  
  .bm-grid-33-list:nth-child(4) {
    grid-column: 1 / -1;
    grid-row: auto;
    aspect-ratio: 2 / 1;
  }
  
  .bm-grid-33-list:nth-child(5) {
    grid-column: span 6;
    grid-row: auto;
  }
  
  .bm-grid-33-list:nth-child(6) {
    grid-column: span 6;
    grid-row: auto;
  }
  }
  
  @media (max-width:478px) {
    .bm-grid-33-list:nth-child(odd), .bm-grid-33-list:nth-child(even) {
    grid-column: span 12;
    grid-row: auto;
      aspect-ratio: 1 / 1;
  }
    
    .bm-grid-33-list:nth-child(3) {
    grid-row: 1;
  }
  
  
  }
}
</style>
