---
/**
 * bm-grid-20 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (grid-20.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="gridcard-20-container">
    <div class="intro">
      <p class="intro__subheading">Lorem ipsum set dolor amet</p>
      <h2 class="intro__heading">{heading}</h2>
    </div>
    <div class="gridcard-20-ct list--none">
      {items.map((it) => (
        <div class="gridcard-20-box">
          <div class="gridcard-20-article">
            <div class="gridcard-20-article__meta">
              <h2 class="gridcard-20-article__title clickable-parent">{it.title}</h2>
              <p class="gridcard-20-article__excerpt">{it.text}</p>
              <a class="gridcard-20-article__cta" href={it.href}>{it.label}</a>
            </div>
            <div class="gridcard-20-article__media">
              <figure class="gridcard-20-article__thumb"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .gridcard-20-container {
    row-gap: var(--space-s);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .gridcard-20-ct {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5em 0.9375em;
  }

  .gridcard-20-article {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    position: relative;
  }

  .gridcard-20-article__meta {
    background: var(--bg-canvas);
    display: flex;
    padding: var(--space-s) var(--space-s) var(--space-s) var(--space-s);
    flex-direction: column;
    row-gap: var(--flow-spacing);
    align-items: flex-start;
    justify-content: center;
  }

  .gridcard-20-article__cta {
    padding: 0 0 0 0;
  }

  .gridcard-20-article__thumb {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  /* bm-custom */
  .gridcard-20-article:hover a {
  	color: var(--action-primary);
  }

  /* bm-custom */
  .gridcard-20-article__title > a::after {
  	z-index: 1;
  }
</style>
