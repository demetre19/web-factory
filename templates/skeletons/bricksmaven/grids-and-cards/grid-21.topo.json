   "custom_css": "/* Card */\n.grid-21-card {\n\toverflow: hidden;\n}\n\n.grid-21-card:focus-within :focus {\n\toutline: none;\n  box-shadow: none;\n}\n\n.grid-21-card:focus-within {\n\tbox-shadow: var(--box-shadow-m);\n}\n\n/* Content */\n\n.grid-21-card__content {\n  padding: var(--space-m);\n  color: var(--white);\n  transition: .6s linear .3s;\n  transform: translateY(12rem);\n  backdrop-filter: blur(1rem);\n}\n\n.grid-21-card:hover .grid-21-card__content,\n.grid-21-card:focus-within .grid-21-card__content {\n  transform: translateY(0rem);\n}\n\n.grid-21-card__text, .grid-21-card__link {\n  opacity: 0;\n  transition: 1s linear;\n}\n\n.grid-21-card:hover .grid-21-card__text, .grid-21-card:focus-within .grid-21-card__text, .grid-21-card:hover .grid-21-card__link, .grid-21-card:focus-within .grid-21-card__link {\n\topacity: 1;\n  display: block;\n}\n\n.grid-21-card__heading {\n  transition: 4s;\n}\n\n.grid-21-card:hover .grid-21-card__heading, .grid-21-card:focus-within .grid-21-card__heading {\n\twriting-mode: unset;\n} \n\n@media (max-width: 767px) {\n\t.grid-21-card__content {\n  transform: translateY(10rem);\n}\n}\n\n@media (max-width: 478px) {\n\t.grid-21-card__content {\n  transform: translateY(12rem);\n}\n}\n\n\n/* Image */\n.grid-21-card__image {\n  transition: 1s linear;  \n}\n\n.grid-21-card:hover .grid-21-card__image, .grid-21-card:focus-within .grid-21-card__image {\n  scale: 1.11; \n}\n\n/* Overlay */\n.grid-21-card__overlay {\n  opacity: 0.6;\n  transition: .3s linear;  \n}\n\n.grid-21-card:hover .grid-21-card__overlay, .grid-21-card:focus-within .grid-21-card__overlay {\n  opacity: 1; \n}\n",
