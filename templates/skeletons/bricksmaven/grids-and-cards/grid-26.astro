---
/**
 * bm-grid-26 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (grid-26.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="grid-26-container">
    <div class="intro">
      <h2 class="intro__heading">{heading}</h2>
      <p class="intro__subheading">{fs}</p>
      <p class="intro__accent-heading">Accent heading</p>
    </div>
    <div class="list--none grid-26-list">
      {items.map((it) => (
        <div class="grid-26-card">
          <div class="grid-26-card__heading-wrapper">
            <h2 class="grid-26-card__heading">{it.title}</h2>
          </div>
          <div class="grid-26-card__content">
            <p class="grid-26-card__psuedo-heading">{it.text}</p>
            <p class="grid-26-card__text">{it.text}</p>
          </div>
          <div class="grid-26-card__overlay"></div>
          <figure class="grid-26-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .grid-26-container {
    row-gap: var(--space-s);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .grid-26-list {
    display: grid;
    grid-template-columns: calc(100% * 1 / 3);
    gap: var(--space-m);
    grid-template-rows: repeat(14, minmax(5rem, 1fr));
  }

  .grid-26-card {
    position: relative;
    overflow: hidden;
    justify-content: flex-end;
  }

  .grid-26-card__heading-wrapper {
    position: absolute;
    top: var(--space-s);
    z-index: 3;
    left: var(--space-m);
  }

  .grid-26-card__content {
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    position: relative;
    display: flex;
    flex-direction: column;
    row-gap: calc(var(--flow-spacing) / 6);
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    justify-content: flex-end;
    background: color-mix(in srgb, var(--bg-subtle) 80%, transparent);
  }

  .grid-26-card__psuedo-heading {
    font-size: var(--fs-2);
    font-weight: 700;
  }

  .grid-26-card__overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
  }

  .grid-26-card__image {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    left: 0;
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  /* bm-custom */
  .grid-26-card:nth-child(1) {
  	grid-area: 1 / 1 / 7 / 2;
  }
  
  .grid-26-card:nth-child(2) {
  	grid-area: 1 / 2 / 5 / 3;
  }
  
  .grid-26-card:nth-child(3) {
  	grid-area: 1 / 3 / 7 / -1;
  }
  
  .grid-26-card:nth-child(4) {
  	grid-area: 7 / 1 / 12 / 2;
  }
  
  .grid-26-card:nth-child(5) {
  	grid-area: 5 / 2 / 12 / 3;
  }
  
  .grid-26-card:nth-child(6) {
  	grid-area: 7 / 3 / 12 / -1;
  }
  
  
  /* Card */
  
  .grid-26-card:focus-within :focus {
  	outline: none;
    box-shadow: none;
  }
  
  .grid-26-card:focus-within {
  	box-shadow: 0 0 10px 0 color-mix(in srgb, var(--text-primary) 10%, transparent);
  
  }
  
  
  /* Content */
  .grid-26-card__content {
  	transition: .4s ease-in-out;
    transform: translateY(100%);
    opacity: 0;
  }
  
  .grid-26-card:hover .grid-26-card__content, .grid-26-card:focus-within .grid-26-card__content {
  	opacity: 1;
    transform: translateY(0);
  }
  
  /* Heading Wrapper */
  .grid-26-card__heading-wrapper {
  	transition: .4s ease-in-out;
    transform: translateX(0);
  }
  
  .grid-26-card:hover .grid-26-card__heading-wrapper, .grid-26-card:focus-within .grid-26-card__heading-wrapper {
  	opacity: 0;
    transform: translateX(calc((100% + var(--space-m)) * -1));
  }
  
  .grid-26-card__heading {
  	transition: .4s ease-in-out;
    writing-mode: vertical-rl;
  }
  
  .grid-26-card:hover .grid-26-card__heading, .grid-26-card:focus-within .grid-26-card__heading {
  	opacity: 0;
  }
  
  /* Overlay */
  .grid-26-card__overlay {
  	transition: .5s ease-in-out;
    opacity: 0.4;
  }
  
  .grid-26-card:hover .grid-26-card__overlay, .grid-26-card:focus-within .grid-26-card__overlay {
    opacity: 1;
  }
  
  /* Image */
  .grid-26-card__image {
  	transition: .8s ease-in-out;
    filter: blur(.1rem) grayscale(1);
  }
  
  .grid-26-card:hover .grid-26-card__image, .grid-26-card:focus-within .grid-26-card__image {
  	filter: blur(0px) grayscale(0);
    scale: 1.1;
  }
  
  @media (max-width: 767px) {
    
    .grid-26-card {
  	height: 34rem;
  }
    
  	.grid-26-card:nth-child(odd), .grid-26-card:nth-child(even) {
  	grid-area: span 1;
  }
  }
</style>
