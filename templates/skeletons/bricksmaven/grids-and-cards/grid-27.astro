---
/**
 * bm-grid-27 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (grid-27.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="grid-27-container">
    <div class="intro-3col">
      <div class="intro__left">
        <h2 class="intro__heading">{heading}</h2>
        <p class="accent-h">Accent heading</p>
      </div>
      <div class="intro__mid">
        <p class="intro__subheading">{fs}</p>
      </div>
      <div class="intro__right">
        <a class="intro__link btn--black" href="#">More Services</a>
      </div>
    </div>
    <div class="grid-27-list list--none">
      {items.map((it) => (
        <div class="grid-27-card">
          <div class="grid-27-card__content">
            <p class="grid-27-card__number">{it.text}</p>
            <div class="grid-27-card__footer">
              <h2 class="grid-27-card__heading clickable-parent">{it.title}</h2>
              <p class="grid-27-card__text">{it.text}</p>
            </div>
          </div>
          <div class="grid-27-card__overlay"></div>
          <figure class="grid-27-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .grid-27-container {
    row-gap: var(--space-s);
  }

  .intro-3col {
    display: grid;
    grid-template-columns: calc(100% * 1 / 3);
    gap: var(--space-m);
  }

  .intro__right {
    align-items: flex-end;
    justify-content: center;
    display: flex;
    flex-direction: column;
  }

  .grid-27-list {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 3);
  }

  .grid-27-card {
    position: relative;
    height: 34rem;
  }

  .grid-27-card__content {
    z-index: 2;
    height: 100%;
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .grid-27-card__number {
    font-weight: 700;
  }

  .grid-27-card__footer {
    row-gap: calc(var(--flow-spacing) / 2.4);
  }

  .grid-27-card__overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .grid-27-card__image {
    object-fit: cover;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
  }

  /* bm-custom */
  @media (max-width:767px) {
    .grid-27-card:last-child {
    	grid-column: span 2;
    }
  }
  
  @media (max-width:478px) {
    .grid-27-card:last-child {
    	grid-column: span 1;
    }
  }
</style>
