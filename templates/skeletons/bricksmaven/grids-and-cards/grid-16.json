     "left": "var(--space-m)"
    },
    "_boxShadow": {
     "values": {
      "offsetX": "0",
      "offsetY": "4px",
      "blur": "28px"
     },
     "color": {
      "hex": "#282625",
      "rgb": "rgba(40, 38, 37, 0.1)",
      "hsl": "hsla(20, 4%, 15%, 0.1)"
     }
    },
    "_display": "flex",
    "_direction": "column",
    "_rowGap": "var(--space-xs)"
   }
  },
