   "id": "hphvxe",
   "name": "gridcard-16-card__box",
   "settings": {
    "_order": "1",
    "_background": {
     "color": {
      "raw": "var(--white)"
     }
    },
    "_width": "100%",
    "_zIndex": "1",
    "_padding": {
