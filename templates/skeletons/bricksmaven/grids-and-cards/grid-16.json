  },
  {
   "id": "lyqxjw",
   "name": "gridcard-16-container",
   "settings": {
    "_direction": "column",
    "_rowGap": "var(--container-gap)"
   }
  },
  {
   "id": "rawpaz",
   "name": "gridcard-16-head",
   "settings": {
    "_display": "flex",
    "_direction": "column",
    "_alignItems": "center",
    "_width": "100%",
    "_rowGap": "var(--space-s)",
    "_typography": {
     "text-align": "center"
    }
   }
  },
  {
   "id": "ngimwq",
   "name": "gridcard-16-head__title",
   "settings": {
    "_widthMax": "100%"
   }
  },
  {
   "id": "hkzwss",
   "name": "gridcard-16-head__desc",
   "settings": {
    "_widthMax": "60%",
    "_widthMax:mobile_landscape": "100%"
   }
  },
  {
   "id": "jayiir",
   "name": "gridcard-16-articles",
   "settings": {
    "_width": "100%",
    "_padding": {
     "top": "0",
     "right": "0",
     "bottom": "0",
     "left": "0"
    },
    "_margin": {
     "top": "0",
     "right": "0",
     "bottom": "0",
     "left": "0"
    },
    "_display": "grid",
    "_gridTemplateColumns": "repeat(2, minmax(0, 1fr))",
    "_gridTemplateRows": "repeat(2, minmax(0, 1fr))",
    "_gridTemplateColumns:mobile_landscape": "repeat(1, minmax(0, 1fr))",
    "_gridTemplateRows:mobile_landscape": "repeat(auto-fill, minmax(0, 1fr))",
    "_gridGap": "var(--grid-gap)"
   }
  },
  {
   "id": "acss_import_list--none",
   "name": "list--none",
   "settings": []
  },
  {
   "id": "exqits",
   "name": "gridcard-16-articles__item",
   "settings": {
    "_cssCustom": ".gridcard-16-articles__item:nth-child(3n+1) {\n\tgrid-column: span 2;\n}",
    "_cssCustom:mobile_landscape": ".gridcard-16-articles__item:nth-child(3n+1) {\n\tgrid-column: span 1;\n}"
   }
  },
  {
   "id": "owrwmv",
   "name": "gridcard-16-card",
   "settings": {
    "_display": "flex",
    "_direction": "column",
    "_alignItems": "center",
    "_cssCustom": ".gridcard-16-card:hover .gridcard-16-card__title {\n\tcolor: var(--primary); \n}",
    "_position": "relative"
   }
  },
