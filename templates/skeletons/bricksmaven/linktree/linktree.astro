---
/**
 * bm-linktree — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (linktree.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="linktree-container">
      <div class="linktree__content">
        <div class="linktree__brand">
          <span class="logo">{brand}</span>
          {fs && <p class="text-fluid-0">{fs}</p>}
        </div>
        <div class="linktree-list">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="linktree-card card">
                <a class="text-fluid-0" href={it.href}>{it.label}</a>
              </div>
            ))}
          </div>
        </div>
        <div class="linktree-social">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="card">
                <span data-icon="lucide" aria-hidden="true"></span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
