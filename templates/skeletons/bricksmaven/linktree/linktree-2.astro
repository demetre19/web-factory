---
/**
 * bm-linktree-2 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (linktree-2.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-linktree-2__container">
      <div class="bm-linktree-2__bio-wrapper">
        <div class="bm-linktree-2-bio">
          <div class="bm-linktree-2-bio__bio-data grid-auto gap-fluid-l">
            <figure class="bm-linktree-2-bio__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            <div></div>
            {fs && <p class="text-fluid-0">{fs}</p>}
          </div>
        </div>
        <div class="bm-linktree-2__links">
          <div class="bm-linktree-list">
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="bm-linktree-card card">
                  <a class="text-fluid-0" href={it.href}>{it.label}</a>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="bm-linktree-2__socials">
          <div class="bm-social-share bm-social-share--left">
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="card">
                  <span data-icon="lucide" aria-hidden="true"></span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
