            <div class="bm-social-share bm-social-share--left">
              <div class="grid-auto gap-fluid-m">
                {(items || []).map((it) => (
                  <div class="card">
                    <span data-icon="lucide" aria-hidden="true"></span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
        <div class="bm-linktree-10__links">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="bm-linktree-9__link-row card">
                <h2 class="text-fluid-2">{it.title}</h2>
                <div class="bm-linktree-list">
                  <div class="grid-auto gap-fluid-m">
                    {((it.items || []) || []).map((it2) => (
                      <div class="bm-linktree-card card">
                        <a class="text-fluid-0" href={it2.href}>{it2.label}</a>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
