---
/**
 * bm-portfolio-single-9 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (portfolio-single-9.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-portfolio-single-9__hero-container grid-auto gap-fluid-l">
      <div class="bm-portfolio-single-9__content">
        {heading && <h1 class="text-fluid-4">{heading}</h1>}
        {fs && <p class="text-fluid-0">{fs}</p>}
        <div class="bm-live-website-btn">
          <div class="bm-live-website-btn__dot"></div>
        </div>
      </div>
      <figure class="bm-portfolio-single-9__background-image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
    </div>
    <div class="bm-portfolio-single-9__paragraph">
      <div class="bm-portfolio-single-9__paragraph-content"></div>
    </div>
    <div class="bm-portfolio-single-9__media-container">
      <div class="bm-portfolio-single-media-list">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="card">
              <figure class="bm-portfolio-single-media-item__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="bm-portfolio-single-9__paragraph">
      <div class="bm-portfolio-single-9__paragraph-content"></div>
    </div>
    <div>
      <div class="bm-portfolio-single-media-list-2col">
        <div>
          <figure class="bm-portfolio-single-media-item-2col__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
        <div>
          <figure class="bm-portfolio-single-media-item-2col__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
      </div>
    </div>
    <div class="bm-portfolio-single-9__paragraph">
      <div class="bm-portfolio-single-9-testimonial"></div>
    </div>
    <div class="bm-portfolio-single-9__cta-container grid-auto gap-fluid-l">
      <div class="bm-contact-widget-9">
        <p class="mt-fluid-m"><a class="wf-cta-button" href={cta.href}>{cta.label || 'Continue'}</a></p>
      </div>
      <figure class="bm-contact-widget-9__background-image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
    </div>
    <div class="bm-portfolio-single-9__footer-container">
      <div class="bm-portfolio-7-related-list">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="bm-portfolio-7-related-card card">
              <div class="bm-portfolio-7-related-card__content">
                <h2 class="text-fluid-2">{it.title}</h2>
                <a class="text-fluid-0" href={it.href}>{it.label}</a>
              </div>
              <div class="bm-portfolio-7-related-card__media">
                <figure class="bm-portfolio-7-related-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
