  }

  /* bm-custom */
  .bm-portfolio-7-related-card:not(:nth-child(2)) {
    margin-block-start: var(--space-m);
  }
  
  /*  Scale images on hover */
  .bm-portfolio-7-related-card__image { 
    transition: 0.5s linear;
  }
  
  .bm-portfolio-7-related-card:hover .bm-portfolio-7-related-card__image, .bm-portfolio-7-related-card:focus-within .bm-portfolio-7-related-card__image {
