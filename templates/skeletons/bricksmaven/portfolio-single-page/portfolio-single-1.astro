---
/**
 * bm-portfolio-single-1 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (portfolio-single-1.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-portfolio-single-1__container">
    <div class="bm-portfolio-single-1__aside">
      <h1 class="bm-portfolio-single-1__heading">Sparking a 45% Sales Surge for EcoEssentials</h1>
      <div class="bm-live-website-btn">
        <div class="bm-live-website-btn__dot"></div>
        <p class="bm-live-website-btn__text clickable-parent">Visit website</p>
      </div>
      <div class="bm-portfolio-single-meta-data-1">
        {items.map((it) => (
          <div class="bm-portfolio-single-meta-data-item-1">
            <p class="bm-portfolio-single-meta-data-item-1__type">{it.text}</p>
            <p class="bm-portfolio-single-meta-data-item-1__label">{it.text}</p>
          </div>
        ))}
      </div>
      <div class="bm-portfolio-single-1__story-content">
        <p class="bm-portfolio-single-1__story">EcoEssentials, while passionate about its mission, faced a common e-commerce hurdle: stagnant online sales and low brand visibility. Despite offering high-quality, ethically sourced products, their website traffic was minimal, bounce rates were high, and conversion rates lagged significantly behind industry averages. They needed a strategic intervention to connect with their target audience and translate interest into purchases.</p>
      </div>
      <div class="bm-contact-widget-2">
        <h2 class="bm-contact-widget-2__heading">Ready to start a project?</h2>
        <div class="bm-contact-widget-2__footer">
          <div class="bm-contact-widget-2__media">
            <figure class="bm-contact-widget-2__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
          <div class="bm-contact-widget-2__data">
            <p class="bm-contact-widget-2__name">Alan Smith</p>
            <p class="bm-contact-widget-2__title">Account manager</p>
          </div>
          <div class="bm-contact-widget-link">
            <div class="bm-contact-widget-link__icon-wrapper">
              <span class="bm-contact-widget-link__icon" data-icon="lucide" aria-hidden="true"></span>
            </div>
            <p class="bm-contact-widget-link__data clickable-parent">+000 123 456 789</p>
          </div>
        </div>
      </div>
    </div>
    <div class="bm-portfolio-single-1__content">
      <div class="bm-portfolio-single-1-media list--none">
        {items.map((it) => (
          <div class="bm-portfolio-single-1-case-piece">
            <figure class="bm-portfolio-single-1-case-piece__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        ))}
      </div>
      <div class="bm-portfolio-single-1-testimonial">
        <h2 class="bm-portfolio-single-1-testimonial__heading">Warm words from our client</h2>
        <div class="testimonial-17-list-card">
          <div class="testimonial-17-list-card__wrapper">
            <div class="testimonial-17-list-card__content">
              <p class="testimonial-17-list-card__desc">Lorem Ipsum is simply a dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s</p>
              <p class="testimonial-17-list-card__author">-John Doe, Founder of Lorem Ipsum</p>
            </div>
            <div class="testimonial-17-list-card__media">
              <figure class="testimonial-17-list-card__image"><img src="/media/placeholder.svg" alt="Photo" loading="lazy" width="900" height="600" /></figure>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="bm-contact-widget-2">
      <h2 class="bm-contact-widget-2__heading">Ready to start a project?</h2>
      <div class="bm-contact-widget-2__footer">
        <div class="bm-contact-widget-2__media">
          <figure class="bm-contact-widget-2__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
        <div class="bm-contact-widget-2__data">
          <p class="bm-contact-widget-2__name">Alan Smith</p>
          <p class="bm-contact-widget-2__title">Account manager</p>
        </div>
        <div class="bm-contact-widget-link">
          <div class="bm-contact-widget-link__icon-wrapper">
            <span class="bm-contact-widget-link__icon" data-icon="lucide" aria-hidden="true"></span>
          </div>
          <p class="bm-contact-widget-link__data clickable-parent">+000 123 456 789</p>
        </div>
      </div>
    </div>
  </div>
  <div class="bm-portfolio-single-1__footer-container">
    <h2 class="bm-portfolio-single-1__heading">Related case studies</h2>
    <div class="bm-portfolio-related-list list--none">
      <div class="bm-portfolio-related-card">
        <div class="bm-portfolio-related-card__content">
          <h2 class="bm-portfolio-related-card__heading">Firefly Productions</h2>
          <p class="bm-portfolio-related-card__accent=heading">Category</p>
        </div>
        <figure class="bm-portfolio-related-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
      <div class="bm-portfolio-related-card">
        <div class="bm-portfolio-related-card__content">
          <h2 class="bm-portfolio-related-card__heading">Firefly Productions</h2>
          <p class="bm-portfolio-related-card__accent=heading">Category</p>
        </div>
        <figure class="bm-portfolio-related-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
    </div>
  </div>
  <div></div>
</div>

<style is:global>
@layer components {
  .bm-portfolio-single-1 {
    row-gap: var(--space-s);
  }

  .bm-portfolio-single-1__container {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 2);
  }

  .bm-portfolio-single-1__aside {
    background: var(--bg-subtle);
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    row-gap: var(--flow-spacing);
  }

  .bm-live-website-btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    column-gap: calc(var(--flow-spacing) / 4);
    background: var(--action-primary);
    padding: calc(var(--space-xs) / 2) var(--space-s) calc(var(--space-xs) / 2) var(--space-s);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    position: relative;
  }

  .bm-live-website-btn__dot {
    width: 8;
    height: 8;
    background: var(--bg-subtle);
    border-radius: 100% 100% 100% 100%;
  }

  .bm-portfolio-single-meta-data-1 {
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-portfolio-single-meta-data-item-1__label {
    font-weight: 700;
  }

  .bm-contact-widget-2 {
    background: var(--bg-subtle);
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    row-gap: var(--flow-spacing);
  }

  .bm-contact-widget-2__footer {
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-contact-widget-2__image {
    object-fit: cover;
    width: 128;
    height: 128;
    border-radius: 100% 100% 100% 100%;
  }

  .bm-contact-widget-2__name {
    font-weight: 700;
  }

  .bm-contact-widget-link {
    display: flex;
    align-items: center;
    column-gap: calc(var(--flow-spacing) / 2);
    padding: calc(var(--space-xs) / 2) var(--space-xs) calc(var(--space-xs) / 2) var(--space-xs);
    background: var(--color-ink-secondary);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    position: relative;
  }

  .bm-contact-widget-link__icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-subtle);
    border-radius: 100% 100% 100% 100%;
    width: 32;
    height: 32;
  }

  .bm-portfolio-single-1__content {
    row-gap: var(--flow-spacing);
  }

  .bm-portfolio-single-1-media {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 2);
  }

  .bm-portfolio-single-1-case-piece__image {
    object-fit: cover;
  }

  .bm-portfolio-single-1-testimonial {
    row-gap: var(--flow-spacing);
    padding: var(--space-l) var(--space-l) var(--space-l) var(--space-l);
    background: var(--bg-subtle);
  }

  .testimonial-17-list-card {
    display: flex;
  }

  .testimonial-17-list-card__wrapper {
    gap: 0;
    display: flex;
    column-gap: var(--flow-spacing);
  }

  .testimonial-17-list-card__content {
    display: flex;
    flex-direction: column;
    width: calc(100% - 7rem);
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .testimonial-17-list-card__author {
    font-size: var(--fs-0);
  }

  .testimonial-17-list-card__image {
    overflow: hidden;
    width: 7rem;
    height: 7rem;
    object-fit: cover;
    border-radius: 100% 100% 100% 100%;
  }

  .bm-portfolio-single-1__footer-container {
    row-gap: var(--space-s);
  }

  .bm-portfolio-related-list {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 2);
  }

  .bm-portfolio-related-card {
    position: relative;
    justify-content: flex-end;
  }

  .bm-portfolio-related-card__content {
    position: relative;
    z-index: 1;
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    row-gap: calc(var(--flow-spacing) / 2);
    display: flex;
  }

  .bm-portfolio-related-card__image {
    object-fit: cover;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
  }

  /* bm-custom */
  .bm-live-website-btn__dot {
    --shadow-m:  0 0 4px 2px rgba(255, 255, 255, 0.2);
    --shadow-xl: 0 0 16px 8px rgba(255, 255, 255, 0.8);
  	--animation-duration-up: 1.2s;
    --shadow-light: var(--shadow-card);
    --shadow-heavy: var(--shadow-card);
    --animation-iteration-count: infinite;
    --animation-direction: alternate;
    --animation-timing-function-up: linear;
  }
  
  /* Define the animation for the first child */
  .bm-live-website-btn__dot{
    animation: glow var(--primitive-duration-med) var(--primitive-ease) var(--primitive-ease) var(--primitive-ease);
  }
  
  /* Define the animations ending point for the first child */
  @keyframes glow {
    0% {
      box-shadow: var(--shadow-card);
    }
    100% {
      box-shadow: var(--shadow-card);
    }
  }

  /* bm-custom */
  .bm-live-website-btn__text {
    --link-color: var(--bg-canvas);
    --link-color-hover: var(--color-line-default);
  }

  /* bm-custom */
  .bm-contact-widget-link__data {
    --link-color: var(--bg-canvas);
    --link-color-hover: var(--color-line-default);
  }

  /* bm-custom */
  .bm-portfolio-single-1-case-piece:first-child {
    grid-column: span 2;
  }

  /* bm-custom */
  .testimonial-17-list-card__author span {
  	text-decoration: underline;
    text-decoration-color: var(--action-primary);
    text-decoration-thickness: .2rem;
  }

  /* bm-custom */
  .bm-portfolio-related-card {
    aspect-ratio: 4/3;
  }
}
</style>
