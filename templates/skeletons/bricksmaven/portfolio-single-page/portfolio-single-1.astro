---
/**
 * bm-portfolio-single-1 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (portfolio-single-1.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-portfolio-single-1__container">
      <div class="bm-portfolio-single-1__aside">
        {heading && <h1 class="text-fluid-4">{heading}</h1>}
        <div class="bm-live-website-btn">
          <div class="bm-live-website-btn__dot"></div>
        </div>
        <div class="bm-portfolio-single-meta-data-1">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="card">
                <p class="text-fluid-0">{it.text}</p>
                <p class="text-fluid-0">{it.text}</p>
              </div>
            ))}
          </div>
        </div>
        <div>
          {fs && <p class="text-fluid-0">{fs}</p>}
        </div>
        <div class="bm-contact-widget-2">
          <div class="bm-contact-widget-2__footer">
            <div>
              <figure class="bm-contact-widget-2__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            </div>
            <div></div>
            <div class="bm-contact-widget-link">
              <div class="bm-contact-widget-link__icon-wrapper">
                <span data-icon="lucide" aria-hidden="true"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="bm-portfolio-single-1__content">
        <div class="bm-portfolio-single-1-media">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="card">
                <figure class="bm-portfolio-single-1-case-piece__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
            ))}
          </div>
        </div>
        <div class="bm-portfolio-single-1-testimonial">
          <div class="testimonial-17-list-card">
            <div class="testimonial-17-list-card__wrapper">
              <div class="testimonial-17-list-card__content"></div>
              <div>
                <figure class="testimonial-17-list-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="Photo" loading="lazy" width="900" height="600" /></figure>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="bm-contact-widget-2">
        <div class="bm-contact-widget-2__footer">
          <div>
            <figure class="bm-contact-widget-2__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
          <div></div>
          <div class="bm-contact-widget-link">
            <div class="bm-contact-widget-link__icon-wrapper">
              <span data-icon="lucide" aria-hidden="true"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="bm-portfolio-single-1__footer-container">
      <div class="bm-portfolio-related-list">
        <div class="bm-portfolio-related-card grid-auto gap-fluid-l">
          <div class="bm-portfolio-related-card__content"></div>
          <figure class="bm-portfolio-related-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
        <div class="bm-portfolio-related-card grid-auto gap-fluid-l">
          <div class="bm-portfolio-related-card__content"></div>
          <figure class="bm-portfolio-related-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
      </div>
    </div>
    <div></div>
  </div>
</div>
