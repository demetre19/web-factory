  {
   "id": "wqfgkp",
   "name": "text-basic",
   "parent": "stousv",
   "children": [],
   "settings": {
    "text": "Within six months of implementing PixelPundits' strategy, EcoEssentials experienced a dramatic transformation:",
    "tag": "p",
    "_cssGlobalClasses": [
     "hidkqc"
    ]
   },
   "label": "Subheading"
  },
  {
   "id": "pxcvqg",
   "name": "text",
   "parent": "tmnmfh",
   "children": [],
   "settings": {
    "text": "<ol><li>45% Increase in Online Sales: The most significant outcome, directly attributed to improved website performance and increased qualified traffic.\u2028</li><li>120% Rise in Organic Website Traffic: Thanks to enhanced SEO and a robust content marketing strategy, EcoEssentials saw a substantial increase in visitors from search engines.\u2028</li><li>60% Reduction in Bounce Rate: The redesigned website and improved user experience kept visitors engaged and exploring more pages.\u2028</li><li>25% Improvement in Conversion Rate: A more streamlined checkout process and trust-building elements led to a higher percentage of visitors making a purchase.\u2028</li><li>Expanded Reach and Brand Awareness: Social media campaigns significantly broadened EcoEssentials' audience, leading to increased brand mentions and engagement.</li></ol>",
    "_cssGlobalClasses": [
     "srvbza"
    ]
   }
