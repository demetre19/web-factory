---
/**
 * bm-portoflio-single-3 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (portoflio-single-3.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string; term?: string;
             label?: string; href?: string;
             icon?: string; items?: any[] }[];
  image?: { src: string; alt: string };
  copy?: any;
  h1?: boolean;
}
import { inline } from '../_shared/inline';
import IconChip from '../_shared/IconChip.astro';
import { Image } from 'astro:assets';
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
  image,
  copy,
  h1 = false,
} = Astro.props;
// §4.3 — a copy slot binds verbatim article copy onto
// the skeleton's native props (F.1 — nothing dropped)
const cp = copy || {};
const head = cp.heading || heading;
const sub = cp.answer || cp.text || fs;
const before = cp.before || [];
const list = (cp.items && cp.items.length
  ? cp.items : items) || [];
const qas = cp.qa || [];
const links = cp.links || [];
const after = cp.after || [];
const act = cp.cta || cta;
const phone = cp.phone || '';
const tel = phone ? 'tel:' + phone.replace(/[^0-9+]/g, '') : '';
// V.8/P.12 — rasters resolve through src/assets/media/
// so <Image> compiles AVIF/WebP srcsets
const _media = import.meta.glob('../assets/media/*.{jpg,jpeg,png,webp}', { eager: true });
const _mn = image ? String(image.src).split('/').pop() : null;
const mediaSrc = _mn ? (_media[`../assets/media/${_mn}`]?.default ?? null) : null;
---

<div class="wf-portoflio-single-3">
  <div class="sec-inner">
    <div class="bm-portfolio-single-3__container">
      <div class="bm-portfolio-single-3__intro">
        {head && (h1 ? <h1 class="text-fluid-4">{head}</h1> : <h2 class="text-fluid-2">{head}</h2>)}
        {sub && <p class="text-fluid-0" set:html={inline(sub)} />}
              </div>
      {before.length > 0 && <div class="flow mt-stack">
{before.map((p) => <p class="mt-flow text-fluid-0" set:html={inline(p)} />)}
      </div>}

      {image &&       <div>
        {image && image.src && <figure class="ratio-portrait"><div class="media-round" data-ratio={image.ratio || null}><Image src={mediaSrc || image.src} alt={image.alt || ''} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 50vw, 100vw" width={900} height={600} loading="lazy" /></div></figure>}
      </div>
      }
      <div class="bm-portfolio-single__case-section-1">
        <div class="bm-2col-media">
          {image &&           <div>
            {image && image.src && <figure class="ratio-portrait"><div class="media-round" data-ratio={image.ratio || null}><Image src={mediaSrc || image.src} alt={image.alt || ''} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 50vw, 100vw" width={900} height={600} loading="lazy" /></div></figure>}
          </div>
          }
          {image &&           <div>
            {image && image.src && <figure class="ratio-portrait"><div class="media-round" data-ratio={image.ratio || null}><Image src={mediaSrc || image.src} alt={image.alt || ''} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 50vw, 100vw" width={900} height={600} loading="lazy" /></div></figure>}
          </div>
          }
        </div>
      </div>
      {image &&       <div>
        {image && image.src && <figure class="ratio-portrait"><div class="media-round" data-ratio={image.ratio || null}><Image src={mediaSrc || image.src} alt={image.alt || ''} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 50vw, 100vw" width={900} height={600} loading="lazy" /></div></figure>}
      </div>
      }
      {image &&       <div class="bm-portfolio-single__case-section-1">
        {image &&         <div class="bm-portfolio-single__solution-wrapper">
          {image &&           <div>
            {image && image.src && <figure class="ratio-portrait"><div class="media-round" data-ratio={image.ratio || null}><Image src={mediaSrc || image.src} alt={image.alt || ''} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 50vw, 100vw" width={900} height={600} loading="lazy" /></div></figure>}
          </div>
          }
        </div>
        }
      </div>
      }
      {links.length > 0 &&       <div class="bm-portfolio-single__case-section-2">
        {links.length > 0 && <div class="bm-portfolio-single-result-list bm-portfolio-single-result-list--alt">{(links || []).map((it) => (
              <div class="bm-portfolio-single-result-item card">
                {it.icon && <IconChip name={it.icon} />}
                <h3 class="text-fluid-1">{it.term || it.title}</h3>
                <p class="text-fluid-0">{it.text}</p>
                <p class="text-fluid-0">{it.text}</p>
              </div>
            ))}</div>}
      </div>
      }
      {image &&       <div class="bm-portfolio-single-testimonial-3">
        {image &&         <div class="testimonial-list-card__profile">
          {image &&           <div>
            {image && image.src && <figure class="ratio-portrait"><div class="media-round" data-ratio={image.ratio || null}><Image src={mediaSrc || image.src} alt={image.alt || ''} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 50vw, 100vw" width={900} height={600} loading="lazy" /></div></figure>}
          </div>
          }
        </div>
        }
      </div>
      }
    </div>
    <div class="bm-portfolio-single-3__cta-container">
      <div class="bm-contact-widget-4">
        <div class="bm-contact-widget-4__manager-data">
          {image &&           <div>
            {image && image.src && <figure class="ratio-portrait"><div class="media-round" data-ratio={image.ratio || null}><Image src={mediaSrc || image.src} alt={image.alt || ''} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 50vw, 100vw" width={900} height={600} loading="lazy" /></div></figure>}
          </div>
          }
          {links.length > 0 &&           <div class="bm-contact-widget-4__data">
            {links.length > 0 && <div class="bm-contact-25-side-list-ul">
              <div class="grid-auto gap-fluid-m">{(links || []).map((it) => (
                  <div class="bm-contact-25-side-list-item card">
                    <div class="bm-contact-25-side-list-item__detail">
                      <h3 class="text-fluid-1"><a class="text-fluid-0" href={it.href}>{it.icon && <IconChip name={it.icon} />} {it.label || it.term || it.anchor || it.text}</a></h3>
                      {(it.label || it.term || it.anchor) && it.text && <p class="text-fluid-0">{it.text}</p>}
                    </div>
                  </div>
                ))}</div>
            </div>}
          </div>
          }
        </div>
      </div>
    </div>
    {links.length > 0 &&     <div class="bm-portfolio-single-3__footer-container">
      {links.length > 0 && <div class="bm-portfolio-2-related-list">{(links || []).map((it) => (
            <div class="card">
              <div class="bm-portfolio-2-related-card__content">
                <div class="bm-portfolio-2-related-card__top">
                  {it.icon && <IconChip name={it.icon} />}
                  <h3 class="text-fluid-1">{it.term || it.title}</h3>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
                <p class="text-fluid-0">{it.text}</p>
              </div>
            </div>
          ))}</div>}
    </div>
    }
  </div>
  {list.length > 0 && <dl class="mt-stack list-plain flow-list">{list.map((it) => <div class="flow-row">{it.icon && <IconChip name={it.icon} />}<dt class="text-fluid-0" set:html={inline(it.term || it.title || it.label || '')} />{it.text && <dd class="text-fluid-0" set:html={inline(it.text)} />}</div>)}</dl>}
  {qas.length > 0 && <dl class="mt-stack">{qas.map((qa) => <><dt class="text-fluid-0" set:html={inline(qa.q)} /><dd class="text-fluid-0" set:html={inline(qa.a)} /></>)}</dl>}
  {links.length > 0 && <div class="flow mt-stack">{links.map((l) => <p class="text-fluid-0" set:html={inline(l.text || `[${l.anchor}](${l.href})`)} />)}</div>}
  {after.length > 0 && <div class="flow mt-stack">{after.map((p) => <p class="text-fluid-0" set:html={inline(p)} />)}</div>}
  {tel && <p class="mt-stack"><a class="link-quiet" href={tel}>{phone}</a></p>}
</div>
