---
/**
 * bm-portoflio-single-3 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (portoflio-single-3.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-portfolio-single-3__container">
      <div class="bm-portfolio-single-3__intro">
        {heading && <h1 class="text-fluid-4">{heading}</h1>}
        {fs && <p class="bm-portfolio-single-3__intro-text text-fluid-0">{fs}</p>}
        <div class="bm-live-website-btn">
          <div class="bm-live-website-btn__dot"></div>
        </div>
      </div>
      <div class="bm-full-width-media">
        <figure class="bm-full-width-media__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
      <div class="bm-portfolio-single__case-section-1">
        <div class="bm-portfolio-single-intro-inline"></div>
        <div class="bm-2col-media">
          <div>
            <figure class="bm-2col-media-item__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
          <div>
            <figure class="bm-2col-media-item__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      </div>
      <div class="bm-portfolio-single__case-section-1">
        <div class="bm-portfolio-single-intro-inline bm-portfolio-single-intro-inline--alt"></div>
        <div class="bm-portfolio-single__case-section-content-wrapper">
          <div class="bm-portfolio-single__case-section-content"></div>
        </div>
      </div>
      <div>
        <figure class="bm-1col-media__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
      <div class="bm-portfolio-single__case-section-1">
        <div class="bm-portfolio-single-intro-inline"></div>
        <div class="bm-portfolio-single__solution-wrapper">
          <div></div>
          <div>
            <figure class="bm-portfolio-single__solution-image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      </div>
      <div class="bm-portfolio-single__case-section-2">
        <div class="bm-portfolio-single-2-intro-stacked"></div>
        <div class="bm-portfolio-single-result-list bm-portfolio-single-result-list--alt">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="bm-portfolio-single-result-item card">
                <h2 class="text-fluid-2">{it.title}</h2>
                <p class="text-fluid-0">{it.text}</p>
                <p class="text-fluid-0">{it.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="bm-span2-media">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="card">
              <figure class="bm-span2-media-item__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            </div>
          ))}
        </div>
      </div>
      <div class="bm-portfolio-single-testimonial-3">
        <div class="testimonial-list-card__profile">
          <div class="testimonial-list-card__meta"></div>
          <div>
            <figure class="testimonial-list-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      </div>
    </div>
    <div class="bm-portfolio-single-3__cta-container">
      <div class="bm-contact-widget-4">
        <div class="bm-contact-widget-4__manager-data">
          <div class="bm-contact-widget-4__media">
            <figure class="bm-contact-widget-4__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
          <div class="bm-contact-widget-4__data">
            <div></div>
            <div class="bm-live-website-btn">
              <div class="bm-live-website-btn__dot"></div>
            </div>
            <div class="bm-contact-25-side-list-ul">
              <div class="bm-contact-25-side-list-item">
                <div class="bm-contact-25-side-list-item__detail"></div>
                <span class="bm-contact-25-side-list-item__icon" data-icon="lucide" aria-hidden="true"></span>
              </div>
              <div class="bm-contact-25-side-list-item">
                <div class="bm-contact-25-side-list-item__detail"></div>
                <span class="bm-contact-25-side-list-item__icon" data-icon="lucide" aria-hidden="true"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="bm-portfolio-single-3__footer-container">
      <div class="bm-portfolio-2-related-list">
        <div>
          <div class="bm-portfolio-2-related-card__content">
            <div class="bm-portfolio-2-related-card__top"></div>
          </div>
          <div>
            <figure class="bm-portfolio-2-related-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
        <div>
          <div class="bm-portfolio-2-related-card__content">
            <div class="bm-portfolio-2-related-card__top"></div>
          </div>
          <div>
            <figure class="bm-portfolio-2-related-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
