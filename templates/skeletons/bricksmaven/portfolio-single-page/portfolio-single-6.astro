---
/**
 * bm-portfolio-single-6 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (portfolio-single-6.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div>
      <div class="bm-portfolio-single-6__intro">
        {heading && <h1 class="text-fluid-4">{heading}</h1>}
        {fs && <p class="bm-portfolio-single-6__intro-text text-fluid-0">{fs}</p>}
        <div class="bm-portfolio-single-6-breadcrumbs"></div>
        <div class="bm-portfolio-single-6-expertise-list">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="bm-portfolio-single-6-expertise-item card">
                <a class="text-fluid-0" href={it.href}>{it.label}</a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
    <div class="bm-portfolio-single-6-case-container">
      <div>
        <div>
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="bm-portfolio-single-6-case-container__slide card">
                <figure class="bm-portfolio-single-6-case-container__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
    <div class="bm-portfolio-single-6__content-container">
      <div class="bm-portfolio-single-6__content">
        <div class="bm-portfolio-single-6__column"></div>
        <div>
          <figure class="bm-1col-media__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
        <div class="bm-portfolio-single-6__column"></div>
        <div class="bm-portfolio-single-testimonial-3">
          <div class="testimonial-list-card__profile">
            <div class="testimonial-list-card__meta"></div>
            <div>
              <figure class="testimonial-list-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            </div>
          </div>
        </div>
      </div>
      <div class="bm-portfolio-single-6__aside">
        <div class="bm-live-website-btn">
          <div class="bm-live-website-btn__dot"></div>
        </div>
        <div>
          <div class="bm-contact-widget-2">
            <div class="bm-contact-widget-2__footer">
              <div>
                <figure class="bm-contact-widget-2__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
              <div></div>
              <div class="bm-contact-widget-link">
                <div class="bm-contact-widget-link__icon-wrapper">
                  <span data-icon="lucide" aria-hidden="true"></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="bm-portfolio-single-6__footer-container">
      <div class="bm-portfolio-5-related-list">
        <div class="bm-portfolio-5-related-card grid-auto gap-fluid-l">
          <figure class="bm-portfolio-5-related-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
        <div class="bm-portfolio-5-related-card grid-auto gap-fluid-l">
          <figure class="bm-portfolio-5-related-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
      </div>
    </div>
  </div>
</div>
