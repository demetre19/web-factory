---
/**
 * bm-portfolio-single-6 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (portfolio-single-6.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string; term?: string;
             label?: string; href?: string;
             icon?: string; items?: any[] }[];
  image?: { src: string; alt: string };
  copy?: any;
}
import { inline } from '../_shared/inline';
import { Image } from 'astro:assets';
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
  image,
  copy,
} = Astro.props;
// §4.3 — a copy slot binds verbatim article copy onto
// the skeleton's native props (F.1 — nothing dropped)
const cp = copy || {};
const head = cp.heading || heading;
const sub = cp.answer || cp.text || fs;
const before = cp.before || [];
const list = (cp.items && cp.items.length
  ? cp.items : items) || [];
const qas = cp.qa || [];
const links = cp.links || [];
const after = cp.after || [];
const act = cp.cta || cta;
const phone = cp.phone || '';
const tel = phone ? 'tel:' + phone.replace(/[^0-9+]/g, '') : '';
// V.8/P.12 — rasters resolve through src/assets/media/
// so <Image> compiles AVIF/WebP srcsets
const _media = import.meta.glob('../assets/media/*.{jpg,jpeg,png,webp}', { eager: true });
const _mn = image ? String(image.src).split('/').pop() : null;
const mediaSrc = _mn ? (_media[`../assets/media/${_mn}`]?.default ?? null) : null;
---

<div>
  <div class="sec-inner">
    <div>
      <div class="bm-portfolio-single-6__intro">
        {head && <h1 class="text-fluid-4">{head}</h1>}
        {sub && <p class="bm-portfolio-single-6__intro-text text-fluid-0" set:html={inline(sub)} />}
        {before.map((p) => <p class="mt-stack text-fluid-0" set:html={inline(p)} />)}
        <div class="bm-portfolio-single-6-breadcrumbs"></div>
        {list.length > 0 &&         <div class="bm-portfolio-single-6-expertise-list">
          {list.length > 0 && <div class="grid-auto gap-fluid-m">{(list || []).map((it) => (
              <div class="bm-portfolio-single-6-expertise-item card">
                <a class="text-fluid-0" href={it.href}>{it.label || it.anchor || it.text}</a>
              </div>
            ))}</div>}
        </div>
        }
      </div>
    </div>
    <div class="bm-portfolio-single-6__content-container">
      <div class="bm-portfolio-single-6__content">
        {image && image.src &&         <div>
          {image && image.src && <figure class="bm-1col-media__image ratio-portrait"><div class="media-round" data-ratio={image.ratio || null}><Image src={mediaSrc || image.src} alt={image.alt || ''} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 50vw, 100vw" width={900} height={600} loading="lazy" /></div></figure>}
        </div>
        }
        {image && image.src &&         <div class="bm-portfolio-single-testimonial-3">
          {image && image.src &&           <div class="testimonial-list-card__profile">
            {image && image.src &&             <div>
              {image && image.src && <figure class="testimonial-list-card__image ratio-portrait"><div class="media-round" data-ratio={image.ratio || null}><Image src={mediaSrc || image.src} alt={image.alt || ''} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 50vw, 100vw" width={900} height={600} loading="lazy" /></div></figure>}
            </div>
            }
          </div>
          }
        </div>
        }
      </div>
      <div class="bm-portfolio-single-6__aside">
        <div class="bm-live-website-btn">
          <div class="bm-live-website-btn__dot"></div>
        </div>
        {image && image.src &&         <div>
          {image && image.src &&           <div class="bm-contact-widget-2">
            {image && image.src &&             <div class="bm-contact-widget-2__footer">
              {image && image.src &&               <div>
                {image && image.src && <figure class="bm-contact-widget-2__image ratio-portrait"><div class="media-round" data-ratio={image.ratio || null}><Image src={mediaSrc || image.src} alt={image.alt || ''} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 50vw, 100vw" width={900} height={600} loading="lazy" /></div></figure>}
              </div>
              }
            </div>
            }
          </div>
          }
        </div>
        }
      </div>
    </div>
    <div class="bm-portfolio-single-6__footer-container">
      <div class="bm-portfolio-5-related-list">
        {image && image.src &&         <div class="bm-portfolio-5-related-card grid-auto gap-fluid-l">
          {image && image.src && <figure class="bm-portfolio-5-related-card__image ratio-portrait"><div class="media-round" data-ratio={image.ratio || null}><Image src={mediaSrc || image.src} alt={image.alt || ''} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 50vw, 100vw" width={900} height={600} loading="lazy" /></div></figure>}
        </div>
        }
        {image && image.src &&         <div class="bm-portfolio-5-related-card grid-auto gap-fluid-l">
          {image && image.src && <figure class="bm-portfolio-5-related-card__image ratio-portrait"><div class="media-round" data-ratio={image.ratio || null}><Image src={mediaSrc || image.src} alt={image.alt || ''} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 50vw, 100vw" width={900} height={600} loading="lazy" /></div></figure>}
        </div>
        }
      </div>
    </div>
  </div>
  {qas.length > 0 && <dl class="mt-stack">{qas.map((qa) => <><dt class="text-fluid-0" set:html={inline(qa.q)} /><dd class="text-fluid-0" set:html={inline(qa.a)} /></>)}</dl>}
  {links.map((l) => <p class="mt-stack text-fluid-0" set:html={inline(l.text || `[${l.anchor}](${l.href})`)} />)}
  {after.map((p) => <p class="mt-stack text-fluid-0" set:html={inline(p)} />)}
  {tel && <p class="mt-stack"><a class="link-quiet" href={tel}>{phone}</a></p>}
</div>
