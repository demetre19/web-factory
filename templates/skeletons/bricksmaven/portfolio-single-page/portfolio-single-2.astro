---
/**
 * bm-portfolio-single-2 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (portfolio-single-2.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-portfolio-single-2__container">
      <div class="bm-portfolio-single-2__intro">
        {heading && <h1 class="text-fluid-4">{heading}</h1>}
        <div class="bm-portfolio-single-2__intro-footer">
          <div class="bm-portfolio-single-meta-data-1 bm-portfolio-single-meta-data-1--inline">
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="card">
                  <p class="text-fluid-0">{it.text}</p>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
              ))}
            </div>
          </div>
          <div class="bm-live-website-btn">
            <div class="bm-live-website-btn__dot"></div>
          </div>
        </div>
      </div>
      <div>
        <figure class="bm-1col-media__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
      <div class="bm-portfolio-single-2__overview">
        {fs && <p class="text-fluid-0">{fs}</p>}
      </div>
      <div class="bm-2col-media">
        <div>
          <figure class="bm-2col-media-item__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
        <div>
          <figure class="bm-2col-media-item__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
      </div>
      <div class="bm-portfolio-single__case-section-1">
        <div class="bm-portfolio-single-intro-inline"></div>
        <div class="bm-portfolio-single-solution-list">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="bm-portfolio-single-solution-item card">
                <h2 class="text-fluid-2">{it.title}</h2>
                <p class="text-fluid-0">{it.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="bm-span2-media">
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="card">
              <figure class="bm-span2-media-item__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
            </div>
          ))}
        </div>
      </div>
      <div class="bm-portfolio-single-testimonial-2"></div>
      <div>
        <figure class="bm-1col-media__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
      <div class="bm-portfolio-single__case-section-2">
        <div class="bm-portfolio-single-2-intro-stacked"></div>
        <div class="bm-portfolio-single-result-list">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="bm-portfolio-single-result-item card">
                <h2 class="text-fluid-2">{it.title}</h2>
                <p class="text-fluid-0">{it.text}</p>
                <p class="text-fluid-0">{it.text}</p>
              </div>
            ))}
          </div>
        </div>
        <div></div>
      </div>
    </div>
    <div class="bm-portfolio-single-2__cta-container">
      <div class="bm-contact-widget-3">
        <div class="bm-contact-widget-3__manager-data">
          <div class="bm-contact-widget-3__media">
            <figure class="bm-contact-widget-3__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
          <div class="bm-contact-widget-3__data">
            <div></div>
            <div class="bm-contact-widget-link">
              <div class="bm-contact-widget-link__icon-wrapper">
                <span data-icon="lucide" aria-hidden="true"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="bm-portfolio-single-1__footer-container">
      <div class="bm-portfolio-related-list">
        <div class="bm-portfolio-related-card grid-auto gap-fluid-l">
          <div class="bm-portfolio-related-card__content"></div>
          <figure class="bm-portfolio-related-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
        <div class="bm-portfolio-related-card grid-auto gap-fluid-l">
          <div class="bm-portfolio-related-card__content"></div>
          <figure class="bm-portfolio-related-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
      </div>
    </div>
  </div>
</div>
