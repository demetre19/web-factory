---
/**
 * bm-portfolio-single-10 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (portfolio-single-10.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string; term?: string;
             label?: string; href?: string;
             icon?: string; items?: any[] }[];
  image?: { src: string; alt: string };
  copy?: any;
}
import { inline } from '../_shared/inline';
import IconChip from '../_shared/IconChip.astro';
import { Image } from 'astro:assets';
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
  image,
  copy,
} = Astro.props;
// §4.3 — a copy slot binds verbatim article copy onto
// the skeleton's native props (F.1 — nothing dropped)
const cp = copy || {};
const head = cp.heading || heading;
const sub = cp.answer || cp.text || fs;
const before = cp.before || [];
const list = (cp.items && cp.items.length
  ? cp.items : items) || [];
const qas = cp.qa || [];
const links = cp.links || [];
const after = cp.after || [];
const act = cp.cta || cta;
const phone = cp.phone || '';
const tel = phone ? 'tel:' + phone.replace(/[^0-9+]/g, '') : '';
// V.8/P.12 — rasters resolve through src/assets/media/
// so <Image> compiles AVIF/WebP srcsets
const _media = import.meta.glob('../assets/media/*.{jpg,jpeg,png,webp}', { eager: true });
const _mn = image ? String(image.src).split('/').pop() : null;
const mediaSrc = _mn ? (_media[`../assets/media/${_mn}`]?.default ?? null) : null;
---

<div>
  <div class="sec-inner">
    <div class="bm-portfolio-single-10__hero-container">
      <div class="bm-portfolio-single-10__hero-content">
        {head && <h1 class="bm-portfolio-single-10__hero-heading text-fluid-4">{head}</h1>}
        {sub && <p class="bm-portfolio-single-10__subheading text-fluid-0" set:html={inline(sub)} />}
        {before.map((p) => <p class="mt-stack text-fluid-0" set:html={inline(p)} />)}
      </div>
    </div>
    {image && image.src &&     <div>
      {image && image.src &&       <div>
        {image && image.src && <figure class="bm-1col-media__image ratio-portrait"><div class="media-round" data-ratio={image.ratio || null}><Image src={mediaSrc || image.src} alt={image.alt || ''} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 50vw, 100vw" width={900} height={600} loading="lazy" /></div></figure>}
      </div>
      }
    </div>
    }
    {links.length > 0 &&     <div class="bm-portfolio-single-10__results-container">
      {links.length > 0 && <div class="bm-portfolio-single-10-data-list">
        <div class="grid-auto gap-fluid-m">{(links || []).map((it) => (
            <div class="bm-portfolio-single-10-data card">
              <p class="text-fluid-0">{it.text}</p>
              <p class="text-fluid-0">{it.text}</p>
            </div>
          ))}</div>
      </div>}
    </div>
    }
    <div class="bm-portfolio-single-10__overlap">
      <div class="bm-portfolio-single-media-2col">
        {image && image.src &&         <div>
          {image && image.src && <figure class="ratio-portrait"><div class="media-round" data-ratio={image.ratio || null}><Image src={mediaSrc || image.src} alt={image.alt || ''} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 50vw, 100vw" width={900} height={600} loading="lazy" /></div></figure>}
        </div>
        }
        {image && image.src &&         <div>
          {image && image.src && <figure class="ratio-portrait"><div class="media-round" data-ratio={image.ratio || null}><Image src={mediaSrc || image.src} alt={image.alt || ''} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 50vw, 100vw" width={900} height={600} loading="lazy" /></div></figure>}
        </div>
        }
      </div>
    </div>
    <div class="bm-portfolio-single-10__cta-container grid-auto gap-fluid-l">
      <div class="bm-contact-widget-10">
        {act.label && <p class="mt-fluid-m"><a class="wf-cta-button" href={act.href}>{act.label}</a></p>}
      </div>
      {image && image.src && <figure class="bm-contact-widget-10__background-image ratio-portrait"><div class="media-round" data-ratio={image.ratio || null}><Image src={mediaSrc || image.src} alt={image.alt || ''} widths={[480, 960, 1440]} sizes="(min-width: 48rem) 50vw, 100vw" width={900} height={600} loading="lazy" /></div></figure>}
    </div>
    {links.length > 0 &&     <div class="bm-portfolio-single-10__footer-container">
      {links.length > 0 && <div class="bm-portfolio-8-related-list">
        <div class="grid-auto gap-fluid-m">{(links || []).map((it) => (
            <div class="bm-portfolio-8-related-card card">
              <div class="bm-portfolio-8-related-card__content">
                <h3 class="text-fluid-2">{it.icon && <IconChip name={it.icon} />} {it.term || it.title}</h3>
                <a class="text-fluid-0" href={it.href}>{it.icon && <IconChip name={it.icon} />} {it.label || it.term || it.anchor || it.text}</a>
                {(it.label || it.term || it.anchor) && it.text && <p class="text-fluid-0">{it.text}</p>}
              </div>
            </div>
          ))}</div>
      </div>}
    </div>
    }
  </div>
  {list.length > 0 && <dl class="mt-stack list-plain flow-list">{list.map((it) => <div class="flow-row">{it.icon && <IconChip name={it.icon} />}<dt class="text-fluid-0" set:html={inline(it.term || it.title || it.label || '')} />{it.text && <dd class="text-fluid-0" set:html={inline(it.text)} />}</div>)}</dl>}
  {qas.length > 0 && <dl class="mt-stack">{qas.map((qa) => <><dt class="text-fluid-0" set:html={inline(qa.q)} /><dd class="text-fluid-0" set:html={inline(qa.a)} /></>)}</dl>}
  {links.map((l) => <p class="mt-stack text-fluid-0" set:html={inline(l.text || `[${l.anchor}](${l.href})`)} />)}
  {after.map((p) => <p class="mt-stack text-fluid-0" set:html={inline(p)} />)}
  {tel && <p class="mt-stack"><a class="link-quiet" href={tel}>{phone}</a></p>}
</div>
