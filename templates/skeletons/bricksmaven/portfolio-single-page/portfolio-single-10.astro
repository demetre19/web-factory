</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-portfolio-single-10 {
    row-gap: var(--space-s);
    overflow: hidden;
  }

  .bm-portfolio-single-10__hero-container {
    width: 100%;
    align-items: center;
    row-gap: var(--space-s);
  }

  .bm-portfolio-single-10__hero-content {
    row-gap: var(--flow-spacing);
  }

  .bm-portfolio-single-10__hero-heading {
    font-size: calc(var(--fs-4) * 1.6);
    width: 100%;
  }

  .bm-portfolio-single-10__subheading {
    width: 100%;
  }

  .bm-live-website-link {
    font-size: var(--fs-2);
    position: relative;
  }

  .bm-portfolio-single-media-hero {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 3);
    width: 100%;
  }

  .bm-portfolio-single-media-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
  }

  .bm-portfolio-single-10__content-container {
    row-gap: var(--flow-spacing);
    width: 100%;
  }

  .bm-portfolio-single-10__top {
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-portfolio-single-10__badge {
    padding: calc(var(--space-xs) / 2) var(--space-s) calc(var(--space-xs) / 2) var(--space-s);
    background: var(--bg-subtle);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    font-size: var(--fs-0);
  }

  .bm-1col-media__image {
    width: 100%;
    object-fit: cover;
    height: 100%;
  }

  .bm-portfolio-single-10__results-container {
    width: 100vw;
    margin: 0 0 0 -50vw;
    position: relative;
    left: 50%;
    padding: var(--section-space-m) var(--gutter) calc(var(--section-space-xxl) * 1.4) var(--gutter);
    align-items: center;
    background: var(--bg-subtle);
    row-gap: var(--flow-spacing);
  }

  .bm-portfolio-single-10__content {
    row-gap: var(--flow-spacing);
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .bm-portfolio-single-10__top-result {
    row-gap: calc(var(--flow-spacing) / 2);
    align-items: center;
    text-align: center;
  }

  .bm-portfolio-single-10-data-list {
    width: 100%;
    display: grid;
    grid-template-columns: calc(100% * 1 / 2);
    gap: var(--space-m);
  }

  .bm-portfolio-single-10-data {
    padding: var(--space-s) var(--space-m) var(--space-s) var(--space-m);
    background: var(--bg-canvas);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    row-gap: calc(var(--flow-spacing) / 4);
  }

  .bm-portfolio-single-10-data__numbers {
    font-size: calc(var(--fs-4) * 1.4);
    font-weight: 700;
  }

  .bm-portfolio-single-10-data__label {
    font-weight: 700;
  }

  .bm-portfolio-single-10__overlap {
    margin: calc(-1 * (var(--section-space-xxl) * 1.2)) 0 0 0;
  }

  .bm-portfolio-single-media-2col {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 2);
  }

  .bm-portfolio-single-10__testimonial-container {
    align-items: center;
    margin: var(--section-space-m) 0 0 0;
  }

  .bm-portfolio-single-testimonial {
    row-gap: var(--flow-spacing);
    align-items: center;
    width: 100%;
    text-align: center;
  }

  .bm-portfolio-single-testimonial__review {
    font-size: var(--fs-2);
  }

  .bm-portfolio-single-testimonial__footer {
    align-items: center;
  }

  .bm-portfolio-single-10__cta-container {
    position: relative;
    padding: var(--section-space-l) var(--gutter) var(--section-space-l) var(--gutter);
    width: 100vw;
    left: 50%;
    margin: 0 0 0 -50vw;
    align-items: center;
  }

  .bm-contact-widget-10 {
    position: relative;
    z-index: 1;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    flex-wrap: nowrap;
  }

  .bm-contact-widget-10__heading {
    font-size: calc(var(--fs-4) * 1.2);
  }

  .bm-contact-widget-10__button {
    font-size: var(--fs-2) !important;
  }

  .bm-contact-widget-10__background-image {
    object-fit: cover;
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    bottom: 0;
    right: 0;
    top: 0;
  }

  .bm-portfolio-single-10__footer-container {
    row-gap: var(--space-s);
    align-items: center;
    margin: var(--section-space-m) 0 0 0;
  }

  .bm-portfolio-single-10__footer-heading {
    font-size: calc(var(--fs-4) * 1.4);
    text-align: center;
    width: 100%;
  }

  .bm-portfolio-8-related-list {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 3);
  }

  .bm-portfolio-8-related-card {
    align-items: center;
    flex-wrap: nowrap;
  }

  .bm-portfolio-8-related-card__content {
    background: var(--bg-canvas);
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    width: 90%;
    /* bm: box-shadow omitted — token layer owns elevation */
    margin: calc(-1 * var(--space-m)) 0 0 0;
    z-index: 1;
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-portfolio-8-related-card__media {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .bm-portfolio-8-related-card__image {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  /* bm-custom */
  .bm-live-website-link::before {
    --animation-duration-up: 0.4s;
    --animation-iteration-count: 1;
    --animation-timing-function-up: linear;
    content: '';
    position: absolute;
    bottom: -3px;
    width: 0%;
    height: 1px;
    background-color: var(--text-secondary);
    transition: all 0.5 ease;
  }
  
  
  /* Define the animation for the first child */
  .bm-live-website-link:hover::before{
    animation: motion var(--primitive-duration-med) var(--primitive-ease) var(--primitive-ease) ;
    width: 100%;
  }
  
  /* Define the animations ending point for the first child */
  @keyframes motion {
    0% {
      width: 0%;
    }
    100% {
      width: 100%;
    }
  }

  /* bm-custom */
  .bm-portfolio-single-media-2col__image-wrapper:first-child {
    margin-block-start: var(--space-l);
  }

  /* bm-custom */
  /*  Scale images on hover */
  .bm-portfolio-8-related-card__image { 
    transition: 0.5s linear;
  }
  
  .bm-portfolio-8-related-card:hover .bm-portfolio-8-related-card__image, .bm-portfolio-8-related-card:focus-within .bm-portfolio-8-related-card__image {
    scale: 1.4;
  }
</style>
