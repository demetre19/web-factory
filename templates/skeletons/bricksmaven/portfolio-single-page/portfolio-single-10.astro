        <p class="bm-portfolio-single-testimonial__name">John Smith</p>
        <p class="bm-portfolio-single-testimonial__title">Owner</p>
      </div>
    </div>
  </div>
  <div class="bm-portfolio-single-10__cta-container">
    <div class="bm-contact-widget-10">
      <h2 class="bm-contact-widget-10__heading">Ready to Tell Your Story? Let's do this.</h2>
      <a class="btn--outline bm-contact-widget-10__button" href={cta.href}>{cta.label}</a>
