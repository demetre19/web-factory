  </div>
  <div class="bm-portfolio-single-10__footer-container">
    <h2 class="bm-portfolio-single-10__footer-heading">We have more work for you to see</h2>
    <div class="bm-portfolio-8-related-list list--none">
      {items.map((it) => (
        <div class="bm-portfolio-8-related-card">
          <div class="bm-portfolio-8-related-card__content">
            <h2 class="bm-portfolio-8-related-card__heading">{it.title}</h2>
            <a class="bm-portfolio-8-related-card__cta" href="#">{it.text}</a>
          </div>
