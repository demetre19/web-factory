    "_cssCustom": ".bm-portfolio-single-6-case-container__slider-nested .splide__track {\n    overflow: visible;\n}\n\n@layer bricks {\n    .bm-portfolio-single-6-case-container__slider-nested .splide__arrows.custom {\n    \tdisplay: flex !important;\n      flex-direction: column;\n  \t\tgap: var(--space-s);\n    }\n  }\n\n.bm-portfolio-single-6-case-container__slider-nested .splide__arrows {\n  position: absolute;\n  top: 50%; \n  transform: translateY(-30%);\n  left: var(--space-l);\n  \n}\n\n.bm-portfolio-single-6-case-container__slider-nested .splide__arrow {\n    position: static;\n  transition: 1s ease;\n\n}\n\n.bm-portfolio-single-6-case-container__slider-nested .splide__arrow:hover {\n    border: 1px solid var(--neutral-semi-light);\n    border-radius: var(--radius-circle);\n  background-color: var(--primary);\n  color: var(--white);\n}\n\n.bm-portfolio-single-6-case-container__slider-nested .bm-portfolio-single-6-case-container__slide {\n  transition: .5s ease;\n}\n\n/* Add Blur to next slide */\n.bm-portfolio-single-6-case-container__slider-nested .bm-portfolio-single-6-case-container__slide:not(.is-visible) {\n  filter: blur(3px);\n  opacity: .5;\n}",
