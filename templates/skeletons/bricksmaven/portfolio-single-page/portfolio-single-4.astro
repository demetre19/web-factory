---
/**
 * bm-portfolio-single-4 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (portfolio-single-4.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-portfolio-single-4__container grid-auto gap-fluid-l">
      <div class="bm-portfolio-single-4__intro">
        {heading && <h1 class="text-fluid-4">{heading}</h1>}
        <div class="bm-portfolio-single-4-breadcrumbs"></div>
      </div>
      <figure class="bm-portfolio-single-4__background-image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
    </div>
    <div class="bm-portfolio-single-4__content-container">
      <div>
        <figure class="bm-1col-media__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
      <div class="bm-portfolio-single-4__overview">
        <div class="bm-portfolio-single-4__column">
          {fs && <p class="text-fluid-0">{fs}</p>}
          <div class="bm-live-website-btn">
            <div class="bm-live-website-btn__dot"></div>
          </div>
        </div>
        <div class="bm-portfolio-single-4__column">
          <div class="bm-portfolio-single-4__top"></div>
        </div>
      </div>
      <div class="bm-portfolio-single-4__case-presentation">
        <div class="bm-portfolio-single-4__case-wrapper">
          <div>
            <div>
              <div class="grid-auto gap-fluid-m">
                {(items || []).map((it) => (
                  <div class="bm-portfolio-single-4-card card">
                    <div></div>
                    <figure class="bm-portfolio-single-4-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="bm-portfolio-single-4__overview">
        <div class="bm-portfolio-single-4__column">
          <div class="bm-portfolio-single-4__top"></div>
        </div>
      </div>
    </div>
    <div class="bm-portfolio-single-4__cta-container">
      <div class="bm-contact-widget-5">
        <div class="bm-contact-widget-5__manager-data">
          <div class="bm-contact-widget-5__media">
            <figure class="bm-contact-widget-5__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
          <div class="bm-contact-widget-5__data">
            <div class="bm-contact-widget-5__top"></div>
            <div class="bm-contact-widget-link">
              <div class="bm-contact-widget-link__icon-wrapper">
                <span data-icon="lucide" aria-hidden="true"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="bm-portfolio-single-4__footer-container">
      <div class="bm-portfolio-single-4__footer-inner">
        <div class="bm-portfolio-3-related-list">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="card">
                <div class="bm-portfolio-3-related-card__content">
                  <div class="bm-portfolio-3-related-card__top">
                    <h2 class="bm-portfolio-3-related-card__heading text-fluid-2">{it.title}</h2>
                    <p class="bm-portfolio-3-related-card__terms text-fluid-0">{it.text}</p>
                  </div>
                  <div class="bm-portfolio-3-related-card__footer">
                    <p class="text-fluid-0">{it.text}</p>
                  </div>
                </div>
                <figure class="bm-portfolio-3-related-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
