  }

  .bm-portfolio-single-2-intro-stacked {
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-portfolio-single-result-list {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 3);
  }

