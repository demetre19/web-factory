---

<div>
  <div class="bm-portfolio-single-8__intro-container">
    <div class="bm-portfolio-single-8__content">
      <h1 class="bm-portfolio-single-8__heading">{heading}</h1>
      <div class="bm-portfolio-single-meta-data-1 bm-portfolio-single-meta-data-1--inline">
        {items.map((it) => (
          <div class="bm-portfolio-single-meta-data-item-2">
