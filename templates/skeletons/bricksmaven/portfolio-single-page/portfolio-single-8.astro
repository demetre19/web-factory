<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-portfolio-single-8 {
    row-gap: var(--space-s);
  }

  .bm-portfolio-single-8__intro-container {
    display: grid;
    gap: var(--space-m);
