    justify-content: flex-end;
  }

  .bm-portfolio-single-8__work-left-image {
    object-fit: cover;
    width: 100%;
    height: 500px;
  }

  .bm-portfolio-single-8__work-right {
    padding: 0 0 var(--section-space-xxl) 0;
  }

  .bm-portfolio-single-8__work-right-image {
    object-fit: cover;
    width: 100%;
    height: 582px;
  }

  .bm-portfolio-single-8__paragraph-image {
