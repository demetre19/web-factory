  /* bm-custom */
  .bm-live-website-btn__dot {
    --shadow-m:  0 0 4px 2px rgba(255, 255, 255, 0.2);
    --shadow-xl: 0 0 16px 8px rgba(255, 255, 255, 0.8);
  	--animation-duration-up: 1.2s;
    --shadow-light: var(--shadow-card);
    --shadow-heavy: var(--shadow-card);
    --animation-iteration-count: infinite;
    --animation-direction: alternate;
    --animation-timing-function-up: linear;
  }
  
  /* Define the animation for the first child */
  .bm-live-website-btn__dot{
    animation: glow var(--primitive-duration-med) var(--primitive-ease) var(--primitive-ease) var(--primitive-ease);
  }
  
  /* Define the animations ending point for the first child */
  @keyframes glow {
    0% {
      box-shadow: var(--shadow-card);
    }
    100% {
      box-shadow: var(--shadow-card);
    }
  }

  /* bm-custom */
  .bm-live-website-btn__text {
    --link-color: var(--bg-canvas);
    --link-color-hover: var(--color-line-default);
  }

  /* bm-custom */
  /*  Scale images on hover */
  .bm-portfolio-6-related-card__background-image { 
    transition: 0.5s linear;
  }
  
  .bm-portfolio-6-related-card:hover .bm-portfolio-6-related-card__background-image, .bm-portfolio-6-related-card:focus-within .bm-portfolio-6-related-card__background-image {
    scale: 1.2;
  }
</style>
