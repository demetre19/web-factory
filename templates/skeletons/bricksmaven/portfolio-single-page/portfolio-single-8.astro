  }

  .bm-live-website-btn__dot {
    width: 8;
    height: 8;
    background: var(--bg-subtle);
    border-radius: 100% 100% 100% 100%;
  }

  .bm-portfolio-single-8__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bm-portfolio-single-8__content-container {
    padding: var(--section-space-m) 0 var(--section-space-m) 0;
  }

  .bm-portfolio-single-8__paragraph {
    row-gap: var(--flow-spacing);
    width: 100%;
    align-self: center;
  }

