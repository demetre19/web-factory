          <figure class="bm-portfolio-single-8__paragraph-image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
        </div>
      </div>
    </div>
    <div class="bm-portfolio-single-8__work-container">
      <div class="bm-portfolio-single-8__work-left">
