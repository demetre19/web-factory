    </div>
    <div></div>
  </div>
  <div class="bm-portfolio-single-8__result-container">
    <div class="bm-portfolio-single__resul-section-8">
      <div class="bm-portfolio-single-2-intro-stacked">
        <h2 class="bm-portfolio-single-2-intro-stacked__heading">Results</h2>
        <p class="bm-portfolio-single-2-intro-stacked__text">Based on the research, PixelPundits developed a multi-pronged digital marketing strategy:</p>
      </div>
      <div class="bm-portfolio-single-result-list list--none">
        {items.map((it) => (
          <div class="bm-portfolio-single-result-item">
            <h2 class="bm-portfolio-single-result-item__heading">{it.title}</h2>
            <p class="bm-portfolio-single-result-item__percentage">{it.text}</p>
