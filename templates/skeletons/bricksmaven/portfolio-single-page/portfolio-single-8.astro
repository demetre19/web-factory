          <div class="bm-live-website-btn__dot"></div>
        </div>
      </div>
      <div>
        <figure class="bm-portfolio-single-8__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
      </div>
    </div>
    <div class="bm-portfolio-single-8__content-container">
