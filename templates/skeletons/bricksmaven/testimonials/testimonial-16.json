  {
   "id": "uzjisd",
   "name": "testimonial-16-list-ul",
   "settings": {
    "_width": "100%",
    "_display": "grid",
    "_gridTemplateColumns": "repeat(12, minmax(0, 1fr))",
    "_gridGap": "var(--grid-gap)",
    "_position": "relative",
    "_cssCustom": ".testimonial-16-list-ul::before {\n\tcontent: '';\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  width: 70%;\n  height: 70%;\n  background-color: var(--primary-light-trans-60);\n  z-index: -1;\n}",
    "_alignItemsGrid": "flex-start"
   }
  },
  {
   "id": "acss_import_list--none",
   "name": "list--none",
   "settings": []
  },
  {
   "id": "atktyu",
   "name": "testimonial-16-list-card",
   "settings": {
    "_cssCustom": "@media (min-width:767px) {\n\n.testimonial-16-list-card:nth-child(odd) {\n\tgrid-column: span 5;\n}\n.testimonial-16-list-card:nth-child(even) {\n\tgrid-column: span 7;\n}\n\n.testimonial-16-list-card:nth-child(1) {\n\tgrid-row: 1/1;\n}\n.testimonial-16-list-card:nth-child(2) {\n\tgrid-row: 1/4;\n}\n.testimonial-16-list-card:nth-child(3) {\n\tgrid-row: 2/5;\n}\n\n}",
    "_gridItemColumnSpan:mobile_landscape": "span 12 !important",
    "_gridItemRowSpan:mobile_landscape": "unset"
   }
  },
  {
   "id": "klwfzu",
   "name": "testimonial-16-list-card__title",
   "settings": []
  },
