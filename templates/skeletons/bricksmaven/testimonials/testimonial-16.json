    "_direction": "column",
    "_rowGap": "var(--content-gap)",
    "_padding": {
     "top": "var(--space-m)",
     "right": "var(--space-m)",
     "bottom": "var(--space-m)",
     "left": "var(--space-m)"
    },
    "_border": {
     "radius": {
      "top": "1rem",
      "right": "1rem",
      "bottom": "1rem",
      "left": "1rem"
     }
    },
    "_boxShadow": {
