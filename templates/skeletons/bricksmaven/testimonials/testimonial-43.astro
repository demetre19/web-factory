interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-testimonial-43__container">
    <div class="intro intro--left">
      <h2 class="intro__heading">{heading}</h2>
      <p class="intro__subheading">{fs}</p>
      <p class="bm-accent-heading">Tagline</p>
    </div>
    <div class="bm-testimonial-43__content-container">
      <div class="bm-testimonial-43-slider">
        {items.map((it) => (
          <div class="bm-testimonial-43-card">
            <div class="bm-testimonial-43-card__video-wrapper">
              <figure class="bm-testimonial-43-card__video"></figure>
              <div class="bm-testimonial-43-card__video-footer">
                <div class="bm-user-card__data">
                  <p class="bm-user-card__name">{it.text}</p>
                  <p class="bm-user-card__title">{it.text}</p>
                </div>
              </div>
            </div>
            <div class="bm-testimonial-43-card__standard">
              <div class="bm-testimonial-43-card__top">
                <h2 class="bm-testimonial-43-card__heading">{it.title}</h2>
                <p class="bm-testimonial-43-card__review">{it.text}</p>
              </div>
              <div class="bm-testimonial-43-card__standard-footer">
                <div class="bm-user-card">
                  <div class="bm-user-card__media">
                    <figure class="bm-user-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                  </div>
                  <div class="bm-user-card__data">
                    <p class="bm-user-card__name">{it.text}</p>
                    <p class="bm-user-card__title">{it.text}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

