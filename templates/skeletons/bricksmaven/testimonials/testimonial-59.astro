                  <figure class="bm-testimonial-59-card__client-avatar"><img src="/media/placeholder.svg" alt="Client Avatar" loading="lazy" width="900" height="600" /></figure>
                </div>
                <div class="bm-testimonial-59-card__client-data">
                  <p class="bm-testimonial-59-card__client-name">{it.text}</p>
                  <p class="bm-testimonial-59-card__client-title">{it.text}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="bm-testimonial-59-stats list--none">
        {items.map((it) => (
          <div class="bm-testimonial-59-stats-card">
            <p class="bm-testimonial-59-stats-card__data">{it.text}</p>
            <p class="bm-testimonial-59-stats-card__label">{it.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

