---
/**
 * bm-testimonial-59 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (testimonial-59.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-testimonial-59__container">
      <div class="intro intro--left">
        {heading && <h2 class="text-fluid-2">{heading}</h2>}
        {fs && <p class="text-fluid-0">{fs}</p>}
      </div>
      <div class="bm-testimonial-59__wrapper">
        <div>
          <div>
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="bm-testimonial-59-card card">
                  <h2 class="text-fluid-2">{it.title}</h2>
                  <div class="bm-testimonial-59-card__client">
                    <div>
                      <figure class="bm-testimonial-59-card__client-avatar ratio-portrait"><img src="/media/placeholder.svg" alt="Client Avatar" loading="lazy" width="900" height="600" /></figure>
                    </div>
                    <div>
                      <p class="text-fluid-0">{it.text}</p>
                      <p class="text-fluid-0">{it.text}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="bm-testimonial-59-stats">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="bm-testimonial-59-stats-card card">
                <p class="text-fluid-0">{it.text}</p>
                <p class="text-fluid-0">{it.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
