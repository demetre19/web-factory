  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-testimonial-59__container">
    <div class="intro intro--left">
      <h2 class="intro__heading">{heading}</h2>
      <p class="intro__subheading">{fs}</p>
      <p class="bm-accent-heading">Tagline</p>
    </div>
    <div class="bm-testimonial-59__wrapper">
      <div class="bm-testimonial-59__slider-cover">
        <div class="bm-testimonial-59-slider">
          {items.map((it) => (
            <div class="bm-testimonial-59-card">
              <h2 class="bm-testimonial-59-card__review-text">{it.title}</h2>
              <div class="bm-testimonial-59-card__client">
