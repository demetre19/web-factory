---
/**
 * bm-testimonial-55 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (testimonial-55.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-testimonial-56__container">
    <div class="intro intro--split">
      <div class="intro__left-column">
        <h2 class="intro__heading">{heading}</h2>
        <p class="bm-accent-heading">Tagline</p>
      </div>
      <div class="intro__right-column">
        <p class="intro__subheading">{fs}</p>
        <a class="btn--primary" href="#">Call to action</a>
      </div>
    </div>
    <div class="bm-testimonial-56-list">
      {items.map((it) => (
        <div class="bm-testimonial-56-card">
          <div class="bm-testimonial-56-card__top">
            <svg class="bm-testimonial-56-card__brand"></svg>
            <figure class="bm-testimonial-56-card__avatar"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
          <div class="bm-testimonial-56-card__content">
            <p class="bm-testimonial-56-card__review">{it.text}</p>
            <div class="bm-testimonial-56-card__user-data">
              <p class="bm-testimonial-56-card__name">{it.text}</p>
              <p class="bm-testimonial-56-card__title">{it.text}</p>
            </div>
          </div>
          <figure class="bm-testimonial-56-card__background-image"><img src="/media/placeholder.svg" alt="Background Image" loading="lazy" width="900" height="600" /></figure>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-testimonial-56__container {
    row-gap: var(--space-s);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--flow-spacing);
    align-self: center;
    width: 100%;
  }

  .intro--split {
    display: grid;
    text-align: left;
    grid-template-columns: calc(100% * 1 / 2);
    gap: var(--space-m);
  }

  .intro__left-column {
    row-gap: var(--flow-spacing);
  }

  .intro__right-column {
    row-gap: var(--flow-spacing);
  }

  .bm-testimonial-56-list {
    padding: var(--space-s) var(--space-s) var(--space-s) var(--space-s);
    background: var(--fs-0);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    display: grid;
    gap: var(--space-m);
    grid-template-columns: calc(100% * 1 / 3);
  }

  .bm-testimonial-56-card {
    position: relative;
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    overflow: clip;
    justify-content: space-between;
    background: var(--bg-canvas);
  }

  .bm-testimonial-56-card__top {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .bm-testimonial-56-card__avatar {
    object-fit: cover;
    width: 40px;
    height: 40px;
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
  }

  .bm-testimonial-56-card__content {
    row-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-testimonial-56-card__review {
    font-weight: 700;
  }

  .bm-testimonial-56-card__user-data {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    column-gap: calc(var(--flow-spacing) / 2);
  }

  .bm-testimonial-56-card__name {
    font-weight: 700;
  }

  .bm-testimonial-56-card__background-image {
    object-fit: cover;
    position: absolute;
    z-index: -1;
    left: 0;
    bottom: 0;
    right: 0;
    top: 0;
    height: 100%;
    width: 100%;
  }

  /* bm-custom */
  @media (max-width:1200px) {
  .bm-testimonial-56-list {
    grid-template-columns: calc(100% * 1 / 2);
  }
    
  }
  
  @media (max-width:740px) {
  .bm-testimonial-56-list {
    grid-template-columns: calc(100% * 1 / 1);
  }
    
  }

  /* bm-custom */
  /* No-background */
  
  .bm-testimonial-56-card[data-variant="no-background"]  {
    justify-content:end;
  }
  
  .bm-testimonial-56-card[data-variant="no-background"] .bm-testimonial-56-card__content {
    color: var(--bg-canvas);
  }
  
  .bm-testimonial-56-card[data-variant="no-background"] .bm-testimonial-56-card__title {
    color: var(--bg-canvas);
  }
  
  .bm-testimonial-56-card[data-variant="no-background"] .bm-testimonial-56-card__top {
    display: none;
  }
  
  .bm-testimonial-56-card[data-variant="no-background"] .bm-testimonial-56-card__background-image {
    display: flex;
    transition: 0.5s ease;
  }
  
  .bm-testimonial-56-card:hover[data-variant="no-background"] .bm-testimonial-56-card__background-image {
    scale: 1.2;
  }
  
  /* Background */
  
  .bm-testimonial-56-card[data-variant="background"] .bm-testimonial-56-card__background-image {
    display: none;
  }
</style>
