 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="testimonial-30-container">
    <div class="intro">
      <h2 class="intro__heading">Medium title placeholder text</h2>
      <p class="intro__subheading">Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Aenean commodo ligula eget dolor. Aenean massa. Cum sociis natoque penatibus et magnis dis parturient montes, nascetur ridiculus mus.</p>
    </div>
    <div class="testimonial-30-list-ul list--none">
      {items.map((it) => (
        <div class="testimonial-30-list-card">
          <div class="testimonial-30-list-card__meta">
            <p class="testimonial-30-list-card__desc">{it.text}</p>
            <div class="testimonial-30-list-card__profile">
              <h3 class="testimonial-30-list-card__heading">{it.title}</h3>
              <hr class="testimonial-30-list-card__divider" />
              <p class="testimonial-30-list-card__bio">{it.text}</p>
            </div>
          </div>
          <div class="testimonial-30-list-card__media">
            <figure class="testimonial-30-content__photo-img"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
@layer components {
  .testimonial-30-container {
    row-gap: var(--space-m);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .testimonial-30-list-ul {
    width: 100%;
    grid-template-columns: repeat(12, minmax(0, 2fr));
    display: grid;
    gap: var(--space-m);
    grid-template-rows: repeat(2, minmax(0, 2fr));
  }

  .testimonial-30-list-card {
    display: flex;
    column-gap: var(--space-xs);
    justify-content: center;
    border-radius: .5rem .5rem .5rem .5rem;
    background: var(--bg-canvas);
    padding: 2.5rem 2.5rem 2.5rem 2.5rem;
    /* bm: box-shadow omitted — token layer owns elevation */
    height: 100%;
  }

  .testimonial-30-list-card__meta {
    display: flex;
    flex-direction: column;
    row-gap: var(--space-xs);
    justify-content: center;
  }

  .testimonial-30-list-card__profile {
    display: flex;
    align-items: center;
    column-gap: 1rem;
  }

  .testimonial-30-list-card__heading {
    font-size: var(--fs-1);
  }

  .testimonial-30-list-card__divider {
    width: auto;
  }

  .testimonial-30-list-card__bio {
    font-size: calc(var(--fs-1) - .4rem);
  }

  .testimonial-30-content__photo-img {
    object-fit: cover;
    width: 13rem;
    height: 13rem;
    overflow: hidden;
    border-radius: 50% 50% 50% 50%;
  }

  /* bm-custom */
  .testimonial-30-list-card:first-child {
  	grid-row: span 2;
    flex-direction: column !important;
    align-items: center !important;
  }
  
  .testimonial-30-list-card:first-child .testimonial-30-list-card__desc {
  	text-align: center;
  }
  
  .testimonial-30-list-card:first-child .testimonial-30-list-card__meta {
  	align-items: center;
  }
  
  .testimonial-30-list-card:nth-child(even), .testimonial-30-list-card:nth-child(odd) {
  	flex-direction: row;
    align-items: center;
  }
  
  @media (max-width:767px) {
  	.testimonial-30-list-card:first-child {
  	grid-row: span 1;
    flex-direction: row !important;
    align-items: center !important;
  }
    .testimonial-30-list-card:first-child .testimonial-30-list-card__desc {
  	text-align: left;
  }
  
  .testimonial-30-list-card:first-child .testimonial-30-list-card__meta {
  	align-items: start;
  }
  }
}
</style>
