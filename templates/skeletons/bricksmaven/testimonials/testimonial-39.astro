      <div class="bm-testimonial-39__content">
        <div class="bm-testimonial-39-list">
          <div class="bm-testimonial-39-card">
            <div class="bm-testimonial-39-card__top">
              <div>
                <figure class="bm-testimonial-39-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
              <div class="bm-testimonial-39-card__meta">
                <div class="bm-testimonial-39-card__name-date"></div>
              </div>
            </div>
          </div>
          <div class="bm-testimonial-39-card">
            <div class="bm-testimonial-39-card__top">
              <div>
                <figure class="bm-testimonial-39-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
