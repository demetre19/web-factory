                <div class="bm-testimonial-39-card__name-date"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="bm-testimonial-39-card__benefits">
          <div class="bm-list">
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="bm-list-item bm-list-item--alt card">
                  <div class="bm-list-item__icon-wrapper">
                    <span data-icon="lucide" aria-hidden="true"></span>
                  </div>
                  <p class="bm-list-item__text text-fluid-0">{it.text}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
      <div></div>
    </div>
  </div>
</div>
