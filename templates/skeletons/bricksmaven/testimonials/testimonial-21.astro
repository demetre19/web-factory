---
/**
 * bm-testimonial-21 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (testimonial-21.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="testimonial-21-container">
    <div class="testimonial-21-content">
      <h2 class="testimonial-21-content__title">{heading}</h2>
      <div class="testimonial-21-content__list">
        {items.map((it) => (
          <div class="testimonial-21-content__item">
            <p class="testimonial-21-content__desc">{it.text}</p>
            <div class="testimonial-21-content__profile">
              <div class="testimonial-21-content__meta">
                <p class="testimonial-21-content__name">{it.text}</p>
                <p class="testimonial-21-content__jobtitle">{it.text}</p>
              </div>
              <div class="testimonial-21-content__media">
                <figure class="testimonial-21-content__photo"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="testimonial-21-post list--none">
      {items.map((it) => (
        <div class="testimonial-21-post__item">
          <div class="testimonial-21-post__card">
            <h4 class="testimonial-21-post__title">{it.title}</h4>
            <a class="testimonial-21-post__cta clickable-parent" href={it.href}>{it.label}</a>
            <figure class="testimonial-21-post__thumb"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .testimonial-21-container {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-m);
  }

  .testimonial-21-content {
    display: flex;
    flex-direction: column;
    row-gap: var(--space-m);
  }

  .testimonial-21-content__item {
    row-gap: var(--space-m);
    align-items: flex-start;
  }

  .testimonial-21-content__desc {
    font-size: calc(var(--fs-2) - .3rem);
  }

  .testimonial-21-content__profile {
    display: flex;
    column-gap: 1.5rem;
    align-items: center;
    align-self: flex-start;
  }

  .testimonial-21-content__meta {
    display: flex;
    flex-direction: column;
    row-gap: .5rem;
  }

  .testimonial-21-content__name {
    font-weight: 700;
    margin: 0 0 0 0;
  }

  .testimonial-21-content__jobtitle {
    font-size: calc(var(--fs-1) - .4rem);
  }

  .testimonial-21-content__photo {
    object-fit: cover;
    width: 6.5rem;
    height: 6.5rem;
    overflow: hidden;
    border-radius: 50% 50% 50% 50%;
  }

  .testimonial-21-post {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
  }

  .testimonial-21-post__card {
    height: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 2rem 2rem 2rem 2rem;
    row-gap: .5rem;
    overflow: hidden;
  }

  .testimonial-21-post__cta {
    padding: 0 0 0 0;
    font-size: calc(var(--fs-1) - .4rem);
    text-decoration: underline;
    margin: 0 0 -3.5rem 0;
  }

  .testimonial-21-post__thumb {
    object-fit: cover;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    z-index: -2;
  }

  /* bm-custom */
  .testimonial-21-post__card::before {
  	content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 39.76%, rgba(0, 0, 0, 0.7) 84.42%);
  }
  .testimonial-21-post__card:hover .testimonial-21-post__cta {
  	margin-bottom: 0;
  }

  /* bm-custom */
  .testimonial-21-post__cta {
  	text-decoration-color: var(--action-primary) !important;
    text-decoration-thickness: .2rem !important;
  }
</style>
