<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .testimonial-28-container {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
  }

  .testimonial-28-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .testimonial-28-content__wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    row-gap: var(--space-s);
  }

  .testimonial-28-content__desc {
    text-align: center;
  }

  .testimonial-28-content__profile {
    display: flex;
    flex-direction: column;
    row-gap: 3rem;
    align-items: center;
    justify-content: center;
  }

  .testimonial-28-content__meta {
    display: flex;
    flex-direction: column;
    row-gap: .3rem;
    align-items: center;
    text-align: center;
  }

  .testimonial-28-content__jobtitle {
    font-size: calc(var(--fs-1) - .4rem);
  }

  .testimonial-28-content__photo {
    object-fit: cover;
    width: 6.5rem;
    height: 6.5rem;
    overflow: hidden;
    border-radius: 50% 50% 50% 50%;
    position: relative;
  }

  .testimonial-28-script {
    display: none;
  }

  /* bm-custom */
  .testimonial-28-content__item:not(.is-active, .is-next, .is-prev) .testimonial-28-content__photo {
  	transform: scale(.75);
  }
  .testimonial-28-content__item:not(.is-active, .is-next, .is-prev) .testimonial-28-content__meta {
  	opacity: 0;
  }
  .testimonial-28-content__item:not(.is-active).is-next .testimonial-28-content__photo,
  .testimonial-28-content__item:not(.is-active).is-prev .testimonial-28-content__photo {
  	transform: scale(1);
  }
  .testimonial-28-content__item:not(.is-active).is-next .testimonial-28-content__meta,
  .testimonial-28-content__item:not(.is-active).is-prev .testimonial-28-content__meta {
  	opacity: 0;
  }
  
  .testimonial-28-content__item .testimonial-28-content__photo::before {
  	content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background: transparent;
    transition: all .3s cubic-bezier(0.2, 1, 0.3, 1);
  }
  .testimonial-28-content__item:not(.is-active) .testimonial-28-content__photo::before {
    background: rgba(219, 35, 35, 0.39);
  }
  
  .testimonial-28-content__item.is-active .testimonial-28-content__photo {
  	transform: scale(1.5);
  }
  
  .testimonial-28-content__item {
  	border: none !important;
  }
</style>
