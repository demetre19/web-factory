  },
  {
   "id": "cezznk",
   "name": "testimonial-15-container",
   "settings": []
  },
  {
   "id": "gzboej",
   "name": "testimonial-15-content",
   "settings": {
    "_width": "100%",
    "_display": "grid",
    "_gridGap": "var(--space-s)",
    "_gridTemplateColumns": "repeat(12, minmax(0, 1fr))"
   }
  },
  {
   "id": "acss_import_list--none",
   "name": "list--none",
   "settings": []
  },
  {
   "id": "kvcgiu",
   "name": "testimonial-15-content__card",
   "settings": {
    "_padding": {
     "top": "var(--space-s)",
     "right": "var(--space-s)",
     "bottom": "var(--space-s)",
     "left": "var(--space-s)"
    },
    "_background": {
     "color": {
      "id": "acss_import_primary-dark",
      "name": "primary-dark",
      "raw": "var(--primary-dark)"
     }
    },
    "_border": {
     "radius": {
      "top": "1rem",
      "right": "1rem",
      "bottom": "1rem",
      "left": "1rem"
     }
    },
    "_typography": {
     "color": {
      "raw": "var(--white)"
     }
    },
    "_height": "100%",
    "_gridItemColumnSpan": "span 4",
    "_cssCustom": ".testimonial-15-content__card:nth-child(2) {\n\tgrid-column: span 8;\n}\n.testimonial-15-content__card:nth-child(2) .testimonial-15-content__card-media {\n\tgrid-column: span 1;\n}\n.testimonial-15-content__card:nth-child(2) .testimonial-15-content__card-meta {\n\tgrid-column: span 9;\n}",
    "_cssCustom:mobile_landscape": ".testimonial-15-content__card:nth-child(2) {\n\tgrid-column: span 6;\n}\n.testimonial-15-content__card:nth-child(2) .testimonial-15-content__card-media {\n\tgrid-column: span 2;\n}\n.testimonial-15-content__card:nth-child(2) .testimonial-15-content__card-meta {\n\tgrid-column: span 8;\n}\n.testimonial-15-content__card:nth-child(5) {\n\tgrid-column: span 12 !important;\n}\n.testimonial-15-content__card:nth-child(5) .testimonial-15-content__card-media {\n\tgrid-column: span 1;\n}\n.testimonial-15-content__card:nth-child(5) .testimonial-15-content__card-meta {\n\tgrid-column: span 9;\n}",
    "_gridItemColumnSpan:mobile_landscape": "span 6",
    "_gridItemColumnSpan:mobile_portrait": "span 12",
    "_cssCustom:mobile_portrait": ".testimonial-15-content__card:nth-child(2)  {\n\tgrid-column: span 12;\n}\n.testimonial-15-content__card:nth-child(5) .testimonial-15-content__card-meta {\n\tgrid-column: span 8;\n}\n.testimonial-15-content__card:nth-child(5) .testimonial-15-content__card-media {\n\tgrid-column: span 2;\n}"
   }
  },
  {
   "id": "uvzism",
   "name": "testimonial-15-content__card-author",
   "settings": {
    "_display": "grid",
    "_gridTemplateColumns": "repeat(12, minmax(0, 1fr))",
    "_alignItemsGrid": "center",
    "_margin": {
     "bottom": "var(--space-s)"
    },
    "_gridGap:tablet_portrait": ".5rem",
    "_gridGap": "1rem"
   }
  },
  {
   "id": "ugknzu",
   "name": "testimonial-15-content__card-meta",
   "settings": {
    "_gridItemColumnSpan": "span 8",
    "_display": "flex",
