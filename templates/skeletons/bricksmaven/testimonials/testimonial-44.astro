---
/**
 * bm-testimonial-44 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (testimonial-44.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-testimonial-44__container">
    <div class="intro intro--split">
      <div class="intro__left-column">
        <h2 class="intro__heading">Long headline to turn your visitors into users</h2>
        <p class="bm-accent-heading">Tagline</p>
      </div>
      <div class="intro__right-column">
        <p class="intro__subheading">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
        <a class="btn--primary" href="#">Call to action</a>
      </div>
    </div>
    <div class="bm-testimonial-44-grid">
      {items.map((it) => (
        <div class="bm-testimonial-44-card">
          <div class="bm-testimonial-44-video-card">
            <figure class="bm-testimonial-44-video-card__video"></figure>
            <div class="bm-testimonial-44-video-card__user-data">
              <div class="bm-testimonial-38-star-list list--none">
                {(it.items || []).map((it2) => (
                  <div class="bm-testimonial-38-star-li">
                    <span class="bm-testimonial-38-star-li__icon" data-icon="lucide" aria-hidden="true"></span>
                  </div>
                ))}
              </div>
              <div class="testimonial-list-card__profile">
                <div class="testimonial-list-card__meta">
                  <custom class="testimonial-list-card__name">{it.title}</custom>
                  <p class="testimonial-list-card__jobtitle">{it.text}</p>
                </div>
              </div>
            </div>
          </div>
          <div class="bm-testimonial-44-review-card">
            <div class="bm-testimonial-44-review-card__user-data">
              <div class="testimonial-list-card__profile">
                <div class="testimonial-list-card__meta">
                  <custom class="testimonial-list-card__name">{it.title}</custom>
                  <p class="testimonial-list-card__jobtitle">{it.text}</p>
                </div>
                <div class="testimonial-list-card__media">
                  <figure class="testimonial-list-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                </div>
              </div>
              <div class="bm-testimonial-38-star-list list--none">
                {(it.items || []).map((it2) => (
                  <div class="bm-testimonial-38-star-li">
                    <span class="bm-testimonial-38-star-li__icon" data-icon="lucide" aria-hidden="true"></span>
                  </div>
                ))}
              </div>
            </div>
            <p class="bm-testimonial-44-review-card__text">{it.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
@layer components {
  .bm-testimonial-44__container {
    row-gap: var(--space-s);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--flow-spacing);
    align-self: center;
    width: 100%;
  }

  .intro--split {
    display: grid;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    align-self: flex-start;
    grid-template-columns: calc(100% * 1 / 2);
    gap: var(--space-m);
  }

  .intro__left-column {
    row-gap: var(--flow-spacing);
  }

  .intro__right-column {
    row-gap: var(--flow-spacing);
  }

  .bm-testimonial-44-grid {
    display: block;
  }

  .bm-testimonial-44-video-card {
    position: relative;
    height: 100%;
    justify-content: flex-end;
    overflow: hidden;
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
  }

  .bm-testimonial-44-video-card__video {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    background: var(--text-primary);
  }

  .bm-testimonial-44-video-card__user-data {
    position: relative;
    z-index: 99;
    padding: var(--space-s) var(--space-s) var(--space-s) var(--space-s);
    display: none;
  }

  .bm-testimonial-38-star-list {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    column-gap: calc(var(--flow-spacing) / 4);
  }

  .testimonial-list-card__profile {
    display: flex;
    column-gap: 1rem;
    align-items: center;
  }

  .testimonial-list-card__meta {
    display: flex;
    flex-direction: column;
    row-gap: calc(--content-gap / 2);
  }

  .testimonial-list-card__name {
    font-weight: 700;
  }

  .testimonial-list-card__jobtitle {
    font-size: var(--fs-0);
  }

  .bm-testimonial-44-review-card {
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    border-top: 1px solid var(--color-line-default);
    border-right: 1px solid var(--color-line-default);
    border-bottom: 1px solid var(--color-line-default);
    border-left: 1px solid var(--color-line-default);
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
    row-gap: var(--flow-spacing);
  }

  .testimonial-list-card__image {
    object-fit: cover;
    width: 5rem;
    height: 5rem;
    overflow: hidden;
    border-radius: 50% 50% 50% 50%;
  }

  /* bm-custom */
  .bm-testimonial-44-grid {
    display: block !important;
    column-count: 3;
    row-gap: var(--acss-row-gap);
    column-gap: var(--acss-column-gap);
    --row-gap: var(--space-m);
    --column-gap: var(--space-m);
  
  }
  
  .bm-testimonial-44-grid > * {
    margin-block-end: var(--acss-row-gap);
    break-inside: avoid;
    width: 100%;
  
  }
  
  @media (max-width: 768px) {
    .bm-testimonial-44-grid {
    column-count: 2;
  }
  }
  
  @media (max-width: 478px) {
    .bm-testimonial-44-grid {
    column-count: 1;
  }
  }

  /* bm-custom */
  .bm-testimonial-44-card[data-card-status="video-card"] .bm-testimonial-44-review-card {
    display: none;
  }
  
  .bm-testimonial-44-card[data-card-status="review-card"] .bm-testimonial-44-video-card {
    display: none;
  }

  /* bm-custom */
  .bm-testimonial-44-video-card__video[data-visible='show'] + .bm-testimonial-44-video-card__user-data {
    display: flex;
  }
}
</style>
