---
/**
 * bm-testimonial-40 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (testimonial-40.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="bm-testimonial-40__container">
      <div class="bm-testimonial-40__intro-wrapper">
        <div class="intro intro--left">
          {heading && <h2 class="text-fluid-2">{heading}</h2>}
          {fs && <p class="text-fluid-0">{fs}</p>}
        </div>
        <div class="cta-combo"></div>
      </div>
      <div class="bm-testimonial-40-list">
        <div class="bm-testimonial-40-card">
          <div class="bm-testimonial-40-card__content">
            <div class="bm-testimonial-40-card__top">
              <div class="bm-testimonial-38-star-list">
                <div class="grid-auto gap-fluid-m">
                  {(items || []).map((it) => (
                    <div class="card">
                      <span data-icon="lucide" aria-hidden="true"></span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
            <div class="bm-testimonial-40-card__client"></div>
          </div>
          <div>
            <figure class="bm-testimonial-40-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
        <div class="bm-testimonial-40-card">
          <div class="bm-testimonial-40-card__content">
            <div class="bm-testimonial-40-card__top">
              <div class="bm-testimonial-38-star-list">
                <div class="grid-auto gap-fluid-m">
                  {(items || []).map((it) => (
                    <div class="card">
                      <span data-icon="lucide" aria-hidden="true"></span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
            <div class="bm-testimonial-40-card__client"></div>
          </div>
          <div>
            <figure class="bm-testimonial-40-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
          </div>
        </div>
      </div>
      <div></div>
    </div>
  </div>
</div>
