---

<div>
  <div class="testimonial-19-container">
    <div class="testimonial-19-content">
      {items.map((it) => (
        <div class="testimonial-19-content__slide">
          <div class="testimonial-19-content__card">
            <h3 class="testimonial-19-content__card-name">{it.title}</h3>
            <p class="testimonial-19-content__card-jobtitle">{it.text}</p>
