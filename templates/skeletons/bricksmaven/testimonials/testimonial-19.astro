            <div class="testimonial-19-content__card-review">
              {(it.items || []).map((it2) => (
                <span class="testimonial-19-content__card-stars" data-icon="lucide" aria-hidden="true"></span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .testimonial-19-content__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    row-gap: 1rem;
  }

  .testimonial-19-content__card-divider {
    margin: 1rem 0 1rem 0;
  }

  .testimonial-19-content__card-photo {
    object-fit: cover;
    width: 10rem;
    height: 10rem;
    overflow: hidden;
    border-radius: 50% 50% 50% 50%;
  }

  .testimonial-19-content__card-review {
    display: flex;
    column-gap: 1rem;
  }

  /* bm-custom */
  .testimonial-19-content__slide.is-active .testimonial-19-content__card {
  	box-shadow: 13px 6px 56px rgba(87, 87, 87, 0.1);
  }
</style>
