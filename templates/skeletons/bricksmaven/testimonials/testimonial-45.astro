              ))}
            </div>
          </div>
        </div>
      </div>
      <div>
        <div>
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="bm-testimonial-45-card card">
                <div class="bm-testimonial-45-card__content">
                  <p class="text-fluid-0">{it.text}</p>
                  <div>
                    <p class="text-fluid-0">{it.text}</p>
                    <p class="text-fluid-0">{it.text}</p>
                  </div>
                </div>
                <div class="bm-testimonial-45-card__media">
                  <figure class="bm-testimonial-45-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
