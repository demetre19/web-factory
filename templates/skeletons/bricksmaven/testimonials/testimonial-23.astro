                      <p class="testimonial-23-content__jobtitle">{it.text}</p>
                      <p class="company">{it.text}</p>
                    </div>
                    <div class="testimonial-23-content__review">
                      {(it.items || []).map((it2) => (
                        <span class="testimonial-23-content__stars" data-icon="lucide" aria-hidden="true"></span>
                      ))}
                    </div>
                  </div>
