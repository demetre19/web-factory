---
/**
 * bm-testimonial-33 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (testimonial-33.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="testimonial-33-container">
      <div class="intro intro--left">
        {heading && <h2 class="text-fluid-2">{heading}</h2>}
        <div class="intro__text-cta-wrapper">
          {fs && <p class="text-fluid-0">{fs}</p>}
          <p class="mt-fluid-m"><a class="wf-cta-button" href={cta.href}>{cta.label || 'Continue'}</a></p>
        </div>
      </div>
      <div>
        <div class="grid-auto gap-fluid-m">
          {(items || []).map((it) => (
            <div class="testimonial-33-slide card">
              <div class="testimonial-33-slide__content">
                <div>
                  <h2 class="text-fluid-2">{it.title}</h2>
                </div>
                <div class="testimonial-33-slide__client-data">
                  <p class="text-fluid-0">{it.text}</p>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
                <div>
                  <figure class="testimonial-33-slide__logo-image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                </div>
              </div>
              <div class="testimonial-33-slide__media">
                <figure class="testimonial-33-slide__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
