    "_cssCustom": ".testimonial-34-slider .splide__arrows {\n\tposition: absolute;\n  display: flex;\n  flex-direction: row;\n  width: auto;\n  gap: var(--space-m);\n  bottom: calc((var(--space-m) + 5rem) * -1 );\n  \n}\n\n.testimonial-34-slider .splide__arrow {\n\tposition: relative;\n  width: 2.4rem;\n  transform: unset !important;\n}\n\n.brxe-slider-nested .splide__arrows:not(.custom) .splide__arrow--prev {\n    transform: translateY(0%) scaleX(-1) !important;\n}\n\n.testimonial-34-slider .splide__track {\n\toverflow: visible;\n}\n\n/* Hide overflow left */\n/*\n.testimonial-34-slider::before {\n\tcontent: \"\";\n  position: absolute;\n  top: 0;\n  right: 100%;\n  width: 100%;\n  max-width: 100%;\n  height: 100%;\n  min-height: 100%;\n  max-height: 100%;\n  background-color: var(--white);\n  z-index: 1;\n}\n\n*/"
