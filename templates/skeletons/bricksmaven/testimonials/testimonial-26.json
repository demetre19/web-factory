  {
   "id": "uvvvjr",
   "name": "code",
   "parent": "zzsdwr",
   "children": [],
   "settings": {
    "code": "<script>\nwindow.addEventListener(\"DOMContentLoaded\", checkDevice);\n\nfunction checkDevice() {\n    if (window.innerWidth <= 674) {\n        initAccordion();\n    }\n}\n\nfunction toggleContent(event) {\n    event.preventDefault();\n    const clickedButton = event.currentTarget;\n    const clickedNavItem = clickedButton.parentNode;\n    const contentPane = clickedNavItem.nextElementSibling;\n\n    if (clickedNavItem.classList.contains('brx-open')) {\n        clickedNavItem.classList.remove('brx-open');\n        contentPane.classList.remove('brx-open');\n    } else {\n        const allNavItems = document.querySelectorAll('.testimonial-26-tabs__nav-item');\n        const allContentPanes = document.querySelectorAll('.testimonial-26-tabs__content-pane');\n        allNavItems.forEach(navItem => navItem.classList.remove('brx-open'));\n        allContentPanes.forEach(pane => pane.classList.remove('brx-open'));\n        clickedNavItem.classList.add('brx-open');\n        contentPane.classList.add('brx-open');\n    }\n}\n\nfunction initAccordion() {\n    const navItems = document.querySelectorAll('.testimonial-26-tabs__nav-item');\n    const contentPanes = document.querySelectorAll('.testimonial-26-tabs__content-pane');\n\n    for (let i = 0; i < navItems.length; i++) {\n        if (navItems[i].nextElementSibling !== contentPanes[i]) {\n            navItems[i].parentNode.insertBefore(contentPanes[i], navItems[i].nextSibling);\n        }\n        navItems[i].firstElementChild.addEventListener('click', toggleContent);\n    }\n}\n\n</script>",
    "_cssGlobalClasses": [
     "cqznro"
    ],
