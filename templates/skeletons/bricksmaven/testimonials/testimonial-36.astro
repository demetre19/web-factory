                  <h3 class="text-fluid-2">{it.title}</h3>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
                <div class="bm-content-feature-list-item__media">
                  <span class="bm-content-feature-list-item__icon" data-icon="lucide" aria-hidden="true"></span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="testimonial-36__carousel">
        <div class="testimonial-36__row">
          <div>
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="testimonial-36-card card">
                  <div>
                    <p class="text-fluid-0">{it.text}</p>
                  </div>
                  <div class="testimonial-36-card__head">
                    <div class="testimonial-36-card__avatar">
                      <figure class="ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                    </div>
                    <div class="testimonial-36-card__client-data">
                      <custom class="text-fluid-2">{it.title}</custom>
                      <p class="text-fluid-0">{it.text}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="testimonial-36__row">
          <div>
            <div class="grid-auto gap-fluid-m">
              {(items || []).map((it) => (
                <div class="testimonial-36-card card">
                  <div>
                    <p class="text-fluid-0">{it.text}</p>
                  </div>
                  <div class="testimonial-36-card__head">
                    <div class="testimonial-36-card__avatar">
                      <figure class="ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                    </div>
                    <div class="testimonial-36-card__client-data">
                      <custom class="text-fluid-2">{it.title}</custom>
                      <p class="text-fluid-0">{it.text}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
