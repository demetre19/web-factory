---

<div>
  <div class="sec-inner">
    <div class="testimonial-36__container">
      <div class="testimonial-36__content">
        <div class="testimonial-36__content-head">
          {heading && <h2 class="text-fluid-2">{heading}</h2>}
        </div>
        <div class="bm-content-feature-list">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="bm-content-feature-list-item card">
