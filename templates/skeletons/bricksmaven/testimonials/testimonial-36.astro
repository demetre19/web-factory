interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="testimonial-36__container">
    <div class="testimonial-36__content">
      <div class="testimonial-36__content-head">
        <h2 class="testimonial-36__heading">{heading}</h2>
        <p class="testimonial-36__accent-heading">Accent heading</p>
      </div>
      <div class="bm-content-feature-list">
        {items.map((it) => (
          <div class="bm-content-feature-list-item">
            <div class="bm-content-feature-list-item__content">
              <h3 class="bm-content-feature-list-item__heading">{it.title}</h3>
              <p class="bm-content-feature-list-item__desc">{it.text}</p>
            </div>
            <div class="bm-content-feature-list-item__media">
              <span class="bm-content-feature-list-item__icon" data-icon="lucide" aria-hidden="true"></span>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="testimonial-36__carousel">
      <div class="testimonial-36__row">
        <div class="testimonial-36-ul">
          {items.map((it) => (
            <div class="testimonial-36-card">
              <div class="testimonial-36-card__content">
                <p class="testimonial-36-card__text">{it.text}</p>
              </div>
              <div class="testimonial-36-card__head">
                <div class="testimonial-36-card__avatar">
                  <figure class="testimonial-36-card__avatar-image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                </div>
                <div class="testimonial-36-card__client-data">
                  <custom class="testimonial-36-card__client-name">{it.title}</custom>
                  <p class="testimonial-36-card__client-title">{it.text}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="testimonial-36__row">
        <div class="testimonial-36-ul">
          {items.map((it) => (
            <div class="testimonial-36-card">
              <div class="testimonial-36-card__content">
                <p class="testimonial-36-card__text">{it.text}</p>
              </div>
              <div class="testimonial-36-card__head">
                <div class="testimonial-36-card__avatar">
                  <figure class="testimonial-36-card__avatar-image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                </div>
                <div class="testimonial-36-card__client-data">
                  <custom class="testimonial-36-card__client-name">{it.title}</custom>
                  <p class="testimonial-36-card__client-title">{it.text}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
