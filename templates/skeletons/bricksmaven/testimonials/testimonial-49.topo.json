   "custom_css": ".bm-testimonial-49__slider-nested {\n  --icon-dimension: 64px; /* Change the icon dimensions*/\n  --icon-size: 16px; /* Change the icon size*/\n  --icon-opacity: 0.5;  /* Change the icon opacity*/\n}\n\n\n.bm-testimonial-49__slider-nested .splide__arrow--next {\n  left: var(--space-m);\n  transition: 0.5s ease;\n}\n\n.bm-testimonial-49__slider-nested .splide__arrow--prev {\n  left: calc(-1 * var(--icon-dimension));\n  transition: 0.5s ease;\n}\n\n.bm-testimonial-49__slider-nested .splide__arrows {\n    position: absolute;\n    inset-block-end: var(--space-xxl);\n  \tinset-inline-start: var(--icon-dimension);\n   \t\n}\n\n@media (max-width:991px) {\n  \n  .bm-testimonial-49__slider-nested {\n  --icon-dimension: 42px; /* Change the icon dimensions*/\n}\n  \n  .bm-testimonial-49__slider-nested .splide__arrows {\n    position: absolute;\n    inset-inline-start: unset;\n    inset-block-end: var(--space-s);\n  \tinset-inline-end: calc(var(--icon-dimension) + var(--space-m));\n}\n}",
