      "hsl": "hsla(0, 0%, 0%, 0.1)"
     }
    },
    "_alignItems:mobile_portrait": "center",
    "_height": "100%",
    "_cssCustom": ".testimonial-30-list-card:first-child {\n\tgrid-row: span 2;\n  flex-direction: column !important;\n  align-items: center !important;\n}\n\n.testimonial-30-list-card:first-child .testimonial-30-list-card__desc {\n\ttext-align: center;\n}\n\n.testimonial-30-list-card:first-child .testimonial-30-list-card__meta {\n\talign-items: center;\n}\n\n.testimonial-30-list-card:nth-child(even), .testimonial-30-list-card:nth-child(odd) {\n\tflex-direction: row;\n  align-items: center;\n}\n\n@media (max-width:767px) {\n\t.testimonial-30-list-card:first-child {\n\tgrid-row: span 1;\n  flex-direction: row !important;\n  align-items: center !important;\n}\n  .testimonial-30-list-card:first-child .testimonial-30-list-card__desc {\n\ttext-align: left;\n}\n\n.testimonial-30-list-card:first-child .testimonial-30-list-card__meta {\n\talign-items: start;\n}\n}",
    "_gridItemColumnSpan": "span 6",
    "_gridItemColumnSpan:mobile_landscape": "span 12"
