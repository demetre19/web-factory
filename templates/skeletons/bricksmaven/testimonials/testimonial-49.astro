    grid-template-columns: calc(100% * 1 / 2);
    gap: var(--space-m);
  }

  .bm-testimonial-49-card__content {
    row-gap: calc(var(--flow-spacing) * 1.4);
    width: 100%;
    padding: var(--section-space-xxl) 0 0 0;
  }

