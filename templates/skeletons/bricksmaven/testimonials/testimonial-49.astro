    display: flex;
    flex-wrap: nowrap;
    flex-direction: row;
    column-gap: calc(var(--flow-spacing) / 2);
    align-items: center;
  }

  .bm-testimonial-49-card__icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--fs-0);
    width: 32px;
    height: 32px;
    border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-card);
  }

  .bm-testimonial-49-card__name {
    font-size: var(--fs-2);
  }

  .bm-testimonial-49-card__image {
    object-fit: cover;
    border-radius: var(--r-card) var(--r-card) 0 0;
  }

  /* bm-custom */
  .bm-testimonial-49__slider-nested {
    --icon-dimension: 64px; /* Change the icon dimensions*/
    --icon-size: 16px; /* Change the icon size*/
    --icon-opacity: 0.5;  /* Change the icon opacity*/
  }
  
  
  .bm-testimonial-49__slider-nested .splide__arrow--next {
    left: var(--space-m);
    transition: 0.5s ease;
  }
  
  .bm-testimonial-49__slider-nested .splide__arrow--prev {
    left: calc(-1 * var(--acss-icon-dimension));
    transition: 0.5s ease;
  }
  
  .bm-testimonial-49__slider-nested .splide__arrows {
      position: absolute;
      inset-block-end: var(--section-space-xxl);
    	inset-inline-start: var(--acss-icon-dimension);
     	
