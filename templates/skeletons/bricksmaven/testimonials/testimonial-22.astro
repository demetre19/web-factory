---
/**
 * bm-testimonial-22 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (testimonial-22.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="testimonial-22-container">
      <div class="intro">
        {heading && <h2 class="text-fluid-2">{heading}</h2>}
        {fs && <p class="text-fluid-0">{fs}</p>}
      </div>
      <div class="testimonial-22-content">
        <div class="testimonial-22-content__list">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="testimonial-22-content__item card">
                <div class="grid-auto gap-fluid-l">
                  <div class="testimonial-22-content__boxlabel">
                    <p class="testimonial-22-content__label text-fluid-0">{it.text}</p>
                    <div class="testimonial-22-content__box">
                      <p class="testimonial-22-content__desc text-fluid-0">{it.text}</p>
                      <h4 class="text-fluid-2">{it.title}</h4>
                      <p class="text-fluid-0">{it.text}</p>
                    </div>
                  </div>
                  <figure class="testimonial-22-content__photo ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
