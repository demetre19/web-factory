    "code": "<style>\n:root {\n  --elements-gap: var(--content-gap);\n  --animation-duration: 32s;\n}\n\n.testimonial-35__row:nth-child(1) .testimonial-35-carousel-list {\n\tanimation: scrolling--f linear infinite;\n  justify-content: flex-end;\n}\n\n.testimonial-35__row:nth-child(2) .testimonial-35-carousel-list {\n\tanimation: scrolling--b linear infinite;\n}\n\n.testimonial-35-carousel-list:hover {\n  animation-play-state: paused !important;\n}\n\n.testimonial-35-carousel-card {\n  padding: 0 calc(var(--elements-gap) / 2);\n  width: unset;\n}\n\n@keyframes scrolling--f {\n  0% {\n    transform: translateX(0);\n  }\n  100% {\n    transform: translateX(calc(var(--first-elements-width)));\n  }\n}\n  \n@keyframes scrolling--b {\n  0% {\n    transform: translateX(0);\n  }\n  100% {\n    transform: translateX(calc(-1 * var(--second-elements-width)));\n  }\n}\n</style>\n<script>\nconst root = document.documentElement,\n\telementContent = document.querySelectorAll('.testimonial-35-carousel-list');\n\nlet firstElementsWidth = 0,\n\tsecondElementsWidth = 0;\n\nelementContent.forEach(function(item) {\n  const itemLength = item.children.length;\n\n\titem.style.animationDuration = `calc(${itemLength} * var(--animation-duration))`;\n\n  for(let i=0; i<itemLength; i++) {\n    if(item === elementContent[0]) {\n      firstElementsWidth += item.children[i].getBoundingClientRect().width;\n    } else {\n    \tsecondElementsWidth += item.children[i].getBoundingClientRect().width;\n    }\n  }\n});\n\nroot.style.setProperty('--first-elements-width', firstElementsWidth + 'px');\nroot.style.setProperty('--second-elements-width', secondElementsWidth + 'px');\n\nfunction addDuplicates(item) {\n  const clonedNodes = [];\n\n  for (let i = 0; i < item.children.length; i++) {\n    const clonedNode = item.children[i].cloneNode(true);\n\n    clonedNode.removeAttribute(\"id\");\n\n    clonedNode.querySelector(\".brxe-image\").removeAttribute(\"id\");\n\n    clonedNodes.push(clonedNode);\n  }\n\n  clonedNodes.forEach(function(node) {\n    item.appendChild(node);\n  });\n}\n\naddDuplicates(elementContent[0]);\naddDuplicates(elementContent[1]);\n</script>",
