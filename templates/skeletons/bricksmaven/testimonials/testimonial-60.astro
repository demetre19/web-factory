                <figure class="bm-testimonial-slider-card__image ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
              <div class="bm-testimonial-slider-card__content">
                <div class="bm-testimonial-slider-card__top">
                  <p class="text-fluid-0">{it.text}</p>
                  <span data-icon="lucide" aria-hidden="true"></span>
                </div>
                <p class="text-fluid-0">{it.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
