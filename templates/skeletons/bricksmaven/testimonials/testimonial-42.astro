---
/**
 * bm-testimonial-42 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (testimonial-42.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-testimonial-42__container">
    <div class="bm-testimonial-42__intro">
      <div class="bm-testimonial-42__content">
        <h1 class="bm-testimonial-42__heading">{heading}</h1>
        <p class="bm-testimonial-42__text">{fs}</p>
        <a class="bm-testimonial-42__button btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
      </div>
    </div>
    <div class="bm-testimonial-42__testimonial-list">
      <div class="bm-testimonial-42__testimonial-column">
        {items.map((it) => (
          <div class="testimonial-36-card">
            <div class="testimonial-36-card__content">
              <p class="testimonial-36-card__text">{it.text}</p>
            </div>
            <div class="testimonial-36-card__head">
              <div class="testimonial-36-card__avatar">
                <figure class="testimonial-36-card__avatar-image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
              <div class="testimonial-36-card__client-data">
                <custom class="testimonial-36-card__client-name">{it.title}</custom>
                <p class="testimonial-36-card__client-title">{it.text}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="bm-testimonial-42__testimonial-column">
        {items.map((it) => (
          <div class="testimonial-36-card">
            <div class="testimonial-36-card__content">
              <p class="testimonial-36-card__text">{it.text}</p>
            </div>
            <div class="testimonial-36-card__head">
              <div class="testimonial-36-card__avatar">
                <figure class="testimonial-36-card__avatar-image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
              </div>
              <div class="testimonial-36-card__client-data">
                <custom class="testimonial-36-card__client-name">{it.title}</custom>
                <p class="testimonial-36-card__client-title">{it.text}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style is:global>
/* bm: components layer (unlayered — see bricks_translate) */
  .bm-testimonial-42 {
    background: var(--bg-subtle);
  }

  .bm-testimonial-42__container {
    display: grid;
    grid-template-columns: calc(100% * 2 / 1);
    gap: var(--space-m);
    position: relative;
  }

  .bm-testimonial-42__content {
    position: sticky;
    top: var(--space-s);
    row-gap: var(--flow-spacing);
  }

  .bm-testimonial-42__testimonial-list {
    padding: 0 0 0 0;
    margin: 0 0 0 0;
    display: grid;
    grid-template-columns: calc(100% * 1 / 2);
    gap: var(--space-m);
  }

  .bm-testimonial-42__testimonial-column {
    row-gap: var(--flow-spacing);
  }

  .testimonial-36-card {
    display: flex;
    flex-direction: column;
    row-gap: var(--flow-spacing);
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-m);
    background: var(--bg-canvas);
  }

  .testimonial-36-card__text {
    font-size: calc(var(--fs-1) / 1.3);
  }

  .testimonial-36-card__head {
    flex-direction: row;
    align-items: center;
    column-gap: calc(var(--flow-spacing) / 2);
  }

  .testimonial-36-card__avatar {
    display: flex;
    width: 40;
    height: 40;
    border-radius: 100% 100% 100% 100%;
    overflow: hidden;
  }

  .testimonial-36-card__avatar-image {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  .testimonial-36-card__client-data {
    display: flex;
    flex-direction: column;
  }

  .testimonial-36-card__client-name {
    font-size: var(--fs-0);
    font-weight: 700;
  }

  .testimonial-36-card__client-title {
    font-size: var(--fs-0);
  }
</style>
