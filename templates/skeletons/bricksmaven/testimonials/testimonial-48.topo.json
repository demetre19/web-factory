   "custom_css": ".bm-testimonial-48__slider {\n  --icon-dimension: 92px; /* Change the icon dimensions*/\n  --icon-size: 24px; /* Change the icon size*/\n  --icon-opacity: 0.5;  /* Change the icon opacity*/\n}\n\n.bm-testimonial-48__slider .splide__track {\n  overflow: visible;\n}\n\n.bm-testimonial-48__slider .splide__arrow--next {\n  left: 0;\n  transition: 0.2s ease;\n}\n\n.bm-testimonial-48__slider .splide__arrow--prev {\n  left: calc(-1 * (var(--space-m) + var(--icon-dimension)));\n  transition: 0.2s ease;\n}\n\n.bm-testimonial-48__slider .splide__arrows {\n    position: absolute;\n    inset-block-start: calc(-1 * (var(--container-gap) + 4rem)); \n  \tinset-inline-end: var(--icon-dimension);\n   \t\n}\n\n@media (max-width:767px) {\n  .bm-testimonial-48__slider .splide__arrows {\n    position: absolute;\n    inset-block-start: unset;\n    inset-block-end: calc(-1 * (var(--container-gap) + 3rem));\n  \tinset-inline-end: var(--icon-dimension);\n}\n}",
