          </div>
          <div class="testimonial-32-slide__client-wrapper">
            <div class="testimonial-32-slide__media">
              <figure class="testimonial-32-slide__client-image"><img src="/media/placeholder.svg" alt="Client Image" loading="lazy" width="900" height="600" /></figure>
