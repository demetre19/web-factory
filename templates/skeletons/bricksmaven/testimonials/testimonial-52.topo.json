   "custom_css": "\n.bm-testimonial-52__slider-nested {\n  --icon-dimension: 32px; /* Change the icon dimensions*/\n  --icon-size: 14px; /* Change the icon size*/\n  --icon-opacity: 0.5;  /* Change the icon opacity*/\n}\n\n.bm-testimonial-52__slider-nested .splide__track {\n  overflow:  visible; /* Expose other slides*/\n}\n\n.bm-testimonial-52__slider-nested .is-active {\n  box-shadow: var(--box-shadow-s); /* Active card gets a box shadow */\n}\n\n.bm-testimonial-52__slider-nested .bm-testimonial-52-card:not(.is-active) {\n  opacity: 0.4; /* non-active card gets a lower opacity */\n}\n\n/* ARROWS */\n.bm-testimonial-52__slider-nested .splide__arrow--next {\n  left: 0;\n  transition: 0.5s ease;\n}\n\n.bm-testimonial-52__slider-nested .splide__arrow--prev {\n  left: calc(-1 * var(--space-xl));\n  transition: 0.5s ease;\n}\n\n.bm-testimonial-52__slider-nested .splide__arrows {\n    position: absolute;\n    inset-block-end: calc(-1 * var(--space-xl));\n  \tinset-inline-end: var(--space-m);  \t\n}\n\n.bm-testimonial-52__slider-nested .splide__arrows button:hover {\n    background-color: var(--base);\n  \n}\n\n.bm-testimonial-52__slider-nested .splide__arrows button:hover svg {\n    fill: var(--base-ultra-light);\n  \n}\n",
