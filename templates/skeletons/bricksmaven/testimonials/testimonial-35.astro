interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="testimonial-35__container">
    <div class="intro intro--split">
      <div class="intro__left-column">
        <h2 class="intro__heading">Long headline to turn your visitors into users</h2>
        <p class="intro__accent-heading">Tagline</p>
      </div>
      <div class="intro__right-column">
        <p class="intro__subheading">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
        <a class="btn--primary wf-cta-button" href={cta.href}>{cta.label}</a>
      </div>
    </div>
    <div class="testimonial-35__carousel">
      <div class="testimonial-35__row">
        <div class="testimonial-35-carousel-list list--none">
          {items.map((it) => (
            <div class="testimonial-35-carousel-card">
              <div class="testimonial-35-carousel-card__wrapper">
                <div class="testimonial-35-carousel-card__content">
                  <div class="testimonial-35-carousel-card__intro">
                    <h2 class="testimonial-35-carousel-card__heading">{it.title}</h2>
                  </div>
                  <div class="testimonial-35-carousel-card__client-data">
                    <p class="testimonial-35-carousel-card__client-name">{it.text}</p>
                    <p class="testimonial-35-carousel-card__title">{it.text}</p>
                  </div>
                  <div class="testimonial-35-carousel-card__logo-wrapper">
                    <figure class="testimonial-35-carousel-card__logo-image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                  </div>
                </div>
                <div class="testimonial-35-carousel-card__media">
                  <figure class="testimonial-35-carousel-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="testimonial-35__row">
        <div class="testimonial-35-carousel-list list--none">
          {items.map((it) => (
            <div class="testimonial-35-carousel-card">
              <div class="testimonial-35-carousel-card__wrapper">
                <div class="testimonial-35-carousel-card__content">
                  <div class="testimonial-35-carousel-card__intro">
                    <h2 class="testimonial-35-carousel-card__heading">{it.title}</h2>
                  </div>
                  <div class="testimonial-35-carousel-card__client-data">
                    <p class="testimonial-35-carousel-card__client-name">{it.text}</p>
                    <p class="testimonial-35-carousel-card__title">{it.text}</p>
                  </div>
                  <div class="testimonial-35-carousel-card__logo-wrapper">
                    <figure class="testimonial-35-carousel-card__logo-image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                  </div>
                </div>
                <div class="testimonial-35-carousel-card__media">
                  <figure class="testimonial-35-carousel-card__image"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div></div>
    </div>
  </div>
</div>

<style is:global>
@layer components {
  .testimonial-35 {
    overflow: hidden;
  }

  .testimonial-35__container {
    row-gap: var(--space-s);
  }

  .intro {
    text-align: center;
    flex-direction: column;
    display: flex;
    align-items: center;
    row-gap: var(--space-s);
    align-self: center;
  }

  .intro--split {
    display: grid;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    align-self: flex-start;
    grid-template-columns: calc(100% * 1 / 2);
    gap: var(--space-m);
  }

  .intro__left-column {
    row-gap: var(--flow-spacing);
  }

  .intro__right-column {
    row-gap: var(--flow-spacing);
  }

  .btn--primary {
    padding: 1.25rem 1.875rem 1.25rem 1.875rem !important;
    width: auto;
  }

  .testimonial-35__carousel {
    width: 100vw;
    margin: 0 -50vw 0 -50vw !important;
    left: 50%;
    position: relative;
    display: grid;
    grid-template-columns: calc(100% * 1 / 1);
    gap: var(--space-m);
    right: 50%;
  }

  .testimonial-35-carousel-list {
    display: flex;
    flex-direction: row;
  }

  .testimonial-35-carousel-card {
    flex-direction: row;
  }

  .testimonial-35-carousel-card__wrapper {
    display: grid;
    grid-template-columns: calc(100% * 1 / 2);
    width: 900;
    height: var(--acss-carousel-card-height);
  }

  .testimonial-35-carousel-card__content {
    row-gap: calc(var(--flow-spacing) * 1.4);
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    background: var(--bg-subtle);
    padding: var(--space-xl) var(--space-xl) var(--space-xl) var(--space-xl);
    justify-content: center;
  }

  .testimonial-35-carousel-card__intro {
    position: relative;
  }

  .testimonial-35-carousel-card__heading {
    font-size: var(--fs-1);
  }

  .testimonial-35-carousel-card__client-data {
    display: flex;
    flex-direction: column;
  }

  .testimonial-35-carousel-card__client-name {
    font-weight: 700;
  }

  .testimonial-35-carousel-card__title {
    object-fit: contain;
  }

  .testimonial-35-carousel-card__logo-wrapper {
    object-fit: contain;
  }

  .testimonial-35-carousel-card__logo-image {
    object-fit: contain;
  }

  .testimonial-35-carousel-card__media {
    overflow: hidden;
  }

  .testimonial-35-carousel-card__image {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  /* bm-custom */
  .testimonial-35__carousel::before {
  	content:'';
    position: absolute;
    left:0;
    height:100%;
    width:25%;
    background: linear-gradient( 90deg, var(--bg-canvas), transparent);
    z-index: 99;
  }
  
  .testimonial-35__carousel::after {
  	content:'';
    position: absolute;
    right:0;
    height:100%;
    width:25%;
    background: linear-gradient( 90deg, transparent,var(--bg-canvas));
    z-index: 99;
  }
}
</style>
