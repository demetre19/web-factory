    justify-content: space-between;
  }

  .bm-testimonial-58-card__review-cover {
    row-gap: calc(var(--flow-spacing) / 2);
    z-index: 2;
  }

  .bm-testimonial-58-card__heading {
    font-size: var(--fs-4);
  }

  .bm-testimonial-58-card__accent-heading {
    font-size: var(--fs-0);
    font-weight: 700;
  }

  .bm-testimonial-58-card__footer {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    z-index: 2;
  }

  .bm-testimonial-58-card__name {
    font-weight: 700;
  }

  .bm-testimonial-58-card__title {
    font-size: var(--fs-0);
  }

  .bm-testimonial-58-card__overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
  }

  .bm-testimonial-58-card__background-image {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
