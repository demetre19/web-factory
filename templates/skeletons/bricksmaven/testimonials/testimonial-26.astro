---
/**
 * bm-testimonial-26 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (testimonial-26.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
} = Astro.props;
---

<div>
  <div class="sec-inner">
    <div class="testimonial-26-container">
      <div class="intro">
        {heading && <h2 class="text-fluid-2">{heading}</h2>}
        {fs && <p class="text-fluid-0">{fs}</p>}
      </div>
      <div>
        <div class="testimonial-26-tabs__nav">
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="testimonial-26-tabs__nav-item card">
                <div class="testimonial-26-tabs__nav-profile">
                  <div class="testimonial-26-tabs__nav-meta">
                    <h4 class="text-fluid-2">{it.title}</h4>
                    <p class="text-fluid-0">{it.text}</p>
                  </div>
                  <div>
                    <figure class="testimonial-26-tabs__nav-photo ratio-portrait"><img src="/media/placeholder.svg" alt="image" loading="lazy" width="900" height="600" /></figure>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div>
          <div class="grid-auto gap-fluid-m">
            {(items || []).map((it) => (
              <div class="card">
                <div class="testimonial-26-tabs__content-wrapper">
                  <h2 class="testimonial-26-tabs__content-title text-fluid-2">{it.title}</h2>
                  <div class="testimonial-26-tabs__content-review">
                    <div class="grid-auto gap-fluid-m">
                      {((it.items || []) || []).map((it2) => (
                        <span class="card" data-icon="lucide" aria-hidden="true"></span>
                      ))}
                    </div>
                  </div>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="testimonial-26-script"></div>
    </div>
  </div>
</div>
