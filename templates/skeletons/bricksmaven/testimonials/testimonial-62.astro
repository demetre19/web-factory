interface Props {
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string;
             label?: string; href?: string;
             items?: any[] }[];
}
const {
  heading = 'Section heading',
  fs = 'The first sentence a reader needs.',
  cta, items = [],
} = Astro.props;
---

<div>
  <div class="bm-testimonial-62__container">
    <div class="intro">
      <h2 class="intro__heading">{heading}</h2>
      <p class="intro__subheading">{fs}</p>
      <p class="bm-accent-heading">Accent heading</p>
    </div>
    <div class="bm-testimonial-62-list">
      <div class="bm-testimonial-62-slider-nestable">
        {items.map((it) => (
          <div class="bm-testimonial-62-card">
            <div class="bm-testimonial-62-card__video-wrapper">
              <figure class="bm-testimonial-62-card__video"></figure>
            </div>
            <div class="bm-testimonial-62-card__content">
              <p class="bm-testimonial-62-card__review">{it.text}</p>
              <p class="bm-testimonial-62-card__client">{it.text}</p>
            </div>
          </div>
        ))}
      </div>
      <div></div>
    </div>
  </div>
</div>

