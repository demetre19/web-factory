    "_cssCustom": ".bm-testimonial-57-slider-comp {\n  --icon-dimension: 64px; /* Change the icon dimensions*/\n  --icon-size: 16px; /* Change the icon size*/\n  --icon-opacity: 0.5;  /* Change the icon opacity*/\n}\n\n\n.bm-testimonial-57-slider-comp .splide__arrow--next {\n  left: var(--space-s);\n  transition: 0.5s ease;\n}\n\n.bm-testimonial-57-slider-comp .splide__arrow--prev {\n  left: calc(-1 * var(--icon-dimension));\n  transition: 0.5s ease;\n}\n\n.bm-testimonial-57-slider-comp .splide__arrows {\n    position: absolute;\n    inset-block-end: var(--space-xl);\n  \tinset-inline-start: var(--icon-dimension);\n   \t\n}\n\n\n@media (max-width:767px) {\n  .splide__pagination {\n    display:none;\n  }\n}",
