---
/**
 * BaseLayout.astro — the document shell every assembled page renders
 * inside. assemble_page wraps its <Section> blocks in this layout;
 * pipeline_emit.py copies it to site/src/layouts/BaseLayout.astro.
 *
 * The shell owns head/meta (P.16, R.1), the light/dark toggle +
 * paint-first theme script (C.5), skip-link and the page landmarks
 * (PS.9). It ships no style blocks, no inline styles, no colour
 * literals: classes bind the shared layer in global.css only.
 */
interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
  slug?: string;
}
const {
  title,
  description = '',
  image = '/og.webp',
  lang = 'en',
  slug = '',
} = Astro.props;
// F3 fix — applyBaseStyles:false means nothing styles the page unless
// the layout imports the shared layer itself (the starter does).
import '../styles/global.css';

---
<!doctype html>
<html lang={lang} dir="ltr">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<link rel="icon" href="/favicon.svg" />
<script is:inline>
(function () {
  // U.3 — first paint is BRIEF theme.default (never the OS preference);
  // a manual toggle persists the choice in localStorage.
  var s = new URLSearchParams(location.search).get('theme') || localStorage.getItem('theme');
  var m = s || {{default_theme}};
  document.documentElement.dataset.theme = m;
  document.documentElement.classList.toggle('dark', m === 'dark');
  window.__wfSetTheme = function (v) {
    localStorage.setItem('theme', v);
    document.documentElement.dataset.theme = v;
    document.documentElement.classList.toggle('dark', v === 'dark');
  };
  document.addEventListener('click', function (e) {
    if (e.target && e.target.closest && e.target.closest('[data-theme-toggle]')) {
      window.__wfSetTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
    }
    var nl = document.querySelector('.nav-links');
    if (e.target && e.target.closest && e.target.closest('.burger, .nav-more')) {
      if (nl) nl.classList.toggle('open');
    } else if (nl && nl.classList.contains('open')) {
      // flyout closes on the close control, on a link it navigates
      // to, or on any click outside the sheet (the scrim)
      var inside = e.target && e.target.closest &&
                   e.target.closest('.nav-links');
      if (!inside || e.target.closest('.nav-close') ||
          e.target.closest('.nav-links a')) {
        nl.classList.remove('open');
      }
    }
    // the generic overlay family (.flyout — modals/popups/dialogs)
    // rides the same contract: trigger toggles, close control and
    // scrim clicks dismiss (N.flyout)
    var fo = document.querySelector('.flyout');
    if (fo) {
      if (e.target && e.target.closest && e.target.closest('.flyout-open')) {
        fo.classList.toggle('open');
      } else if (fo.classList.contains('open')) {
        var inFo = e.target && e.target.closest &&
                   e.target.closest('.flyout');
        if (!inFo || e.target.closest('.flyout-close')) {
          fo.classList.remove('open');
        }
      }
    }
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      var nl = document.querySelector('.nav-links');
      if (nl) nl.classList.remove('open');
      var fo = document.querySelector('.flyout');
      if (fo) fo.classList.remove('open');
    }
  });
})();
</script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<main id="main">
<slot />
</main>
<a class="call-bar" href="{{tel}}">
  <span>{{phone}}</span><span class="sr-only">Call now</span>
</a>
</body>
</html>
