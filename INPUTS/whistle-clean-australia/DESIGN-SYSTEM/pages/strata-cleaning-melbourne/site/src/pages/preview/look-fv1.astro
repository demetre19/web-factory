<Section sec="definition" comp="editorial" wf-ref="preview/layouts.html#d1:definition" ratio="4:3" disclosure="open" surface="muted" density="regular" intent="detail" content="c-b01" recipe="bricksmaven/content/content-1" mode="band">
  <!-- section contract: composition=editorial section=definition surface=muted density=regular speech_act=detail -->
  <Editorial heading="What is strata cleaning?" fs="Strata cleaning is the scheduled cleaning of a building's shared areas \u2013 a trained team keeps foyers, lifts, carparks and amenities to a documented standard on a recurring roster." image={({"src": "/media/gallery-vacuum.jpg", "alt": "Whistle Clean cleaner vacuuming a gallery floor", "ratio": "3:2"})} copy={({"heading": "What is strata cleaning?", "answer": "Strata cleaning is **the scheduled cleaning of a building's shared areas** – a trained team keeps foyers, lifts, carparks and amenities to a documented standard on a recurring roster.", "before": ["The work answers to the strata manager and the strata management company, not to one household: the owners corporation signs for the scope, and the same residents judge the result every day.", "That is why the standard stays written down – shared areas hold no single owner to complain for them.", "Common-area work differs from a residential booking because the payer judges collectively.", "The owners corporation holds the budget, the committee holds the vote, and the manager answers when a foyer slips – so the scope stays written and reported.", "Strata Cleaning Melbourne runs this way for strata managers, owners corporations and building managers. Foyers mark the building's first impression, and the roster keeps it fixed."], "items": [], "list_ordered": false, "qa": [], "links": [], "after": []})} brand="Whistle Clean" logo="/logo.svg" />
</Section>
<Section sec="scope" comp="cards-n" wf-ref="preview/layouts.html#d1:scope" ratio="none" disclosure="open" surface="base" density="regular" intent="proof" content="c-b02" cols="2" recipe="bricksmaven/grids-and-cards/grid-1" mode="band">
  <!-- section contract: composition=cards-n section=scope surface=base density=regular speech_act=detail -->
  <CardsN heading="What does a strata clean include?" fs="A strata clean covers foyers, lifts, carparks and shared amenities on every scheduled visit \u2013 each area scoped and quality-checked." copy={({"heading": "What does a strata clean include?", "answer": "A strata clean covers **foyers, lifts, carparks and shared amenities** on every scheduled visit – each area scoped and quality-checked.", "before": ["The visit scope for strata cleaning services covers:"], "items": [{"term": "Foyers.", "text": "Entry glass polished, floors mopped, letterboxes and intercoms wiped.", "icon": "broom"}, {"term": "Lifts.", "text": "Walls, buttons and floors detailed; high-touch points sanitised every visit.", "icon": "spraycan"}, {"term": "Carparks.", "text": "Sweeping, litter pickup and stain spotting on a set rotation.", "icon": "map-pin"}, {"term": "Shared amenities.", "text": "Gym equipment, pool surrounds and common rooms reset, with consumables restocked under the restocking clause.", "icon": "building"}], "list_ordered": false, "qa": [], "links": [], "after": ["Bin rooms, storage cages and plant corridors join the rotation on monthly cycles. The scope also names what stays out: individual lots, balcony glass and appliances inside apartments remain the owner's job.", "Weekly cycles add deeper detail like skirting, cobwebs and bin-room wash-downs to the same written scope."]})} brand="Whistle Clean" logo="/logo.svg" />
</Section>
<Section sec="process" comp="sequence" wf-ref="preview/layouts.html#d1:process" ratio="none" disclosure="open" surface="muted" density="regular" intent="process" content="c-b03" recipe="bricksmaven/how-it-works/how-it-works-1" mode="band">
  <!-- section contract: composition=sequence section=process surface=muted density=regular speech_act=how -->
  <Sequence heading="How does a strata cleaning contract run?" fs="Every strata cleaning contract runs the same four steps \u2013 site audit, scope plan, team assignment, supervisor QA." copy={({"heading": "How does a strata cleaning contract run?", "answer": "Every strata cleaning contract runs **the same four steps** – site audit, scope plan, team assignment, supervisor QA.", "before": [], "items": [{"term": "Site audit.", "text": "A supervisor walks the building, maps shared areas and notes access, alarms and resident rules.", "icon": "clipboard-check"}, {"term": "Scope plan.", "text": "The audit becomes a written task list with daily, weekly and monthly items.", "icon": "clipboard-check"}, {"term": "Team assignment.", "text": "The same trained cleaners take the site, inducted on its keys, hazards and layout.", "icon": "users"}, {"term": "Supervisor QA.", "text": "A supervisor inspects against the scope on a set cycle and signs off each visit.", "icon": "clipboard-check"}], "list_ordered": true, "qa": [], "links": [], "after": ["Strata buildings add resident-facing rules the audit captures early – quiet hours, lift bookings and foyer signage all land in the site notes before the first visit.", "The steps then repeat per building, so a second tower or an adjoining block runs the identical sequence."]})} brand="Whistle Clean" logo="/logo.svg" />
</Section>
<Section sec="reporting" comp="proof-band" wf-ref="preview/layouts.html#d1:reporting" ratio="4:3" disclosure="open" surface="base" density="regular" intent="proof" content="c-b04" recipe="bricksmaven/testimonials/testimonial-1" mode="band">
  <!-- section contract: composition=proof-band section=reporting surface=base density=regular speech_act=proof -->
  <ProofBand heading="What reporting does strata cleaning carry?" fs="Strata cleaning carries a reporting rhythm \u2013 visit logs, photo records and a supervisor sign-off the strata manager files with each invoice." image={({"src": "/media/team-foyer.jpg", "alt": "Whistle Clean cleaner mopping a bright residential foyer", "ratio": "21:9"})} copy={({"heading": "What reporting does strata cleaning carry?", "answer": "Strata cleaning carries **a reporting rhythm** – visit logs, photo records and a supervisor sign-off the strata manager files with each invoice.", "before": ["The reporting discipline is what separates a contract from a casual arrangement. Visit logs timestamp every attendance, photo records show condition at handover, and the sign-off closes each visit against the written scope.", "The strata manager files the lot in the compliance file, ready for committee meetings or owner queries.", "Committee meetings run on evidence, and the file supplies it: missed visits show as gaps, extra work shows as photos, and the manager defends the spend from records rather than memory.", "The [strata cleaning contracts](/guides/strata-contracts/) guide lists the clauses worth holding in the agreement, and each invoice on this side arrives with the records already attached."], "items": [], "list_ordered": false, "qa": [], "links": [], "after": []})} brand="Whistle Clean" logo="/logo.svg" />
</Section>
<Section sec="pricing" comp="comparison" wf-ref="preview/layouts.html#d1:pricing" ratio="none" disclosure="open" surface="muted" density="regular" intent="detail" content="c-b05" cols="2" recipe="bricksmaven/comparison/comparison-1" mode="band">
  <!-- section contract: composition=comparison section=pricing surface=muted density=regular speech_act=detail -->
  <Comparison heading="How is strata cleaning priced?" fs="Strata cleaning prices follow building size, visit frequency and access points \u2013 written as a monthly invoice after a site audit." items={([{"term": "Visit frequency", "text": "multiplies them across the week", "icon": "calendar"}, {"term": "Monthly invoice", "text": "carries wages", "icon": "calendar"}, {"term": "Building size", "text": "sets the base minutes", "icon": "building"}, {"term": "Access points", "text": "decide whether the team services one entry or several", "icon": "users"}])} copy={({"heading": "How is strata cleaning priced?", "answer": "Strata cleaning prices follow **building size, visit frequency and access points** – written as a monthly invoice after a site audit.", "before": ["Building size sets the base minutes; visit frequency multiplies them across the week; access points decide whether the team services one entry or several. Amenity count, lift banks and carpark area adjust the figure inside that frame.", "Every engagement ships as a written quote first, so the owners corporation sees the rate structure before approval.", "Older walk-ups and new towers price on the same frame – stairwell count, lift banks and basement levels feed the audit, and committees compare like-for-like written quotes rather than hourly guesses.", "Buyers who ask about an hourly rate find it folded into the contract figure – the monthly invoice carries wages, super and insurance, then stays flat until scope changes."], "items": [], "list_ordered": false, "qa": [], "links": [], "after": []})} brand="Whistle Clean" logo="/logo.svg" />
</Section>
<Section sec="frequency" comp="stat-band" wf-ref="preview/layouts.html#d1:frequency" ratio="none" disclosure="open" surface="base" density="regular" intent="proof" content="c-b06" cols="2" recipe="bricksmaven/counter/counter-1" mode="band">
  <!-- section contract: composition=stat-band section=frequency surface=base density=regular speech_act=proof -->
  <StatBand heading="How often should common areas be cleaned?" fs="Common-area frequency follows traffic \u2013 foyers and lifts need daily attention, carparks and shared amenities a weekly cycle." items={([{"term": "Strata cleaning checklist", "text": "sets out the common-area items", "icon": "sparkles"}, {"term": "Common-area schedule", "text": "matches resident load", "icon": "users"}, {"term": "Daily attention", "text": "through the working week", "icon": "calendar"}, {"term": "Weekly cycle", "text": "with monthly detail passes on top", "icon": "calendar"}])} copy={({"heading": "How often should common areas be cleaned?", "answer": "Common-area frequency follows **traffic** – foyers and lifts need daily attention, carparks and shared amenities a weekly cycle.", "before": ["The common-area schedule matches resident load. High-traffic foyers and lift cars take daily attention through the working week; carparks, storage corridors and shared amenities hold a weekly cycle with monthly detail passes on top.", "The [strata cleaning checklist](/guides/strata-cleaning-checklist/) sets out the common-area items and their frequencies for committees auditing a scope.", "Quiet buildings stretch the roster; busy towers tighten it – the site audit sets the starting point and the visit log adjusts it.", "Short-stay towers and school-holiday buildings shift the load again, so the roster tightens around occupancy peaks instead of holding a flat weekly shape residents never see."], "items": [], "list_ordered": false, "qa": [], "links": [], "after": []})} brand="Whistle Clean" logo="/logo.svg" />
</Section>
