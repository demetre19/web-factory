---
import '../styles/global.css';
import CardsN from '../components/cards-n.astro';
import Comparison from '../components/comparison.astro';
import Faq from '../components/faq.astro';
import FooterBar from '../components/footer-bar.astro';
import FormPanel from '../components/form-panel.astro';
import LinkGrid from '../components/link-grid.astro';
import NavBar from '../components/nav-bar.astro';
import Sequence from '../components/sequence.astro';
import SplitMedia from '../components/split-media.astro';
import StackedHero from '../components/stacked-hero.astro';
import StatBand from '../components/stat-band.astro';
---
<button data-theme-toggle aria-label="Light or dark">Light/Dark</button>
<div data-comp="cards-n"><CardsN /></div><div data-comp="comparison"><Comparison /></div><div data-comp="faq"><Faq /></div><div data-comp="footer-bar"><FooterBar /></div><div data-comp="form-panel"><FormPanel /></div><div data-comp="link-grid"><LinkGrid /></div><div data-comp="nav-bar"><NavBar /></div><div data-comp="sequence"><Sequence /></div><div data-comp="split-media"><SplitMedia /></div><div data-comp="stacked-hero"><StackedHero /></div><div data-comp="stat-band"><StatBand /></div>
