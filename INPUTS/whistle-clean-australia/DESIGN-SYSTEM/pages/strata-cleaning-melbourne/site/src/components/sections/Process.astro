<Sequence heading="How does a strata cleaning contract run?" fs="Every strata cleaning contract runs the same four steps \u2013 site audit, scope plan, team assignment, supervisor QA." copy={({"heading": "How does a strata cleaning contract run?", "answer": "Every strata cleaning contract runs **the same four steps** – site audit, scope plan, team assignment, supervisor QA.", "before": [], "items": [{"term": "Site audit.", "text": "A supervisor walks the building, maps shared areas and notes access, alarms and resident rules.", "icon": "clipboard-check"}, {"term": "Scope plan.", "text": "The audit becomes a written task list with daily, weekly and monthly items.", "icon": "clipboard-check"}, {"term": "Team assignment.", "text": "The same trained cleaners take the site, inducted on its keys, hazards and layout.", "icon": "users"}, {"term": "Supervisor QA.", "text": "A supervisor inspects against the scope on a set cycle and signs off each visit.", "icon": "clipboard-check"}], "list_ordered": true, "qa": [], "links": [], "after": ["Strata buildings add resident-facing rules the audit captures early – quiet hours, lift bookings and foyer signage all land in the site notes before the first visit.", "The steps then repeat per building, so a second tower or an adjoining block runs the identical sequence."]})} brand="Whistle Clean" logo="/logo.svg" />
