---
/**
 * capture-form — gold exemplar (SB.5). Adapt copy, tokens and rhythm to the
 * contract; keep the skeleton. Renders inside Section.astro: no
 * <section>, no outer padding/background/max-width (SB.2).
 *
 * U.4: the submit label is the plan's cta label — no default button
 * copy, no example placeholder. Without a cta the form does not render.
 */
interface Props {
  heading?: string;
  fs?: string;
  body?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string; value?: string;
             label?: string; href?: string; quote?: string }[];
  image?: { src: string; alt: string };
  h1?: boolean;
}
const {
  heading = 'Section heading', fs = '', body = '', cta, items = [],
  image, h1,
} = Astro.props;
---

<div class="text-center">
  <div class="mx-auto max-w-prose">
    {h1 ? <h1 class="text-fluid-4">{heading}</h1> : <h2 class="text-fluid-3">{heading}</h2>}
    {fs && <p class="mt-stack text-fluid-0">{fs}</p>}
    {cta && (
      <form class="mt-stack flex flex-wrap justify-center gap-fluid-s" novalidate>
        <label class="sr-only" for="capture-email">Email</label>
        <input id="capture-email" class="rounded-card border border-muted p-fluid-s text-fluid-0"
               type="email" name="email" autocomplete="email" />
        <button class="wf-cta-button" type="submit">{cta.label}</button>
      </form>
    )}
  </div>
</div>
