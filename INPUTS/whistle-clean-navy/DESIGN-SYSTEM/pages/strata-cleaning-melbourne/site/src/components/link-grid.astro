---
/**
 * link-grid — gold exemplar (SB.5). Adapt copy, tokens and rhythm to the
 * contract; keep the skeleton. Renders inside Section.astro: no
 * <section>, no outer padding/background/max-width (SB.2).
 *
 * Full-copy slots (§4.3): heading → answer → before → link cells →
 * items → after in article order (F.1). A link cell renders the
 * article sentence that carries the link, not a bare anchor.
 */
import { inline } from '../_shared/inline';
import type { CopySlot } from '../_shared/inline';
interface Props {
  heading?: string;
  fs?: string;
  body?: string;
  cta?: { label: string; href: string };
  items?: { term?: string; title?: string; text?: string; value?: string;
             label?: string; href?: string; quote?: string }[];
  image?: { src: string; alt: string };
  h1?: boolean;
  copy?: CopySlot;
}
const {
  heading = 'Section heading', fs = '', body = '', cta, items = [],
  image, h1, copy,
} = Astro.props;
const cp: CopySlot = copy || {};
const head = cp.heading || heading;
const sub = cp.answer || fs || body;
const before = cp.before || [];
const links = (cp.links && cp.links.length)
  ? cp.links.map((l) => l.text || `[${l.anchor}](${l.href})`)
  : items.filter((it) => it.label)
         .map((it) => `[${it.label}](${it.href ?? '#'})`);
const list = cp.items || [];
const after = cp.after || [];
---

<div>
  {h1 ? <h1 class="text-fluid-4">{head}</h1> : <h2 class="text-fluid-3">{head}</h2>}
  {sub && <p class="mt-stack max-w-prose text-fluid-0" set:html={inline(sub)} />}
  {before.map((p) => (
    <p class="mt-stack max-w-prose text-fluid-0" set:html={inline(p)} />
  ))}
  {links.length > 0 && (
    <ul class="mt-stack grid-auto list-plain text-fluid-0">
      {links.map((t) => <li set:html={inline(t)} />)}
    </ul>
  )}
  {list.length > 0 && (
    <ul class="mt-stack max-w-prose list-items text-fluid-0">
      {list.map((it) => (
        <li><strong set:html={inline(it.term || it.title)} />{' – '}<span set:html={inline(it.text)} /></li>
      ))}
    </ul>
  )}
  {after.map((p) => (
    <p class="mt-stack max-w-prose text-fluid-0" set:html={inline(p)} />
  ))}
</div>
