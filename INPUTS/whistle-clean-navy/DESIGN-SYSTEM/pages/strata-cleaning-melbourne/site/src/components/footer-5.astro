---
/**
 * footer-5 — gold exemplar (SB.5), bound to bank recipe bricksmaven/footer/footer-5. The skeleton IS the gold structure — this file is the recipe verbatim so emit and the gate judge one artifact.
 */

/**
 * wf-footer-5 — TRANSLATED Bricksmaven skeleton.
 * Produced by bricks_translate.py from the ACSS payload
 * beside this file (footer-5.json). Bank source, NOT a gold
 * exemplar: the SOP adapts props/copy/rhythm before
 * canonising (SB.5). Unmapped ACSS vars surface as
 * var(--acss-*) and are listed in the translate report.
 */
interface Props {
  brand?: string;
  heading?: string;
  fs?: string;
  cta?: { label: string; href: string };
  items?: { title?: string; text?: string; term?: string;
             label?: string; href?: string;
             icon?: string; items?: any[] }[];
  image?: { src: string; alt: string };
  copy?: any;
}
import { inline } from '../_shared/inline';
import IconChip from '../_shared/IconChip.astro';
const {
  brand = 'Brand',
  heading = '',
  fs = '',
  cta = { label: '', href: '#' },
  items = [],
  image,
  copy,
} = Astro.props;
// §4.3 — a copy slot binds verbatim article copy onto
// the skeleton's native props (F.1 — nothing dropped)
const cp = copy || {};
const head = cp.heading || heading;
const sub = cp.answer || cp.text || fs;
const before = cp.before || [];
const list = (cp.items && cp.items.length
  ? cp.items : items) || [];
const qas = cp.qa || [];
const links = cp.links || [];
const after = cp.after || [];
const act = cp.cta || cta;
const phone = cp.phone || '';
const tel = phone ? 'tel:' + phone.replace(/[^0-9+]/g, '') : '';
---

<div class="wf-footer-5">
  <div class="sec-inner">
    <div class="wf-footer-5-container row between">
      <div class="wf-footer-5-alpha row between">
        <span class="logo brand-mark">{brand}</span>
        {sub && <p class="text-fluid-0" set:html={inline(sub)} />}
              </div>
      {before.length > 0 && <div class="flow mt-stack">
{before.map((p) => <p class="mt-flow text-fluid-0" set:html={inline(p)} />)}
      </div>}

      {list.length > 0 &&       <div class="footer-nav-wrapper footer-nav-wrapper-5 row between">
        {list.length > 0 && <div class="row gap-fluid-m">{(list || []).map((it) => (
            <div class="footer-nav-column row between">
              {it.icon && <IconChip name={it.icon} />}
              <h3 class="text-fluid-1">{it.term || it.title}</h3>
              {(it.items || []).length > 0 && <div class="footer-menu row between">
                <div class="row gap-fluid-m">{((it.items || []) || []).map((it2) => (
                    <div>
                      <a class="text-fluid-0" href={it2.href}>{it2.icon && <IconChip name={it2.icon} />} {it2.label || it2.term || it2.anchor || it2.text}</a>
                      {(it2.label || it2.term || it2.anchor) && it2.text && <p class="text-fluid-0">{it2.text}</p>}
                    </div>
                  ))}</div>
              </div>}
            </div>
          ))}</div>}
      </div>
      }
      <div class="wf-footer-5-epsilon row between">
        {head && <h4 class="text-fluid-2">{head}</h4>}
        {links.length >= 0 &&         <div class="wf-footer-5__apps row between">
          {links.length > 0 && <div class="row gap-fluid-m">{(links || []).map((it) => (
              <div class="wf-footer-5__apps-btn row between">
                <div class="row between">
                  <p class="text-fluid-0">{it.text}</p>
                  <p class="text-fluid-0">{it.text}</p>
                </div>
              </div>
            ))}</div>}
          {links.length === 0 && <p class="footer-legal-nav text-fluid-0">Copyright {new Date().getFullYear()} {brand}</p>}
        </div>
        }
      </div>
    </div>
    <div class="wf-footer-5-bottom row between">
      <div class="wf-footer-5-bottom__beta">
        <div>
          {links.length > 0 && <div class="footer-legal-nav row between">
            <div class="row gap-fluid-m">{(links || []).map((it) => (
                <div>
                  <a class="text-fluid-0" href={it.href}>{it.icon && <IconChip name={it.icon} />} {it.label || it.term || it.anchor || it.text}</a>
                  {(it.label || it.term || it.anchor) && it.text && <p class="text-fluid-0">{it.text}</p>}
                </div>
              ))}</div>
          </div>}
          {links.length === 0 && <p class="footer-legal-nav text-fluid-0">Copyright {new Date().getFullYear()} {brand}</p>}
        </div>
      </div>
    </div>
  </div>
  {qas.length > 0 && <dl class="mt-stack">{qas.map((qa) => <><dt class="text-fluid-0" set:html={inline(qa.q)} /><dd class="text-fluid-0" set:html={inline(qa.a)} /></>)}</dl>}
  {links.length > 0 && <div class="flow mt-stack">{links.map((l) => <p class="text-fluid-0" set:html={inline(l.text || `[${l.anchor}](${l.href})`)} />)}</div>}
  {after.length > 0 && <div class="flow mt-stack">{after.map((p) => <p class="text-fluid-0" set:html={inline(p)} />)}</div>}
  {tel && <p class="mt-stack"><a class="link-quiet" href={tel}>{phone}</a></p>}
</div>
